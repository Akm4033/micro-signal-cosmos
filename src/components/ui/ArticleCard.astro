---
import ArticleLogo from './ArticleLogo.astro';
import { getAuthor } from '../../data/authors';

interface Props {
  title: string;
  href?: string;
  slug?: string;
  category: string;
  categorySlug?: string;
  categoryVariant?: 'tech' | 'science' | 'ai' | 'devtools' | string;
  author?: string;
  authorName?: string;
  readingTime?: string;
  publishedTime?: string;
  publishedDate?: string | Date;
  excerpt?: string;
  logo?: string;
  class?: string;
}

const {
  title,
  href,
  slug,
  category,
  categorySlug,
  categoryVariant: propVariant,
  author = 'editorial-desk',
  authorName: propAuthorName,
  readingTime = '8 min read',
  publishedTime,
  publishedDate,
  excerpt = '',
  logo,
  class: className = '',
} = Astro.props;

const articleHref = href || (slug ? `/articles/${slug}/` : '#');
const authorData = getAuthor(author);
const authorName = propAuthorName || authorData.name || 'Lead Editor';

const catSlug = categorySlug || category.toLowerCase().replace(/\s+/g, '-');
const categoryVariantMap: Record<string, 'tech' | 'science' | 'ai' | 'devtools'> = {
  technology: 'tech',
  tech: 'tech',
  'artificial-intelligence': 'ai',
  ai: 'ai',
  science: 'science',
  'developer-tools': 'devtools',
  devtools: 'devtools',
};
const categoryVariant = (propVariant as 'tech' | 'science' | 'ai' | 'devtools') || categoryVariantMap[catSlug] || 'tech';

const rawDate = publishedTime || publishedDate;
const formattedDate = rawDate
  ? new Date(rawDate).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })
  : '';
const isoDate = rawDate ? new Date(rawDate).toISOString() : '';
---

<article class={`editorial-card group flex flex-col justify-between ${className}`} itemscope itemtype="https://schema.org/Article">
  <a href={articleHref} class="block" aria-label={`Read article: ${title}`}>
    <!-- Article Visual with Logo (Clean, Friendly 2D Flat Design) -->
    <div class={`editorial-card__media relative aspect-[16/10] w-full overflow-hidden flex items-center justify-center transition-colors ${
      categoryVariant === 'tech' ? 'bg-sky-50/80 border-b border-sky-100 dark:bg-sky-950/20 dark:border-sky-900/40' :
      categoryVariant === 'ai' ? 'bg-emerald-50/80 border-b border-emerald-100 dark:bg-emerald-950/20 dark:border-emerald-900/40' :
      categoryVariant === 'science' ? 'bg-violet-50/80 border-b border-violet-100 dark:bg-violet-950/20 dark:border-violet-900/40' :
      'bg-amber-50/80 border-b border-amber-100 dark:bg-amber-950/20 dark:border-amber-900/40'
    }`}>
      <!-- Subtle Flat Grid Pattern -->
      <div class="absolute inset-0 opacity-40 pointer-events-none" aria-hidden="true">
        <div class="w-full h-full bg-[radial-gradient(#CBD5E1_1px,transparent_1px)] [background-size:16px_16px] dark:opacity-10"></div>
      </div>
      <span class={`editorial-card__category absolute top-3 left-3 badge badge--${categoryVariant} shadow-2xs`}>{category}</span>
      <!-- Center Article Logo on Elevated Pill -->
      <div class="relative z-10 p-3 rounded-2xl bg-white shadow-xs border border-neutral-200/80 group-hover:scale-105 transition-transform duration-200 dark:bg-neutral-800 dark:border-neutral-700">
        <ArticleLogo logo={logo || catSlug} category={categoryVariant} size="md" />
      </div>
    </div>

    <!-- Article Content -->
    <div class="editorial-card__content p-5 sm:p-6">
      <div class="editorial-card__meta flex items-center gap-2 text-xs mb-3 text-text-muted">
        <span class="font-medium text-text-primary" itemprop="author">{authorName}</span>
        {formattedDate && (
          <>
            <span aria-hidden="true">&bull;</span>
            <time datetime={isoDate} itemprop="datePublished">{formattedDate}</time>
          </>
        )}
        <span aria-hidden="true">&bull;</span>
        <span itemprop="timeRequired">{readingTime}</span>
      </div>

      <h3 class="editorial-card__title text-lg sm:text-xl font-bold leading-snug text-text-primary group-hover:text-brand-primary transition-colors" itemprop="headline">
        <span class="focus-visible:outline-none focus-visible:underline">{title}</span>
      </h3>

      {excerpt && (
        <p class="mt-3 text-sm leading-relaxed text-text-secondary line-clamp-3" itemprop="description">
          {excerpt}
        </p>
      )}
    </div>
  </a>

  <!-- Card Footer -->
  <div class="editorial-card__footer px-5 pb-5 sm:px-6 sm:pb-6 mt-auto">
    <div class="flex items-center justify-between border-t border-neutral-200 pt-4 dark:border-neutral-800">
      <div class="editorial-card__author flex items-center gap-2">
        <div class="editorial-card__avatar w-7 h-7 rounded-full bg-brand-primary/10 text-brand-primary flex items-center justify-center text-xs font-bold">
          {authorData.initials || 'ED'}
        </div>
        <span class="text-xs font-semibold text-text-secondary">{authorData.role || 'Editorial Desk'}</span>
      </div>
      <a href={articleHref} class="ml-auto inline-flex items-center gap-1 text-xs font-bold text-brand-primary group-hover:text-brand-primary-hover transition-colors" aria-label={`Read article: ${title}`}>
        <span>Read</span>
        <span aria-hidden="true" class="transition-transform group-hover:translate-x-0.5">&rarr;</span>
      </a>
    </div>
  </div>
</article>
