---
import ArticleVisual from './ArticleVisual.astro';
import { getAuthor } from '../../data/authors';
import { formatCategoryLabel } from '../../data/categories';

interface Props {
  title: string;
  href?: string;
  slug?: string;
  category: string;
  categorySlug?: string;
  categoryVariant?: 'tech' | 'science' | 'ai' | 'devtools' | string;
  author?: string;
  authorName?: string;
  readingTime?: string;
  publishedTime?: string;
  publishedDate?: string | Date;
  excerpt?: string;
  logo?: string;
  class?: string;
}

const {
  title,
  href,
  slug,
  category,
  categorySlug,
  categoryVariant: propVariant,
  author = 'editorial-desk',
  authorName: propAuthorName,
  readingTime = '8 min read',
  publishedTime,
  publishedDate,
  excerpt = '',
  logo,
  class: className = '',
} = Astro.props;

const articleHref = href || (slug ? `/articles/${slug}/` : '#');
const authorData = getAuthor(author);
const authorName = propAuthorName || authorData.name || 'Signal Insight';

const catSlug = categorySlug || category.toLowerCase().replace(/\s+/g, '-');
const categoryVariantMap: Record<string, 'tech' | 'science' | 'ai' | 'devtools'> = {
  technology: 'tech',
  tech: 'tech',
  'artificial-intelligence': 'ai',
  ai: 'ai',
  science: 'science',
  'developer-tools': 'devtools',
  devtools: 'devtools',
};
const categoryVariant = (propVariant as 'tech' | 'science' | 'ai' | 'devtools') || categoryVariantMap[catSlug] || 'tech';
const displayCategory = formatCategoryLabel(category);

const rawDate = publishedTime || publishedDate;
const formattedDate = rawDate
  ? new Date(rawDate).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })
  : '';
const isoDate = rawDate ? new Date(rawDate).toISOString() : '';
---

<article
  class={`group flex flex-col justify-between overflow-hidden rounded-2xl border border-slate-200/80 bg-white shadow-xs hover:shadow-lg hover:-translate-y-1 hover:border-blue-400 dark:hover:border-blue-500/60 dark:hover:shadow-[0_12px_28px_-6px_rgba(0,0,0,0.5),0_0_20px_rgba(59,130,246,0.15)] transition-all duration-200 dark:bg-[#0B101D] dark:border-white/[0.08] ${className}`}
  itemscope
  itemtype="https://schema.org/Article"
>
  <a href={articleHref} class="block">
    <!-- Scientific Vector Visual Header (High Contrast & Responsive) -->
    <div
      class="relative h-44 sm:h-48 w-full shrink-0 overflow-hidden flex items-center justify-center p-3 transition-colors border-b border-slate-100 dark:border-white/[0.06] bg-slate-50/80 dark:bg-[#05070E]/80"
    >
      <!-- Technical Vector Graphic -->
      <ArticleVisual slug={slug || ''} category={categoryVariant} logo={logo || catSlug} />
    </div>

    <!-- Article Content -->
    <div class="p-4 sm:p-5">
      <!-- Category Badge & Metadata Row Directly Above Title -->
      <div class="mb-3 flex items-center justify-between gap-2 flex-wrap">
        <span
          class={`inline-flex items-center px-2.5 py-0.5 rounded-full text-[10px] font-bold tracking-wide shadow-2xs ${
            categoryVariant === 'tech' ? 'bg-sky-50 text-sky-700 border border-sky-200 dark:bg-sky-950/70 dark:text-sky-300 dark:border-sky-800' :
            categoryVariant === 'ai' ? 'bg-emerald-50 text-emerald-700 border border-emerald-200 dark:bg-emerald-950/70 dark:text-emerald-300 dark:border-emerald-800' :
            categoryVariant === 'science' ? 'bg-purple-50 text-purple-700 border border-purple-200 dark:bg-purple-950/70 dark:text-purple-300 dark:border-purple-800' :
            'bg-amber-50 text-amber-700 border border-amber-200 dark:bg-amber-950/70 dark:text-amber-300 dark:border-amber-800'
          }`}
        >
          {displayCategory}
        </span>

        <div class="flex items-center gap-1.5 text-xs text-slate-500 dark:text-slate-400 font-mono">
          {formattedDate && (
            <>
              <time datetime={isoDate} itemprop="datePublished">{formattedDate}</time>
              <span aria-hidden="true" class="text-slate-300 dark:text-slate-700">&bull;</span>
            </>
          )}
          <span itemprop="timeRequired">{readingTime}</span>
        </div>
      </div>

      <h3 class="text-base sm:text-lg font-bold leading-snug text-slate-900 group-hover:text-blue-600 transition-colors line-clamp-2 dark:text-white dark:group-hover:text-blue-400" itemprop="headline">
        <span>{title}</span>
      </h3>

      {excerpt && (
        <p class="mt-2 text-xs sm:text-sm leading-relaxed text-slate-600 line-clamp-2 dark:text-slate-400" itemprop="description">
          {excerpt}
        </p>
      )}
    </div>
  </a>

  <!-- Compact Card Footer -->
  <div class="px-4 pb-4 sm:px-5 sm:pb-5 mt-auto">
    <div class="flex items-center justify-between border-t border-slate-100 pt-3 dark:border-white/[0.06]">
      <div class="flex items-center gap-2">
        <div class="w-6 h-6 rounded-full bg-blue-50 text-blue-700 flex items-center justify-center text-[10px] font-bold border border-blue-100 dark:bg-blue-950/60 dark:text-blue-300 dark:border-blue-900/60">
          {authorData.initials || 'SI'}
        </div>
        <span class="text-xs font-medium text-slate-500 dark:text-slate-400">{authorData.role || 'Signal Insight Research Desk'}</span>
      </div>

      <a
        href={articleHref}
        class="inline-flex items-center gap-1 text-xs font-bold text-blue-600 group-hover:text-blue-700 group-hover:translate-x-0.5 transition-all dark:text-blue-400 dark:group-hover:text-blue-300"
        aria-label={`Read ${title}`}
      >
        <span>Read</span>
        <span aria-hidden="true">&rarr;</span>
      </a>
    </div>
  </div>
</article>
