---
import { getAuthor } from '../../data/authors';

interface Props {
  title: string;
  slug: string;
  category: string;
  categorySlug?: string;
  readingTime?: string;
  excerpt?: string;
  author?: string;
  publishedDate?: string | Date;
  class?: string;
}

const {
  title,
  slug,
  category,
  categorySlug,
  readingTime = '8 min read',
  excerpt = '',
  author = 'marina',
  publishedDate,
  class: className = '',
} = Astro.props;

const authorData = getAuthor(author);
const catSlug = categorySlug || category.toLowerCase().replace(/\s+/g, '-');

const categoryVariantMap: Record<string, string> = {
  'technology': 'tech',
  'artificial-intelligence': 'ai',
  'science': 'science',
  'developer-tools': 'devtools',
};
const categoryVariant = categoryVariantMap[catSlug] || 'default';

const formattedDate = publishedDate
  ? new Date(publishedDate).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })
  : '';
---

<article class={`editorial-card group flex flex-col justify-between ${className}`}>
  <div>
    <div class="editorial-card__media">
      <div class="editorial-card__gradient"></div>
      <span class="editorial-card__category">{category}</span>
    </div>
    <div class="editorial-card__content">
      <div class="editorial-card__meta">
        <span class="font-medium text-text-primary">{authorData.name}</span>
        {formattedDate && (
          <>
            <span aria-hidden="true">&bull;</span>
            <time>{formattedDate}</time>
          </>
        )}
        <span aria-hidden="true">&bull;</span>
        <span>{readingTime}</span>
      </div>
      <h3 class="editorial-card__title">
        <a href={`/articles/${slug}/`} class="focus-visible:outline-none focus-visible:underline">
          {title}
        </a>
      </h3>
      {excerpt && (
        <p class="editorial-card__excerpt">
          {excerpt}
        </p>
      )}
    </div>
  </div>
  <div class="px-5 pb-5 sm:px-6 sm:pb-6">
    <div class="editorial-card__footer">
      <div class="editorial-card__author">
        <div class="editorial-card__avatar">
          {authorData.initials}
        </div>
        <span class="text-xs font-semibold text-text-secondary">{authorData.role}</span>
      </div>
      <a href={`/articles/${slug}/`} class="ml-auto inline-flex items-center gap-1 text-xs font-bold text-brand-primary group-hover:text-brand-sky-deep">
        <span>Read</span>
        <span aria-hidden="true">&rarr;</span>
      </a>
    </div>
  </div>
</article>

