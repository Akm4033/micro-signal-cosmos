---
import ArticleVisual from './ArticleVisual.astro';
import { getAuthor } from '../../data/authors';

interface Props {
  title: string;
  href?: string;
  slug?: string;
  category: string;
  categorySlug?: string;
  categoryVariant?: 'tech' | 'science' | 'ai' | 'devtools' | string;
  author?: string;
  authorName?: string;
  readingTime?: string;
  publishedTime?: string;
  publishedDate?: string | Date;
  excerpt?: string;
  logo?: string;
  class?: string;
}

const {
  title,
  href,
  slug,
  category,
  categorySlug,
  categoryVariant: propVariant,
  author = 'editorial-desk',
  authorName: propAuthorName,
  readingTime = '8 min read',
  publishedTime,
  publishedDate,
  excerpt = '',
  logo,
  class: className = '',
} = Astro.props;

const articleHref = href || (slug ? `/articles/${slug}/` : '#');
const authorData = getAuthor(author);
const authorName = propAuthorName || authorData.name || 'CURION';

const catSlug = categorySlug || category.toLowerCase().replace(/\s+/g, '-');
const categoryVariantMap: Record<string, 'tech' | 'science' | 'ai' | 'devtools'> = {
  technology: 'tech',
  tech: 'tech',
  'artificial-intelligence': 'ai',
  ai: 'ai',
  science: 'science',
  'developer-tools': 'devtools',
  devtools: 'devtools',
};
const categoryVariant = (propVariant as 'tech' | 'science' | 'ai' | 'devtools') || categoryVariantMap[catSlug] || 'tech';

const rawDate = publishedTime || publishedDate;
const formattedDate = rawDate
  ? new Date(rawDate).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })
  : '';
const isoDate = rawDate ? new Date(rawDate).toISOString() : '';
---

<article
  class={`group flex flex-col justify-between overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-xs hover:shadow-lg hover:-translate-y-1 hover:border-blue-400 dark:hover:border-blue-500 transition-all duration-200 dark:bg-slate-900 dark:border-slate-800 ${className}`}
  itemscope
  itemtype="https://schema.org/Article"
>
  <a href={articleHref} class="block" aria-label={`Read article: ${title}`}>
    <!-- Scientific Vector Visual Header (High Contrast & Responsive) -->
    <div
      class="relative h-40 sm:h-44 w-full shrink-0 overflow-hidden flex items-center justify-center transition-colors border-b border-slate-100 dark:border-slate-800 bg-slate-50 dark:bg-slate-950/50"
    >
      <!-- Technical Vector Graphic -->
      <ArticleVisual slug={slug || ''} category={categoryVariant} logo={logo || catSlug} />

      <!-- Category Pill -->
      <span
        class={`absolute top-3 left-3 px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider shadow-xs pointer-events-none z-20 ${
          categoryVariant === 'tech' ? 'bg-sky-50 text-sky-700 border border-sky-200 dark:bg-sky-950/70 dark:text-sky-300 dark:border-sky-800' :
          categoryVariant === 'ai' ? 'bg-emerald-50 text-emerald-700 border border-emerald-200 dark:bg-emerald-950/70 dark:text-emerald-300 dark:border-emerald-800' :
          categoryVariant === 'science' ? 'bg-purple-50 text-purple-700 border border-purple-200 dark:bg-purple-950/70 dark:text-purple-300 dark:border-purple-800' :
          'bg-amber-50 text-amber-700 border border-amber-200 dark:bg-amber-950/70 dark:text-amber-300 dark:border-amber-800'
        }`}
      >
        {category}
      </span>
    </div>

    <!-- Article Content -->
    <div class="p-4 sm:p-5">
      <div class="flex items-center gap-2 text-xs mb-2 text-slate-500 dark:text-slate-400">
        <span class="font-medium text-slate-900 dark:text-slate-200 text-[11px]" itemprop="author">{authorName}</span>
        {formattedDate && (
          <>
            <span aria-hidden="true" class="text-slate-300 dark:text-slate-600">&bull;</span>
            <time datetime={isoDate} class="text-[11px]" itemprop="datePublished">{formattedDate}</time>
          </>
        )}
        <span aria-hidden="true" class="text-slate-300 dark:text-slate-600">&bull;</span>
        <span class="text-[11px]" itemprop="timeRequired">{readingTime}</span>
      </div>

      <h3 class="text-base sm:text-lg font-bold leading-snug text-slate-900 group-hover:text-blue-600 transition-colors line-clamp-2 dark:text-white dark:group-hover:text-blue-400" itemprop="headline">
        <span class="focus-visible:outline-none focus-visible:underline">{title}</span>
      </h3>

      {excerpt && (
        <p class="mt-2 text-xs sm:text-sm leading-relaxed text-slate-600 line-clamp-2 dark:text-slate-400" itemprop="description">
          {excerpt}
        </p>
      )}
    </div>
  </a>

  <!-- Compact Card Footer -->
  <div class="px-4 pb-4 sm:px-5 sm:pb-5 mt-auto">
    <div class="flex items-center justify-between border-t border-slate-100 pt-3 dark:border-slate-800">
      <div class="flex items-center gap-2">
        <div class="w-6 h-6 rounded-full bg-blue-50 text-blue-700 flex items-center justify-center text-[10px] font-bold border border-blue-100 dark:bg-blue-950/60 dark:text-blue-300 dark:border-blue-900">
          {authorData.initials || 'CU'}
        </div>
        <span class="text-[11px] font-medium text-slate-500 dark:text-slate-400">{authorData.role || 'CURION Research Desk'}</span>
      </div>

      <a
        href={articleHref}
        class="inline-flex items-center gap-1 text-xs font-bold text-blue-600 group-hover:text-blue-700 group-hover:translate-x-0.5 transition-all dark:text-blue-400 dark:group-hover:text-blue-300"
        aria-label={`Read ${title}`}
      >
        <span>Read</span>
        <span aria-hidden="true">&rarr;</span>
      </a>
    </div>
  </div>
</article>
