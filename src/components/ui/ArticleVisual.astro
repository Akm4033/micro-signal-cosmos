---
interface Props {
  slug?: string;
  category?: 'tech' | 'science' | 'ai' | 'devtools' | string;
  logo?: string;
  class?: string;
}

const {
  slug = '',
  category = 'tech',
  logo = '',
  class: className = '',
} = Astro.props;

const key = (slug || '').toLowerCase();
const cat = (category || 'tech').toLowerCase();

// Determine category theme for subtle background tint (zero dotted patterns)
const isAI = cat.includes('ai') || cat.includes('art') || key.includes('llm') || key.includes('rag') || key.includes('benchmark') || key.includes('eval');
const isScience = cat.includes('sci') || key.includes('star') || key.includes('fusion') || key.includes('dark-matter') || key.includes('alien') || key.includes('atmosphere');
const isDevTools = cat.includes('dev') || cat.includes('tool') || key.includes('database') || key.includes('passkey') || key.includes('https') || key.includes('self-hosting');
const isTech = !isAI && !isScience && !isDevTools;
---

<div
  class={`relative w-full h-full overflow-hidden flex items-center justify-center select-none transition-colors ${
    isAI ? 'bg-emerald-50/60 dark:bg-emerald-950/30' :
    isScience ? 'bg-purple-50/60 dark:bg-purple-950/30' :
    isDevTools ? 'bg-amber-50/60 dark:bg-amber-950/30' :
    'bg-sky-50/60 dark:bg-sky-950/30'
  } ${className}`}
>
  <!-- Scientific Vector Illustration Container: Full Bleed, High Contrast, 3D Subtle Scale on Hover -->
  <div class="relative z-10 w-full h-full flex items-center justify-center p-2.5 sm:p-3 transition-transform duration-300 ease-out group-hover:scale-[1.03]">
    
    {/* 1. CHOOSING A DATABASE IN 2026 (Relational, Vector, Columnar & Edge Architecture) */}
    {(key.includes('database') || logo === 'database') && (
      <svg class="w-full h-full max-h-full max-w-full" viewBox="0 0 320 160" fill="none" xmlns="http://www.w3.org/2000/svg" aria-label="Database storage architecture diagram">
        <!-- Relational Engine Node (PostgreSQL) -->
        <g transform="translate(18, 20)">
          <rect width="80" height="118" rx="8" class="fill-white dark:fill-slate-800 stroke-blue-600 dark:stroke-blue-400" stroke-width="2"/>
          <rect width="80" height="24" rx="8" class="fill-blue-600"/>
          <text x="40" y="16" fill="#FFFFFF" font-family="system-ui, sans-serif" font-weight="700" font-size="10" text-anchor="middle">RELATIONAL</text>
          <!-- Table Rows -->
          <line x1="10" y1="38" x2="70" y2="38" class="stroke-slate-300 dark:stroke-slate-600" stroke-width="1.5"/>
          <line x1="10" y1="54" x2="70" y2="54" class="stroke-slate-300 dark:stroke-slate-600" stroke-width="1.5"/>
          <line x1="10" y1="70" x2="70" y2="70" class="stroke-slate-300 dark:stroke-slate-600" stroke-width="1.5"/>
          <line x1="10" y1="86" x2="70" y2="86" class="stroke-slate-300 dark:stroke-slate-600" stroke-width="1.5"/>
          <rect x="8" y="96" width="64" height="16" rx="4" class="fill-blue-50 dark:fill-blue-950/60 stroke-blue-500" stroke-width="1"/>
          <text x="40" y="108" class="fill-blue-700 dark:fill-blue-300" font-family="monospace" font-weight="700" font-size="8.5" text-anchor="middle">ACID • WAL</text>
        </g>
        <!-- Connectors -->
        <path d="M 98 79 L 126 79" class="stroke-blue-600 dark:stroke-blue-400" stroke-width="2" stroke-dasharray="4 3"/>
        <path d="M 194 56 L 222 42" class="stroke-cyan-600 dark:stroke-cyan-400" stroke-width="2"/>
        <polygon points="222,42 214,40 216,46" class="fill-cyan-600 dark:fill-cyan-400"/>
        <path d="M 194 102 L 222 116" class="stroke-emerald-600 dark:stroke-emerald-400" stroke-width="2"/>
        <polygon points="222,116 216,112 214,118" class="fill-emerald-600 dark:fill-emerald-400"/>
        <!-- Central Query Router -->
        <g transform="translate(126, 48)">
          <rect width="68" height="62" rx="8" class="fill-blue-600 stroke-blue-700" stroke-width="2"/>
          <circle cx="34" cy="22" r="10" fill="#FFFFFF" fill-opacity="0.2"/>
          <text x="34" y="26" fill="#FFFFFF" font-family="system-ui, sans-serif" font-weight="800" font-size="10" text-anchor="middle">QUERY</text>
          <text x="34" y="44" fill="#DBEAFE" font-family="system-ui, sans-serif" font-weight="700" font-size="9" text-anchor="middle">ROUTER</text>
        </g>
        <!-- Vector Store Node -->
        <g transform="translate(222, 16)">
          <rect width="84" height="52" rx="8" class="fill-white dark:fill-slate-800 stroke-cyan-600 dark:stroke-cyan-400" stroke-width="2"/>
          <rect width="84" height="18" rx="8" class="fill-cyan-50 dark:fill-cyan-950/60 stroke-cyan-600 dark:stroke-cyan-400" stroke-width="1.5"/>
          <text x="42" y="13" class="fill-cyan-700 dark:fill-cyan-300" font-family="system-ui, sans-serif" font-weight="700" font-size="9" text-anchor="middle">VECTOR (HNSW)</text>
          <text x="42" y="32" class="fill-slate-700 dark:fill-slate-300" font-family="monospace" font-size="8.5" text-anchor="middle">1536-dim</text>
          <text x="42" y="44" class="fill-slate-500 dark:fill-slate-400" font-family="monospace" font-size="8" text-anchor="middle">Cosine Sim</text>
        </g>
        <!-- Edge Replica Node -->
        <g transform="translate(222, 88)">
          <rect width="84" height="52" rx="8" class="fill-white dark:fill-slate-800 stroke-emerald-600 dark:stroke-emerald-400" stroke-width="2"/>
          <rect width="84" height="18" rx="8" class="fill-emerald-50 dark:fill-emerald-950/60 stroke-emerald-600 dark:stroke-emerald-400" stroke-width="1.5"/>
          <text x="42" y="13" class="fill-emerald-700 dark:fill-emerald-300" font-family="system-ui, sans-serif" font-weight="700" font-size="9" text-anchor="middle">EDGE (SQLite)</text>
          <text x="42" y="32" class="fill-slate-700 dark:fill-slate-300" font-family="monospace" font-size="8.5" text-anchor="middle">Zero Latency</text>
          <text x="42" y="44" class="fill-slate-500 dark:fill-slate-400" font-family="monospace" font-size="8" text-anchor="middle">Local WAL</text>
        </g>
      </svg>
    )}

    {/* 2. PASSKEYS & WEBAUTHN (Asymmetric Public-Key Authentication Protocol) */}
    {(key.includes('passkey') || logo === 'key') && (
      <svg class="w-full h-full max-h-full max-w-full" viewBox="0 0 320 160" fill="none" xmlns="http://www.w3.org/2000/svg" aria-label="Passkeys WebAuthn security diagram">
        <!-- Client Device / Hardware Authenticator -->
        <g transform="translate(20, 18)">
          <rect width="96" height="122" rx="10" class="fill-white dark:fill-slate-800 stroke-slate-300 dark:stroke-slate-600" stroke-width="2"/>
          <rect width="96" height="24" rx="10" class="fill-blue-50 dark:fill-blue-950/60 stroke-blue-500" stroke-width="1.5"/>
          <text x="48" y="16" class="fill-blue-700 dark:fill-blue-300" font-family="system-ui, sans-serif" font-weight="700" font-size="9" text-anchor="middle">AUTHENTICATOR</text>
          <!-- Secure Enclave Box -->
          <rect x="10" y="36" width="76" height="48" rx="6" class="fill-amber-50 dark:fill-amber-950/50 stroke-amber-500" stroke-width="1.5"/>
          <circle cx="48" cy="52" r="8" class="fill-amber-500/20 stroke-amber-600" stroke-width="1.5"/>
          <text x="48" y="72" class="fill-amber-800 dark:fill-amber-300" font-family="system-ui, sans-serif" font-weight="700" font-size="8" text-anchor="middle">Secure Enclave</text>
          <text x="48" y="98" class="fill-slate-600 dark:fill-slate-400" font-family="monospace" font-weight="600" font-size="8" text-anchor="middle">PrvKey (Ed25519)</text>
          <text x="48" y="112" class="fill-emerald-600 dark:fill-emerald-400" font-family="system-ui, sans-serif" font-weight="700" font-size="8" text-anchor="middle">Biometric Match ✓</text>
        </g>
        <!-- Handshake Flow Arrows -->
        <g transform="translate(122, 42)">
          <path d="M 0 14 L 70 14" class="stroke-blue-600 dark:stroke-blue-400" stroke-width="2"/>
          <polygon points="70,14 62,10 62,18" class="fill-blue-600 dark:fill-blue-400"/>
          <text x="35" y="8" class="fill-blue-700 dark:fill-blue-300" font-family="monospace" font-weight="700" font-size="8" text-anchor="middle">1. Challenge</text>
          
          <path d="M 70 46 L 0 46" class="stroke-emerald-600 dark:stroke-emerald-400" stroke-width="2"/>
          <polygon points="0,46 8,42 8,50" class="fill-emerald-600 dark:fill-emerald-400"/>
          <text x="35" y="40" class="fill-emerald-700 dark:fill-emerald-300" font-family="monospace" font-weight="700" font-size="8" text-anchor="middle">2. Signed Sig</text>
        </g>
        <!-- Relying Party Server -->
        <g transform="translate(200, 18)">
          <rect width="100" height="122" rx="10" class="fill-white dark:fill-slate-800 stroke-slate-300 dark:stroke-slate-600" stroke-width="2"/>
          <rect width="100" height="24" rx="10" class="fill-slate-100 dark:fill-slate-700 stroke-slate-400" stroke-width="1.5"/>
          <text x="50" y="16" class="fill-slate-800 dark:fill-slate-200" font-family="system-ui, sans-serif" font-weight="700" font-size="9" text-anchor="middle">RELYING PARTY</text>
          <!-- Public Key Registry -->
          <rect x="10" y="36" width="80" height="48" rx="6" class="fill-emerald-50 dark:fill-emerald-950/40 stroke-emerald-500" stroke-width="1.5"/>
          <text x="50" y="54" class="fill-emerald-800 dark:fill-emerald-300" font-family="system-ui, sans-serif" font-weight="700" font-size="8" text-anchor="middle">Public Key Registry</text>
          <text x="50" y="70" class="fill-slate-600 dark:fill-slate-400" font-family="monospace" font-size="7.5" text-anchor="middle">PubKey (x, y)</text>
          <!-- Verification Output -->
          <rect x="10" y="92" width="80" height="20" rx="4" class="fill-emerald-600"/>
          <text x="50" y="106" fill="#FFFFFF" font-family="system-ui, sans-serif" font-weight="700" font-size="8" text-anchor="middle">Verified Authentic</text>
        </g>
      </svg>
    )}

    {/* 3. HTTPS DEEP DIVE (TLS 1.3 1-RTT Handshake Sequence) */}
    {(key.includes('https') || logo === 'shield') && (
      <svg class="w-full h-full max-h-full max-w-full" viewBox="0 0 320 160" fill="none" xmlns="http://www.w3.org/2000/svg" aria-label="TLS 1.3 Handshake diagram">
        <!-- Client Timeline -->
        <line x1="55" y1="26" x2="55" y2="140" class="stroke-slate-300 dark:stroke-slate-700" stroke-width="2"/>
        <rect x="25" y="12" width="60" height="24" rx="6" class="fill-white dark:fill-slate-800 stroke-blue-600 dark:stroke-blue-400" stroke-width="2"/>
        <text x="55" y="28" class="fill-blue-700 dark:fill-blue-300" font-family="system-ui, sans-serif" font-weight="700" font-size="9" text-anchor="middle">CLIENT</text>

        <!-- Server Timeline -->
        <line x1="265" y1="26" x2="265" y2="140" class="stroke-slate-300 dark:stroke-slate-700" stroke-width="2"/>
        <rect x="235" y="12" width="60" height="24" rx="6" class="fill-white dark:fill-slate-800 stroke-blue-600 dark:stroke-blue-400" stroke-width="2"/>
        <text x="265" y="28" class="fill-blue-700 dark:fill-blue-300" font-family="system-ui, sans-serif" font-weight="700" font-size="9" text-anchor="middle">SERVER</text>

        <!-- Flow 1: ClientHello (ECDH Key Share) -->
        <line x1="55" y1="52" x2="260" y2="68" class="stroke-blue-600 dark:stroke-blue-400" stroke-width="2"/>
        <polygon points="260,68 250,63 252,71" class="fill-blue-600 dark:fill-blue-400"/>
        <rect x="90" y="44" width="140" height="18" rx="4" class="fill-blue-50 dark:fill-blue-950/60 stroke-blue-400" stroke-width="1"/>
        <text x="160" y="56" class="fill-blue-700 dark:fill-blue-300" font-family="monospace" font-weight="700" font-size="8" text-anchor="middle">ClientHello + KeyShare (X25519)</text>

        <!-- Flow 2: ServerHello + CertVerify + Finished -->
        <line x1="265" y1="84" x2="60" y2="100" class="stroke-emerald-600 dark:stroke-emerald-400" stroke-width="2"/>
        <polygon points="60,100 70,105 68,97" class="fill-emerald-600 dark:fill-emerald-400"/>
        <rect x="80" y="78" width="160" height="18" rx="4" class="fill-emerald-50 dark:fill-emerald-950/60 stroke-emerald-400" stroke-width="1"/>
        <text x="160" y="90" class="fill-emerald-700 dark:fill-emerald-300" font-family="monospace" font-weight="700" font-size="8" text-anchor="middle">ServerHello + CertVerify + Finished</text>

        <!-- Flow 3: 1-RTT Encrypted Session -->
        <rect x="40" y="118" width="240" height="26" rx="6" class="fill-emerald-600 stroke-emerald-700" stroke-width="1.5"/>
        <text x="160" y="134" fill="#FFFFFF" font-family="monospace" font-weight="700" font-size="9.5" text-anchor="middle">🔒 Encrypted HTTP/2 Traffic (1-RTT)</text>
      </svg>
    )}

    {/* 4. NUCLEAR FUSION (Magnetic Confinement Tokamak Torus Cross-Section) */}
    {(key.includes('fusion') || logo === 'fusion') && (
      <svg class="w-full h-full max-h-full max-w-full" viewBox="0 0 320 160" fill="none" xmlns="http://www.w3.org/2000/svg" aria-label="Tokamak nuclear fusion diagram">
        <!-- Central Solenoid Core -->
        <g transform="translate(144, 16)">
          <rect width="32" height="116" rx="6" class="fill-purple-100 dark:fill-purple-950/70 stroke-purple-600 dark:stroke-purple-400" stroke-width="2"/>
          <text x="16" y="60" class="fill-purple-800 dark:fill-purple-300" font-family="system-ui, sans-serif" font-weight="800" font-size="8" text-anchor="middle" transform="rotate(-90 16 60)">SOLENOID</text>
        </g>
        <!-- Left Vacuum Vessel & Plasma Torus -->
        <g transform="translate(42, 28)">
          <ellipse cx="50" cy="46" rx="44" ry="36" class="stroke-slate-400 dark:stroke-slate-600 fill-white dark:fill-slate-900" stroke-width="2"/>
          <!-- Toroidal Plasma Zone -->
          <ellipse cx="50" cy="46" rx="26" ry="20" class="fill-purple-200/70 dark:fill-purple-900/60 stroke-purple-600 dark:stroke-purple-400" stroke-width="2.5"/>
          <circle cx="50" cy="46" r="9" class="fill-purple-600"/>
          <text x="50" y="98" class="fill-purple-700 dark:fill-purple-300" font-family="system-ui, sans-serif" font-weight="700" font-size="8.5" text-anchor="middle">D-T Plasma</text>
        </g>
        <!-- Right Vacuum Vessel & Plasma Torus -->
        <g transform="translate(186, 28)">
          <ellipse cx="50" cy="46" rx="44" ry="36" class="stroke-slate-400 dark:stroke-slate-600 fill-white dark:fill-slate-900" stroke-width="2"/>
          <ellipse cx="50" cy="46" rx="26" ry="20" class="fill-purple-200/70 dark:fill-purple-900/60 stroke-purple-600 dark:stroke-purple-400" stroke-width="2.5"/>
          <circle cx="50" cy="46" r="9" class="fill-purple-600"/>
          <text x="50" y="98" class="fill-purple-700 dark:fill-purple-300" font-family="system-ui, sans-serif" font-weight="700" font-size="8.5" text-anchor="middle">150M °C</text>
        </g>
        <!-- Nuclear Reaction Equation Banner -->
        <rect x="30" y="136" width="260" height="20" rx="4" class="fill-slate-100 dark:fill-slate-800 stroke-slate-300 dark:stroke-slate-700" stroke-width="1"/>
        <text x="160" y="150" class="fill-slate-800 dark:fill-slate-200" font-family="monospace" font-weight="700" font-size="9" text-anchor="middle">²H + ³H → ⁴He (3.5 MeV) + n (14.1 MeV)</text>
      </svg>
    )}

    {/* 5. DARK MATTER (Gravitational Lensing & Galactic Rotation Curve) */}
    {(key.includes('dark-matter') || logo === 'atom') && (
      <svg class="w-full h-full max-h-full max-w-full" viewBox="0 0 320 160" fill="none" xmlns="http://www.w3.org/2000/svg" aria-label="Dark matter gravitational lensing diagram">
        <!-- Gravitational Lensing System (Left) -->
        <g transform="translate(20, 16)">
          <text x="60" y="14" class="fill-slate-800 dark:fill-slate-200" font-family="system-ui, sans-serif" font-weight="700" font-size="9" text-anchor="middle">GRAVITATIONAL LENSING</text>
          <!-- Massive Deflector -->
          <circle cx="60" cy="65" r="20" class="fill-purple-100 dark:fill-purple-950/70 stroke-purple-600 dark:stroke-purple-400" stroke-width="2"/>
          <circle cx="60" cy="65" r="6" class="fill-purple-600"/>
          <!-- Einstein Ring Deflection Light Arcs -->
          <path d="M 10 65 Q 60 25 110 65" class="stroke-blue-500" stroke-width="2" stroke-dasharray="3 3"/>
          <path d="M 10 65 Q 60 105 110 65" class="stroke-blue-500" stroke-width="2" stroke-dasharray="3 3"/>
          <ellipse cx="110" cy="45" rx="4" ry="10" class="fill-cyan-500"/>
          <ellipse cx="110" cy="85" rx="4" ry="10" class="fill-cyan-500"/>
          <text x="60" y="122" class="fill-slate-500 dark:fill-slate-400" font-family="monospace" font-size="8" text-anchor="middle">Einstein Radius θ_E</text>
        </g>
        <!-- Divider -->
        <line x1="158" y1="20" x2="158" y2="135" class="stroke-slate-300 dark:stroke-slate-700" stroke-width="1.5"/>
        <!-- Galactic Rotation Curve Plot (Right) -->
        <g transform="translate(175, 16)">
          <text x="65" y="14" class="fill-slate-800 dark:fill-slate-200" font-family="system-ui, sans-serif" font-weight="700" font-size="9" text-anchor="middle">ROTATION CURVE</text>
          <!-- Axes -->
          <line x1="15" y1="105" x2="125" y2="105" class="stroke-slate-400" stroke-width="1.5"/>
          <line x1="15" y1="105" x2="15" y2="30" class="stroke-slate-400" stroke-width="1.5"/>
          <!-- Observed Curve (Flat) -->
          <path d="M 15 95 Q 40 45 120 45" class="stroke-purple-600 dark:stroke-purple-400" stroke-width="2.5"/>
          <text x="120" y="40" class="fill-purple-700 dark:fill-purple-300" font-family="monospace" font-weight="700" font-size="8" text-anchor="end">Observed (Flat)</text>
          <!-- Keplerian Decline -->
          <path d="M 15 95 Q 40 55 120 95" class="stroke-slate-400" stroke-width="1.5" stroke-dasharray="3 3"/>
          <text x="120" y="102" class="fill-slate-500" font-family="monospace" font-size="7.5" text-anchor="end">Keplerian (v ∝ r^-½)</text>
          <text x="70" y="122" class="fill-slate-500 font-mono" font-size="8" text-anchor="middle">Distance r (kpc) →</text>
        </g>
      </svg>
    )}

    {/* 6. READING ALIEN ATMOSPHERES (Exoplanet Transmission Spectroscopy) */}
    {(key.includes('alien') || key.includes('atmosphere') || logo === 'telescope') && (
      <svg class="w-full h-full max-h-full max-w-full" viewBox="0 0 320 160" fill="none" xmlns="http://www.w3.org/2000/svg" aria-label="Transmission spectroscopy diagram">
        <!-- Stellar Host Disk & Transiting Planet -->
        <g transform="translate(20, 24)">
          <circle cx="55" cy="55" r="48" class="fill-amber-100 dark:fill-amber-950/60 stroke-amber-500" stroke-width="2"/>
          <circle cx="55" cy="55" r="36" class="fill-amber-200/60 dark:fill-amber-900/40"/>
          <!-- Transiting Planet with Atmospheric Ring -->
          <circle cx="92" cy="55" r="18" class="fill-slate-900 stroke-cyan-500" stroke-width="2"/>
          <circle cx="92" cy="55" r="23" class="stroke-cyan-400" stroke-width="1.5" stroke-dasharray="3 2"/>
          <text x="55" y="122" class="fill-slate-700 dark:fill-slate-300" font-family="system-ui, sans-serif" font-weight="700" font-size="8.5" text-anchor="middle">TRANSIT OCCULTATION</text>
        </g>
        <!-- Transmission Spectrum Plot -->
        <g transform="translate(165, 20)">
          <rect width="135" height="110" rx="8" class="fill-white dark:fill-slate-800 stroke-slate-200 dark:stroke-slate-700" stroke-width="1.5"/>
          <text x="67" y="18" class="fill-slate-800 dark:fill-slate-200" font-family="system-ui, sans-serif" font-weight="700" font-size="9" text-anchor="middle">TRANSMISSION SPECTRUM</text>
          <!-- Spectral Dips for H2O, CH4, CO2 -->
          <path d="M 15 55 Q 28 55 38 38 Q 48 75 58 55 Q 72 55 85 34 Q 98 72 110 55 Q 120 55 125 55" class="stroke-cyan-600 dark:stroke-cyan-400" stroke-width="2.5"/>
          <text x="38" y="30" class="fill-cyan-700 dark:fill-cyan-300" font-family="monospace" font-weight="700" font-size="8.5" text-anchor="middle">H₂O</text>
          <text x="85" y="26" class="fill-blue-700 dark:fill-blue-300" font-family="monospace" font-weight="700" font-size="8.5" text-anchor="middle">CH₄</text>
          <text x="110" y="85" class="fill-purple-700 dark:fill-purple-300" font-family="monospace" font-weight="700" font-size="8.5" text-anchor="middle">CO₂</text>
          <text x="67" y="102" class="fill-slate-500 font-mono" font-size="7.5" text-anchor="middle">Wavelength λ (μm) →</text>
        </g>
      </svg>
    )}

    {/* 7. HOW WE KNOW WHAT STARS ARE MADE OF (Fraunhofer Lines & Stellar Spectroscopy) */}
    {(key.includes('star') || logo === 'star') && (
      <svg class="w-full h-full max-h-full max-w-full" viewBox="0 0 320 160" fill="none" xmlns="http://www.w3.org/2000/svg" aria-label="Fraunhofer spectroscopy diagram">
        <!-- Light Source -->
        <g transform="translate(18, 40)">
          <circle cx="24" cy="35" r="20" class="fill-amber-400 stroke-amber-500" stroke-width="2"/>
          <text x="24" y="70" class="fill-slate-700 dark:fill-slate-300" font-family="system-ui, sans-serif" font-weight="700" font-size="8" text-anchor="middle">Starlight</text>
        </g>
        <!-- Dispersion Prism -->
        <g transform="translate(80, 28)">
          <polygon points="32,6 64,68 0,68" class="fill-blue-50 dark:fill-slate-800 stroke-blue-600 dark:stroke-blue-400" stroke-width="2"/>
          <text x="32" y="86" class="fill-blue-700 dark:fill-blue-300" font-family="system-ui, sans-serif" font-weight="800" font-size="9" text-anchor="middle">PRISM</text>
        </g>
        <!-- Continuous Spectrum with Absorption Notches -->
        <g transform="translate(162, 30)">
          <text x="70" y="14" class="fill-slate-800 dark:fill-slate-200" font-family="system-ui, sans-serif" font-weight="700" font-size="9" text-anchor="middle">FRAUNHOFER ABSORPTION</text>
          <!-- Spectrum Bar -->
          <rect x="0" y="26" width="140" height="30" rx="6" class="fill-slate-100 dark:fill-slate-800 stroke-slate-300 dark:stroke-slate-600" stroke-width="1.5"/>
          <!-- Spectral Lines -->
          <line x1="26" y1="26" x2="26" y2="56" stroke="#DC2626" stroke-width="2.5"/>
          <text x="26" y="70" class="fill-slate-700 dark:fill-slate-300" font-family="monospace" font-weight="600" font-size="7.5" text-anchor="middle">Hα (656nm)</text>
          <line x1="68" y1="26" x2="68" y2="56" stroke="#059669" stroke-width="2.5"/>
