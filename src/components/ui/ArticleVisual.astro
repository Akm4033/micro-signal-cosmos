---
interface Props {
  slug?: string;
  category?: 'tech' | 'science' | 'ai' | 'devtools' | string;
  logo?: string;
  class?: string;
}

const {
  slug = '',
  category = 'tech',
  logo = '',
  class: className = '',
} = Astro.props;

const cat = (category || 'tech').toLowerCase();
const isScience = cat.includes('sci');
const isAI = cat.includes('ai') || cat.includes('art');
const isDevTools = cat.includes('dev') || cat.includes('tool');
const isTech = !isScience && !isAI && !isDevTools;

const key = (slug || '').toLowerCase();
const uid = key.replace(/[^a-z0-9]/g, '-') || 'default';
---

<div class={`relative w-full h-full overflow-hidden flex items-center justify-center select-none ${className}`}>
  <!-- Glowing Ambient Aura (Hover Reactivity) -->
  <div class="absolute inset-0 pointer-events-none opacity-40 group-hover:opacity-90 transition-opacity duration-500">
    {isTech && <div class="absolute -top-6 -right-6 w-36 h-36 rounded-full bg-blue-500/25 blur-2xl group-hover:bg-blue-400/40 transition-all"></div>}
    {isAI && <div class="absolute -top-6 -right-6 w-36 h-36 rounded-full bg-emerald-500/25 blur-2xl group-hover:bg-emerald-400/40 transition-all"></div>}
    {isScience && <div class="absolute -top-6 -right-6 w-36 h-36 rounded-full bg-purple-500/25 blur-2xl group-hover:bg-purple-400/40 transition-all"></div>}
    {isDevTools && <div class="absolute -top-6 -right-6 w-36 h-36 rounded-full bg-amber-500/25 blur-2xl group-hover:bg-amber-400/40 transition-all"></div>}
  </div>

  <!-- Precision Technical Micro-Grid -->
  <div class="absolute inset-0 opacity-20 pointer-events-none" aria-hidden="true">
    <div class="w-full h-full bg-[radial-gradient(#38bdf8_1px,transparent_1px)] [background-size:16px_16px] dark:opacity-25"></div>
  </div>

  <!-- Dynamic 2D/3D Technical Graphic with Interactive Perspective Hover Lift -->
  <div class="relative z-10 w-full h-full flex items-center justify-center p-2.5 transition-transform duration-500 ease-out group-hover:scale-105 group-hover:-translate-y-1">
    
    {/* 1. CHOOSING A DATABASE (3D Isometric Data Cylinder Stack & Query Routing) */}
    {(key.includes('database') || logo === 'database') && (
      <svg class="w-full h-full max-h-32 drop-shadow-[0_8px_16px_rgba(0,0,0,0.3)]" viewBox="0 0 240 120" fill="none" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <linearGradient id={`grad-db-${uid}`} x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#f59e0b" stop-opacity="0.9" />
            <stop offset="100%" stop-color="#b45309" stop-opacity="0.4" />
          </linearGradient>
        </defs>
        <!-- 3D Cylindrical Cluster -->
        <g transform="translate(80, 20)">
          <!-- Top Disk -->
          <ellipse cx="40" cy="18" rx="36" ry="12" fill={`url(#grad-db-${uid})`} stroke="#fbbf24" stroke-width="2"/>
          <path d="M4 18 v22 c0 6.6 16.1 12 36 12 s36 -5.4 36 -12 v-22" fill="#1e293b" fill-opacity="0.85" stroke="#fbbf24" stroke-width="2"/>
          <path d="M4 40 v22 c0 6.6 16.1 12 36 12 s36 -5.4 36 -12 v-22" fill="#0f172a" fill-opacity="0.95" stroke="#fbbf24" stroke-width="2"/>
          <!-- Active Rows with 3D Light -->
          <line x1="20" y1="32" x2="60" y2="32" stroke="#fef08a" stroke-width="2" stroke-linecap="round"/>
          <line x1="20" y1="52" x2="52" y2="52" stroke="#fef08a" stroke-width="2" stroke-linecap="round"/>
          <line x1="20" y1="72" x2="62" y2="72" stroke="#fef08a" stroke-width="2" stroke-linecap="round"/>
        </g>
        <!-- Satellite Query Node (SQL) -->
        <g transform="translate(172, 32)">
          <rect width="44" height="26" rx="8" fill="#0f172a" stroke="#38bdf8" stroke-width="1.8"/>
          <text x="22" y="17" fill="#38bdf8" font-size="9" font-weight="900" text-anchor="middle" font-family="monospace">SQL</text>
          <path d="M-12 13 L0 13" stroke="#38bdf8" stroke-width="1.5" stroke-dasharray="2 2"/>
        </g>
        <!-- Satellite Vector Node (HNSW / Vector) -->
        <g transform="translate(18, 48)">
          <rect width="46" height="26" rx="8" fill="#0f172a" stroke="#10b981" stroke-width="1.8"/>
          <text x="23" y="17" fill="#10b981" font-size="9" font-weight="900" text-anchor="middle" font-family="monospace">VECTOR</text>
          <path d="M46 13 L62 13" stroke="#10b981" stroke-width="1.5" stroke-dasharray="2 2"/>
        </g>
      </svg>
    )}

    {/* 2. PASSKEYS & WEBAUTHN (3D Hardware Key & Biometric Shield) */}
    {(key.includes('passkey') || logo === 'key') && (
      <svg class="w-full h-full max-h-32 drop-shadow-[0_8px_16px_rgba(0,0,0,0.3)]" viewBox="0 0 240 120" fill="none" xmlns="http://www.w3.org/2000/svg">
        <!-- Hardware Key Body -->
        <g transform="translate(90, 16)">
          <rect x="0" y="14" width="46" height="66" rx="12" fill="#1e293b" stroke="#f59e0b" stroke-width="2.2"/>
          <rect x="12" y="2" width="22" height="14" rx="4" fill="#0f172a" stroke="#fbbf24" stroke-width="1.8"/>
          <!-- Gold Contacts -->
          <line x1="17" y1="5" x2="17" y2="12" stroke="#fbbf24" stroke-width="2" stroke-linecap="round"/>
          <line x1="29" y1="5" x2="29" y2="12" stroke="#fbbf24" stroke-width="2" stroke-linecap="round"/>
          <!-- Biometric Pulse Scanner -->
          <circle cx="23" cy="46" r="14" fill="#f59e0b" fill-opacity="0.15" stroke="#f59e0b" stroke-width="2"/>
          <path d="M16 46 c0 -3.8 3.1 -7 7 -7 s7 3.2 7 7 c0 2.5 -1.2 4.5 -3.2 5.8" stroke="#fbbf24" stroke-width="2" stroke-linecap="round"/>
          <circle cx="23" cy="46" r="3" fill="#fbbf24"/>
        </g>
        <!-- FIDO2 Badge -->
        <g transform="translate(24, 38)">
          <rect width="50" height="26" rx="8" fill="#0f172a" stroke="#38bdf8" stroke-width="1.8"/>
          <text x="25" y="17" fill="#38bdf8" font-size="9" font-weight="900" text-anchor="middle" font-family="monospace">FIDO2</text>
        </g>
        <!-- Verified Keypair Badge -->
        <g transform="translate(156, 38)">
          <rect width="58" height="26" rx="8" fill="#0f172a" stroke="#10b981" stroke-width="1.8"/>
          <text x="29" y="17" fill="#10b981" font-size="8.5" font-weight="900" text-anchor="middle" font-family="monospace">ED25519</text>
        </g>
      </svg>
    )}

    {/* 3. HTTPS & TLS 1.3 (3D Cryptographic Shield & 1-RTT Handshake) */}
    {(key.includes('https') || logo === 'shield') && (
      <svg class="w-full h-full max-h-32 drop-shadow-[0_8px_16px_rgba(0,0,0,0.3)]" viewBox="0 0 240 120" fill="none" xmlns="http://www.w3.org/2000/svg">
        <!-- 3D Security Shield Core -->
        <g transform="translate(98, 16)">
          <path d="M22 6 L42 14 C42 38 22 56 22 58 C22 56 2 38 2 14 Z" fill="#0f172a" stroke="#38bdf8" stroke-width="2.4"/>
          <path d="M22 10 L38 17 C38 34 22 48 22 50 C22 48 6 34 6 17 Z" fill="#38bdf8" fill-opacity="0.2"/>
          <!-- Padlock -->
          <rect x="14" y="28" width="16" height="13" rx="3" fill="#38bdf8"/>
          <path d="M17 28 v-5 a5 5 0 0 1 10 0 v5" stroke="#38bdf8" stroke-width="2" stroke-linecap="round"/>
          <circle cx="22" cy="34.5" r="2" fill="#0f172a"/>
        </g>
        <!-- 1-RTT Handshake Waves -->
        <path d="M36 42 Q 65 30 86 38" stroke="#38bdf8" stroke-width="2" stroke-dasharray="3 3"/>
        <text x="56" y="28" fill="#38bdf8" font-size="8" font-weight="bold" font-family="monospace">ClientHello</text>
        <!-- Cipher Suite (Right) -->
        <g transform="translate(158, 36)">
          <rect width="64" height="26" rx="8" fill="#0f172a" stroke="#10b981" stroke-width="1.8"/>
          <text x="32" y="17" fill="#34d399" font-size="8.5" font-weight="900" text-anchor="middle" font-family="monospace">TLS 1.3</text>
        </g>
      </svg>
    )}

    {/* 4. NUCLEAR FUSION (3D Tokamak Torus & Magnetic Plasma Ring) */}
    {(key.includes('fusion') || logo === 'fusion') && (
      <svg class="w-full h-full max-h-32 drop-shadow-[0_8px_16px_rgba(0,0,0,0.3)]" viewBox="0 0 240 120" fill="none" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <radialGradient id={`plasma-${uid}`} cx="50%" cy="50%" r="50%">
            <stop offset="0%" stop-color="#f43f5e" stop-opacity="1" />
            <stop offset="60%" stop-color="#c084fc" stop-opacity="0.9" />
            <stop offset="100%" stop-color="#3b82f6" stop-opacity="0" />
          </radialGradient>
        </defs>
        <!-- Tokamak Coils -->
        <g transform="translate(70, 18)">
          <ellipse cx="50" cy="40" rx="66" ry="28" fill="none" stroke="#a855f7" stroke-width="2" stroke-opacity="0.6"/>
          <!-- Toroidal Plasma Ring -->
          <ellipse cx="50" cy="40" rx="44" ry="18" fill="none" stroke={`url(#plasma-${uid})`} stroke-width="8" class="animate-pulse"/>
          <ellipse cx="50" cy="40" rx="24" ry="10" fill="#0f172a" stroke="#f43f5e" stroke-width="2"/>
          <!-- High-Energy Alpha Particles -->
          <circle cx="94" cy="40" r="3.5" fill="#f43f5e"/>
          <circle cx="50" cy="58" r="3" fill="#38bdf8"/>
          <circle cx="6" cy="40" r="2.5" fill="#fbbf24"/>
        </g>
        <!-- Temperature Indicator -->
        <g transform="translate(150, 14)">
          <rect width="66" height="22" rx="11" fill="#0f172a" stroke="#ec4899" stroke-width="1.5"/>
          <text x="33" y="15" fill="#f472b6" font-size="8.5" font-weight="900" text-anchor="middle" font-family="monospace">150M °C</text>
        </g>
        <g transform="translate(18, 86)">
          <text x="0" y="0" fill="#c084fc" font-size="8.5" font-weight="bold" font-family="monospace">²H + ³H → α + n</text>
        </g>
      </svg>
    )}

    {/* 5. DARK MATTER (Gravitational Lensing & Flat Rotation Curve) */}
    {(key.includes('dark-matter') || logo === 'atom') && (
      <svg class="w-full h-full max-h-32 drop-shadow-[0_8px_16px_rgba(0,0,0,0.3)]" viewBox="0 0 240 120" fill="none" xmlns="http://www.w3.org/2000/svg">
        <!-- Gravitational Lensing Field -->
        <g transform="translate(80, 18)">
          <!-- Core Dark Matter Halo -->
          <circle cx="40" cy="42" r="10" fill="#7c3aed" fill-opacity="0.8"/>
          <circle cx="40" cy="42" r="26" fill="none" stroke="#a855f7" stroke-width="2" stroke-dasharray="4 2"/>
          <circle cx="40" cy="42" r="42" fill="none" stroke="#38bdf8" stroke-width="1.8"/>
          <!-- Lensed Arc Images -->
          <ellipse cx="6" cy="42" rx="3" ry="8" fill="#38bdf8"/>
          <ellipse cx="74" cy="42" rx="3" ry="8" fill="#38bdf8"/>
        </g>
        <!-- Observed Flat Rotation Curve -->
        <g transform="translate(162, 34)">
          <rect width="64" height="46" rx="8" fill="#0f172a" stroke="#475569" stroke-width="1.5"/>
          <path d="M10 16 Q 24 28 54 36" stroke="#64748b" stroke-width="1.5" stroke-dasharray="2 2"/>
          <path d="M10 16 Q 24 14 54 14" stroke="#c084fc" stroke-width="2.5"/>
          <text x="32" y="40" fill="#c084fc" font-size="7.5" font-weight="bold" text-anchor="middle" font-family="monospace">v(r) ~ const</text>
        </g>
      </svg>
    )}

    {/* 6. READING ALIEN ATMOSPHERES & SPECTROSCOPY (JWST Transit Spectrum) */}
    {(key.includes('alien') || key.includes('atmosphere') || logo === 'telescope') && (
      <svg class="w-full h-full max-h-32 drop-shadow-[0_8px_16px_rgba(0,0,0,0.3)]" viewBox="0 0 240 120" fill="none" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <radialGradient id={`star-${uid}`} cx="40%" cy="50%" r="50%">
            <stop offset="0%" stop-color="#fbbf24" stop-opacity="1"/>
            <stop offset="60%" stop-color="#f59e0b" stop-opacity="0.85"/>
            <stop offset="100%" stop-color="#ef4444" stop-opacity="0"/>
          </radialGradient>
        </defs>
        <!-- Host Star -->
        <circle cx="65" cy="60" r="38" fill={`url(#star-${uid})`}/>
        <!-- Transiting Exoplanet -->
        <g transform="translate(94, 46)">
          <circle cx="14" cy="14" r="12" fill="#0f172a" stroke="#38bdf8" stroke-width="2"/>
          <circle cx="14" cy="14" r="16" fill="none" stroke="#38bdf8" stroke-width="1.5" stroke-dasharray="3 2"/>
        </g>
        <!-- Absorption Spectrum Bands -->
        <g transform="translate(148, 28)">
          <rect width="76" height="24" rx="6" fill="#0f172a" stroke="#475569" stroke-width="1.5"/>
          <line x1="16" y1="4" x2="16" y2="20" stroke="#38bdf8" stroke-width="2.5"/>
          <line x1="36" y1="4" x2="36" y2="20" stroke="#c084fc" stroke-width="3"/>
          <line x1="56" y1="4" x2="56" y2="20" stroke="#10b981" stroke-width="2.5"/>
          <text x="38" y="42" fill="#c084fc" font-size="8" font-weight="900" text-anchor="middle" font-family="monospace">H₂O • CH₄ • CO₂</text>
        </g>
      </svg>
    )}

    {/* 7. HOW WE KNOW WHAT STARS ARE MADE OF (Fraunhofer Prism & Spectral Lines) */}
    {(key.includes('star') || logo === 'star') && (
      <svg class="w-full h-full max-h-32 drop-shadow-[0_8px_16px_rgba(0,0,0,0.3)]" viewBox="0 0 240 120" fill="none" xmlns="http://www.w3.org/2000/svg">
        <!-- 3D Optical Dispersion Prism -->
        <g transform="translate(70, 20)">
          <polygon points="35,10 65,70 5,70" fill="#1e293b" stroke="#38bdf8" stroke-width="2.2"/>
          <polygon points="35,10 65,70 55,75 25,15" fill="#38bdf8" fill-opacity="0.2"/>
        </g>
        <!-- Incident White Ray -->
        <line x1="15" y1="52" x2="85" y2="52" stroke="#ffffff" stroke-width="2.5"/>
        <text x="35" y="44" fill="#ffffff" font-size="8" font-weight="bold" font-family="monospace">Starlight</text>
        <!-- Dispersed Spectral Bands -->
        <line x1="125" y1="36" x2="205" y2="24" stroke="#f43f5e" stroke-width="2.5"/>
        <line x1="125" y1="46" x2="205" y2="44" stroke="#fbbf24" stroke-width="2.5"/>
        <line x1="125" y1="56" x2="205" y2="64" stroke="#10b981" stroke-width="2.5"/>
        <line x1="125" y1="66" x2="205" y2="84" stroke="#38bdf8" stroke-width="2.5"/>
        <!-- Absorption Notches -->
        <rect x="160" y="20" width="3" height="70" fill="#0f172a" fill-opacity="0.8"/>
        <rect x="180" y="20" width="3" height="70" fill="#0f172a" fill-opacity="0.8"/>
      </svg>
    )}

    {/* 8. HOW LLMS ACTUALLY WORK (Transformer Stack & Multi-Head Attention) */}
    {(key.includes('llm') || logo === 'transformer') && (
      <svg class="w-full h-full max-h-32 drop-shadow-[0_8px_16px_rgba(0,0,0,0.3)]" viewBox="0 0 240 120" fill="none" xmlns="http://www.w3.org/2000/svg">
        <g transform="translate(65, 14)">
          <!-- SwiGLU FFN Layer -->
          <rect x="25" y="0" width="80" height="18" rx="5" fill="#065f46" stroke="#10b981" stroke-width="1.8"/>
          <text x="65" y="13" fill="#ecfdf5" font-size="8.5" font-weight="900" text-anchor="middle" font-family="monospace">SwiGLU FFN</text>
          <!-- Multi-Head Attention Block -->
          <rect x="15" y="26" width="100" height="34" rx="6" fill="#0f172a" stroke="#10b981" stroke-width="2"/>
          <text x="65" y="40" fill="#34d399" font-size="8.5" font-weight="900" text-anchor="middle" font-family="monospace">Self-Attention</text>
          <!-- Q K V Sub-Blocks -->
          <rect x="24" y="46" width="22" height="9" rx="3" fill="#10b981"/>
          <text x="35" y="53" fill="#0f172a" font-size="6.5" font-weight="900" text-anchor="middle">Q</text>
          <rect x="54" y="46" width="22" height="9" rx="3" fill="#38bdf8"/>
          <text x="65" y="53" fill="#0f172a" font-size="6.5" font-weight="900" text-anchor="middle">K</text>
          <rect x="84" y="46" width="22" height="9" rx="3" fill="#fbbf24"/>
          <text x="95" y="53" fill="#0f172a" font-size="6.5" font-weight="900" text-anchor="middle">V</text>
          <!-- RoPE Embeddings -->
          <rect x="30" y="68" width="70" height="16" rx="5" fill="#0f172a" stroke="#38bdf8" stroke-width="1.5"/>
          <text x="65" y="79" fill="#7dd3fc" font-size="8" font-weight="bold" text-anchor="middle" font-family="monospace">RoPE Embed</text>
        </g>
      </svg>
    )}

    {/* 9. BUILD YOUR OWN RAG (Hybrid Search & Two-Stage Reranking) */}
    {key.includes('rag') && (
      <svg class="w-full h-full max-h-32 drop-shadow-[0_8px_16px_rgba(0,0,0,0.3)]" viewBox="0 0 240 120" fill="none" xmlns="http://www.w3.org/2000/svg">
        <!-- Dual Pipeline: Dense + Sparse -->
        <g transform="translate(24, 20)">
          <!-- Dense Vector Path -->
          <rect width="52" height="22" rx="6" fill="#0f172a" stroke="#10b981" stroke-width="1.8"/>
          <text x="26" y="15" fill="#10b981" font-size="8" font-weight="bold" text-anchor="middle" font-family="monospace">Dense vec</text>
          <!-- Sparse BM25 Path -->
          <rect y="32" width="52" height="22" rx="6" fill="#0f172a" stroke="#38bdf8" stroke-width="1.8"/>
          <text x="26" y="47" fill="#38bdf8" font-size="8" font-weight="bold" text-anchor="middle" font-family="monospace">BM25</text>
        </g>
        <!-- Reciprocal Rank Fusion Core -->
        <g transform="translate(94, 26)">
          <polygon points="25,5 50,42 0,42" fill="#1e293b" stroke="#fbbf24" stroke-width="2"/>
          <text x="25" y="32" fill="#fbbf24" font-size="7.5" font-weight="900" text-anchor="middle" font-family="monospace">RRF</text>
        </g>
        <!-- Cross-Encoder Reranker Node -->
        <g transform="translate(162, 28)">
          <rect width="60" height="34" rx="8" fill="#0f172a" stroke="#ec4899" stroke-width="2"/>
          <text x="30" y="18" fill="#f472b6" font-size="8" font-weight="900" text-anchor="middle" font-family="monospace">CROSS</text>
          <text x="30" y="28" fill="#f472b6" font-size="7" font-weight="bold" text-anchor="middle" font-family="monospace">ENCODER</text>
        </g>
      </svg>
    )}

    {/* 10. HOW BROWSERS ACTUALLY RENDER A PAGE (DOM -> Render Tree -> GPU Compositor) */}
    {(key.includes('browser') || logo === 'browser') && (
      <svg class="w-full h-full max-h-32 drop-shadow-[0_8px_16px_rgba(0,0,0,0.3)]" viewBox="0 0 240 120" fill="none" xmlns="http://www.w3.org/2000/svg">
        <!-- Pipeline Stages -->
        <g transform="translate(18, 30)">
          <!-- DOM Node -->
          <rect width="44" height="26" rx="6" fill="#0f172a" stroke="#38bdf8" stroke-width="1.8"/>
          <text x="22" y="17" fill="#38bdf8" font-size="8.5" font-weight="900" text-anchor="middle" font-family="monospace">DOM</text>
          <!-- Flow Arrow -->
          <path d="M48 13 L60 13" stroke="#94a3b8" stroke-width="2" stroke-linecap="round"/>
        </g>
        <g transform="translate(86, 30)">
          <!-- Layout Node -->
          <rect width="52" height="26" rx="6" fill="#0f172a" stroke="#10b981" stroke-width="1.8"/>
          <text x="26" y="17" fill="#10b981" font-size="8.5" font-weight="900" text-anchor="middle" font-family="monospace">LAYOUT</text>
          <path d="M56 13 L68 13" stroke="#94a3b8" stroke-width="2" stroke-linecap="round"/>
        </g>
        <g transform="translate(162, 22)">
          <!-- 3D Compositor Layers -->
          <rect x="0" y="16" width="56" height="26" rx="6" fill="#1e293b" stroke="#f59e0b" stroke-width="1.8"/>
          <rect x="6" y="6" width="56" height="26" rx="6" fill="#0f172a" stroke="#fbbf24" stroke-width="2"/>
          <text x="34" y="23" fill="#fbbf24" font-size="8" font-weight="900" text-anchor="middle" font-family="monospace">GPU RASTER</text>
        </g>
      </svg>
    )}

    {/* 11. INSIDE THE MODERN CPU (3D Die Shot & Out-of-Order Core) */}
    {(key.includes('cpu') || logo === 'cpu') && (
      <svg class="w-full h-full max-h-32 drop-shadow-[0_8px_16px_rgba(0,0,0,0.3)]" viewBox="0 0 240 120" fill="none" xmlns="http://www.w3.org/2000/svg">
        <!-- CPU Silicon Die -->
        <g transform="translate(75, 12)">
          <rect width="90" height="90" rx="10" fill="#0f172a" stroke="#38bdf8" stroke-width="2.4"/>
          <!-- Out-of-Order Engine Block -->
          <rect x="10" y="10" width="32" height="32" rx="4" fill="#1e293b" stroke="#38bdf8" stroke-width="1.5"/>
          <text x="26" y="28" fill="#38bdf8" font-size="7" font-weight="900" text-anchor="middle" font-family="monospace">OoO</text>
          <!-- ALU Array -->
          <rect x="48" y="10" width="32" height="32" rx="4" fill="#1e293b" stroke="#10b981" stroke-width="1.5"/>
          <text x="64" y="28" fill="#10b981" font-size="7" font-weight="900" text-anchor="middle" font-family="monospace">ALU</text>
          <!-- L3 Cache Strip -->
          <rect x="10" y="48" width="70" height="32" rx="4" fill="#1e293b" stroke="#f59e0b" stroke-width="1.5"/>
          <text x="45" y="68" fill="#fbbf24" font-size="8.5" font-weight="900" text-anchor="middle" font-family="monospace">L3 CACHE (32MB)</text>
        </g>
        <!-- Gold Interconnect Pins -->
        <g transform="translate(56, 20)">
          <line x1="0" y1="10" x2="14" y2="10" stroke="#fbbf24" stroke-width="2"/>
          <line x1="0" y1="28" x2="14" y2="28" stroke="#fbbf24" stroke-width="2"/>
          <line x1="0" y1="46" x2="14" y2="46" stroke="#fbbf24" stroke-width="2"/>
          <line x1="0" y1="64" x2="14" y2="64" stroke="#fbbf24" stroke-width="2"/>
        </g>
      </svg>
    )}

    {/* 12. WEBASSEMBLY (3D WASM Binary Module & WASI Runtime) */}
