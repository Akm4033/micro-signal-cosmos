---
interface Props {
  slug?: string;
  category?: 'tech' | 'science' | 'ai' | 'devtools' | string;
  logo?: string;
  class?: string;
}

const {
  slug = '',
  category = 'tech',
  logo = '',
  class: className = '',
} = Astro.props;

const key = (slug || '').toLowerCase();
const uid = key.replace(/[^a-z0-9]/g, '-') || 'default';
---

<div class={`relative w-full h-full overflow-hidden flex items-center justify-center select-none bg-slate-50 dark:bg-slate-900/60 ${className}`}>
  <!-- Technical Grid Background -->
  <div class="absolute inset-0 opacity-40 pointer-events-none" aria-hidden="true">
    <div class="w-full h-full bg-[radial-gradient(#CBD5E1_1px,transparent_1px)] dark:bg-[radial-gradient(#334155_1px,transparent_1px)] [background-size:16px_16px]"></div>
  </div>

  <!-- Scientific Vector Illustration Container -->
  <div class="relative z-10 w-full h-full flex items-center justify-center p-3">
    
    {/* 1. CHOOSING A DATABASE (Relational, Vector, & Edge Storage Architecture) */}
    {(key.includes('database') || logo === 'database') && (
      <svg class="w-full h-full max-h-full max-w-full" viewBox="0 0 280 130" fill="none" xmlns="http://www.w3.org/2000/svg" aria-label="Database architecture diagram">
        <!-- Relational Engine Node -->
        <g transform="translate(25, 20)">
          <rect width="65" height="85" rx="6" class="fill-white dark:fill-slate-800 stroke-blue-600 dark:stroke-blue-400" stroke-width="1.5"/>
          <rect x="0" y="0" width="65" height="18" rx="6" class="fill-blue-50 dark:fill-blue-950/60 stroke-blue-600 dark:stroke-blue-400" stroke-width="1.5"/>
          <text x="32.5" y="12" class="fill-blue-700 dark:fill-blue-300 font-sans font-bold text-[8px]" text-anchor="middle">RELATIONAL</text>
          <line x1="8" y1="32" x2="57" y2="32" class="stroke-slate-300 dark:stroke-slate-600" stroke-width="1.2"/>
          <line x1="8" y1="46" x2="57" y2="46" class="stroke-slate-300 dark:stroke-slate-600" stroke-width="1.2"/>
          <line x1="8" y1="60" x2="57" y2="60" class="stroke-slate-300 dark:stroke-slate-600" stroke-width="1.2"/>
          <text x="32.5" y="80" class="fill-slate-500 dark:fill-slate-400 font-mono text-[7px]" text-anchor="middle">ACID • WAL</text>
        </g>
        <!-- Data Flow Connector Lines -->
        <path d="M 90 62 L 115 62" class="stroke-slate-400 dark:stroke-slate-500" stroke-width="1.5" stroke-dasharray="3 3"/>
        <path d="M 165 40 L 190 30" class="stroke-blue-500" stroke-width="1.5"/>
        <path d="M 165 85 L 190 95" class="stroke-cyan-500" stroke-width="1.5"/>
        <!-- Central Query Router -->
        <g transform="translate(115, 38)">
          <rect width="50" height="48" rx="6" class="fill-blue-600 stroke-blue-700" stroke-width="1.5"/>
          <text x="25" y="22" fill="#FFFFFF" class="font-sans font-bold text-[8px]" text-anchor="middle">QUERY</text>
          <text x="25" y="34" fill="#EFF6FF" class="font-mono text-[7px]" text-anchor="middle">ROUTER</text>
        </g>
        <!-- Vector Store Node -->
        <g transform="translate(190, 15)">
          <rect width="65" height="38" rx="6" class="fill-white dark:fill-slate-800 stroke-cyan-600 dark:stroke-cyan-400" stroke-width="1.5"/>
          <text x="32.5" y="16" class="fill-cyan-700 dark:fill-cyan-300 font-sans font-bold text-[8px]" text-anchor="middle">VECTOR (HNSW)</text>
          <text x="32.5" y="28" class="fill-slate-500 dark:fill-slate-400 font-mono text-[7px]" text-anchor="middle">Cosine Sim</text>
        </g>
        <!-- Edge Replica Node -->
        <g transform="translate(190, 75)">
          <rect width="65" height="38" rx="6" class="fill-white dark:fill-slate-800 stroke-emerald-600 dark:stroke-emerald-400" stroke-width="1.5"/>
          <text x="32.5" y="16" class="fill-emerald-700 dark:fill-emerald-300 font-sans font-bold text-[8px]" text-anchor="middle">EDGE (SQLite)</text>
          <text x="32.5" y="28" class="fill-slate-500 dark:fill-slate-400 font-mono text-[7px]" text-anchor="middle">Zero Latency</text>
        </g>
      </svg>
    )}

    {/* 2. PASSKEYS & WEBAUTHN (Asymmetric Public-Key Authentication Protocol) */}
    {(key.includes('passkey') || logo === 'key') && (
      <svg class="w-full h-full max-h-full max-w-full" viewBox="0 0 280 130" fill="none" xmlns="http://www.w3.org/2000/svg" aria-label="Passkeys WebAuthn security diagram">
        <!-- Client Device / Authenticator -->
        <g transform="translate(25, 20)">
          <rect width="80" height="90" rx="8" class="fill-white dark:fill-slate-800 stroke-slate-300 dark:stroke-slate-600" stroke-width="1.5"/>
          <rect x="10" y="12" width="60" height="20" rx="4" class="fill-blue-50 dark:fill-blue-950/60 stroke-blue-500" stroke-width="1.2"/>
          <text x="40" y="25" class="fill-blue-700 dark:fill-blue-300 font-sans font-bold text-[8px]" text-anchor="middle">AUTHENTICATOR</text>
          <!-- Secure Enclave Box -->
          <rect x="10" y="40" width="60" height="38" rx="4" class="fill-slate-50 dark:fill-slate-900 stroke-amber-500" stroke-width="1.2"/>
          <text x="40" y="54" class="fill-amber-600 dark:fill-amber-400 font-sans font-bold text-[7.5px]" text-anchor="middle">Secure Enclave</text>
          <text x="40" y="66" class="fill-slate-500 dark:fill-slate-400 font-mono text-[7px]" text-anchor="middle">PrvKey (Ed25519)</text>
        </g>
        <!-- Signature Handshake Flow -->
        <g transform="translate(108, 40)">
          <path d="M 0 10 L 60 10" class="stroke-blue-600 dark:stroke-blue-400" stroke-width="1.5"/>
          <polygon points="60,10 53,7 53,13" class="fill-blue-600 dark:fill-blue-400"/>
          <text x="30" y="5" class="fill-slate-600 dark:fill-slate-400 font-mono text-[7px]" text-anchor="middle">1. Challenge</text>

          <path d="M 60 35 L 0 35" class="stroke-emerald-600 dark:stroke-emerald-400" stroke-width="1.5"/>
          <polygon points="0,35 7,32 7,38" class="fill-emerald-600 dark:fill-emerald-400"/>
          <text x="30" y="30" class="fill-emerald-700 dark:fill-emerald-400 font-mono text-[7px]" text-anchor="middle">2. Signed AuthData</text>
        </g>
        <!-- Relying Party Server -->
        <g transform="translate(175, 20)">
          <rect width="80" height="90" rx="8" class="fill-white dark:fill-slate-800 stroke-slate-300 dark:stroke-slate-600" stroke-width="1.5"/>
          <rect x="10" y="12" width="60" height="20" rx="4" class="fill-slate-100 dark:fill-slate-700 stroke-slate-400" stroke-width="1.2"/>
          <text x="40" y="25" class="fill-slate-700 dark:fill-slate-200 font-sans font-bold text-[8px]" text-anchor="middle">RELYING PARTY</text>
          <!-- Public Key Verification -->
          <rect x="10" y="40" width="60" height="38" rx="4" class="fill-emerald-50 dark:fill-emerald-950/40 stroke-emerald-500" stroke-width="1.2"/>
          <text x="40" y="54" class="fill-emerald-700 dark:fill-emerald-300 font-sans font-bold text-[7.5px]" text-anchor="middle">Public Key Registry</text>
          <text x="40" y="66" class="fill-slate-500 dark:fill-slate-400 font-mono text-[7px]" text-anchor="middle">Verify(Sig, PubKey)</text>
        </g>
      </svg>
    )}

    {/* 3. HTTPS DEEP DIVE (TLS 1.3 1-RTT Handshake Sequence) */}
    {(key.includes('https') || logo === 'shield') && (
      <svg class="w-full h-full max-h-full max-w-full" viewBox="0 0 280 130" fill="none" xmlns="http://www.w3.org/2000/svg" aria-label="TLS 1.3 Handshake diagram">
        <!-- Client Timeline -->
        <line x1="50" y1="20" x2="50" y2="115" class="stroke-slate-300 dark:stroke-slate-700" stroke-width="1.5"/>
        <rect x="25" y="8" width="50" height="20" rx="4" class="fill-white dark:fill-slate-800 stroke-blue-600 dark:stroke-blue-400" stroke-width="1.5"/>
        <text x="50" y="21" class="fill-blue-700 dark:fill-blue-300 font-sans font-bold text-[8px]" text-anchor="middle">CLIENT</text>

        <!-- Server Timeline -->
        <line x1="230" y1="20" x2="230" y2="115" class="stroke-slate-300 dark:stroke-slate-700" stroke-width="1.5"/>
        <rect x="205" y="8" width="50" height="20" rx="4" class="fill-white dark:fill-slate-800 stroke-blue-600 dark:stroke-blue-400" stroke-width="1.5"/>
        <text x="230" y="21" class="fill-blue-700 dark:fill-blue-300 font-sans font-bold text-[8px]" text-anchor="middle">SERVER</text>

        <!-- Flow 1: ClientHello (Key Share) -->
        <line x1="50" y1="42" x2="225" y2="54" class="stroke-blue-600 dark:stroke-blue-400" stroke-width="1.5"/>
        <polygon points="225,54 218,50 219,57" class="fill-blue-600 dark:fill-blue-400"/>
        <text x="135" y="44" class="fill-blue-700 dark:fill-blue-300 font-mono text-[7.5px]" text-anchor="middle">ClientHello + KeyShare (ECDH)</text>

        <!-- Flow 2: ServerHello + Handshake Finished -->
        <line x1="230" y1="68" x2="55" y2="80" class="stroke-emerald-600 dark:stroke-emerald-400" stroke-width="1.5"/>
        <polygon points="55,80 62,84 61,77" class="fill-emerald-600 dark:fill-emerald-400"/>
        <text x="145" y="70" class="fill-emerald-700 dark:fill-emerald-300 font-mono text-[7.5px]" text-anchor="middle">ServerHello + CertVerify + Finished</text>

        <!-- Flow 3: Encrypted Application Data (1-RTT) -->
        <rect x="70" y="94" width="140" height="22" rx="4" class="fill-emerald-50 dark:fill-emerald-950/40 stroke-emerald-600 dark:stroke-emerald-500" stroke-width="1.2"/>
        <text x="140" y="108" class="fill-emerald-700 dark:fill-emerald-300 font-mono font-bold text-[8px]" text-anchor="middle">Encrypted HTTP/2 Traffic (1-RTT)</text>
      </svg>
    )}

    {/* 4. NUCLEAR FUSION (Magnetic Confinement Tokamak Torus Cross-Section) */}
    {(key.includes('fusion') || logo === 'fusion') && (
      <svg class="w-full h-full max-h-full max-w-full" viewBox="0 0 280 130" fill="none" xmlns="http://www.w3.org/2000/svg" aria-label="Tokamak nuclear fusion diagram">
        <!-- Central Solenoid Core -->
        <g transform="translate(125, 15)">
          <rect width="30" height="100" rx="4" class="fill-slate-200 dark:fill-slate-800 stroke-purple-600 dark:stroke-purple-400" stroke-width="1.5"/>
          <text x="15" y="55" class="fill-purple-700 dark:fill-purple-300 font-sans font-bold text-[7px]" text-anchor="middle" transform="rotate(-90 15 55)">CENTRAL SOLENOID</text>
        </g>
        <!-- Left Vacuum Vessel & Plasma Torus -->
        <g transform="translate(40, 25)">
          <ellipse cx="45" cy="40" rx="38" ry="32" class="stroke-slate-300 dark:stroke-slate-600 fill-white dark:fill-slate-900" stroke-width="1.5"/>
          <!-- Toroidal Plasma Zone -->
          <ellipse cx="45" cy="40" rx="22" ry="18" class="fill-purple-100 dark:fill-purple-950/60 stroke-purple-600 dark:stroke-purple-400" stroke-width="2"/>
          <circle cx="45" cy="40" r="8" class="fill-purple-600"/>
          <text x="45" y="86" class="fill-purple-700 dark:fill-purple-300 font-mono text-[7px]" text-anchor="middle">D-T Plasma</text>
        </g>
        <!-- Right Vacuum Vessel & Plasma Torus -->
        <g transform="translate(165, 25)">
          <ellipse cx="45" cy="40" rx="38" ry="32" class="stroke-slate-300 dark:stroke-slate-600 fill-white dark:fill-slate-900" stroke-width="1.5"/>
          <ellipse cx="45" cy="40" rx="22" ry="18" class="fill-purple-100 dark:fill-purple-950/60 stroke-purple-600 dark:stroke-purple-400" stroke-width="2"/>
          <circle cx="45" cy="40" r="8" class="fill-purple-600"/>
          <text x="45" y="86" class="fill-purple-700 dark:fill-purple-300 font-mono text-[7px]" text-anchor="middle">150M °C</text>
        </g>
        <!-- Reaction Equation -->
        <text x="140" y="122" class="fill-slate-600 dark:fill-slate-300 font-mono font-bold text-[8px]" text-anchor="middle">²H + ³H → ⁴He (3.5 MeV) + n (14.1 MeV)</text>
      </svg>
    )}

    {/* 5. DARK MATTER (Gravitational Lensing & Galactic Rotation Curve) */}
    {(key.includes('dark-matter') || logo === 'atom') && (
      <svg class="w-full h-full max-h-full max-w-full" viewBox="0 0 280 130" fill="none" xmlns="http://www.w3.org/2000/svg" aria-label="Dark matter gravitational lensing diagram">
        <!-- Gravitational Lensing System (Left) -->
        <g transform="translate(20, 15)">
          <text x="50" y="10" class="fill-slate-700 dark:fill-slate-200 font-sans font-bold text-[8px]" text-anchor="middle">GRAVITATIONAL LENSING</text>
          <!-- Massive Deflector -->
          <circle cx="50" cy="55" r="16" class="fill-purple-100 dark:fill-purple-950/70 stroke-purple-600 dark:stroke-purple-400" stroke-width="1.5"/>
          <circle cx="50" cy="55" r="4" class="fill-purple-600"/>
          <!-- Einstein Ring Deflection Path -->
          <path d="M 10 55 Q 50 25 90 55" class="stroke-blue-500" stroke-width="1.2" stroke-dasharray="2 2"/>
          <path d="M 10 55 Q 50 85 90 55" class="stroke-blue-500" stroke-width="1.2" stroke-dasharray="2 2"/>
          <ellipse cx="90" cy="40" rx="3" ry="8" class="fill-cyan-500"/>
          <ellipse cx="90" cy="70" rx="3" ry="8" class="fill-cyan-500"/>
          <text x="50" y="100" class="fill-slate-500 dark:fill-slate-400 font-mono text-[7px]" text-anchor="middle">Einstein Radius θ_E</text>
        </g>
        <!-- Divider -->
        <line x1="140" y1="20" x2="140" y2="110" class="stroke-slate-200 dark:stroke-slate-700" stroke-width="1"/>
        <!-- Galactic Rotation Curve Plot (Right) -->
        <g transform="translate(155, 15)">
          <text x="55" y="10" class="fill-slate-700 dark:fill-slate-200 font-sans font-bold text-[8px]" text-anchor="middle">ROTATION CURVE</text>
          <!-- Axes -->
          <line x1="15" y1="85" x2="105" y2="85" class="stroke-slate-400" stroke-width="1.2"/>
          <line x1="15" y1="85" x2="15" y2="25" class="stroke-slate-400" stroke-width="1.2"/>
          <!-- Observed Curve (Flat) -->
          <path d="M 15 80 Q 35 40 100 40" class="stroke-purple-600 dark:stroke-purple-400" stroke-width="2"/>
          <text x="100" y="35" class="fill-purple-700 dark:fill-purple-300 font-mono font-bold text-[7px]" text-anchor="end">Observed (Flat)</text>
          <!-- Keplerian Decline (Expected from luminous mass alone) -->
          <path d="M 15 80 Q 35 45 100 75" class="stroke-slate-400" stroke-width="1.2" stroke-dasharray="3 3"/>
          <text x="100" y="82" class="fill-slate-500 font-mono text-[6.5px]" text-anchor="end">Keplerian (v ∝ r^-½)</text>
          <!-- Axis Labels -->
          <text x="60" y="96" class="fill-slate-500 font-mono text-[6.5px]" text-anchor="middle">Distance r (kpc)</text>
        </g>
      </svg>
    )}

    {/* 6. READING ALIEN ATMOSPHERES (Exoplanet Transmission Spectroscopy) */}
    {(key.includes('alien') || key.includes('atmosphere') || logo === 'telescope') && (
      <svg class="w-full h-full max-h-full max-w-full" viewBox="0 0 280 130" fill="none" xmlns="http://www.w3.org/2000/svg" aria-label="Transmission spectroscopy diagram">
        <!-- Stellar Host Disk -->
        <g transform="translate(20, 20)">
          <circle cx="45" cy="45" r="38" class="fill-amber-100 dark:fill-amber-950/50 stroke-amber-500" stroke-width="1.5"/>
          <circle cx="45" cy="45" r="28" class="fill-amber-200/50 dark:fill-amber-900/30"/>
          <!-- Transiting Planet with Atmospheric Ring -->
          <circle cx="75" cy="45" r="14" class="fill-slate-900 stroke-cyan-500" stroke-width="1.5"/>
          <circle cx="75" cy="45" r="18" class="stroke-cyan-400" stroke-width="1" stroke-dasharray="2 2"/>
          <text x="45" y="100" class="fill-slate-600 dark:fill-slate-300 font-sans font-bold text-[7.5px]" text-anchor="middle">TRANSIT OCCULTATION</text>
        </g>
        <!-- Spectral Absorption Curve (Right) -->
        <g transform="translate(145, 18)">
          <rect width="115" height="85" rx="6" class="fill-white dark:fill-slate-800 stroke-slate-200 dark:stroke-slate-700" stroke-width="1.2"/>
          <text x="57" y="16" class="fill-slate-800 dark:fill-slate-200 font-sans font-bold text-[8px]" text-anchor="middle">TRANSMISSION SPECTRUM</text>
          <!-- Notches for H2O, CH4, CO2 -->
          <path d="M 15 45 Q 25 45 32 32 Q 40 60 48 45 Q 60 45 70 28 Q 80 58 90 45 Q 98 45 105 45" class="stroke-cyan-600 dark:stroke-cyan-400" stroke-width="1.8"/>
          <!-- Molecules -->
          <text x="32" y="24" class="fill-cyan-700 dark:fill-cyan-300 font-mono text-[7px]" text-anchor="middle">H₂O</text>
          <text x="70" y="20" class="fill-blue-700 dark:fill-blue-300 font-mono text-[7px]" text-anchor="middle">CH₄</text>
          <text x="90" y="70" class="fill-purple-700 dark:fill-purple-300 font-mono text-[7px]" text-anchor="middle">CO₂</text>
          <text x="57.5" y="80" class="fill-slate-400 font-mono text-[6.5px]" text-anchor="middle">Wavelength λ (μm)</text>
        </g>
      </svg>
    )}

    {/* 7. HOW WE KNOW WHAT STARS ARE MADE OF (Fraunhofer Lines & Stellar Spectroscopy) */}
    {(key.includes('star') || logo === 'star') && (
      <svg class="w-full h-full max-h-full max-w-full" viewBox="0 0 280 130" fill="none" xmlns="http://www.w3.org/2000/svg" aria-label="Fraunhofer spectroscopy diagram">
        <!-- Light Source -->
        <g transform="translate(20, 30)">
          <circle cx="20" cy="30" r="16" class="fill-amber-400 stroke-amber-500" stroke-width="1.5"/>
          <text x="20" y="58" class="fill-slate-600 dark:fill-slate-400 font-mono text-[7px]" text-anchor="middle">Starlight</text>
        </g>
        <!-- Dispersion Prism -->
        <g transform="translate(75, 20)">
          <polygon points="25,5 50,55 0,55" class="fill-blue-50 dark:fill-slate-800 stroke-blue-600 dark:stroke-blue-400" stroke-width="1.5"/>
          <text x="25" y="70" class="fill-blue-700 dark:fill-blue-300 font-sans font-bold text-[7.5px]" text-anchor="middle">PRISM</text>
        </g>
        <!-- Continuous Spectrum with Absorption Notches -->
        <g transform="translate(145, 25)">
          <text x="55" y="10" class="fill-slate-800 dark:fill-slate-200 font-sans font-bold text-[8px]" text-anchor="middle">FRAUNHOFER ABSORPTION LINES</text>
          <!-- Spectrum Gradient Bar -->
          <rect x="0" y="20" width="115" height="24" rx="4" class="fill-slate-100 dark:fill-slate-800 stroke-slate-300 dark:stroke-slate-600" stroke-width="1"/>
          <!-- Absorption Lines -->
          <line x1="22" y1="20" x2="22" y2="44" stroke="#DC2626" stroke-width="2"/>
          <text x="22" y="56" class="fill-slate-600 dark:fill-slate-300 font-mono text-[7px]" text-anchor="middle">Hα (656nm)</text>
          <line x1="55" y1="20" x2="55" y2="44" stroke="#059669" stroke-width="2"/>
          <text x="55" y="56" class="fill-slate-600 dark:fill-slate-300 font-mono text-[7px]" text-anchor="middle">Fe (527nm)</text>
          <line x1="88" y1="20" x2="88" y2="44" stroke="#2563EB" stroke-width="2"/>
          <text x="88" y="56" class="fill-slate-600 dark:fill-slate-300 font-mono text-[7px]" text-anchor="middle">Hβ (486nm)</text>
        </g>
      </svg>
    )}

    {/* 8. HOW LLMS ACTUALLY WORK (Transformer Block & Scaled Dot-Product Attention) */}
    {(key.includes('llm') || logo === 'transformer') && (
      <svg class="w-full h-full max-h-full max-w-full" viewBox="0 0 280 130" fill="none" xmlns="http://www.w3.org/2000/svg" aria-label="Transformer architecture diagram">
        <!-- SwiGLU FFN -->
        <g transform="translate(45, 12)">
          <rect width="190" height="22" rx="4" class="fill-emerald-50 dark:fill-emerald-950/50 stroke-emerald-600 dark:stroke-emerald-400" stroke-width="1.5"/>
          <text x="95" y="14" class="fill-emerald-700 dark:fill-emerald-300 font-sans font-bold text-[8.5px]" text-anchor="middle">Feed-Forward Network (SwiGLU)</text>
        </g>
        <!-- Residual Connector -->
        <path d="M 35 23 L 25 23 L 25 65 L 35 65" class="stroke-slate-400" stroke-width="1.2" stroke-dasharray="2 2"/>
        <!-- Multi-Head Attention Block -->
        <g transform="translate(45, 42)">
          <rect width="190" height="42" rx="4" class="fill-blue-50 dark:fill-blue-950/50 stroke-blue-600 dark:stroke-blue-400" stroke-width="1.5"/>
          <text x="95" y="15" class="fill-blue-700 dark:fill-blue-300 font-sans font-bold text-[8.5px]" text-anchor="middle">Multi-Head Self-Attention (MHA)</text>
          <!-- Q, K, V Tensors -->
          <rect x="25" y="22" width="38" height="14" rx="3" class="fill-white dark:fill-slate-800 stroke-blue-500" stroke-width="1"/>
          <text x="44" y="32" class="fill-blue-600 dark:fill-blue-400 font-mono font-bold text-[7.5px]" text-anchor="middle">Query Q</text>
          <rect x="76" y="22" width="38" height="14" rx="3" class="fill-white dark:fill-slate-800 stroke-cyan-500" stroke-width="1"/>
          <text x="95" y="32" class="fill-cyan-600 dark:fill-cyan-400 font-mono font-bold text-[7.5px]" text-anchor="middle">Key K</text>
          <rect x="127" y="22" width="38" height="14" rx="3" class="fill-white dark:fill-slate-800 stroke-purple-500" stroke-width="1"/>
          <text x="146" y="32" class="fill-purple-600 dark:fill-purple-400 font-mono font-bold text-[7.5px]" text-anchor="middle">Value V</text>
        </g>
        <!-- Equation -->
        <text x="140" y="105" class="fill-slate-600 dark:fill-slate-400 font-mono text-[7.5px]" text-anchor="middle">Attention(Q,K,V) = softmax(QKᵀ / √d_k) · V</text>
        <text x="140" y="120" class="fill-slate-500 dark:fill-slate-500 font-mono text-[7px]" text-anchor="middle">Rotary Positional Embeddings (RoPE) + RMSNorm</text>
      </svg>
    )}

    {/* 9. BUILD YOUR OWN RAG (Two-Stage Hybrid Search & Reranking Architecture) */}
    {key.includes('rag') && (
      <svg class="w-full h-full max-h-full max-w-full" viewBox="0 0 280 130" fill="none" xmlns="http://www.w3.org/2000/svg" aria-label="RAG pipeline diagram">
        <!-- User Query -->
        <g transform="translate(15, 45)">
          <rect width="50" height="34" rx="5" class="fill-white dark:fill-slate-800 stroke-slate-300 dark:stroke-slate-600" stroke-width="1.2"/>
          <text x="25" y="16" class="fill-slate-800 dark:fill-slate-200 font-sans font-bold text-[7.5px]" text-anchor="middle">QUERY</text>
