---
import { monetizationConfig } from '../../config/monetization';

export interface Props {
  className?: string;
  compact?: boolean;
}

const { className = '', compact = false } = Astro.props;
---

<div
  class={`ai-transparency-note rounded-xl border border-[#E3E8EF] bg-[#F8FAFC] p-4 text-xs leading-relaxed text-[#4B5565] ${className}`}
  role="note"
  aria-label="AI and Content Transparency Notice"
>
  <div class="flex items-start gap-3">
    <div class="mt-0.5 flex-shrink-0 text-[#3478F6]">
      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
      </svg>
    </div>
    <div class="space-y-1">
      <div class="flex items-center gap-2">
        <span class="font-bold tracking-wider text-[#14233B] uppercase text-[10px]">
          Content & AI Notice
        </span>
      </div>
      <p class="text-[#4B5565]">
        {monetizationConfig.aiDisclosure.statement}
      </p>
      {!compact && (
        <p class="text-[11px] text-[#697586]">
          Have questions or feedback? Feel free to <a href="/contact/" class="underline underline-offset-2 hover:text-[#14233B] font-medium text-[#3478F6]">reach out to us</a>.
        </p>
      )}
    </div>
  </div>
</div>

