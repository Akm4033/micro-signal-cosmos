---
import { CATEGORIES } from '../data/categories';
import { getPublishedArticles, getFeaturedArticles, getArticleReadingTime } from '../data/articles';

// Retrieve published and featured articles
const publishedArticles = await getPublishedArticles();
const featuredArticles = await getFeaturedArticles();

// Filter latest articles
const featuredSlugs = new Set(featuredArticles.map((a) => a.data.slug || a.id));
let latestArticles = publishedArticles.filter((a) => !featuredSlugs.has(a.data.slug || a.id));

if (latestArticles.length === 0) {
  latestArticles = publishedArticles;
}

function getCategoryInfo(categoryValue: string) {
  const norm = categoryValue.toLowerCase().trim();
  return (
    CATEGORIES.find((c) => c.slug.toLowerCase() === norm || c.name.toLowerCase() === norm) || {
      name: categoryValue,
      icon: '01',
      accent: 'sky' as const,
      href: `/category/${norm}/`,
    }
  );
}
---

{latestArticles.length > 0 && (
  <section id="latest-articles" class="bg-[#F7F9FC] py-14 sm:py-20 border-b border-[#E3E8EF]" aria-labelledby="latest-heading">
    <div class="container-main">

      <!-- Section Header -->
      <div class="mb-10 flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
        <div>
          <div class="inline-flex items-center gap-2 text-xs font-bold tracking-widest text-[#3478F6] uppercase mb-2">
            <span class="h-1.5 w-1.5 rounded-full bg-[#3478F6]"></span>
            <span>Latest Guides</span>
          </div>

          <h2 id="latest-heading" class="text-3xl font-extrabold tracking-tight text-[#14233B] sm:text-4xl">
            Latest <span class="text-[#3478F6]">Articles</span>
          </h2>

          <p class="mt-2 text-sm leading-relaxed text-[#697586] max-w-xl">
            Discover in-depth guides, practical tutorials, and informative articles published on Signal Insight.
          </p>
        </div>

        <a
          href="/articles/"
          class="inline-flex items-center gap-1.5 text-xs font-bold tracking-wider uppercase text-[#3478F6] hover:text-[#2563EB] transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#3478F6] rounded py-1"
        >
          <span>View All Articles</span>
          <span aria-hidden="true">&rarr;</span>
        </a>
      </div>

      <!-- Articles Grid -->
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">

        {latestArticles.map((article, idx) => {
          const slug = article.data.slug || article.id;
          const catInfo = getCategoryInfo(article.data.category);
          const number = String(idx + 1).padStart(2, '0');
          const formattedDate = article.data.publishDate.toLocaleDateString('en-US', {
            year: 'numeric',
            month: 'short',
            day: 'numeric',
          });
          const readingTime = getArticleReadingTime(article);

          return (
            <article class="group flex flex-col justify-between overflow-hidden rounded-2xl border border-[#E3E8EF] bg-white shadow-2xs transition-all duration-300 hover:-translate-y-1 hover:shadow-md hover:border-[#CBD5E1]">

              <!-- Article Visual Header -->
              <div class="relative aspect-[16/10] w-full overflow-hidden bg-gradient-to-br from-[#101B2D] via-[#14233B] to-[#1E3A63] flex items-center justify-center text-white p-5">
                
                <!-- Geometric Grid Silhouette -->
                <div class="absolute inset-0 opacity-10" aria-hidden="true">
                  <svg width="100%" height="100%" xmlns="http://www.w3.org/2000/svg">
                    <line x1="0" y1="20" x2="100%" y2="20" stroke="white" stroke-width="1" />
                    <line x1="0" y1="40" x2="100%" y2="40" stroke="white" stroke-width="1" />
                    <line x1="0" y1="60" x2="100%" y2="60" stroke="white" stroke-width="1" />
                  </svg>
                </div>

                <span class="text-6xl font-black text-white/10 select-none tracking-widest font-mono">
                  {number}
                </span>

                <a
                  href={catInfo.href}
                  class="absolute top-3.5 left-3.5 inline-flex items-center gap-1.5 rounded-full bg-white/95 px-3 py-1 text-xs font-bold text-[#14233B] shadow-2xs hover:text-[#3478F6] transition-colors"
                >
                  <span class="h-1.5 w-1.5 rounded-full bg-[#3478F6]"></span>
                  <span>{catInfo.name}</span>
                </a>

                <span class="absolute bottom-3 right-3 rounded-full bg-[#101B2D]/85 backdrop-blur-md px-2.5 py-0.5 text-xs font-medium text-slate-200 border border-white/10">
                  {readingTime}
                </span>
              </div>

              <!-- Article Content -->
              <div class="flex flex-1 flex-col p-6">

                <div class="flex items-center gap-2 text-xs text-[#697586] mb-3">
                  <span class="font-bold text-[#14233B]">{article.data.author}</span>
                  <span aria-hidden="true">&bull;</span>
                  <time datetime={article.data.publishDate.toISOString()}>{formattedDate}</time>
                </div>

                <h3 class="text-lg sm:text-xl font-bold leading-snug text-[#14233B] transition-colors group-hover:text-[#3478F6]">
                  <a href={`/articles/${slug}/`} class="focus-visible:outline-none focus-visible:underline">
                    {article.data.title}
                  </a>
                </h3>

                <p class="mt-3 text-sm leading-relaxed text-[#4B5565] line-clamp-3">
                  {article.data.description}
                </p>

                <div class="mt-auto border-t border-[#E3E8EF] pt-4 mt-6 flex items-center justify-between">
                  <a
                    href={`/articles/${slug}/`}
                    class="inline-flex items-center gap-1.5 text-xs font-bold uppercase tracking-wider text-[#3478F6] transition-all group-hover:gap-2.5 hover:text-[#2563EB]"
                    aria-label={`Read article: ${article.data.title}`}
                  >
                    <span>Read Article</span>
                    <span aria-hidden="true">&rarr;</span>
                  </a>
                  <span class="text-xs text-[#697586] font-medium">Verified Source</span>
                </div>

              </div>

            </article>
          );
        })}

      </div>

    </div>
  </section>
)}
