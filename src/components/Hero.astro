
<section class="relative isolate overflow-hidden bg-[#0B0F19]">
  <!-- Background Effects -->
  <div class="pointer-events-none absolute inset-0 -z-10 overflow-hidden">
    <div class="absolute -right-40 -top-40 h-96 w-96 rounded-full bg-blue-500/10 blur-[120px]"></div>
    <div class="absolute -bottom-40 left-1/4 h-96 w-96 rounded-full bg-purple-500/10 blur-[120px]"></div>
  </div>

  <div class="container-main grid min-h-[620px] items-center gap-12 py-20 lg:grid-cols-2 lg:py-28">

    <!-- Hero Content -->
    <div class="max-w-2xl">

      <div class="mb-7 inline-flex items-center gap-2 rounded-full border border-sky-400/20 bg-sky-400/5 px-4 py-2">
        <span class="h-2 w-2 rounded-full bg-sky-400"></span>
        <span class="text-xs font-semibold tracking-wider text-sky-300 uppercase">
          Explore the World of Knowledge
        </span>
      </div>

      <h1 class="text-4xl font-bold leading-tight tracking-tight text-white sm:text-5xl lg:text-6xl">
        Discover More.
        <span class="mt-2 block bg-gradient-to-r from-sky-400 via-blue-400 to-purple-400 bg-clip-text text-transparent">
          Understand Better.
        </span>
      </h1>

      <p class="mt-7 max-w-xl text-base leading-8 text-slate-400 sm:text-lg">
        Explore the ideas shaping our world. Discover insightful articles
        about technology, science, artificial intelligence and the
        ever-evolving digital universe.
      </p>

      <p class="mt-4 max-w-xl text-sm leading-7 text-slate-400">
        From emerging innovations to practical tutorials, Micro Signal
        Cosmos helps you explore complex topics and understand them better.
      </p>

      <!-- Hero Buttons -->
      <div class="mt-9 flex flex-wrap gap-4">

        <a
          href="#latest-articles"
          class="inline-flex items-center justify-center gap-2 rounded-lg bg-sky-400 px-7 py-3.5 text-sm font-bold text-slate-950 transition-all hover:-translate-y-1 hover:bg-sky-300 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-sky-400"
        >
          Explore Articles
          <span aria-hidden="true">→</span>
        </a>

        <a
          href="#categories"
          class="inline-flex items-center justify-center rounded-lg border border-white/15 px-7 py-3.5 text-sm font-semibold text-white transition-all hover:border-purple-400 hover:bg-white/5 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-purple-400"
        >
          Browse Categories
        </a>

      </div>

      <!-- Topic Highlights -->
      <div class="mt-12 flex flex-wrap gap-x-6 gap-y-3 border-t border-white/10 pt-7 text-sm text-slate-400">
        <span>Technology</span>
        <span>Science</span>
        <span>Artificial Intelligence</span>
        <span>Innovation</span>
      </div>

    </div>

    <!-- Hero Visual / Celestial Orbital Compass -->
    <div class="relative mx-auto mt-8 flex aspect-square w-full max-w-[340px] items-center justify-center sm:max-w-[420px] lg:mt-0 lg:max-w-[480px]">

      <!-- Central Core Glow -->
      <div class="absolute h-64 w-64 rounded-full bg-gradient-to-br from-sky-500/20 via-blue-600/15 to-purple-600/20 blur-3xl"></div>

      <!-- Outer Orbital Ring (Hardware-Accelerated 45s Clockwise Rotation) -->
      <div class="animate-cosmos-orbit absolute inset-2 sm:inset-4 rounded-full border border-sky-400/25 border-dashed">
        <!-- Orbiting celestial beacon 1 -->
        <div class="absolute -top-1.5 left-1/2 -translate-x-1/2 h-3 w-3 rounded-full bg-[#00D2FF] shadow-[0_0_12px_#00D2FF]"></div>
        <!-- Orbiting celestial beacon 2 -->
        <div class="absolute -bottom-1.5 left-1/2 -translate-x-1/2 h-2.5 w-2.5 rounded-full bg-[#A855F7] shadow-[0_0_12px_#A855F7]"></div>
      </div>

      <!-- Middle Counter-Rotating Ring (30s Counter-Clockwise Rotation) -->
      <div class="animate-cosmos-orbit-reverse absolute inset-10 sm:inset-14 rounded-full border border-purple-400/25">
        <!-- Celestial marker nodes -->
        <div class="absolute top-1/2 -left-1 -translate-y-1/2 h-2 w-2 rounded-full bg-sky-300 shadow-[0_0_8px_#38BDF8]"></div>
        <div class="absolute top-1/2 -right-1 -translate-y-1/2 h-2 w-2 rounded-full bg-purple-300 shadow-[0_0_8px_#A855F7]"></div>
      </div>

      <!-- Inner Orbital Ring -->
      <div class="absolute inset-20 sm:inset-26 rounded-full border border-sky-400/30"></div>

      <!-- Central Compass Core Graphic -->
      <div class="relative flex h-36 w-36 sm:h-44 sm:w-44 items-center justify-center rounded-full border border-sky-400/30 bg-gradient-to-br from-[#151C2E] via-[#172B49] to-[#1E1733] shadow-[0_0_80px_rgba(56,189,248,0.2)]">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 120 120"
          fill="none"
          width="112"
          height="112"
          class="h-24 w-24 sm:h-28 sm:w-28 animate-cosmos-orbit-reverse"
          role="img"
          aria-label="Abstract interconnected scientific signal compass"
        >
          <circle cx="60" cy="60" r="42" stroke="#38BDF8" stroke-opacity=".35" stroke-width="1.5" stroke-dasharray="4 4"/>
          <circle cx="60" cy="60" r="29" stroke="#A855F7" stroke-opacity=".5" stroke-width="1.5"/>
          <path d="M18 60H102M60 18V102M30 30L90 90M90 30L30 90" stroke="#00D2FF" stroke-opacity=".4" stroke-width="1.5"/>
          <circle cx="60" cy="60" r="13" fill="#00D2FF" fill-opacity=".2" stroke="#00D2FF" stroke-width="2"/>
          <circle cx="60" cy="60" r="5" fill="#00D2FF"/>
          <circle cx="18" cy="60" r="3" fill="#A855F7"/>
          <circle cx="102" cy="60" r="3" fill="#00D2FF"/>
          <circle cx="60" cy="18" r="3" fill="#00D2FF"/>
          <circle cx="60" cy="102" r="3" fill="#A855F7"/>
        </svg>
      </div>

      <!-- Floating Frosted-Glass Badge 1: TECHNOLOGY -->
      <div
        class="floating-badge absolute -left-2 top-8 sm:left-1 sm:top-12 z-20 rounded-xl px-4 py-3 transition-transform hover:scale-105"
        style="background: rgba(15, 23, 42, 0.75); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); border: 1px solid rgba(56, 189, 248, 0.25); box-shadow: 0 4px 20px rgba(0, 0, 0, 0.5), 0 0 15px rgba(56, 189, 248, 0.15);"
      >
        <div class="flex items-center gap-2">
          <span class="h-2 w-2 rounded-full bg-[#00D2FF] shadow-[0_0_8px_#00d2ff] animate-pulse"></span>
          <p style="font-size: 0.7rem; font-weight: 700; letter-spacing: 0.12em; color: #38bdf8; text-transform: uppercase;">
            TECHNOLOGY
          </p>
        </div>
        <p class="mt-1" style="font-size: 0.85rem; font-weight: 500; color: #e2e8f0;">
          Explore Innovation
        </p>
      </div>

      <!-- Floating Frosted-Glass Badge 2: SCIENCE & AI -->
      <div
        class="floating-badge absolute -right-2 bottom-8 sm:right-1 sm:bottom-12 z-20 rounded-xl px-4 py-3 transition-transform hover:scale-105"
        style="background: rgba(15, 23, 42, 0.75); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); border: 1px solid rgba(168, 85, 247, 0.25); box-shadow: 0 4px 20px rgba(0, 0, 0, 0.5), 0 0 15px rgba(168, 85, 247, 0.15);"
      >
        <div class="flex items-center gap-2">
          <span class="h-2 w-2 rounded-full bg-[#A855F7] shadow-[0_0_8px_#a855f7] animate-pulse"></span>
          <p style="font-size: 0.7rem; font-weight: 700; letter-spacing: 0.12em; color: #a78bfa; text-transform: uppercase;">
            SCIENCE & AI
          </p>
        </div>
        <p class="mt-1" style="font-size: 0.85rem; font-weight: 500; color: #e2e8f0;">
          Understand Discovery
        </p>
      </div>

    </div>

  </div>
</section>
