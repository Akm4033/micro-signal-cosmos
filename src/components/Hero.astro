---
// Hero Section: Modern International Digital Publication Masthead
---

<section class="relative isolate overflow-hidden bg-white border-b border-[#E3E8EF] py-16 sm:py-20 lg:py-24">
  <!-- Subtle Editorial Background Pattern -->
  <div class="pointer-events-none absolute inset-0 -z-10 opacity-40" aria-hidden="true">
    <div class="absolute inset-0 bg-[radial-gradient(#E2E8F0_1px,transparent_1px)] [background-size:24px_24px]"></div>
  </div>

  <div class="container-main grid items-center gap-12 lg:grid-cols-12 lg:gap-8">

    <!-- Hero Content Column (7 cols) -->
    <div class="lg:col-span-7 max-w-2xl">

      <!-- Eyebrow Tag -->
      <div class="mb-5 inline-flex items-center gap-2 rounded-full border border-[#E3E8EF] bg-[#F7F9FC] px-3.5 py-1.5 text-xs font-bold tracking-widest text-[#3478F6] uppercase">
        <span class="h-1.5 w-1.5 rounded-full bg-[#3478F6]"></span>
        <span>MICRO SIGNAL COSMOS</span>
      </div>

      <!-- Headline & Tagline -->
      <h1 class="text-4xl font-extrabold tracking-tight text-[#14233B] sm:text-5xl lg:text-6xl leading-[1.12]">
        Explore Ideas.
        <span class="block text-[#3478F6]">Discover Possibilities.</span>
      </h1>

      <p class="mt-3 text-base font-semibold text-[#697586] tracking-wide">
        Discover More. Understand Better.
      </p>

      <!-- Description -->
      <p class="mt-5 text-base sm:text-lg leading-relaxed text-[#202938]">
        Explore the world of technology, science, artificial intelligence and innovation through insightful articles, practical guides and ideas that shape our future.
      </p>

      <!-- Action Buttons -->
      <div class="mt-8 flex flex-wrap items-center gap-4">
        <a
          href="/articles/"
          class="btn-primary"
        >
          <span>Explore Articles</span>
          <span aria-hidden="true">&rarr;</span>
        </a>

        <a
          href="/#categories"
          class="btn-secondary"
        >
          <span>Browse Topics</span>
        </a>
      </div>

      <!-- Core Topics Quick Bar -->
      <div class="mt-10 pt-6 border-t border-[#E3E8EF] flex flex-wrap items-center gap-2 text-xs text-[#697586]">
        <span class="font-semibold uppercase tracking-wider text-[#14233B] mr-1">Core Streams:</span>
        <a href="/category/technology/" class="rounded-md bg-[#F7F9FC] border border-[#E3E8EF] px-2.5 py-1 text-[#202938] hover:text-[#3478F6] hover:border-[#3478F6] transition-colors">Technology</a>
        <a href="/category/science/" class="rounded-md bg-[#F7F9FC] border border-[#E3E8EF] px-2.5 py-1 text-[#202938] hover:text-[#3478F6] hover:border-[#3478F6] transition-colors">Science</a>
        <a href="/category/artificial-intelligence/" class="rounded-md bg-[#F7F9FC] border border-[#E3E8EF] px-2.5 py-1 text-[#202938] hover:text-[#3478F6] hover:border-[#3478F6] transition-colors">AI</a>
        <a href="/category/digital-world/" class="rounded-md bg-[#F7F9FC] border border-[#E3E8EF] px-2.5 py-1 text-[#202938] hover:text-[#3478F6] hover:border-[#3478F6] transition-colors">Digital World</a>
        <a href="/category/innovation/" class="rounded-md bg-[#F7F9FC] border border-[#E3E8EF] px-2.5 py-1 text-[#202938] hover:text-[#3478F6] hover:border-[#3478F6] transition-colors">Innovation</a>
      </div>

    </div>

    <!-- Editorial Visual Column (5 cols) -->
    <div class="lg:col-span-5 flex justify-center">
      <div class="relative w-full max-w-[420px] rounded-2xl border border-[#E3E8EF] bg-[#F7F9FC] p-6 shadow-md transition-all hover:shadow-lg">
        
        <!-- Header Pill of Editorial Showcase -->
        <div class="flex items-center justify-between pb-4 border-b border-[#E3E8EF]">
          <div class="flex items-center gap-2">
            <span class="h-2 w-2 rounded-full bg-[#3478F6]"></span>
            <span class="text-xs font-bold uppercase tracking-wider text-[#14233B]">Digital Dispatch</span>
          </div>
          <span class="text-[11px] font-medium text-[#697586]">Vol. 2026</span>
        </div>

        <!-- Abstract Editorial Illustration -->
        <div class="relative my-6 aspect-video w-full overflow-hidden rounded-xl bg-gradient-to-br from-[#14233B] via-[#1E3A63] to-[#3478F6] flex items-center justify-center p-6 text-white shadow-inner">
          <div class="absolute inset-0 opacity-15" aria-hidden="true">
            <svg width="100%" height="100%" xmlns="http://www.w3.org/2000/svg">
              <defs>
                <pattern id="grid" width="20" height="20" patternUnits="userSpaceOnUse">
                  <path d="M 20 0 L 0 0 0 20" fill="none" stroke="white" stroke-width="1" />
                </pattern>
              </defs>
              <rect width="100%" height="100%" fill="url(#grid)" />
            </svg>
          </div>

          <div class="relative z-10 text-center">
            <div class="mx-auto mb-3 flex h-14 w-14 items-center justify-center rounded-2xl bg-white/10 backdrop-blur-md border border-white/20 shadow-lg">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="2" y1="12" x2="22" y2="12"></line>
                <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
              </svg>
            </div>
            <p class="text-xs font-semibold uppercase tracking-widest text-sky-200">Knowledge Stream</p>
            <p class="text-sm font-bold text-white mt-1">Science &bull; Technology &bull; Future</p>
          </div>
        </div>

        <!-- Featured Takeaway Box -->
        <div class="rounded-lg bg-white p-4 border border-[#E3E8EF]">
          <p class="text-xs font-bold uppercase tracking-wider text-[#3478F6]">Editorial Focus</p>
          <p class="mt-1 text-sm font-semibold text-[#14233B]">
            Translating complex discoveries into clear, accessible knowledge.
          </p>
          <p class="mt-1 text-xs text-[#697586]">
            Fact-checked insights, primary citations, and deep-dive technical explorations.
          </p>
        </div>

      </div>
    </div>

  </div>
</section>
