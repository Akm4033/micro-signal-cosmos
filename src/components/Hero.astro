
<section class="relative isolate overflow-hidden bg-[#0B1020]">
  <!-- Background Effects -->
  <div class="pointer-events-none absolute inset-0 -z-10 overflow-hidden">
    <div class="absolute -right-40 -top-40 h-96 w-96 rounded-full bg-blue-500/10 blur-[120px]"></div>
    <div class="absolute -bottom-40 left-1/4 h-96 w-96 rounded-full bg-purple-500/10 blur-[120px]"></div>
  </div>

  <div class="container-main grid min-h-[620px] items-center gap-12 py-20 lg:grid-cols-2 lg:py-28">

    <!-- Hero Content -->
    <div class="max-w-2xl">

      <div class="mb-7 inline-flex items-center gap-2 rounded-full border border-sky-400/20 bg-sky-400/5 px-4 py-2">
        <span class="h-2 w-2 rounded-full bg-sky-400"></span>
        <span class="text-xs font-semibold tracking-wider text-sky-300 uppercase">
          Explore the World of Knowledge
        </span>
      </div>

      <h1 class="text-4xl font-bold leading-tight tracking-tight text-white sm:text-5xl lg:text-6xl">
        Discover More.
        <span class="mt-2 block bg-gradient-to-r from-sky-400 via-blue-400 to-purple-400 bg-clip-text text-transparent">
          Understand Better.
        </span>
      </h1>

      <p class="mt-7 max-w-xl text-base leading-8 text-slate-400 sm:text-lg">
        Explore the ideas shaping our world. Discover insightful articles
        about technology, science, artificial intelligence and the
        ever-evolving digital universe.
      </p>

      <p class="mt-4 max-w-xl text-sm leading-7 text-slate-400">
        From emerging innovations to practical tutorials, Micro Signal
        Cosmos helps you explore complex topics and understand them better.
      </p>

      <!-- Hero Buttons -->
      <div class="mt-9 flex flex-wrap gap-4">

        <a
          href="#latest-articles"
          class="inline-flex items-center justify-center gap-2 rounded-lg bg-sky-400 px-7 py-3.5 text-sm font-bold text-slate-950 transition-all hover:-translate-y-1 hover:bg-sky-300 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-sky-400"
        >
          Explore Articles
          <span aria-hidden="true">→</span>
        </a>

        <a
          href="#categories"
          class="inline-flex items-center justify-center rounded-lg border border-white/15 px-7 py-3.5 text-sm font-semibold text-white transition-all hover:border-purple-400 hover:bg-white/5 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-purple-400"
        >
          Browse Categories
        </a>

      </div>

      <!-- Topic Highlights -->
      <div class="mt-12 flex flex-wrap gap-x-6 gap-y-3 border-t border-white/10 pt-7 text-sm text-slate-400">
        <span>Technology</span>
        <span>Science</span>
        <span>Artificial Intelligence</span>
        <span>Innovation</span>
      </div>

    </div>

    <!-- Hero Visual -->
    <div class="relative mx-auto flex aspect-square w-full max-w-[480px] items-center justify-center">

      <!-- Outer Orbital Ring -->
      <div class="absolute inset-4 rounded-full border border-sky-400/10"></div>

      <!-- Middle Orbital Ring -->
      <div class="absolute inset-12 rounded-full border border-purple-400/15"></div>

      <!-- Inner Orbital Ring -->
      <div class="absolute inset-24 rounded-full border border-sky-400/20"></div>

      <!-- Central Glow -->
      <div class="absolute h-64 w-64 rounded-full bg-gradient-to-br from-sky-500/20 to-purple-500/20 blur-3xl"></div>

      <!-- Central Graphic -->
      <div class="relative flex h-44 w-44 items-center justify-center rounded-full border border-sky-400/30 bg-gradient-to-br from-[#172B49] to-[#17152F] shadow-[0_0_80px_rgba(56,189,248,0.12)]">

        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 120 120"
          fill="none"
          class="h-28 w-28"
          role="img"
          aria-label="Abstract interconnected scientific signal illustration"
        >
          <circle cx="60" cy="60" r="42" stroke="#38BDF8" stroke-opacity=".35" stroke-width="1.5"/>
          <circle cx="60" cy="60" r="29" stroke="#A78BFA" stroke-opacity=".5" stroke-width="1.5"/>
          <path d="M18 60H102M60 18V102M30 30L90 90M90 30L30 90" stroke="#38BDF8" stroke-opacity=".4" stroke-width="1.5"/>
          <circle cx="60" cy="60" r="13" fill="#38BDF8" fill-opacity=".2" stroke="#38BDF8" stroke-width="2"/>
          <circle cx="60" cy="60" r="5" fill="#38BDF8"/>
          <circle cx="18" cy="60" r="3" fill="#A78BFA"/>
          <circle cx="102" cy="60" r="3" fill="#38BDF8"/>
          <circle cx="60" cy="18" r="3" fill="#38BDF8"/>
          <circle cx="60" cy="102" r="3" fill="#A78BFA"/>
        </svg>

      </div>

      <!-- Floating Information Cards -->
      <div class="absolute left-0 top-1/4 rounded-xl border border-white/10 bg-[#141C2E]/90 px-4 py-3 shadow-xl backdrop-blur-md sm:left-2">
        <p class="text-xs font-semibold text-sky-400">TECHNOLOGY</p>
        <p class="mt-1 text-sm font-medium text-white">Explore Innovation</p>
      </div>

      <div class="absolute bottom-1/4 right-0 rounded-xl border border-white/10 bg-[#141C2E]/90 px-4 py-3 shadow-xl backdrop-blur-md sm:right-2">
        <p class="text-xs font-semibold text-purple-400">SCIENCE & AI</p>
        <p class="mt-1 text-sm font-medium text-white">Understand Discovery</p>
      </div>

      <!-- Decorative Signal Points -->
      <div class="absolute right-1/4 top-8 h-3 w-3 rounded-full bg-sky-400 shadow-[0_0_20px_#38BDF8]"></div>
      <div class="absolute bottom-12 left-1/4 h-2 w-2 rounded-full bg-purple-400 shadow-[0_0_20px_#A78BFA]"></div>

    </div>

  </div>
</section>
