---
// Hero Section: Premium International Technology & Science Publication Masthead
---

<section class="relative isolate overflow-hidden bg-white border-b border-[#E3E8EF] py-14 sm:py-20 lg:py-24">
  <!-- Subtle Editorial Grid Motif -->
  <div class="pointer-events-none absolute inset-0 -z-10 opacity-30" aria-hidden="true">
    <div class="absolute inset-0 bg-[radial-gradient(#CBD5E1_1px,transparent_1px)] [background-size:28px_28px]"></div>
  </div>

  <div class="container-main grid items-center gap-12 lg:grid-cols-12 lg:gap-8">

    <!-- Hero Content Column (7 cols) -->
    <div class="lg:col-span-7 max-w-2xl">

      <!-- Eyebrow Tag -->
      <div class="mb-5 inline-flex items-center gap-2 rounded-full border border-[#E3E8EF] bg-[#F7F9FC] px-3.5 py-1.5 text-xs font-bold tracking-widest text-[#3478F6] uppercase shadow-2xs">
        <span class="h-2 w-2 rounded-full bg-[#3478F6]"></span>
        <span>MICRO SIGNAL COSMOS</span>
      </div>

      <!-- Main Headline & Tagline -->
      <h1 class="text-4xl font-extrabold tracking-tight text-[#14233B] sm:text-5xl lg:text-6xl leading-[1.12]">
        Explore Ideas.
        <span class="block text-[#3478F6]">Discover Possibilities.</span>
      </h1>

      <p class="mt-3.5 text-base sm:text-lg font-bold text-[#4B5565] tracking-wide">
        Discover More. Understand Better.
      </p>

      <!-- Description -->
      <p class="mt-5 text-base sm:text-lg leading-relaxed text-[#202938]">
        Explore the world of technology, science, artificial intelligence and innovation through insightful articles, practical guides and ideas that shape our future.
      </p>

      <!-- Action Buttons -->
      <div class="mt-8 flex flex-wrap items-center gap-4">
        <a
          href="/articles/"
          class="btn-primary"
        >
          <span>Explore Articles</span>
          <span aria-hidden="true">&rarr;</span>
        </a>

        <a
          href="/#categories"
          class="btn-secondary"
        >
          <span>Browse Topics</span>
        </a>
      </div>

      <!-- Editorial Streams Quick Access Strip -->
      <div class="mt-10 pt-6 border-t border-[#E3E8EF] flex flex-wrap items-center gap-2 text-xs">
        <span class="font-bold uppercase tracking-wider text-[#14233B] mr-1">Active Streams:</span>
        <a href="/category/technology/" class="rounded-md bg-[#F7F9FC] border border-[#E3E8EF] px-2.5 py-1 font-medium text-[#202938] hover:text-[#3478F6] hover:border-[#3478F6] transition-colors">Technology</a>
        <a href="/category/science/" class="rounded-md bg-[#F7F9FC] border border-[#E3E8EF] px-2.5 py-1 font-medium text-[#202938] hover:text-[#3478F6] hover:border-[#3478F6] transition-colors">Science</a>
        <a href="/category/artificial-intelligence/" class="rounded-md bg-[#F7F9FC] border border-[#E3E8EF] px-2.5 py-1 font-medium text-[#202938] hover:text-[#3478F6] hover:border-[#3478F6] transition-colors">Artificial Intelligence</a>
        <a href="/category/digital-world/" class="rounded-md bg-[#F7F9FC] border border-[#E3E8EF] px-2.5 py-1 font-medium text-[#202938] hover:text-[#3478F6] hover:border-[#3478F6] transition-colors">Digital World</a>
        <a href="/category/innovation/" class="rounded-md bg-[#F7F9FC] border border-[#E3E8EF] px-2.5 py-1 font-medium text-[#202938] hover:text-[#3478F6] hover:border-[#3478F6] transition-colors">Innovation</a>
      </div>

    </div>

    <!-- Editorial Showcase Column (5 cols) -->
    <div class="lg:col-span-5 flex justify-center">
      <div class="relative w-full max-w-[430px] rounded-2xl border border-[#E3E8EF] bg-[#F7F9FC] p-6 shadow-sm transition-all duration-300 hover:shadow-md hover:border-[#CBD5E1]">

        <!-- Editorial Issue Masthead Header -->
        <div class="flex items-center justify-between pb-4 border-b border-[#E3E8EF]">
          <div class="flex items-center gap-2">
            <span class="inline-flex h-2 w-2 rounded-full bg-[#3478F6]"></span>
            <span class="text-xs font-bold uppercase tracking-wider text-[#14233B]">Lead Investigation</span>
          </div>
          <span class="rounded-full bg-white border border-[#E3E8EF] px-2.5 py-0.5 text-[11px] font-semibold text-[#697586]">
            8 min read
          </span>
        </div>

        <!-- Editorial Visual Graphic: Cosmic & Neural Signal Core -->
        <a
          href="/articles/understanding-artificial-intelligence/"
          class="group block relative my-5 aspect-[16/10] w-full overflow-hidden rounded-xl bg-gradient-to-br from-[#101B2D] via-[#14233B] to-[#1E3A63] p-6 text-white shadow-inner transition-transform group-hover:scale-[1.01]"
          aria-label="Read lead investigation: Understanding Artificial Intelligence"
        >
          <!-- Technical Grid Background -->
          <div class="absolute inset-0 opacity-15" aria-hidden="true">
            <svg width="100%" height="100%" xmlns="http://www.w3.org/2000/svg">
              <defs>
                <pattern id="hero-signal-grid" width="24" height="24" patternUnits="userSpaceOnUse">
                  <path d="M 24 0 L 0 0 0 24" fill="none" stroke="white" stroke-width="1" />
                </pattern>
              </defs>
              <rect width="100%" height="100%" fill="url(#hero-signal-grid)" />
            </svg>
          </div>

          <!-- Central Graphic: Interconnected Signal Nodes -->
          <div class="relative z-10 flex h-full flex-col justify-between">
            <div class="flex items-center justify-between">
              <span class="rounded-md bg-white/10 backdrop-blur-md px-2.5 py-1 text-[11px] font-bold tracking-wider text-sky-300 uppercase border border-white/15">
                AI & Deep Systems
              </span>
              <span class="text-xs font-mono text-white/50">#01-DISPATCH</span>
            </div>

            <div class="text-center my-auto">
              <div class="mx-auto mb-2 flex h-12 w-12 items-center justify-center rounded-xl bg-[#3478F6]/20 border border-[#3478F6]/40 text-sky-300 shadow-md">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="2" y="2" width="20" height="8" rx="2" ry="2"></rect>
                  <rect x="2" y="14" width="20" height="8" rx="2" ry="2"></rect>
                  <line x1="6" y1="6" x2="6.01" y2="6"></line>
                  <line x1="6" y1="18" x2="6.01" y2="18"></line>
                </svg>
              </div>
              <p class="text-xs font-semibold uppercase tracking-widest text-slate-300">Neural Architectures</p>
            </div>

            <div class="flex items-center justify-between text-[11px] text-slate-300">
              <span>Peer-reviewed Sourcing</span>
              <span class="font-bold text-white group-hover:text-sky-300 transition-colors">Read Investigation &rarr;</span>
            </div>
          </div>
        </a>

        <!-- Story Title & Excerpt -->
        <div class="rounded-xl bg-white p-4 border border-[#E3E8EF] shadow-2xs">
          <h2 class="text-base font-bold text-[#14233B] hover:text-[#3478F6] transition-colors leading-snug">
            <a href="/articles/understanding-artificial-intelligence/">
              Understanding Artificial Intelligence: Beyond the Hype and Into the Mechanics
            </a>
          </h2>
          <p class="mt-2 text-xs leading-relaxed text-[#697586] line-clamp-2">
            A comprehensive exploration of how modern AI systems, neural networks, and machine learning models actually process information.
          </p>
          <div class="mt-3 pt-3 border-t border-[#E3E8EF] flex items-center justify-between text-xs">
            <span class="text-[#697586]">By Editorial Staff</span>
            <a href="/articles/understanding-artificial-intelligence/" class="font-bold text-[#3478F6] hover:underline">
              Full Analysis &rarr;
            </a>
          </div>
        </div>

      </div>
    </div>

  </div>
</section>
