---
import { CATEGORIES } from '../data/categories';

const currentPath = Astro.url.pathname;

const navItems = [
  { name: 'Home', shortName: 'Home', href: '/' },
  ...CATEGORIES.map((c) => ({
    name: c.name,
    shortName: c.shortName || c.name,
    href: c.href,
  })),
];
---

<header class="sticky top-0 z-50 border-b border-[#E3E8EF] bg-white/95 backdrop-blur-md shadow-xs">
  <div class="container-main">

    <div class="flex min-h-20 items-center justify-between gap-4 lg:gap-8">

      <!-- Brand Identity -->
      <a href="/" class="shrink-0 flex flex-col group py-1" aria-label="Micro Signal Cosmos homepage">
        <span class="block text-xl font-extrabold tracking-tight text-[#14233B] sm:text-2xl transition-colors group-hover:text-[#3478F6]">
          Micro Signal
          <span class="text-[#3478F6]">Cosmos</span>
        </span>
        <span class="block text-[10px] font-semibold tracking-[0.2em] text-[#697586] uppercase">
          Discover More. Understand Better.
        </span>
      </a>

      <!-- Desktop Navigation -->
      <nav aria-label="Main navigation" class="hidden items-center gap-1 xl:gap-2 lg:flex">
        {navItems.map((item) => {
          const isActive = item.href === '/' ? currentPath === '/' : currentPath.startsWith(item.href);
          return (
            <a
              href={item.href}
              class:list={[
                'rounded-md px-2.5 py-1.5 text-sm font-medium transition-colors',
                isActive
                  ? 'text-[#3478F6] font-semibold bg-[#EEF1F5]/60'
                  : 'text-[#202938] hover:text-[#3478F6] hover:bg-[#F7F9FC]',
              ]}
              aria-current={isActive ? 'page' : undefined}
              title={item.name}
            >
              {item.shortName || item.name}
            </a>
          );
        })}
      </nav>

      <!-- Right Controls: Search & Mobile Toggle -->
      <div class="flex items-center gap-2.5">
        <!-- Working Search Link Button -->
        <a
          href="/articles/"
          class="flex h-10 w-10 items-center justify-center rounded-lg border border-[#E3E8EF] bg-[#F7F9FC] text-[#202938] transition-all hover:border-[#3478F6] hover:bg-white hover:text-[#3478F6] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#3478F6]"
          aria-label="Search articles across Micro Signal Cosmos"
          title="Search all articles"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
        </a>

        <!-- Mobile Menu Toggle -->
        <details class="relative lg:hidden" id="mobile-nav-details">
          <summary
            class="flex h-10 w-10 min-h-[44px] min-w-[44px] cursor-pointer list-none items-center justify-center rounded-lg border border-[#E3E8EF] bg-white text-[#14233B] transition-colors hover:border-[#3478F6] hover:text-[#3478F6] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#3478F6]"
            aria-label="Toggle navigation menu"
            aria-expanded="false"
            id="mobile-nav-toggle"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="22"
              height="22"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <line x1="3" y1="12" x2="21" y2="12"></line>
              <line x1="3" y1="6" x2="21" y2="6"></line>
              <line x1="3" y1="18" x2="21" y2="18"></line>
            </svg>
          </summary>

          <nav
            aria-label="Mobile navigation"
            class="absolute right-0 top-14 z-50 w-72 rounded-xl border border-[#E3E8EF] bg-white p-4 shadow-xl"
          >
            <!-- Mobile Quick Search -->
            <a
              href="/articles/"
              class="mb-3 flex min-h-[44px] items-center justify-between rounded-lg border border-[#E3E8EF] bg-[#F7F9FC] px-3.5 py-2 text-xs font-medium text-[#697586] hover:border-[#3478F6] hover:text-[#3478F6]"
            >
              <span>Search all articles...</span>
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="8"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
              </svg>
            </a>

            <div class="flex flex-col gap-1 border-t border-[#E3E8EF] pt-2">
              {navItems.map((item) => {
                const isActive = item.href === '/' ? currentPath === '/' : currentPath.startsWith(item.href);
                return (
                  <a
                    href={item.href}
                    class:list={[
                      'flex min-h-[46px] items-center rounded-lg px-3.5 py-2.5 text-sm font-medium transition-colors',
                      isActive
                        ? 'bg-[#EEF1F5] text-[#3478F6] font-semibold'
                        : 'text-[#202938] hover:bg-[#F7F9FC] hover:text-[#3478F6]',
                    ]}
                    aria-current={isActive ? 'page' : undefined}
                  >
                    {item.name}
                  </a>
                );
              })}
            </div>
          </nav>
        </details>
      </div>

    </div>

  </div>
</header>

<script is:inline>
  const details = document.getElementById('mobile-nav-details');
  const toggle = document.getElementById('mobile-nav-toggle');
  if (details && toggle) {
    details.addEventListener('toggle', () => {
      toggle.setAttribute('aria-expanded', details.open ? 'true' : 'false');
    });

    // Close mobile dropdown when clicking outside
    document.addEventListener('click', (e) => {
      if (details.open && !details.contains(e.target)) {
        details.removeAttribute('open');
      }
    });

    // Close on Escape
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && details.open) {
        details.removeAttribute('open');
        toggle.focus();
      }
    });
  }
</script>
