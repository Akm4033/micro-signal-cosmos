---
import { CATEGORIES } from '../data/categories';

const currentYear = new Date().getFullYear();
---

<footer class="border-t border-white/10 bg-[#0B1020]">
  <div class="container-main py-14">

    <div class="grid grid-cols-1 gap-12 md:grid-cols-2 lg:grid-cols-4">

      <!-- Brand -->
      <div>
        <a href="/" class="text-2xl font-bold tracking-tight text-white">
          Micro Signal <span class="text-sky-400">Cosmos</span>
        </a>

        <p class="mt-3 text-sm font-medium text-slate-400">
          Discover More. Understand Better.
        </p>

        <p class="mt-5 max-w-xs text-sm leading-7 text-slate-400">
          Exploring technology, science, artificial intelligence and
          the digital world through informative articles and practical guides.
        </p>
      </div>

      <!-- Explore -->
      <div>
        <h2 class="mb-5 text-sm font-semibold uppercase tracking-wider text-white">
          Explore
        </h2>

        <ul class="space-y-3 text-sm text-slate-400">
          <li><a href="/" class="footer-link">Home</a></li>
          <li><a href="/articles/" class="footer-link">Latest Articles</a></li>
          <li><a href="/about/" class="footer-link">About Us</a></li>
          <li><a href="/contact/" class="footer-link">Contact</a></li>
        </ul>
      </div>

      <!-- Categories -->
      <div>
        <h2 class="mb-5 text-sm font-semibold uppercase tracking-wider text-white">
          Categories
        </h2>

        <ul class="space-y-3 text-sm text-slate-400">
          {CATEGORIES.map((category) => (
            <li>
              <a href={category.href} class="footer-link">
                {category.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Social Links -->
      <div>
        <h2 class="mb-5 text-sm font-semibold uppercase tracking-wider text-white">
          Connect With Us
        </h2>

        <p class="mb-5 text-sm leading-6 text-slate-400">
          Follow Micro Signal Cosmos for technology and science insights.
        </p>

        <div class="flex flex-col items-start gap-4 text-sm">
          <a
            href="https://www.facebook.com/profile.php?id=61596288235891"
            target="_blank"
            rel="noopener noreferrer"
            class="footer-link"
          >
            Facebook ↗
          </a>

          <a
            href="https://www.youtube.com/@MicroSignalCosmos"
            target="_blank"
            rel="noopener noreferrer"
            class="footer-link"
          >
            YouTube ↗
          </a>
        </div>
      </div>

    </div>

    <!-- Copyright and Legal Links -->
    <div class="mt-14 border-t border-white/10 pt-7">
      <div class="flex flex-col gap-4 text-center md:flex-row md:items-center md:justify-between md:text-left">

        <p class="text-xs text-slate-400">
          © {currentYear} Micro Signal Cosmos. All rights reserved.
        </p>

        <div class="flex flex-wrap justify-center gap-5 text-xs text-slate-400">
          <a href="/privacy-policy/" class="footer-link">Privacy Policy</a>
          <a href="/terms/" class="footer-link">Terms</a>
          <a href="/disclaimer/" class="footer-link">Disclaimer</a>
        </div>

      </div>
    </div>

  </div>
</footer>

<style>
  .footer-link {
    transition: color 0.2s ease;
  }

  .footer-link:hover {
    color: #38BDF8;
  }

  .footer-link:focus-visible {
    outline: 2px solid #38BDF8;
    outline-offset: 4px;
    border-radius: 2px;
  }
</style>
