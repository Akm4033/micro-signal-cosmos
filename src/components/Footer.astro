---
import { CATEGORIES } from '../data/categories';

const currentYear = new Date().getFullYear();
---

<footer class="border-t border-[#E3E8EF] bg-[#101B2D] text-slate-300">
  <div class="container-main py-16">

    <div class="grid grid-cols-1 gap-12 md:grid-cols-2 lg:grid-cols-5">

      <!-- Brand & Mission Column -->
      <div class="lg:col-span-2">
        <a href="/" class="text-2xl font-extrabold tracking-tight text-white flex items-center gap-1.5">
          <span>Micro Signal</span>
          <span class="text-[#3478F6]">Cosmos</span>
        </a>

        <p class="mt-2 text-xs font-semibold uppercase tracking-wider text-slate-400">
          Discover More. Understand Better.
        </p>

        <p class="mt-4 max-w-sm text-sm leading-relaxed text-slate-300">
          An international digital publishing platform exploring technology, science, artificial intelligence, and digital innovations through insightful articles, practical guides, and thoughtful explanations.
        </p>

        <!-- Social Channels -->
        <div class="mt-6 flex items-center gap-3">
          <a
            href="https://www.facebook.com/profile.php?id=61596288235891"
            target="_blank"
            rel="noopener noreferrer"
            class="flex h-9 items-center gap-1.5 rounded-lg border border-slate-700 bg-slate-800/80 px-3 text-xs font-medium text-slate-200 transition-colors hover:border-[#3478F6] hover:text-[#3478F6]"
            aria-label="Follow Micro Signal Cosmos on Facebook"
          >
            <span>Facebook</span>
            <span aria-hidden="true">↗</span>
          </a>

          <a
            href="https://www.youtube.com/@MicroSignalCosmos"
            target="_blank"
            rel="noopener noreferrer"
            class="flex h-9 items-center gap-1.5 rounded-lg border border-slate-700 bg-slate-800/80 px-3 text-xs font-medium text-slate-200 transition-colors hover:border-[#3478F6] hover:text-[#3478F6]"
            aria-label="Subscribe to Micro Signal Cosmos on YouTube"
          >
            <span>YouTube</span>
            <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>

      <!-- Categories Column -->
      <div>
        <h2 class="text-xs font-bold uppercase tracking-widest text-white mb-4">
          Core Topics
        </h2>

        <ul class="space-y-2.5 text-sm">
          {CATEGORIES.map((category) => (
            <li>
              <a href={category.href} class="text-slate-300 transition-colors hover:text-white hover:underline underline-offset-4">
                {category.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Editorial & Trust Column -->
      <div>
        <h2 class="text-xs font-bold uppercase tracking-widest text-white mb-4">
          Editorial Standards
        </h2>

        <ul class="space-y-2.5 text-sm">
          <li><a href="/about/" class="text-slate-300 transition-colors hover:text-white hover:underline underline-offset-4">About the Publication</a></li>
          <li><a href="/authors/" class="text-slate-300 transition-colors hover:text-white hover:underline underline-offset-4">Editorial Desk & Authors</a></li>
          <li><a href="/editorial-policy/" class="text-slate-300 transition-colors hover:text-white hover:underline underline-offset-4">Editorial Policy</a></li>
          <li><a href="/fact-checking-policy/" class="text-slate-300 transition-colors hover:text-white hover:underline underline-offset-4">Fact-checking Standards</a></li>
          <li><a href="/corrections-policy/" class="text-slate-300 transition-colors hover:text-white hover:underline underline-offset-4">Corrections Policy</a></li>
          <li><a href="/contact/" class="text-slate-300 transition-colors hover:text-white hover:underline underline-offset-4">Contact & Inquiries</a></li>
        </ul>
      </div>

      <!-- Legal & Feeds Column -->
      <div>
        <h2 class="text-xs font-bold uppercase tracking-widest text-white mb-4">
          Legal & Feeds
        </h2>

        <ul class="space-y-2.5 text-sm">
          <li><a href="/privacy-policy/" class="text-slate-300 transition-colors hover:text-white hover:underline underline-offset-4">Privacy Policy</a></li>
          <li><a href="/terms/" class="text-slate-300 transition-colors hover:text-white hover:underline underline-offset-4">Terms of Use</a></li>
          <li><a href="/disclaimer/" class="text-slate-300 transition-colors hover:text-white hover:underline underline-offset-4">Editorial Disclaimer</a></li>
          <li><a href="/articles/" class="text-slate-300 transition-colors hover:text-white hover:underline underline-offset-4">Articles Archive</a></li>
          <li><a href="/rss.xml" class="text-slate-300 transition-colors hover:text-white hover:underline underline-offset-4">RSS Feed 2.0</a></li>
          <li><a href="/sitemap.xml" class="text-slate-300 transition-colors hover:text-white hover:underline underline-offset-4">XML Sitemap</a></li>
        </ul>
      </div>

    </div>

    <!-- Bottom Bar -->
    <div class="mt-14 border-t border-slate-800/80 pt-8 flex flex-col items-center justify-between gap-4 text-xs text-slate-400 sm:flex-row">
      <p>
        © {currentYear} Micro Signal Cosmos. All rights reserved.
      </p>

      <div class="flex flex-wrap items-center gap-6">
        <a href="/privacy-policy/" class="hover:text-white transition-colors">Privacy</a>
        <a href="/terms/" class="hover:text-white transition-colors">Terms</a>
        <a href="/disclaimer/" class="hover:text-white transition-colors">Disclaimer</a>
        <a href="/contact/" class="hover:text-white transition-colors">Contact Desk</a>
      </div>
    </div>

  </div>
</footer>
