---
import AdSlot from './AdSlot.astro';

export interface Props {
  adUnitId?: string;
  className?: string;
}

const { adUnitId, className = '' } = Astro.props;
---

<div class={`sidebar-ad-wrapper hidden lg:block ${className}`}>
  <AdSlot
    slot="sidebar"
    format="vertical"
    adUnitId={adUnitId}
    className="sticky top-24"
  />
</div>

