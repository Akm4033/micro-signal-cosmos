---
import { isSlotEnabled, monetizationConfig } from '../../config/monetization';

export interface Props {
  slot: 'above-fold' | 'in-content' | 'post-article' | 'sidebar' | 'homepage';
  format?: 'horizontal' | 'rectangle' | 'vertical' | 'responsive';
  adUnitId?: string;
  className?: string;
}

const {
  slot,
  format = 'responsive',
  adUnitId = 'auto',
  className = '',
} = Astro.props;

const enabled = isSlotEnabled(slot);
const clientId = monetizationConfig.ads.adsenseClientId;

// Dimension classes to reserve layout space and minimize CLS ONLY when enabled
let sizeClasses = 'min-h-[100px] sm:min-h-[120px] max-w-full';
if (format === 'rectangle') {
  sizeClasses = 'min-h-[250px] max-w-[336px] mx-auto';
} else if (format === 'vertical') {
  sizeClasses = 'min-h-[600px] max-w-[300px] mx-auto';
} else if (format === 'horizontal') {
  sizeClasses = 'min-h-[90px] sm:min-h-[120px] max-w-[728px] mx-auto';
}
---

{enabled && clientId ? (
  <aside
    class={`ad-slot ad-slot-${slot} my-8 w-full overflow-hidden text-center transition-all ${className}`}
    aria-label="Advertisement"
    data-ad-slot={slot}
  >
    <!-- Policy-compliant micro-label -->
    <div class="mb-1.5 flex items-center justify-center gap-2">
      <span class="h-px w-8 bg-[#E3E8EF]"></span>
      <span class="text-[10px] font-semibold tracking-widest text-[#9AA4B2] uppercase">
        Advertisement
      </span>
      <span class="h-px w-8 bg-[#E3E8EF]"></span>
    </div>

    <!-- Ad Frame with reserved layout height to prevent CLS -->
    <div
      class={`ad-frame relative flex items-center justify-center rounded-xl border border-dashed border-[#E3E8EF] bg-[#F8FAFC] ${sizeClasses}`}
    >
      <ins
        class="adsbygoogle"
        style="display:block; width:100%; height:100%;"
        data-ad-client={clientId}
        data-ad-slot={adUnitId}
        data-ad-format={format === 'rectangle' ? 'rectangle' : format === 'vertical' ? 'vertical' : 'auto'}
        data-full-width-responsive="true"
      ></ins>
      <script is:inline>
        (adsbygoogle = window.adsbygoogle || []).push({});
      </script>
    </div>
  </aside>
) : null}

