<!-- JAVASCRIPT: CLEAN, DETERMINISTIC, ZERO-DEPENDENCY ENGINE -->
<!-- ========================================================================= -->
<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    // -------------------------------------------------------------------------
    // TAB SWITCHING LOGIC
    // -------------------------------------------------------------------------
    const tabBtns = document.querySelectorAll('.calc-tab-btn');
    const panels = document.querySelectorAll('.calc-panel');

    tabBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const targetId = btn.getAttribute('data-target');

        tabBtns.forEach(b => {
          b.setAttribute('aria-selected', 'false');
          b.className = 'calc-tab-btn rounded-lg px-3.5 py-1.5 text-xs font-semibold transition-all text-slate-600 hover:text-slate-900 dark:text-slate-400 dark:hover:text-white';
        });

        btn.setAttribute('aria-selected', 'true');
        btn.className = 'calc-tab-btn rounded-lg px-3.5 py-1.5 text-xs font-semibold transition-all bg-white text-slate-900 shadow-xs dark:bg-blue-600 dark:text-white';

        panels.forEach(p => {
          if (p.id === targetId) {
            p.classList.remove('hidden');
          } else {
            p.classList.add('hidden');
          }
        });
      });
    });

    // -------------------------------------------------------------------------
    // 1. AI TOKEN & INFERENCE COST CALCULATOR LOGIC
    // -------------------------------------------------------------------------
    const aiModelSelect = document.getElementById('ai-model-select');
    const aiInputTokens = document.getElementById('ai-input-tokens');
    const aiOutputTokens = document.getElementById('ai-output-tokens');
    const aiRequests = document.getElementById('ai-requests');

    const aiInputDisplay = document.getElementById('ai-input-display');
    const aiOutputDisplay = document.getElementById('ai-output-display');
    const aiRequestsDisplay = document.getElementById('ai-requests-display');

    const aiCostSingle = document.getElementById('ai-cost-single');
    const aiCostBreakdown = document.getElementById('ai-cost-breakdown');
    const aiCostDaily = document.getElementById('ai-cost-daily');
    const aiCostMonthly = document.getElementById('ai-cost-monthly');
    const aiMonthlyTokens = document.getElementById('ai-monthly-tokens');

    function updateAiCalculator() {
      if (!aiModelSelect || !aiInputTokens) return;

      const selectedOption = aiModelSelect.options[aiModelSelect.selectedIndex];
      const costPerMillionInput = parseFloat(selectedOption.getAttribute('data-input')) || 3.0;
      const costPerMillionOutput = parseFloat(selectedOption.getAttribute('data-output')) || 15.0;

      const inputTokens = parseInt(aiInputTokens.value, 10) || 0;
      const outputTokens = parseInt(aiOutputTokens.value, 10) || 0;
      const dailyReqs = parseInt(aiRequests.value, 10) || 0;

      aiInputDisplay.textContent = inputTokens.toLocaleString() + ' tokens';
      aiOutputDisplay.textContent = outputTokens.toLocaleString() + ' tokens';
      aiRequestsDisplay.textContent = dailyReqs.toLocaleString() + ' req/day';

      const promptCost = (inputTokens / 1_000_000) * costPerMillionInput;
      const completionCost = (outputTokens / 1_000_000) * costPerMillionOutput;
      const totalSingleCost = promptCost + completionCost;

      const dailyCost = totalSingleCost * dailyReqs;
      const monthlyCost = dailyCost * 30;

      const totalMonthlyTokens = (inputTokens + outputTokens) * dailyReqs * 30;
      const millionsMonthlyTokens = totalMonthlyTokens / 1_000_000;

      aiCostSingle.textContent = '$' + totalSingleCost.toFixed(4);
      aiCostBreakdown.textContent = `Prompt: $${promptCost.toFixed(4)} • Completion: $${completionCost.toFixed(4)}`;
      aiCostDaily.textContent = '$' + dailyCost.toFixed(2);
      aiCostMonthly.textContent = '$' + monthlyCost.toFixed(2);
      aiMonthlyTokens.textContent = millionsMonthlyTokens.toFixed(2) + ' Million Tokens';
    }

    if (aiModelSelect) {
      aiModelSelect.addEventListener('change', updateAiCalculator);
      aiInputTokens.addEventListener('input', updateAiCalculator);
      aiOutputTokens.addEventListener('input', updateAiCalculator);
      aiRequests.addEventListener('input', updateAiCalculator);

      // Setup preset chip click listeners
      document.querySelectorAll('#ai-prompt-chips .ai-chip').forEach(btn => {
        btn.addEventListener('click', () => {
          aiInputTokens.value = btn.getAttribute('data-val');
          updateAiCalculator();
          highlightChip('#ai-prompt-chips', btn);
        });
      });

      document.querySelectorAll('#ai-output-chips .ai-chip').forEach(btn => {
        btn.addEventListener('click', () => {
          aiOutputTokens.value = btn.getAttribute('data-val');
          updateAiCalculator();
          highlightChip('#ai-output-chips', btn);
        });
      });

      document.querySelectorAll('#ai-req-chips .ai-chip').forEach(btn => {
        btn.addEventListener('click', () => {
          aiRequests.value = btn.getAttribute('data-val');
          updateAiCalculator();
          highlightChip('#ai-req-chips', btn);
        });
      });

      function highlightChip(containerSelector, activeBtn) {
        document.querySelectorAll(containerSelector + ' .ai-chip').forEach(b => {
          b.className = 'ai-chip rounded-md border border-slate-200 bg-slate-50 px-2.5 py-1 text-xs font-mono text-slate-600 hover:border-blue-500 hover:text-blue-600 dark:border-white/[0.08] dark:bg-white/[0.04] dark:text-slate-300';
        });
        activeBtn.className = 'ai-chip rounded-md border border-blue-500 bg-blue-50 px-2.5 py-1 text-xs font-mono text-blue-700 font-bold dark:border-blue-500 dark:bg-blue-950/60 dark:text-blue-300';
      }

      updateAiCalculator();
    }

    // -------------------------------------------------------------------------
    // 2. NETWORK BDP CALCULATOR LOGIC
    // -------------------------------------------------------------------------
    const netBandwidth = document.getElementById('net-bandwidth');
    const netBandwidthUnit = document.getElementById('net-bandwidth-unit');
    const netRtt = document.getElementById('net-rtt');
    const netRttDisplay = document.getElementById('net-rtt-display');
    const netBdpBytes = document.getElementById('net-bdp-bytes');
    const netBdpBits = document.getElementById('net-bdp-bits');
    const netBufferRec = document.getElementById('net-buffer-rec');
    const netTransferTime = document.getElementById('net-transfer-time');
    const netPresetBtns = document.querySelectorAll('.net-preset-btn');

    function updateNetworkCalculator() {
      if (!netBandwidth || !netRtt) return;

      const rawBw = parseFloat(netBandwidth.value) || 0;
      const unit = netBandwidthUnit.value;
      const totalMbps = unit === 'gbps' ? rawBw * 1000 : rawBw;
      const rttMs = parseFloat(netRtt.value) || 0;

      netRttDisplay.textContent = rttMs + ' ms';

      const bdpBits = (totalMbps * 1_000_000) * (rttMs / 1000);
      const bdpBytes = bdpBits / 8;

      let bdpDisplay = '';
      if (bdpBytes >= 1_073_741_824) {
        bdpDisplay = (bdpBytes / 1_073_741_824).toFixed(2) + ' GB';
      } else if (bdpBytes >= 1_048_576) {
        bdpDisplay = (bdpBytes / 1_048_576).toFixed(2) + ' MB';
      } else {
        bdpDisplay = (bdpBytes / 1024).toFixed(1) + ' KB';
      }

      netBdpBytes.textContent = bdpDisplay;
      netBdpBits.textContent = (bdpBits / 1_000_000).toFixed(1) + ' Megabits in flight';

      const recBuffer = bdpBytes * 2;
      let recDisplay = '';
      if (recBuffer >= 1_048_576) {
        recDisplay = '~' + (recBuffer / 1_048_576).toFixed(2) + ' MB (2× BDP)';
      } else {
        recDisplay = '~' + (recBuffer / 1024).toFixed(1) + ' KB (2× BDP)';
      }
      netBufferRec.textContent = recDisplay;

      const secToTransfer = (8192 / (totalMbps || 1)) + (rttMs / 1000);
      if (secToTransfer < 1) {
        netTransferTime.textContent = (secToTransfer * 1000).toFixed(0) + ' milliseconds';
      } else {
        netTransferTime.textContent = secToTransfer.toFixed(2) + ' seconds';
      }
    }

    if (netBandwidth) {
      netBandwidth.addEventListener('input', updateNetworkCalculator);
      netBandwidthUnit.addEventListener('change', updateNetworkCalculator);
      netRtt.addEventListener('input', updateNetworkCalculator);

      netPresetBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          netBandwidth.value = btn.getAttribute('data-bw');
          netBandwidthUnit.value = btn.getAttribute('data-unit');
          netRtt.value = btn.getAttribute('data-rtt');
          updateNetworkCalculator();

          netPresetBtns.forEach(b => {
            b.className = 'net-preset-btn rounded-lg border border-slate-200 bg-slate-50 p-2 text-left text-xs hover:border-blue-500 dark:border-white/[0.08] dark:bg-white/[0.04] dark:hover:border-blue-400 transition-colors';
          });
          btn.className = 'net-preset-btn rounded-lg border border-blue-500 bg-blue-50 p-2 text-left text-xs dark:border-blue-500 dark:bg-blue-950/60 transition-colors';
        });
      });

      updateNetworkCalculator();
    }

    // -------------------------------------------------------------------------
    // 3. COSMIC REDSHIFT CALCULATOR LOGIC
    // -------------------------------------------------------------------------
    const astroZExact = document.getElementById('astro-z-exact');
    const astroZDisplay = document.getElementById('astro-z-display');
    const astroLookback = document.getElementById('astro-lookback');
    const astroAge = document.getElementById('astro-age');
    const astroStretch = document.getElementById('astro-stretch');
    const astroVelocity = document.getElementById('astro-velocity');
    const astroStepDown = document.getElementById('astro-step-down');
    const astroStepUp = document.getElementById('astro-step-up');
    const astroPresetBtns = document.querySelectorAll('.astro-preset-btn');

    function calculateLookbackTime(z) {
      const H0 = 67.4;
      const Om = 0.315;
      const Ol = 0.685;
      const Th = 977.8 / H0;

      const steps = 100;
      const dz = z / steps;
      let integral = 0;
      for (let i = 0; i < steps; i++) {
        const zp = (i + 0.5) * dz;
        const Ez = Math.sqrt(Om * Math.pow(1 + zp, 3) + Ol);
        integral += dz / ((1 + zp) * Ez);
      }
      return Th * integral;
    }

    function updateAstroCalculator() {
      if (!astroZExact) return;
      let z = parseFloat(astroZExact.value) || 0.001;
      if (z < 0.0001) z = 0.0001;

      astroZDisplay.textContent = 'z = ' + z.toFixed(3);

      const stretch = 1 + z;
      astroStretch.textContent = `${stretch.toFixed(3)}× (${(z * 100).toFixed(0)}% stretch)`;

      const zPlusOneSq = Math.pow(1 + z, 2);
      const beta = (zPlusOneSq - 1) / (zPlusOneSq + 1);
      const velKmS = beta * 299792;
      astroVelocity.textContent = `${Math.round(velKmS).toLocaleString()} km/s (${beta.toFixed(3)} c)`;

      const totalAge = 13.8;
      let lookback = calculateLookbackTime(z);
      if (lookback > 13.75) lookback = 13.75;
      const universeAge = Math.max(0.05, totalAge - lookback);

      astroLookback.textContent = lookback.toFixed(2) + ' Billion Years';
      astroAge.textContent = `Universe was ~${universeAge.toFixed(2)} Gyr old at emission`;
    }

    if (astroZExact) {
      astroZExact.addEventListener('input', updateAstroCalculator);

      astroStepDown?.addEventListener('click', () => {
        let cur = parseFloat(astroZExact.value) || 1.0;
        cur = Math.max(0.01, cur - 0.5);
        astroZExact.value = cur.toFixed(3);
        updateAstroCalculator();
      });

      astroStepUp?.addEventListener('click', () => {
        let cur = parseFloat(astroZExact.value) || 1.0;
        cur = cur + 0.5;
        astroZExact.value = cur.toFixed(3);
        updateAstroCalculator();
      });

      astroPresetBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          const zVal = parseFloat(btn.getAttribute('data-z'));
          astroZExact.value = zVal.toFixed(3);
          updateAstroCalculator();

          astroPresetBtns.forEach(b => {
            b.className = 'astro-preset-btn rounded-lg border border-slate-200 bg-slate-50 p-2 text-left text-xs hover:border-purple-500 dark:border-white/[0.08] dark:bg-white/[0.04] dark:hover:border-purple-400 transition-colors';
          });
          btn.className = 'astro-preset-btn rounded-lg border border-purple-500 bg-purple-50 p-2 text-left text-xs dark:border-purple-500 dark:bg-purple-950/60 transition-colors';
        });
      });

      updateAstroCalculator();
    }
  });
</script>
