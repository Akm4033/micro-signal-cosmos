            </button>
            <button type="button" class="astro-preset-btn rounded-lg border border-slate-200 bg-slate-50 p-2 text-left text-xs hover:border-purple-500 dark:border-white/[0.08] dark:bg-white/[0.04] dark:hover:border-purple-400 transition-colors" data-z="10.603">
              <span class="font-bold block text-slate-900 dark:text-white">JWST GN-z11</span>
