---
// InteractiveCalculators.astro — Signal Insight Engineering Calculators
// Client-side, zero-dependency, high-precision technical utilities.
// 100% Slider-free: utilizes quick preset chips & number inputs to eliminate horizontal track overflows permanently.
---

<div class="my-10 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm dark:border-white/[0.08] dark:bg-[#0B101D] sm:p-8 overflow-hidden w-full max-w-full" id="engineering-calculators">
  <!-- Header -->
  <div class="mb-8 flex flex-col justify-between gap-4 border-b border-slate-200 pb-6 dark:border-white/[0.08] sm:flex-row sm:items-center">
    <div>
      <div class="inline-flex items-center gap-2 rounded-full border border-blue-500/20 bg-blue-500/10 px-3 py-0.5 text-xs font-semibold text-blue-600 dark:text-blue-400 font-mono">
        <span class="h-1.5 w-1.5 rounded-full bg-blue-500 animate-pulse"></span>
        <span>Interactive Systems Workbench</span>
      </div>
      <h2 class="mt-2 text-2xl font-bold tracking-tight text-slate-900 dark:text-white">
        Signal Insight Engineering Workbench
      </h2>
      <p class="mt-1 text-sm text-slate-600 dark:text-slate-400">
        Deterministic technical calculators computed instantly in your browser. Zero tracking, zero network requests.
      </p>
    </div>

    <!-- Tab Buttons -->
    <div class="flex flex-wrap gap-1 rounded-xl bg-slate-100 p-1 dark:bg-white/[0.04]" role="tablist" aria-label="Engineering Calculators">
      <button
        type="button"
        role="tab"
        aria-selected="true"
        aria-controls="calc-ai-panel"
        id="calc-ai-tab"
        class="calc-tab-btn rounded-lg px-3.5 py-1.5 text-xs font-semibold transition-all bg-white text-slate-900 shadow-xs dark:bg-blue-600 dark:text-white"
        data-target="calc-ai-panel"
      >
        AI Inference Cost
      </button>
      <button
        type="button"
        role="tab"
        aria-selected="false"
        aria-controls="calc-network-panel"
        id="calc-network-tab"
        class="calc-tab-btn rounded-lg px-3.5 py-1.5 text-xs font-semibold transition-all text-slate-600 hover:text-slate-900 dark:text-slate-400 dark:hover:text-white"
        data-target="calc-network-panel"
      >
        Network BDP Sizer
      </button>
      <button
        type="button"
        role="tab"
        aria-selected="false"
        aria-controls="calc-astro-panel"
        id="calc-astro-tab"
        class="calc-tab-btn rounded-lg px-3.5 py-1.5 text-xs font-semibold transition-all text-slate-600 hover:text-slate-900 dark:text-slate-400 dark:hover:text-white"
        data-target="calc-astro-panel"
      >
        Cosmic Redshift (z)
      </button>
    </div>
  </div>

  <!-- ========================================================================= -->
  <!-- 1. AI INFERENCE COST & TOKEN CALCULATOR (SLIDER-FREE CHIP INTERFACE) -->
  <!-- ========================================================================= -->
  <div id="calc-ai-panel" role="tabpanel" aria-labelledby="calc-ai-tab" class="calc-panel">
    <div class="grid gap-8 lg:grid-cols-2 items-start w-full min-w-0">
      <!-- Input Controls -->
      <div class="space-y-6 w-full min-w-0">
        <!-- Model Selection -->
        <div>
          <label for="ai-model-select" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 font-mono">
            Target Model Architecture
          </label>
          <select
            id="ai-model-select"
            class="mt-2 block w-full rounded-xl border border-slate-300 bg-white px-3.5 py-2.5 text-sm text-slate-900 shadow-xs focus:border-blue-500 focus:outline-hidden focus:ring-1 focus:ring-blue-500 dark:border-white/[0.1] dark:bg-[#121826] dark:text-white"
          >
            <option value="deepseek-v3" data-input="0.14" data-output="0.28">DeepSeek-V3 ($0.14 / $0.28 per 1M)</option>
            <option value="deepseek-r1" data-input="0.55" data-output="2.19">DeepSeek-R1 Reasoning ($0.55 / $2.19 per 1M)</option>
            <option value="gpt-4o" data-input="2.50" data-output="10.00">OpenAI GPT-4o ($2.50 / $10.00 per 1M)</option>
            <option value="gpt-4o-mini" data-input="0.15" data-output="0.60">OpenAI GPT-4o-mini ($0.15 / $0.60 per 1M)</option>
            <option value="claude-sonnet" data-input="3.00" data-output="15.00" selected>Anthropic Claude 3.5 Sonnet ($3.00 / $15.00 per 1M)</option>
            <option value="gemini-flash" data-input="0.075" data-output="0.30">Google Gemini 1.5 Flash ($0.075 / $0.30 per 1M)</option>
            <option value="llama-70b" data-input="0.59" data-output="0.79">Meta Llama 3.3 70B (Hosted/Groq) ($0.59 / $0.79 per 1M)</option>
          </select>
        </div>

        <!-- Prompt Tokens: Number Input & Preset Chips -->
        <div>
          <div class="flex items-center justify-between text-xs font-semibold mb-2">
            <label for="ai-input-tokens" class="text-slate-700 dark:text-slate-300">
              Avg Prompt / Context Tokens
            </label>
            <span id="ai-input-display" class="font-mono text-blue-600 dark:text-blue-400">1,500 tokens</span>
          </div>
          <div class="flex items-center gap-2 mb-2">
            <input
              type="number"
              id="ai-input-tokens"
              min="1"
              max="2000000"
              value="1500"
              class="w-full rounded-xl border border-slate-300 bg-white px-3.5 py-2 text-sm text-slate-900 shadow-xs focus:border-blue-500 focus:outline-hidden dark:border-white/[0.1] dark:bg-[#121826] dark:text-white font-mono"
            />
          </div>
          <!-- Preset Chips (Fast 1-Click Sizing) -->
          <div class="flex flex-wrap gap-1.5" id="ai-prompt-chips">
            <button type="button" class="ai-chip rounded-md border border-slate-200 bg-slate-50 px-2.5 py-1 text-xs font-mono text-slate-600 hover:border-blue-500 hover:text-blue-600 dark:border-white/[0.08] dark:bg-white/[0.04] dark:text-slate-300" data-val="500">500</button>
            <button type="button" class="ai-chip rounded-md border border-blue-500 bg-blue-50 px-2.5 py-1 text-xs font-mono text-blue-700 font-bold dark:border-blue-500 dark:bg-blue-950/60 dark:text-blue-300" data-val="1500">1.5k</button>
            <button type="button" class="ai-chip rounded-md border border-slate-200 bg-slate-50 px-2.5 py-1 text-xs font-mono text-slate-600 hover:border-blue-500 hover:text-blue-600 dark:border-white/[0.08] dark:bg-white/[0.04] dark:text-slate-300" data-val="4000">4k</button>
            <button type="button" class="ai-chip rounded-md border border-slate-200 bg-slate-50 px-2.5 py-1 text-xs font-mono text-slate-600 hover:border-blue-500 hover:text-blue-600 dark:border-white/[0.08] dark:bg-white/[0.04] dark:text-slate-300" data-val="16000">16k</button>
            <button type="button" class="ai-chip rounded-md border border-slate-200 bg-slate-50 px-2.5 py-1 text-xs font-mono text-slate-600 hover:border-blue-500 hover:text-blue-600 dark:border-white/[0.08] dark:bg-white/[0.04] dark:text-slate-300" data-val="32000">32k</button>
            <button type="button" class="ai-chip rounded-md border border-slate-200 bg-slate-50 px-2.5 py-1 text-xs font-mono text-slate-600 hover:border-blue-500 hover:text-blue-600 dark:border-white/[0.08] dark:bg-white/[0.04] dark:text-slate-300" data-val="128000">128k</button>
          </div>
        </div>

        <!-- Completion Tokens: Number Input & Preset Chips -->
        <div>
          <div class="flex items-center justify-between text-xs font-semibold mb-2">
            <label for="ai-output-tokens" class="text-slate-700 dark:text-slate-300">
              Avg Completion / Output Tokens
            </label>
            <span id="ai-output-display" class="font-mono text-blue-600 dark:text-blue-400">600 tokens</span>
          </div>
          <div class="flex items-center gap-2 mb-2">
            <input
              type="number"
              id="ai-output-tokens"
              min="1"
              max="64000"
              value="600"
              class="w-full rounded-xl border border-slate-300 bg-white px-3.5 py-2 text-sm text-slate-900 shadow-xs focus:border-blue-500 focus:outline-hidden dark:border-white/[0.1] dark:bg-[#121826] dark:text-white font-mono"
            />
          </div>
          <div class="flex flex-wrap gap-1.5" id="ai-output-chips">
            <button type="button" class="ai-chip rounded-md border border-slate-200 bg-slate-50 px-2.5 py-1 text-xs font-mono text-slate-600 hover:border-blue-500 hover:text-blue-600 dark:border-white/[0.08] dark:bg-white/[0.04] dark:text-slate-300" data-val="100">100</button>
            <button type="button" class="ai-chip rounded-md border border-slate-200 bg-slate-50 px-2.5 py-1 text-xs font-mono text-slate-600 hover:border-blue-500 hover:text-blue-600 dark:border-white/[0.08] dark:bg-white/[0.04] dark:text-slate-300" data-val="300">300</button>
            <button type="button" class="ai-chip rounded-md border border-blue-500 bg-blue-50 px-2.5 py-1 text-xs font-mono text-blue-700 font-bold dark:border-blue-500 dark:bg-blue-950/60 dark:text-blue-300" data-val="600">600</button>
            <button type="button" class="ai-chip rounded-md border border-slate-200 bg-slate-50 px-2.5 py-1 text-xs font-mono text-slate-600 hover:border-blue-500 hover:text-blue-600 dark:border-white/[0.08] dark:bg-white/[0.04] dark:text-slate-300" data-val="1500">1.5k</button>
            <button type="button" class="ai-chip rounded-md border border-slate-200 bg-slate-50 px-2.5 py-1 text-xs font-mono text-slate-600 hover:border-blue-500 hover:text-blue-600 dark:border-white/[0.08] dark:bg-white/[0.04] dark:text-slate-300" data-val="4000">4k</button>
          </div>
        </div>

        <!-- Daily Volume: Number Input & Preset Chips -->
        <div>
          <div class="flex items-center justify-between text-xs font-semibold mb-2">
            <label for="ai-requests" class="text-slate-700 dark:text-slate-300">
              Daily Request Volume
            </label>
            <span id="ai-requests-display" class="font-mono text-blue-600 dark:text-blue-400">1,000 req/day</span>
          </div>
          <div class="flex items-center gap-2 mb-2">
            <input
              type="number"
              id="ai-requests"
              min="1"
              max="10000000"
              value="1000"
              class="w-full rounded-xl border border-slate-300 bg-white px-3.5 py-2 text-sm text-slate-900 shadow-xs focus:border-blue-500 focus:outline-hidden dark:border-white/[0.1] dark:bg-[#121826] dark:text-white font-mono"
            />
          </div>
          <div class="flex flex-wrap gap-1.5" id="ai-req-chips">
            <button type="button" class="ai-chip rounded-md border border-slate-200 bg-slate-50 px-2.5 py-1 text-xs font-mono text-slate-600 hover:border-blue-500 hover:text-blue-600 dark:border-white/[0.08] dark:bg-white/[0.04] dark:text-slate-300" data-val="100">100 req</button>
            <button type="button" class="ai-chip rounded-md border border-blue-500 bg-blue-50 px-2.5 py-1 text-xs font-mono text-blue-700 font-bold dark:border-blue-500 dark:bg-blue-950/60 dark:text-blue-300" data-val="1000">1k req</button>
            <button type="button" class="ai-chip rounded-md border border-slate-200 bg-slate-50 px-2.5 py-1 text-xs font-mono text-slate-600 hover:border-blue-500 hover:text-blue-600 dark:border-white/[0.08] dark:bg-white/[0.04] dark:text-slate-300" data-val="5000">5k req</button>
            <button type="button" class="ai-chip rounded-md border border-slate-200 bg-slate-50 px-2.5 py-1 text-xs font-mono text-slate-600 hover:border-blue-500 hover:text-blue-600 dark:border-white/[0.08] dark:bg-white/[0.04] dark:text-slate-300" data-val="25000">25k req</button>
            <button type="button" class="ai-chip rounded-md border border-slate-200 bg-slate-50 px-2.5 py-1 text-xs font-mono text-slate-600 hover:border-blue-500 hover:text-blue-600 dark:border-white/[0.08] dark:bg-white/[0.04] dark:text-slate-300" data-val="100000">100k req</button>
          </div>
        </div>
      </div>

      <!-- Live Spend Projection Card -->
      <div class="rounded-xl border border-slate-200 bg-slate-50 p-6 dark:border-white/[0.08] dark:bg-[#121826] w-full min-w-0">
        <h3 class="text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400 font-mono">
          Inference Spend Projection
        </h3>

        <!-- Cost Per Single Request -->
        <div class="mt-4 rounded-lg bg-white p-4 border border-slate-200/80 dark:bg-white/[0.04] dark:border-white/[0.06]">
          <span class="text-xs text-slate-500 dark:text-slate-400">Cost Per Single Request</span>
          <div class="mt-1 text-2xl font-black tracking-tight text-slate-900 dark:text-white" id="ai-cost-single">
            $0.0135
          </div>
          <div class="mt-1 text-[11px] text-slate-500 dark:text-slate-400 font-mono" id="ai-cost-breakdown">
            Prompt: $0.0045 &bull; Completion: $0.0090
          </div>
        </div>

        <!-- Daily & Monthly Spend Grid -->
        <div class="mt-4 grid grid-cols-2 gap-3">
          <div class="rounded-lg bg-white p-4 border border-slate-200/80 dark:bg-white/[0.04] dark:border-white/[0.06]">
            <span class="text-xs text-slate-500 dark:text-slate-400">Daily Burn</span>
            <div class="mt-1 text-xl font-bold text-slate-900 dark:text-white" id="ai-cost-daily">
              $13.50
            </div>
          </div>
          <div class="rounded-lg bg-white p-4 border border-slate-200/80 dark:bg-white/[0.04] dark:border-white/[0.06]">
            <span class="text-xs text-slate-500 dark:text-slate-400">Monthly Projection (30d)</span>
            <div class="mt-1 text-xl font-black text-blue-600 dark:text-blue-400" id="ai-cost-monthly">
              $405.00
            </div>
          </div>
        </div>

        <!-- Monthly Token Throughput -->
        <div class="mt-4 rounded-lg bg-white p-4 border border-slate-200/80 dark:bg-white/[0.04] dark:border-white/[0.06]">
          <span class="text-xs text-slate-500 dark:text-slate-400">Monthly Total Tokens Processed</span>
          <div class="mt-1 text-lg font-bold font-mono text-slate-900 dark:text-white" id="ai-monthly-tokens">
            63.00 Million Tokens
          </div>
        </div>

        <p class="mt-4 text-[11px] text-slate-500 dark:text-slate-400">
          Explore architecture: <a href="/articles/training-vs-inference-economics/" class="text-blue-600 dark:text-blue-400 hover:underline">Training vs. Inference Economics &rarr;</a>
        </p>
      </div>
    </div>
  </div>

  <!-- ========================================================================= -->
  <!-- 2. NETWORK BDP SIZER (SLIDER-FREE CHIP & NUMBER INTERFACE) -->
  <!-- ========================================================================= -->
  <div id="calc-network-panel" role="tabpanel" aria-labelledby="calc-network-tab" class="calc-panel hidden">
    <div class="grid gap-8 lg:grid-cols-2 items-start w-full min-w-0">
      <!-- Input Controls -->
      <div class="space-y-6 w-full min-w-0">
        <div>
          <span class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 font-mono mb-2">
            Topology Presets
          </span>
          <div class="grid grid-cols-2 sm:grid-cols-3 gap-2">
            <button type="button" class="net-preset-btn rounded-lg border border-slate-200 bg-slate-50 p-2 text-left text-xs hover:border-blue-500 dark:border-white/[0.08] dark:bg-white/[0.04] dark:hover:border-blue-400 transition-colors" data-bw="10000" data-unit="mbps" data-rtt="2">
              <span class="font-bold block text-slate-900 dark:text-white">Local DC</span>
              <span class="text-[10px] text-slate-500 dark:text-slate-400">10G LAN &bull; 2ms</span>
            </button>
            <button type="button" class="net-preset-btn rounded-lg border border-slate-200 bg-slate-50 p-2 text-left text-xs hover:border-blue-500 dark:border-white/[0.08] dark:bg-white/[0.04] dark:hover:border-blue-400 transition-colors" data-bw="1" data-unit="gbps" data-rtt="18">
              <span class="font-bold block text-slate-900 dark:text-white">Metro Cloud</span>
              <span class="text-[10px] text-slate-500 dark:text-slate-400">1G Metro &bull; 18ms</span>
            </button>
            <button type="button" class="net-preset-btn rounded-lg border border-blue-500 bg-blue-50 p-2 text-left text-xs dark:border-blue-500 dark:bg-blue-950/60 transition-colors" data-bw="1" data-unit="gbps" data-rtt="70">
              <span class="font-bold block text-blue-900 dark:text-blue-300">Cross-Country</span>
              <span class="text-[10px] text-blue-700 dark:text-blue-400">1G US-East/West &bull; 70ms</span>
            </button>
            <button type="button" class="net-preset-btn rounded-lg border border-slate-200 bg-slate-50 p-2 text-left text-xs hover:border-blue-500 dark:border-white/[0.08] dark:bg-white/[0.04] dark:hover:border-blue-400 transition-colors" data-bw="10" data-unit="gbps" data-rtt="140">
              <span class="font-bold block text-slate-900 dark:text-white">Transatlantic</span>
              <span class="text-[10px] text-slate-500 dark:text-slate-400">10G NYC-LON &bull; 140ms</span>
            </button>
            <button type="button" class="net-preset-btn rounded-lg border border-slate-200 bg-slate-50 p-2 text-left text-xs hover:border-blue-500 dark:border-white/[0.08] dark:bg-white/[0.04] dark:hover:border-blue-400 transition-colors" data-bw="100" data-unit="gbps" data-rtt="80">
              <span class="font-bold block text-slate-900 dark:text-white">Core Backbone</span>
              <span class="text-[10px] text-slate-500 dark:text-slate-400">100G Fabric &bull; 80ms</span>
            </button>
            <button type="button" class="net-preset-btn rounded-lg border border-slate-200 bg-slate-50 p-2 text-left text-xs hover:border-blue-500 dark:border-white/[0.08] dark:bg-white/[0.04] dark:hover:border-blue-400 transition-colors" data-bw="100" data-unit="mbps" data-rtt="220">
              <span class="font-bold block text-slate-900 dark:text-white">Global Edge</span>
              <span class="text-[10px] text-slate-500 dark:text-slate-400">100M Edge &bull; 220ms</span>
            </button>
          </div>
        </div>

        <!-- Bandwidth Input -->
        <div>
          <label for="net-bandwidth" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 font-mono">
            Network Link Bandwidth
          </label>
          <div class="mt-2 flex gap-2">
            <input
              type="number"
              id="net-bandwidth"
              value="1"
              min="1"
              step="any"
              class="w-full rounded-xl border border-slate-300 bg-white px-3.5 py-2.5 text-sm text-slate-900 shadow-xs focus:border-blue-500 focus:outline-hidden dark:border-white/[0.1] dark:bg-[#121826] dark:text-white font-mono"
            />
            <select
              id="net-bandwidth-unit"
              class="rounded-xl border border-slate-300 bg-white px-3.5 py-2.5 text-sm text-slate-900 shadow-xs focus:border-blue-500 focus:outline-hidden dark:border-white/[0.1] dark:bg-[#121826] dark:text-white font-mono"
            >
              <option value="mbps">Mbps</option>
              <option value="gbps" selected>Gbps</option>
            </select>
          </div>
        </div>

        <!-- Latency Input -->
        <div>
          <div class="flex items-center justify-between text-xs font-semibold mb-2">
            <label for="net-rtt" class="text-slate-700 dark:text-slate-300">
              Round-Trip Time (RTT Latency)
            </label>
            <span id="net-rtt-display" class="font-mono text-blue-600 dark:text-blue-400">70 ms</span>
          </div>
          <div class="flex items-center gap-2">
            <input
              type="number"
              id="net-rtt"
              value="70"
              min="1"
              max="2000"
              class="w-full rounded-xl border border-slate-300 bg-white px-3.5 py-2.5 text-sm text-slate-900 shadow-xs focus:border-blue-500 focus:outline-hidden dark:border-white/[0.1] dark:bg-[#121826] dark:text-white font-mono"
            />
            <span class="text-xs font-mono text-slate-500 dark:text-slate-400 shrink-0">ms</span>
          </div>
        </div>
      </div>

      <!-- Results Card -->
      <div class="rounded-xl border border-slate-200 bg-slate-50 p-6 dark:border-white/[0.08] dark:bg-[#121826] w-full min-w-0">
        <h3 class="text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400 font-mono">
          TCP Buffer &amp; In-Flight Capacity
        </h3>

        <div class="mt-4 rounded-lg bg-white p-4 border border-slate-200/80 dark:bg-white/[0.04] dark:border-white/[0.06]">
          <span class="text-xs text-slate-500 dark:text-slate-400">Bandwidth-Delay Product (BDP)</span>
          <div class="mt-1 text-2xl font-black tracking-tight text-slate-900 dark:text-white font-mono" id="net-bdp-bytes">
            8.75 MB
          </div>
          <div class="mt-1 text-[11px] text-slate-500 dark:text-slate-400 font-mono" id="net-bdp-bits">
            70.0 Megabits in flight
          </div>
        </div>

        <div class="mt-4 rounded-lg bg-white p-4 border border-slate-200/80 dark:bg-white/[0.04] dark:border-white/[0.06]">
          <span class="text-xs text-slate-500 dark:text-slate-400">Recommended TCP Socket Window Size (2× BDP)</span>
          <div class="mt-1 text-xl font-bold text-blue-600 dark:text-blue-400 font-mono" id="net-buffer-rec">
            ~17.50 MB (2× BDP)
          </div>
          <div class="mt-1 text-[10.5px] text-slate-500 dark:text-slate-400">
            Configure via <code class="font-mono text-slate-800 dark:text-slate-200">sysctl net.ipv4.tcp_rmem / tcp_wmem</code>
          </div>
        </div>

        <div class="mt-4 rounded-lg bg-white p-4 border border-slate-200/80 dark:bg-white/[0.04] dark:border-white/[0.06]">
          <span class="text-xs text-slate-500 dark:text-slate-400">Theoretical Transfer Duration (1 GB File)</span>
          <div class="mt-1 text-lg font-bold font-mono text-slate-900 dark:text-white" id="net-transfer-time">
            8.26 seconds
          </div>
        </div>

        <p class="mt-4 text-[11px] text-slate-500 dark:text-slate-400">
          Related guide: <a href="/articles/zero-copy-networking-in-linux-with-io-uring-and-ebpf/" class="text-blue-600 dark:text-blue-400 hover:underline">Zero-Copy Linux Networking with io_uring &rarr;</a>
        </p>
      </div>
    </div>
  </div>

  <!-- ========================================================================= -->
  <!-- 3. COSMIC REDSHIFT CALCULATOR (SLIDER-FREE PRESET & STEPPER INTERFACE) -->
  <!-- ========================================================================= -->
  <div id="calc-astro-panel" role="tabpanel" aria-labelledby="calc-astro-tab" class="calc-panel hidden">
    <div class="grid gap-8 lg:grid-cols-2 items-start w-full min-w-0">
      <!-- Input Controls -->
      <div class="space-y-6 w-full min-w-0">
