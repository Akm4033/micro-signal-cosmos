---
import { CATEGORIES } from '../data/categories';
---

<section id="categories" class="bg-[#0E1628] py-20" aria-labelledby="categories-heading">
  <div class="container-main">

    <!-- Section Heading -->
    <div class="mb-12 max-w-2xl">
      <p class="mb-3 text-xs font-bold tracking-[0.2em] text-sky-400 uppercase">
        Explore Your Interests
      </p>

      <h2 id="categories-heading" class="text-3xl font-bold tracking-tight text-white sm:text-4xl">
        Explore Our <span class="text-sky-400">Categories</span>
      </h2>

      <p class="mt-4 text-sm leading-7 text-slate-400 sm:text-base">
        From scientific discoveries to practical digital skills,
        explore a world of knowledge across our seven core topics.
      </p>
    </div>

    <!-- Category Cards -->
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">

      {CATEGORIES.map((category) => (
        <a
          href={category.href}
          class="group relative overflow-hidden rounded-xl border border-white/10 bg-[#141C2E] p-6 transition-all duration-300 hover:-translate-y-1 hover:border-sky-400/40 hover:bg-[#19263B] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-sky-400"
        >

          <div class="mb-6 flex items-center justify-between">

            <span class:list={[
              'flex h-12 w-12 items-center justify-center rounded-xl border text-sm font-bold',
              category.accent === 'sky'
                ? 'border-sky-400/20 bg-sky-400/10 text-sky-400'
                : 'border-purple-400/20 bg-purple-400/10 text-purple-400',
            ]}>
              {category.icon}
            </span>

            <span class="text-sm font-semibold text-slate-400">
              {category.number}
            </span>

          </div>

          <h3 class="text-lg font-bold text-white transition-colors group-hover:text-sky-400">
            {category.name}
          </h3>

          <p class="mt-3 text-sm leading-7 text-slate-400">
            {category.description}
          </p>

          <div class="mt-6 flex items-center gap-2 text-sm font-semibold text-sky-400">
            Explore Topic
            <span class="transition-transform group-hover:translate-x-1" aria-hidden="true">→</span>
          </div>

          <div class="absolute -bottom-12 -right-12 h-32 w-32 rounded-full bg-sky-400/5 blur-3xl transition-all group-hover:bg-sky-400/10"></div>

        </a>
      ))}

    </div>

  </div>
</section>
