---
import { CATEGORIES } from '../data/categories';
---

<section id="categories" class="bg-white py-16 sm:py-20 border-b border-[#E3E8EF]" aria-labelledby="categories-heading">
  <div class="container-main">

    <!-- Section Header -->
    <div class="mb-12 max-w-2xl">
      <div class="inline-flex items-center gap-2 text-xs font-bold tracking-widest text-[#3478F6] uppercase mb-2">
        <span class="h-1.5 w-1.5 rounded-full bg-[#3478F6]"></span>
        <span>Knowledge Streams</span>
      </div>

      <h2 id="categories-heading" class="text-3xl font-extrabold tracking-tight text-[#14233B] sm:text-4xl">
        Explore Our <span class="text-[#3478F6]">Core Topics</span>
      </h2>

      <p class="mt-3 text-base leading-relaxed text-[#697586]">
        From fundamental scientific research to practical digital tools and artificial intelligence breakthroughs, explore thoughtful analysis across our seven editorial pillars.
      </p>
    </div>

    <!-- 7 Category Cards Grid -->
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">

      {CATEGORIES.map((category) => (
        <a
          href={category.href}
          class="group flex flex-col justify-between rounded-xl border border-[#E3E8EF] bg-[#F7F9FC] p-6 shadow-xs transition-all duration-300 hover:-translate-y-1 hover:bg-white hover:border-[#3478F6] hover:shadow-md focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#3478F6]"
        >
          <div>
            <div class="mb-5 flex items-center justify-between">
              <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-white border border-[#E3E8EF] text-sm font-extrabold text-[#3478F6] shadow-xs group-hover:bg-[#3478F6] group-hover:text-white transition-colors">
                {category.icon}
              </span>

              <span class="text-xs font-bold tracking-wider text-[#697586]">
                Pillar {category.number}
              </span>
            </div>

            <h3 class="text-lg font-bold text-[#14233B] transition-colors group-hover:text-[#3478F6]">
              {category.name}
            </h3>

            <p class="mt-2.5 text-sm leading-relaxed text-[#202938]">
              {category.description}
            </p>
          </div>

          <div class="mt-6 pt-4 border-t border-[#E3E8EF]/80 flex items-center gap-1.5 text-xs font-bold text-[#3478F6]">
            <span>Explore Pillar</span>
            <span class="transition-transform group-hover:translate-x-1" aria-hidden="true">&rarr;</span>
          </div>
        </a>
      ))}

    </div>

  </div>
</section>
