---
import { CATEGORIES } from '../data/categories';
---

<section id="categories" class="bg-white py-14 sm:py-20 border-b border-[#E3E8EF]" aria-labelledby="categories-heading">
  <div class="container-main">

    <!-- Section Header -->
    <div class="mb-12 flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
      <div class="max-w-2xl">
        <div class="inline-flex items-center gap-2 text-xs font-bold tracking-widest text-[#3478F6] uppercase mb-2">
          <span class="h-1.5 w-1.5 rounded-full bg-[#3478F6]"></span>
          <span>Knowledge Streams</span>
        </div>

        <h2 id="categories-heading" class="text-3xl font-extrabold tracking-tight text-[#14233B] sm:text-4xl">
          Explore Our <span class="text-[#3478F6]">Core Topics</span>
        </h2>

        <p class="mt-2 text-sm sm:text-base leading-relaxed text-[#697586]">
          From fundamental scientific research to practical digital tools and artificial intelligence breakthroughs, explore thoughtful analysis across our seven core categories.
        </p>
      </div>

      <a
        href="/articles/"
        class="inline-flex items-center gap-1.5 text-xs font-bold tracking-wider uppercase text-[#3478F6] hover:text-[#2563EB] transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#3478F6] rounded py-1"
      >
        <span>View Full Taxonomy</span>
        <span aria-hidden="true">&rarr;</span>
      </a>
    </div>

    <!-- 8-Card Balanced Editorial Grid (4 cols on lg, 2 cols on sm) -->
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">

      {CATEGORIES.map((category) => (
        <a
          href={category.href}
          class="group flex flex-col justify-between rounded-xl border border-[#E3E8EF] bg-[#F7F9FC] p-6 shadow-2xs transition-all duration-300 hover:-translate-y-1 hover:bg-white hover:border-[#3478F6] hover:shadow-md focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#3478F6]"
        >
          <div>
            <div class="mb-5 flex items-center justify-between">
              <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-white border border-[#E3E8EF] text-xs font-extrabold text-[#3478F6] shadow-xs group-hover:bg-[#3478F6] group-hover:text-white transition-colors">
                {category.icon}
              </span>

              <span class="text-xs font-bold tracking-widest text-[#697586] uppercase">
                Pillar {category.number}
              </span>
            </div>

            <h3 class="text-base font-bold text-[#14233B] transition-colors group-hover:text-[#3478F6]">
              {category.name}
            </h3>

            <p class="mt-2 text-xs leading-relaxed text-[#4B5565] line-clamp-3">
              {category.description}
            </p>
          </div>

          <div class="mt-6 pt-4 border-t border-[#E3E8EF]/80 flex items-center gap-1.5 text-xs font-bold text-[#3478F6]">
            <span>Explore Stream</span>
            <span class="transition-transform group-hover:translate-x-1" aria-hidden="true">&rarr;</span>
          </div>
        </a>
      ))}

      <!-- 8th Balancing Card: Editorial Archive Hub -->
      <a
        href="/articles/"
        class="group flex flex-col justify-between rounded-xl border border-[#14233B] bg-[#14233B] p-6 text-white shadow-xs transition-all duration-300 hover:-translate-y-1 hover:bg-[#101B2D] hover:shadow-md focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#3478F6]"
      >
        <div>
          <div class="mb-5 flex items-center justify-between">
            <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-white/10 border border-white/20 text-xs font-extrabold text-sky-300 shadow-xs group-hover:bg-white/20 transition-colors">
              ALL
            </span>

            <span class="text-xs font-bold tracking-widest text-slate-400 uppercase">
              The Archive
            </span>
          </div>

          <h3 class="text-base font-bold text-white transition-colors group-hover:text-sky-300">
            Complete Topic Index
          </h3>

          <p class="mt-2 text-xs leading-relaxed text-slate-300">
            Search and filter our complete library of guides, practical tutorials, and scientific explanations across all topics.
          </p>
        </div>

        <div class="mt-6 pt-4 border-t border-white/15 flex items-center gap-1.5 text-xs font-bold text-sky-300">
          <span>Search All Articles</span>
          <span class="transition-transform group-hover:translate-x-1" aria-hidden="true">&rarr;</span>
        </div>
      </a>

    </div>

  </div>
</section>
