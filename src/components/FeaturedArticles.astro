---
import { CATEGORIES } from '../data/categories';
import { getFeaturedArticles, getPublishedArticles, type Article } from '../data/articles';

// Retrieve featured and published articles (drafts strictly excluded)
const featuredArticles = await getFeaturedArticles();
const publishedArticles = await getPublishedArticles();

// Resolve primary featured article
const mainFeatured = featuredArticles.length > 0 ? featuredArticles[0] : publishedArticles[0];

// Resolve supporting articles: prefer remaining featured articles, fallback to other published articles
const mainSlug = mainFeatured ? (mainFeatured.data.slug || mainFeatured.id) : '';
const supportingArticles = (
  featuredArticles.length > 1
    ? featuredArticles.slice(1, 3)
    : publishedArticles.filter((a) => (a.data.slug || a.id) !== mainSlug).slice(0, 2)
);

function getCategoryInfo(categoryValue: string) {
  const norm = categoryValue.toLowerCase().trim();
  return (
    CATEGORIES.find((c) => c.slug.toLowerCase() === norm || c.name.toLowerCase() === norm) || {
      name: categoryValue,
      icon: 'MS',
      accent: 'sky' as const,
    }
  );
}

const mainCategoryInfo = mainFeatured ? getCategoryInfo(mainFeatured.data.category) : null;
---

{mainFeatured && (
  <section class="bg-[#0B0F19] py-20" aria-labelledby="featured-heading">
    <div class="container-main">

      <!-- Section Heading -->
      <div class="mb-10 flex flex-col justify-between gap-5 sm:flex-row sm:items-end">
        <div>
          <p class="mb-3 text-xs font-bold tracking-[0.2em] text-[#00D2FF] uppercase">
            Editor's Selection
          </p>

          <h2 id="featured-heading" class="text-3xl font-bold tracking-tight text-white sm:text-4xl">
            Featured <span class="text-[#00D2FF]">Insights</span>
          </h2>

          <p class="mt-3 max-w-xl text-sm leading-7 text-slate-300">
            Explore ideas, discoveries and technologies worth understanding.
          </p>
        </div>

        <a
          href="/articles/"
          class="text-sm font-semibold text-[#00D2FF] transition-colors hover:text-sky-300 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sky-400 rounded"
        >
          Explore all articles →
        </a>
      </div>

      <!-- Featured Article Grid -->
      <div class="grid gap-6 lg:grid-cols-2">

        <!-- Main Featured Article -->
        <article class="group flex flex-col overflow-hidden rounded-2xl border border-white/10 bg-[#151C2E] transition-all duration-300 hover:-translate-y-1 hover:border-sky-400/40">

          <div class="relative flex min-h-64 items-center justify-center overflow-hidden bg-gradient-to-br from-[#15304B] via-[#182441] to-[#281D46] sm:min-h-80">

            <div class="absolute inset-0 opacity-30">
              <div class="absolute left-1/2 top-1/2 h-52 w-52 -translate-x-1/2 -translate-y-1/2 rounded-full border border-sky-400/40"></div>
              <div class="absolute left-1/2 top-1/2 h-36 w-36 -translate-x-1/2 -translate-y-1/2 rounded-full border border-purple-400/50"></div>
              <div class="absolute left-1/2 top-1/2 h-20 w-20 -translate-x-1/2 -translate-y-1/2 rounded-full border border-sky-400/60"></div>
            </div>

            <div class="relative flex h-28 w-28 items-center justify-center rounded-full border border-sky-400/30 bg-sky-400/10 shadow-[0_0_60px_rgba(0,210,255,0.15)]">
              <span class="text-5xl font-bold text-sky-300" aria-hidden="true">
                {mainCategoryInfo?.icon || 'AI'}
              </span>
            </div>

            <span class="absolute left-5 top-5 rounded-full border border-sky-400/30 bg-[#0B0F19]/70 px-3 py-1.5 text-xs font-semibold text-sky-300 backdrop-blur">
              Featured Article
            </span>

          </div>

          <div class="flex flex-1 flex-col p-7">

            <span class="text-xs font-semibold tracking-wider text-[#00D2FF] uppercase">
              {mainCategoryInfo?.name || mainFeatured.data.category}
            </span>

            <h3 class="mt-4 text-2xl font-bold leading-snug text-white transition-colors group-hover:text-sky-300">
              {mainFeatured.data.title}
            </h3>

            <p class="mt-4 text-sm leading-7 text-slate-300">
              {mainFeatured.data.description}
            </p>

            <div class="mt-auto pt-7">
              <a
                href={`/articles/${mainFeatured.data.slug || mainFeatured.id}/`}
                class="inline-flex items-center gap-2 text-sm font-bold text-[#00D2FF] transition-all hover:gap-3 focus-visible:outline-none focus-visible:underline"
              >
                Read Article <span aria-hidden="true">→</span>
              </a>
            </div>

          </div>
        </article>

        <!-- Supporting Articles -->
        <div class="grid gap-6 sm:grid-rows-2">

          {supportingArticles.map((article, idx) => {
            const catInfo = getCategoryInfo(article.data.category);
            const slug = article.data.slug || article.id;
            const number = String(idx + 1).padStart(2, '0');

            return (
              <article class="group flex flex-col overflow-hidden rounded-2xl border border-white/10 bg-[#151C2E] transition-all duration-300 hover:-translate-y-1 hover:border-purple-400/40 sm:flex-row">

                <div class="relative flex min-h-44 items-center justify-center overflow-hidden bg-gradient-to-br from-[#182D46] to-[#252044] sm:min-h-0 sm:w-2/5">
                  <span class="text-6xl font-bold text-white/10">
                    {number}
                  </span>

                  <div class="absolute bottom-4 left-4 h-2 w-2 rounded-full bg-[#00D2FF] shadow-[0_0_15px_#00D2FF]"></div>
                </div>

                <div class="flex flex-1 flex-col p-6">

                  <span
                    class:list={[
                      'text-xs font-semibold tracking-wider uppercase',
                      catInfo.accent === 'purple' ? 'text-purple-400' : 'text-[#00D2FF]',
                    ]}
                  >
                    {catInfo.name}
                  </span>

                  <h3 class="mt-3 text-lg font-bold leading-snug text-white transition-colors group-hover:text-sky-300">
                    {article.data.title}
                  </h3>

                  <p class="mt-3 text-sm leading-6 text-slate-300 line-clamp-2">
                    {article.data.description}
                  </p>

                  <div class="mt-auto pt-5">
                    <a
                      href={`/articles/${slug}/`}
                      class="inline-flex items-center gap-2 text-sm font-semibold text-[#00D2FF] focus-visible:outline-none focus-visible:underline"
                    >
                      Read More <span aria-hidden="true">→</span>
                    </a>
                  </div>

                </div>
              </article>
            );
          })}

        </div>

      </div>

    </div>
  </section>
)}
