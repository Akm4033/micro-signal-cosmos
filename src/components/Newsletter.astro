
<section class="relative isolate overflow-hidden bg-[#111B30] py-20" aria-labelledby="newsletter-heading">

  <!-- Background Effects -->
  <div class="pointer-events-none absolute inset-0 -z-10 overflow-hidden">
    <div class="absolute -right-20 -top-32 h-80 w-80 rounded-full bg-sky-500/10 blur-[100px]"></div>
    <div class="absolute -bottom-32 -left-20 h-80 w-80 rounded-full bg-purple-500/10 blur-[100px]"></div>
  </div>

  <div class="container-main">

    <div class="mx-auto max-w-3xl text-center">

      <!-- Label -->
      <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-purple-400/20 bg-purple-400/5 px-4 py-2">
        <span class="text-xs font-semibold tracking-wider text-purple-300 uppercase">
          Stay Curious
        </span>
      </div>

      <!-- Heading -->
      <h2 id="newsletter-heading" class="text-3xl font-bold leading-tight tracking-tight text-white sm:text-4xl lg:text-5xl">
        Knowledge Worth
        <span class="bg-gradient-to-r from-sky-400 to-purple-400 bg-clip-text text-transparent">
          Discovering.
        </span>
      </h2>

      <!-- Description -->
      <p class="mx-auto mt-6 max-w-2xl text-sm leading-8 text-slate-400 sm:text-base">
        Stay connected with the latest ideas in technology, science and
        artificial intelligence. Explore new perspectives and never stop learning.
      </p>

      <!-- Newsletter Visual -->
      <div class="mx-auto mt-9 flex h-16 w-16 items-center justify-center rounded-2xl border border-sky-400/20 bg-sky-400/10">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="30"
          height="30"
          viewBox="0 0 24 24"
          fill="none"
          stroke="#38BDF8"
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <rect x="3" y="5" width="18" height="14" rx="2"/>
          <path d="m3 7 9 6 9-6"/>
        </svg>
      </div>

      <!-- Future Subscription Note -->
      <div class="mx-auto mt-8 max-w-xl rounded-xl border border-white/10 bg-[#0B1020]/60 px-6 py-5">
        <p class="text-sm font-semibold text-white">
          A newsletter is coming soon.
        </p>

        <p class="mt-2 text-sm leading-7 text-slate-400">
          We're preparing a useful, reader-focused newsletter.
          Subscription will be available once our email service is configured.
        </p>
      </div>

      <!-- Supporting Text -->
      <p class="mt-6 text-xs text-slate-400">
        Thoughtful content. Useful knowledge. No unnecessary noise.
      </p>

    </div>

  </div>

</section>
