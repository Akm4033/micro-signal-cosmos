---
export interface Props {
  className?: string;
  leadMagnetTitle?: string;
}

const {
  className = '',
  leadMagnetTitle = 'Technical Deep-Dive Checklist & Architecture Sheet',
} = Astro.props;
---

<aside
  class={`newsletter-inline my-10 rounded-2xl border border-blue-200/80 bg-gradient-to-br from-blue-50/70 to-slate-50 p-6 sm:p-8 dark:border-blue-900/60 dark:from-blue-950/40 dark:to-slate-900/40 ${className}`}
  aria-label="Subscribe to technical guides"
>
  <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6">
    <div class="space-y-2 max-w-xl">
      <div class="inline-flex items-center gap-1.5 rounded-full bg-blue-100/80 px-2.5 py-0.5 text-[11px] font-bold text-blue-700 uppercase tracking-wider dark:bg-blue-900/50 dark:text-blue-300">
        <span>CURION Knowledge Stream</span>
      </div>
      <h3 class="text-lg font-bold text-slate-900 dark:text-white">
        Enjoying this technical investigation?
      </h3>
      <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
        Follow our open RSS 2.0 feed for weekly architectural breakdowns, reproducible code, and science research.
      </p>
    </div>

    <div class="w-full sm:w-auto flex flex-col sm:flex-row items-stretch sm:items-center gap-2.5 shrink-0">
      <button
        id="inline-copy-rss-btn"
        type="button"
        class="rounded-xl bg-blue-600 px-4 py-2.5 text-xs font-bold uppercase tracking-wider text-white shadow-xs transition-all hover:bg-blue-700 active:translate-y-0.5 cursor-pointer inline-flex items-center justify-center gap-2"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M4 11a9 9 0 0 1 9 9"></path>
          <path d="M4 4a16 16 0 0 1 16 16"></path>
          <circle cx="5" cy="19" r="1"></circle>
        </svg>
        <span id="inline-copy-rss-text">Copy RSS Feed</span>
      </button>

      <a
        href="/rss.xml"
        target="_blank"
        class="rounded-xl border border-slate-300 bg-white px-4 py-2.5 text-xs font-bold uppercase tracking-wider text-slate-700 hover:bg-slate-50 transition-colors text-center dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200"
      >
        View /rss.xml
      </a>
    </div>
  </div>
</aside>

<script is:inline>
  (function() {
    const btn = document.getElementById('inline-copy-rss-btn');
    const text = document.getElementById('inline-copy-rss-text');
    if (!btn || !text) return;

    btn.addEventListener('click', async () => {
      const feedUrl = window.location.origin + '/rss.xml';
      try {
        await navigator.clipboard.writeText(feedUrl);
        text.textContent = 'Feed Copied! ✓';
        btn.classList.add('bg-emerald-600');
        setTimeout(() => {
          text.textContent = 'Copy RSS Feed';
          btn.classList.remove('bg-emerald-600');
        }, 2500);
      } catch (err) {
        window.open('/rss.xml', '_blank');
      }
    });
  })();
</script>
