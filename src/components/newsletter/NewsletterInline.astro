---
export interface Props {
  className?: string;
  leadMagnetTitle?: string;
}

const {
  className = '',
  leadMagnetTitle = 'Technical Deep-Dive Checklist & Architecture Sheet',
} = Astro.props;

const buttondownUsername = import.meta.env.PUBLIC_BUTTONDOWN_USERNAME || 'microsignalcosmos';
---

<aside
  class={`newsletter-inline my-10 rounded-2xl border border-[#0ea5e9]/30 bg-gradient-to-br from-sky-50/70 to-slate-50 p-6 sm:p-8 ${className}`}
  aria-label="Subscribe to technical guides"
>
  <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6">
    <div class="space-y-2 max-w-xl">
      <div class="inline-flex items-center gap-1.5 rounded-full bg-[#0ea5e9]/10 px-2.5 py-0.5 text-[11px] font-bold text-[#0ea5e9] uppercase tracking-wider">
        <span>Engineering Digest</span>
      </div>
      <h3 class="text-lg font-bold text-[#14233B]">
        Enjoying this deep dive?
      </h3>
      <p class="text-xs sm:text-sm text-[#4B5565] leading-relaxed">
        Join our weekly breakdown of real production systems and get our free <strong class="text-[#14233B]">{leadMagnetTitle}</strong>.
      </p>
    </div>

    <form
      action={`https://buttondown.email/api/emails/embed-subscribe/${buttondownUsername}`}
      method="post"
      target="popupwindow"
      onsubmit="window.open('https://buttondown.email/' + '${buttondownUsername}', 'popupwindow'); return true;"
      class="w-full sm:w-auto flex flex-col gap-2 shrink-0 sm:min-w-[280px]"
    >
      <input
        type="email"
        name="email"
        required
        placeholder="your.email@company.com"
        aria-label="Email address"
        class="rounded-lg border border-[#E3E8EF] bg-white px-3.5 py-2.5 text-xs text-[#202938] shadow-xs focus:border-[#0ea5e9] focus:outline-none focus:ring-2 focus:ring-[#0ea5e9]/20"
      />
      <input type="hidden" value="1" name="embed" />
      <button
        type="submit"
        class="rounded-lg bg-[#0ea5e9] px-4 py-2.5 text-xs font-semibold text-white shadow-xs transition-colors hover:bg-[#0284c7]"
      >
        Get Cheat Sheet & Subscribe
      </button>
      <span class="text-[10px] text-center text-[#697586]">Zero spam. 1-click unsubscribe.</span>
    </form>
  </div>
</aside>
