---
---

<div class="newsletter-footer space-y-3">
  <h3 class="text-xs font-bold uppercase tracking-widest text-white">
    CURION Syndication
  </h3>
  <p class="text-xs leading-relaxed text-slate-300">
    Follow our weekly research deep-dives via open RSS 2.0 syndication.
  </p>
  <div class="flex flex-col sm:flex-row gap-2">
    <a
      href="/rss.xml"
      target="_blank"
      class="inline-flex items-center justify-center gap-1.5 rounded-lg bg-blue-600 px-3.5 py-2 text-xs font-bold uppercase tracking-wider text-white transition-colors hover:bg-blue-500 text-center"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M4 11a9 9 0 0 1 9 9"></path>
        <path d="M4 4a16 16 0 0 1 16 16"></path>
        <circle cx="5" cy="19" r="1"></circle>
      </svg>
      <span>Open /rss.xml</span>
    </a>
    <button
      id="footer-copy-rss-btn"
      type="button"
      class="rounded-lg border border-slate-700 bg-slate-800/90 px-3 py-2 text-xs font-medium text-slate-300 hover:text-white hover:bg-slate-700 transition-colors cursor-pointer"
      title="Copy RSS Feed URL"
    >
      <span id="footer-copy-rss-text">Copy URL</span>
    </button>
  </div>
  <p class="text-[10px] text-slate-400">
    Zero algorithms &bull; 100% open web standards.
  </p>
</div>

<script is:inline>
  (function() {
    const btn = document.getElementById('footer-copy-rss-btn');
    const text = document.getElementById('footer-copy-rss-text');
    if (!btn || !text) return;

    btn.addEventListener('click', async () => {
      const feedUrl = window.location.origin + '/rss.xml';
      try {
        await navigator.clipboard.writeText(feedUrl);
        text.textContent = 'Copied! ✓';
        setTimeout(() => {
          text.textContent = 'Copy URL';
        }, 2000);
      } catch (err) {
        window.open('/rss.xml', '_blank');
      }
    });
  })();
</script>
