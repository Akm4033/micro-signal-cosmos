---
export interface Props {
  leadMagnet?: string;
}

const {
  leadMagnet = 'Architecture Poster & Cheat Sheet Bundle',
} = Astro.props;
---

<div
  id="exit-intent-modal"
  class="fixed inset-0 z-50 flex items-center justify-center p-3 sm:p-4 bg-slate-950/70 backdrop-blur-sm opacity-0 pointer-events-none transition-opacity duration-300"
  role="dialog"
  aria-modal="true"
  aria-labelledby="exit-modal-title"
  style="box-sizing: border-box;"
>
  <!-- Modal Card: Strictly Contained, Compact 3D Framing -->
  <div
    class="relative w-full max-w-[360px] mx-auto rounded-2xl border border-slate-200 bg-white p-5 sm:p-6 shadow-[0_20px_50px_rgba(0,0,0,0.2)] transition-all duration-300 scale-95 dark:border-white/[0.08] dark:bg-[#0B101D] overflow-hidden"
    id="exit-modal-panel"
    style="box-sizing: border-box; width: min(360px, calc(100vw - 32px)); max-width: min(360px, calc(100vw - 32px));"
  >
    <!-- Close button -->
    <button
      id="exit-modal-close"
      type="button"
      class="absolute top-3.5 right-3.5 text-slate-400 hover:text-slate-700 dark:hover:text-white p-1.5 rounded-lg hover:bg-slate-100 dark:hover:bg-white/[0.08] transition-colors cursor-pointer"
      aria-label="Close dialog"
    >
      <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
        <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd" />
      </svg>
    </button>

    <!-- Top Badge -->
    <div class="inline-flex items-center gap-1.5 rounded-full bg-blue-50 border border-blue-200/80 px-2.5 py-0.5 text-xs font-bold text-blue-700 uppercase tracking-wider mb-2.5 dark:bg-blue-950/50 dark:border-blue-800 dark:text-blue-300">
      <span class="h-1.5 w-1.5 rounded-full bg-blue-600 animate-pulse"></span>
      <span>Signal Insight Syndication</span>
    </div>

    <!-- Title & Subtitle -->
    <h2 id="exit-modal-title" class="text-lg sm:text-xl font-bold text-slate-900 tracking-tight leading-snug dark:text-white">
      Subscribe via Open RSS
    </h2>

    <p class="mt-1.5 text-xs text-slate-600 leading-relaxed dark:text-slate-300">
      Get our rigorous technical deep-dives straight into your favorite reader. Free forever, open web standards, zero spam.
    </p>

    <!-- Lead magnet callout -->
    <div class="mt-3 rounded-xl border border-blue-100 bg-blue-50/60 p-2.5 text-xs text-blue-900 dark:border-blue-900/60 dark:bg-blue-950/40 dark:text-blue-200">
      <span class="font-bold">Starter Pack:</span> Includes our <strong class="text-blue-700 dark:text-blue-300">{leadMagnet}</strong> directly accessible via the archive.
    </div>

    <!-- Actions Container: 100% Contained & Responsive -->
    <div class="mt-4 flex flex-col gap-2.5 w-full block" style="box-sizing: border-box; width: 100%; max-width: 100%;">
      <!-- 1-Click Copy RSS Button -->
      <button
        id="exit-modal-copy-rss"
        type="button"
        style="box-sizing: border-box; width: 100%; max-width: 100%; height: 44px; display: flex; align-items: center; justify-content: center; gap: 8px; background-color: #2563eb !important; color: #ffffff !important; border: none; cursor: pointer; border-radius: 12px; box-shadow: 0 4px 0 #1d4ed8;"
        class="w-full h-11 flex items-center justify-center gap-2 text-center font-bold text-xs uppercase tracking-wider text-white hover:bg-blue-700 hover:brightness-105 active:translate-y-0.5 active:shadow-[0_1px_0_#1d4ed8] transition-all cursor-pointer"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M4 11a9 9 0 0 1 9 9"></path>
          <path d="M4 4a16 16 0 0 1 16 16"></path>
          <circle cx="5" cy="19" r="1"></circle>
        </svg>
        <span id="exit-modal-copy-text" style="color: #ffffff !important; font-weight: 700; font-size: 13px; letter-spacing: 0.04em; text-transform: uppercase;">
          Copy RSS Feed URL
        </span>
      </button>

      <!-- Secondary Links -->
      <div class="flex items-center justify-between gap-2 pt-1 text-xs">
        <a
          href="/rss.xml"
          target="_blank"
          class="flex-1 text-center py-2 px-3 rounded-lg border border-slate-200 bg-slate-50 text-slate-700 hover:bg-slate-100 font-semibold text-xs dark:border-slate-700 dark:bg-slate-800/80 dark:text-slate-200 transition-colors"
        >
          Open /rss.xml &rarr;
        </a>
        <a
          href="/newsletter/"
          class="flex-1 text-center py-2 px-3 rounded-lg border border-slate-200 bg-slate-50 text-slate-700 hover:bg-slate-100 font-semibold text-xs dark:border-slate-700 dark:bg-slate-800/80 dark:text-slate-200 transition-colors"
        >
          Syndication Hub &rarr;
        </a>
      </div>

      <p class="text-xs text-center text-slate-500 dark:text-slate-400 pt-0.5 leading-tight">
        Compatible with Feedly, NetNewsWire, Apple News &amp; Thunderbird.
      </p>
    </div>
  </div>
</div>

<script is:inline>
  (function() {
    const modal = document.getElementById('exit-intent-modal');
    const closeBtn = document.getElementById('exit-modal-close');
    const panel = document.getElementById('exit-modal-panel');
    const copyBtn = document.getElementById('exit-modal-copy-rss');
    const copyText = document.getElementById('exit-modal-copy-text');
    if (!modal) return;

    let shown = sessionStorage.getItem('Signal Insight_exit_shown') === 'true';

    function showModal() {
      if (shown) return;
      shown = true;
      sessionStorage.setItem('Signal Insight_exit_shown', 'true');
      modal.classList.remove('opacity-0', 'pointer-events-none');
      panel?.classList.remove('scale-95');
      panel?.classList.add('scale-100');
    }

    function hideModal() {
      modal.classList.add('opacity-0', 'pointer-events-none');
      panel?.classList.remove('scale-100');
      panel?.classList.add('scale-95');
    }

    // Trigger on mouse leave near top of viewport (desktop)
    document.addEventListener('mouseleave', (e) => {
      if (e.clientY <= 10 && !shown) {
        showModal();
      }
    });

    closeBtn?.addEventListener('click', hideModal);
    modal.addEventListener('click', (e) => {
      if (e.target === modal) hideModal();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') hideModal();
    });

    // Copy RSS Feed URL to clipboard
    copyBtn?.addEventListener('click', async () => {
      const feedUrl = window.location.origin + '/rss.xml';
      try {
        await navigator.clipboard.writeText(feedUrl);
        if (copyText) {
          copyText.textContent = 'Feed URL Copied! ✓';
          copyBtn.style.backgroundColor = '#16a34a';
          setTimeout(() => {
            copyText.textContent = 'Copy RSS Feed URL';
            copyBtn.style.backgroundColor = '#2563eb';
          }, 2500);
        }
      } catch (err) {
        window.open('/rss.xml', '_blank');
      }
    });
  })();
</script>
