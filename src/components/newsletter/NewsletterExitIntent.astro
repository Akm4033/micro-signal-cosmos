---
export interface Props {
  leadMagnet?: string;
}

const {
  leadMagnet = 'Architecture Poster & Cheat Sheet Bundle',
} = Astro.props;

const buttondownUsername = import.meta.env.PUBLIC_BUTTONDOWN_USERNAME || 'microsignalcosmos';
---

<div
  id="exit-intent-modal"
  class="fixed inset-0 z-50 flex items-center justify-center p-3 sm:p-4 bg-slate-950/70 backdrop-blur-sm opacity-0 pointer-events-none transition-opacity duration-300"
  role="dialog"
  aria-modal="true"
  aria-labelledby="exit-modal-title"
  style="box-sizing: border-box;"
>
  <!-- Modal Card: Strictly Contained, Compact 3D Framing -->
  <div
    class="relative w-full max-w-[350px] mx-auto rounded-2xl border border-slate-200 bg-white p-5 sm:p-6 shadow-[0_20px_50px_rgba(0,0,0,0.2)] transition-all duration-300 scale-95 dark:border-slate-800 dark:bg-[#0f172a] overflow-hidden"
    id="exit-modal-panel"
    style="box-sizing: border-box; width: min(350px, calc(100vw - 32px)); max-width: min(350px, calc(100vw - 32px));"
  >
    <!-- Close button -->
    <button
      id="exit-modal-close"
      type="button"
      class="absolute top-3.5 right-3.5 text-slate-400 hover:text-slate-700 dark:hover:text-white p-1.5 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors cursor-pointer"
      aria-label="Close dialog"
    >
      <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
        <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd" />
      </svg>
    </button>

    <!-- Top Badge -->
    <div class="inline-flex items-center gap-1.5 rounded-full bg-blue-50 border border-blue-200/80 px-2.5 py-0.5 text-[10px] font-bold text-blue-700 uppercase tracking-wider mb-2.5 dark:bg-blue-950/50 dark:border-blue-800 dark:text-blue-300">
      <span class="h-1.5 w-1.5 rounded-full bg-blue-600 animate-pulse"></span>
      <span>CURION Briefing</span>
    </div>

    <!-- Title & Subtitle -->
    <h2 id="exit-modal-title" class="text-lg sm:text-xl font-bold text-slate-900 tracking-tight leading-snug dark:text-white">
      Level up your technical intuition
    </h2>

    <p class="mt-1.5 text-xs text-slate-600 leading-relaxed dark:text-slate-300">
      Get our free <strong class="text-slate-900 dark:text-white font-semibold">{leadMagnet}</strong> plus weekly technical briefings sent straight to your inbox.
    </p>

    <!-- Bulletproof Form: 100% Contained Inside Modal Box -->
    <form
      action={`https://buttondown.email/api/emails/embed-subscribe/${buttondownUsername}`}
      method="post"
      target="popupwindow"
      onsubmit={`window.open('https://buttondown.email/${buttondownUsername}', 'popupwindow'); return true;`}
      class="mt-4 flex flex-col gap-2.5 w-full block"
      style="box-sizing: border-box; width: 100%; max-width: 100%; overflow: hidden;"
    >
      <div class="w-full block" style="box-sizing: border-box; width: 100%; max-width: 100%;">
        <input
          type="email"
          name="email"
          required
          placeholder="Enter your email address..."
          aria-label="Email for free cheat sheet"
          style="box-sizing: border-box; width: 100%; max-width: 100%; height: 40px;"
          class="w-full h-10 block rounded-xl border border-slate-300 bg-slate-50 px-3 text-xs text-slate-900 placeholder-slate-400 focus:border-blue-600 focus:bg-white focus:outline-none focus:ring-2 focus:ring-blue-600/20 dark:border-slate-700 dark:bg-slate-800/90 dark:text-white dark:placeholder-slate-500 transition-all"
        />
      </div>

      <input type="hidden" value="1" name="embed" />

      <!-- 3D Tactile Push Button Framed 100% Inside Container -->
      <div class="w-full block" style="box-sizing: border-box; width: 100%; max-width: 100%; overflow: hidden;">
        <button
          type="submit"
          style="box-sizing: border-box; width: 100%; max-width: 100%; height: 44px; display: flex; align-items: center; justify-content: center; gap: 8px; background-color: #2563eb !important; color: #ffffff !important; border: none; cursor: pointer; border-radius: 12px; box-shadow: 0 4px 0 #1d4ed8;"
          class="w-full h-11 flex items-center justify-center gap-2 text-center font-bold text-xs uppercase tracking-wider text-white hover:bg-blue-700 hover:brightness-105 active:translate-y-0.5 active:shadow-[0_1px_0_#1d4ed8] transition-all cursor-pointer"
        >
          <span style="color: #ffffff !important; font-weight: 700; font-size: 13px; letter-spacing: 0.04em; text-transform: uppercase; display: inline-block;">
            Send Me The Free Guide
          </span>
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="stroke: #ffffff !important; display: inline-block;" aria-hidden="true">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </button>
      </div>

      <p class="text-[11px] text-center text-slate-500 dark:text-slate-400 pt-0.5 leading-tight">
        No spam, ever. Unsubscribe anytime with 1 click.
      </p>
    </form>
  </div>
</div>

<script is:inline>
  (function() {
    const modal = document.getElementById('exit-intent-modal');
    const closeBtn = document.getElementById('exit-modal-close');
    const panel = document.getElementById('exit-modal-panel');
    if (!modal) return;

    let shown = sessionStorage.getItem('curion_exit_shown') === 'true';

    function showModal() {
      if (shown) return;
      shown = true;
      sessionStorage.setItem('curion_exit_shown', 'true');
      modal.classList.remove('opacity-0', 'pointer-events-none');
      panel?.classList.remove('scale-95');
      panel?.classList.add('scale-100');
    }

    function hideModal() {
      modal.classList.add('opacity-0', 'pointer-events-none');
      panel?.classList.remove('scale-100');
      panel?.classList.add('scale-95');
    }

    // Trigger on mouse leave near top of viewport (desktop)
    document.addEventListener('mouseleave', (e) => {
      if (e.clientY <= 10 && !shown) {
        showModal();
      }
    });

    closeBtn?.addEventListener('click', hideModal);
    modal.addEventListener('click', (e) => {
      if (e.target === modal) hideModal();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') hideModal();
    });
  })();
</script>
