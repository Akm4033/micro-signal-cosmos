---
export interface Props {
  leadMagnet?: string;
}

const {
  leadMagnet = 'Free Architecture Poster & Cheat Sheet Bundle',
} = Astro.props;

const buttondownUsername = import.meta.env.PUBLIC_BUTTONDOWN_USERNAME || 'microsignalcosmos';
---

<div
  id="exit-intent-modal"
  class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/60 backdrop-blur-xs opacity-0 pointer-events-none transition-opacity duration-300"
  role="dialog"
  aria-modal="true"
  aria-labelledby="exit-modal-title"
>
  <div
    class="relative w-full max-w-lg rounded-2xl border border-[#E3E8EF] bg-white p-6 sm:p-8 shadow-2xl transition-transform duration-300 scale-95"
    id="exit-modal-panel"
  >
    <!-- Close button -->
    <button
      id="exit-modal-close"
      type="button"
      class="absolute top-4 right-4 text-slate-400 hover:text-slate-700 p-1.5 rounded-lg hover:bg-slate-100 transition-colors"
      aria-label="Close dialog"
    >
      <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
        <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd" />
      </svg>
    </button>

    <div class="inline-flex items-center gap-1.5 rounded-full bg-[#0ea5e9]/10 px-3 py-1 text-xs font-bold text-[#0ea5e9] uppercase tracking-wider mb-3">
      <span>Before you go</span>
    </div>

    <h2 id="exit-modal-title" class="text-2xl font-bold text-[#14233B] tracking-tight">
      Level up your technical intuition
    </h2>

    <p class="mt-2 text-sm text-[#4B5565] leading-relaxed">
      Get our free <strong class="text-[#14233B]">{leadMagnet}</strong> plus our weekly technical briefings sent straight to your inbox.
    </p>

    <form
      action={`https://buttondown.email/api/emails/embed-subscribe/${buttondownUsername}`}
      method="post"
      target="popupwindow"
      onsubmit="window.open('https://buttondown.email/' + '${buttondownUsername}', 'popupwindow'); return true;"
      class="mt-6 space-y-3"
    >
      <input
        type="email"
        name="email"
        required
        placeholder="Enter your email address..."
        aria-label="Email for free cheat sheet"
        class="w-full rounded-lg border border-[#E3E8EF] px-3.5 py-2.5 text-sm text-[#202938] shadow-xs focus:border-[#0ea5e9] focus:outline-none focus:ring-2 focus:ring-[#0ea5e9]/20"
      />
      <input type="hidden" value="1" name="embed" />
      <button
        type="submit"
        class="w-full rounded-lg bg-[#0ea5e9] py-3 text-xs font-bold text-white uppercase tracking-wider shadow-xs transition-colors hover:bg-[#0284c7]"
      >
        Send Me The Free Guide
      </button>
      <p class="text-[11px] text-center text-[#697586]">
        No spam, ever. Unsubscribe anytime.
      </p>
    </form>
  </div>
</div>

<script is:inline>
  (function() {
    const modal = document.getElementById('exit-intent-modal');
    const closeBtn = document.getElementById('exit-modal-close');
    const panel = document.getElementById('exit-modal-panel');
    if (!modal) return;

    let shown = sessionStorage.getItem('msc_exit_shown') === 'true';

    function showModal() {
      if (shown) return;
      shown = true;
      sessionStorage.setItem('msc_exit_shown', 'true');
      modal.classList.remove('opacity-0', 'pointer-events-none');
      panel?.classList.remove('scale-95');
      panel?.classList.add('scale-100');
    }

    function hideModal() {
      modal.classList.add('opacity-0', 'pointer-events-none');
      panel?.classList.remove('scale-100');
      panel?.classList.add('scale-95');
    }

    // Trigger on mouse leave near top of viewport (desktop)
    document.addEventListener('mouseleave', (e) => {
      if (e.clientY <= 10 && !shown) {
        showModal();
      }
    });

    closeBtn?.addEventListener('click', hideModal);
    modal.addEventListener('click', (e) => {
      if (e.target === modal) hideModal();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') hideModal();
    });
  })();
</script>