---
import { site } from '../../config/site';

export interface Props {
  className?: string;
  leadMagnet?: string;
}

const {
  className = '',
  leadMagnet = 'Systems & AI Architecture Cheat Sheet Pack',
} = Astro.props;
---

<section
  class={`newsletter-hero bg-[#070B14] dark:bg-[#030509] border-t border-b border-slate-200 dark:border-white/[0.08] text-white py-16 sm:py-20 relative overflow-hidden ${className}`}
  aria-labelledby="newsletter-hero-heading"
  id="newsletter-hero-section"
>
  <!-- Background Fine Technical Grid -->
  <div class="pointer-events-none absolute inset-0 -z-10 opacity-10" aria-hidden="true">
    <svg width="100%" height="100%" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <pattern id="nl-hero-grid" width="32" height="32" patternUnits="userSpaceOnUse">
          <path d="M 32 0 L 0 0 0 32" fill="none" stroke="white" stroke-width="1" />
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill="url(#nl-hero-grid)" />
    </svg>
  </div>

  <div class="container-main text-center">
    <div class="mx-auto max-w-2xl">
      <!-- Badge -->
      <div class="mb-4 inline-flex items-center gap-2 rounded-full border border-blue-400/30 bg-blue-500/10 px-3.5 py-1 text-xs font-bold tracking-widest text-blue-300 uppercase font-mono">
        <span class="h-1.5 w-1.5 rounded-full bg-blue-500 animate-pulse"></span>
        <span>Signal Insight Briefing</span>
      </div>

      <h2 id="newsletter-hero-heading" class="text-3xl sm:text-4xl font-extrabold tracking-tight text-white">
        Understand How Modern Systems Actually Work
      </h2>

      <p class="mt-4 text-base sm:text-lg leading-relaxed text-slate-300">
        Every week: in-depth technical breakdowns, reproducible architectures, and zero marketing hype. Join engineers receiving our weekly analysis.
      </p>

      <!-- Real Email Capture Form -->
      <!-- TODO(signal-insight): replace site.newsletterAction with real provider endpoint; current value returns 404 until configured -->
      <form
        method="post"
        action={site.newsletterAction}
        target="_blank"
        class="mt-8 max-w-md mx-auto space-y-3"
        id="hero-newsletter-form"
      >
        <label for="hero-newsletter-email" class="sr-only">Email address</label>
        <div class="flex flex-col sm:flex-row items-stretch gap-2.5">
          <input
            type="email"
            id="hero-newsletter-email"
            name="email"
            required
            autocomplete="email"
            placeholder="you@company.com"
            aria-describedby="newsletter-hero-help"
            class="min-h-11 flex-1 rounded-xl border border-white/[0.15] bg-white/[0.06] px-4 py-2.5 text-sm text-white placeholder-slate-400 focus:border-blue-500 focus:bg-white/[0.1] focus:outline-none focus:ring-2 focus:ring-blue-500/20 transition-all shadow-xs"
          />
          <button
            type="submit"
            class="min-h-11 shrink-0 rounded-xl bg-blue-600 px-5 py-2.5 text-xs font-bold uppercase tracking-wider text-white shadow-xs hover:bg-blue-500 active:translate-y-0.5 transition-all cursor-pointer inline-flex items-center justify-center gap-2 font-mono"
          >
            Get the weekly briefing
          </button>
        </div>
        <p id="newsletter-hero-help" class="text-xs text-slate-400">
          One email per week. Unsubscribe anytime. We only use your email for the briefing.
        </p>
        <p class="hero-post-submit hidden text-xs font-semibold text-emerald-400" aria-live="polite">
          Almost there — confirm via the email we just sent.
        </p>
      </form>

      <!-- Open RSS Syndication Sub-Block (Below Form) -->
      <div class="mt-10 pt-6 border-t border-white/[0.08] max-w-md mx-auto flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-left">
        <div>
          <h3 class="text-xs font-bold uppercase tracking-wider text-white font-mono">
            Prefer RSS?
          </h3>
          <p class="text-xs text-slate-400 mt-0.5">
            Add Signal Insight to your reader. No ad trackers. Optional, anonymized session analytics only.
          </p>
        </div>
        <div class="flex items-center gap-2 shrink-0">
          <button
            id="hero-copy-rss-btn"
            type="button"
            class="min-h-11 rounded-lg border border-white/[0.1] bg-white/[0.04] px-3 py-2 text-xs font-bold uppercase tracking-wider text-slate-200 hover:bg-white/[0.08] hover:text-white transition-all cursor-pointer inline-flex items-center gap-1.5 font-mono"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 11a9 9 0 0 1 9 9"></path><path d="M4 4a16 16 0 0 1 16 16"></path><circle cx="5" cy="19" r="1"></circle></svg>
            <span id="hero-copy-rss-text">Copy RSS</span>
          </button>
          <a
            href="/rss.xml"
            target="_blank"
            class="min-h-11 rounded-lg border border-white/[0.1] bg-white/[0.04] px-3 py-2 text-xs font-bold uppercase tracking-wider text-slate-200 hover:bg-white/[0.08] hover:text-white transition-all font-mono inline-flex items-center gap-1"
          >
            <span>/rss.xml</span>
            <span aria-hidden="true">&rarr;</span>
          </a>
        </div>
      </div>

    </div>
  </div>
</section>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const btn = document.getElementById('hero-copy-rss-btn');
    const text = document.getElementById('hero-copy-rss-text');
    if (btn && text) {
      btn.addEventListener('click', async () => {
        const feedUrl = window.location.origin + '/rss.xml';
        try {
          await navigator.clipboard.writeText(feedUrl);
          text.textContent = 'Copied!';
          btn.classList.add('text-emerald-400');
          setTimeout(() => {
            text.textContent = 'Copy RSS';
            btn.classList.remove('text-emerald-400');
          }, 2000);
        } catch (err) {
          window.open('/rss.xml', '_blank');
        }
      });
    }

    const form = document.getElementById('hero-newsletter-form');
    if (form) {
      form.addEventListener('submit', () => {
        const feedback = form.querySelector('.hero-post-submit');
        if (feedback) feedback.classList.remove('hidden');
      });
    }
  });
</script>
