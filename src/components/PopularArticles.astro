---
import { getPublishedArticles, getArticleReadingTime } from '../data/articles';

// Editorially curated selection of prominent published articles
const publishedArticles = await getPublishedArticles();
const primaryPick = publishedArticles[0];
const listArticles = publishedArticles.slice(0, 3);
---

{publishedArticles.length > 0 && (
  <section class="bg-white py-14 sm:py-20 border-b border-[#E3E8EF]" aria-labelledby="popular-heading">
    <div class="container-main">

      <!-- Section Header -->
      <div class="mb-10 flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
        <div>
          <div class="inline-flex items-center gap-2 text-xs font-bold tracking-widest text-[#3478F6] uppercase mb-2">
            <span class="h-1.5 w-1.5 rounded-full bg-[#3478F6]"></span>
            <span>Curated Analysis</span>
          </div>

          <h2 id="popular-heading" class="text-3xl font-extrabold tracking-tight text-[#14233B] sm:text-4xl">
            Popular & <span class="text-[#3478F6]">Essential Reads</span>
          </h2>

          <p class="mt-2 text-sm leading-relaxed text-[#697586] max-w-xl">
            Selected investigations, technical overviews, and foundational articles recommended by our editorial desk.
          </p>
        </div>

        <a
          href="/articles/"
          class="inline-flex items-center gap-1.5 text-xs font-bold tracking-wider uppercase text-[#3478F6] hover:text-[#2563EB] transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#3478F6] rounded py-1"
        >
          <span>Browse All Dispatches</span>
          <span aria-hidden="true">&rarr;</span>
        </a>
      </div>

      <!-- Asymmetric Editorial Showcase (Split Layout: Spotlight + Ranked Leaderboard) -->
      <div class="grid gap-8 lg:grid-cols-12 items-stretch">

        <!-- Left Spotlight Card (5 cols) -->
        {primaryPick && (
          <div class="lg:col-span-5 rounded-2xl border border-[#E3E8EF] bg-[#F7F9FC] p-6 sm:p-8 flex flex-col justify-between shadow-2xs hover:border-[#CBD5E1] transition-all">
            <div>
              <div class="flex items-center justify-between mb-4">
                <span class="rounded-full bg-[#3478F6] text-white px-3 py-0.5 text-[10px] font-extrabold uppercase tracking-widest">
                  Staff Pick
                </span>
                <span class="text-xs font-semibold text-[#697586]">
                  {getArticleReadingTime(primaryPick)}
                </span>
              </div>

              <span class="text-xs font-bold tracking-wider uppercase text-[#3478F6]">
                {primaryPick.data.category}
              </span>

              <h3 class="mt-2 text-xl sm:text-2xl font-extrabold text-[#14233B] hover:text-[#3478F6] transition-colors leading-snug">
                <a href={`/articles/${primaryPick.data.slug || primaryPick.id}/`}>
                  {primaryPick.data.title}
                </a>
              </h3>

              <p class="mt-3 text-sm leading-relaxed text-[#4B5565]">
                {primaryPick.data.description}
              </p>
            </div>

            <div class="mt-8 pt-4 border-t border-[#E3E8EF] flex items-center justify-between">
              <span class="text-xs font-medium text-[#697586]">{primaryPick.data.author}</span>
              <a
                href={`/articles/${primaryPick.data.slug || primaryPick.id}/`}
                class="inline-flex items-center gap-1.5 text-xs font-bold uppercase tracking-wider text-[#3478F6] hover:text-[#2563EB]"
              >
                <span>Read Pick</span>
                <span aria-hidden="true">&rarr;</span>
              </a>
            </div>
          </div>
        )}

        <!-- Right Ranked Editorial List (7 cols) -->
        <div class="lg:col-span-7 flex flex-col justify-between gap-4">
          {listArticles.map((article, index) => {
            const slug = article.data.slug || article.id;
            const rank = String(index + 1).padStart(2, '0');

            return (
              <article class="group rounded-xl border border-[#E3E8EF] bg-white p-5 sm:p-6 transition-all duration-200 hover:border-[#3478F6] hover:shadow-xs flex items-start gap-5">
                <span class="text-3xl sm:text-4xl font-black text-slate-300 group-hover:text-[#3478F6] transition-colors font-mono shrink-0">
                  {rank}
                </span>

                <div class="flex-1">
                  <div class="flex flex-wrap items-center gap-2 text-xs mb-1.5">
                    <span class="font-bold uppercase tracking-wider text-[#3478F6] text-[11px]">
                      {article.data.category}
                    </span>
                    <span aria-hidden="true" class="text-slate-300">&bull;</span>
                    <span class="text-[#697586]">{getArticleReadingTime(article)}</span>
                  </div>

                  <h3 class="text-base sm:text-lg font-bold text-[#14233B] group-hover:text-[#3478F6] transition-colors leading-snug">
                    <a href={`/articles/${slug}/`} class="focus-visible:outline-none focus-visible:underline">
                      {article.data.title}
                    </a>
                  </h3>

                  <p class="mt-1.5 text-xs sm:text-sm text-[#4B5565] line-clamp-2">
                    {article.data.description}
                  </p>
                </div>
              </article>
            );
          })}
        </div>

      </div>

    </div>
  </section>
)}
