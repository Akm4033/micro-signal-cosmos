---
import Base from '../layouts/Base.astro';
import { CATEGORIES } from '../data/categories';
---

<Base
  title="404: Signal Lost | CURION"
  description="The transmission you are seeking has drifted beyond our observable coordinates."
  noindex={true}
>
  <main id="main-content" class="relative isolate flex min-h-[calc(100vh-80px-340px)] items-center justify-center bg-neutral-50 py-16 sm:py-24 border-b border-neutral-200 dark:bg-[#05070E] dark:border-white/[0.08]">
    <div class="container-narrow text-center">
      <div class="mx-auto max-w-xl rounded-2xl border border-neutral-200 bg-white p-8 sm:p-14 shadow-sm dark:border-white/[0.08] dark:bg-[#0B101D]">

        <!-- 404 Radar Visual -->
        <div class="relative mx-auto mb-6 flex flex-col items-center justify-center">
          <div class="relative mb-6 flex h-24 w-24 items-center justify-center rounded-2xl border border-neutral-200 bg-neutral-50 shadow-inner dark:border-white/[0.08] dark:bg-[#070B14]">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 80 80"
              fill="none"
              class="h-12 w-12"
              role="img"
              aria-label="Lost signal radar illustration"
            >
              <circle cx="40" cy="40" r="34" stroke="#0ea5e9" stroke-opacity=".3" stroke-width="1.5" stroke-dasharray="4 3"/>
              <circle cx="40" cy="40" r="24" stroke="#0a0f1a" stroke-opacity=".2" stroke-width="1.5"/>
              <circle cx="40" cy="40" r="14" stroke="#0ea5e9" stroke-opacity=".5" stroke-width="1.5"/>
              <path d="M12 40H68M40 12V68" stroke="#0a0f1a" stroke-opacity=".2" stroke-width="1.5"/>
              <path d="M25 40L32 30L39 49L46 33L53 40" stroke="#0ea5e9" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
              <circle cx="46" cy="33" r="3.5" fill="#0ea5e9"/>
            </svg>
          </div>

          <span class="block text-6xl font-black tracking-tight text-text-primary sm:text-7xl">
            4<span class="text-brand-primary">0</span>4
          </span>
        </div>

        <h1 class="text-2xl font-bold text-text-primary sm:text-3xl">
          Signal Lost in Transit
        </h1>

        <p class="mt-4 text-sm sm:text-base leading-relaxed text-text-secondary">
          The requested coordinate or document no longer exists at this location. It may have been relocated, consolidated, or retired.
        </p>

        <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
          <a href="/" class="btn-primary">
            Return to Homepage
          </a>
          <a href="/articles/" class="btn-secondary">
            Search Archive
          </a>
        </div>

        <!-- Four Streams Quick Navigation -->
        <div class="mt-10 border-t border-neutral-200 pt-6 dark:border-neutral-700">
          <h2 class="text-xs font-bold uppercase tracking-wider text-text-muted mb-3">
            Active Knowledge Streams
          </h2>
          <div class="flex flex-wrap justify-center gap-2">
            {CATEGORIES.map((cat) => (
              <a
                href={cat.href}
                class="rounded-lg border border-neutral-200 bg-neutral-50 px-3 py-1.5 text-xs font-semibold text-text-secondary hover:border-brand-primary hover:text-brand-primary transition-colors dark:border-neutral-700 dark:bg-neutral-800"
              >
                {cat.name}
              </a>
            ))}
          </div>
        </div>

      </div>
    </div>
  </main>
</Base>
