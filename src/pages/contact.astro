---
import Base from '../layouts/Base.astro';

const siteUrl = Astro.site ? Astro.site.href.replace(/\/$/, '') : (process.env.SITE_URL || 'https://micro-signal-cosmos.pages.dev');
const contactUrl = `${siteUrl}/contact/`;
---

<Base
  title="Contact Desk | CURION"
  description="Get in touch with the CURION research team for article feedback, technical errata, rapid corrections, or collaboration inquiries."
  canonical={contactUrl}
>
  <main id="main-content" class="bg-neutral-50 py-12 sm:py-20 border-b border-neutral-200 dark:bg-neutral-900/50 dark:border-neutral-800">
    <div class="container-narrow">

      <!-- Breadcrumbs -->
      <nav aria-label="Breadcrumb" class="mb-8">
        <ol class="flex items-center gap-2 text-xs text-text-muted">
          <li>
            <a href="/" class="transition-colors hover:text-brand-primary">Home</a>
          </li>
          <li aria-hidden="true" class="text-neutral-400">/</li>
          <li class="font-semibold text-text-primary" aria-current="page">Contact Desk</li>
        </ol>
      </nav>

      <!-- Hero Header -->
      <header class="mb-12">
        <div class="inline-flex items-center gap-2 rounded-full border border-neutral-200 bg-white px-3.5 py-1 text-xs font-bold tracking-widest text-brand-primary uppercase shadow-xs dark:border-neutral-700 dark:bg-neutral-900">
          <span class="h-1.5 w-1.5 rounded-full bg-brand-primary"></span>
          <span>Contact &amp; Errata</span>
        </div>
        <h1 class="mt-4 text-3xl font-extrabold tracking-tight text-text-primary sm:text-4xl">
          Get in Touch
        </h1>
        <p class="mt-4 text-base sm:text-lg leading-relaxed text-text-secondary">
          Have feedback on an investigation, found code errata, or want to suggest a technical topic? We respond promptly.
        </p>
      </header>

      <!-- Direct Contact Channels -->
      <div class="grid gap-6 sm:grid-cols-2 mb-12">
        <div class="rounded-2xl border border-neutral-200 bg-white p-6 shadow-xs dark:border-neutral-700 dark:bg-neutral-900">
          <h2 class="text-sm font-bold uppercase tracking-wider text-text-muted mb-2">Editorial Desk</h2>
          <p class="text-sm text-text-secondary">Direct research and correction inquiries:</p>
          <a href="mailto:editorial@curion.pages.dev" class="mt-3 inline-block font-semibold text-brand-primary hover:underline">
            editorial@curion.pages.dev
          </a>
        </div>
        <div class="rounded-2xl border border-neutral-200 bg-white p-6 shadow-xs dark:border-neutral-700 dark:bg-neutral-900">
          <h2 class="text-sm font-bold uppercase tracking-wider text-text-muted mb-2">Code Errata &amp; Issues</h2>
          <p class="text-sm text-text-secondary">Submit public corrections or bug reports via GitHub:</p>
          <a href="https://github.com/Akm4033/micro-signal-cosmos/issues" target="_blank" rel="noopener noreferrer" class="mt-3 inline-block font-semibold text-brand-primary hover:underline">
            GitHub Issues &rarr;
          </a>
        </div>
      </div>

      <!-- Contact Form -->
      <div class="rounded-2xl border border-neutral-200 bg-white p-6 sm:p-10 shadow-xs dark:border-neutral-700 dark:bg-neutral-900">
        <h2 class="text-xl font-bold text-text-primary mb-2">Send a Message</h2>
        <p class="text-xs text-text-secondary mb-6">All submissions are validated on the server with active spam protection.</p>

        <!-- Feedback Notification Box -->
        <div id="contact-status" class="hidden mb-6 rounded-xl p-4 text-xs font-semibold leading-relaxed transition-all" role="alert"></div>

        <form
          id="contact-form"
          action="/api/contact"
          method="POST"
          class="space-y-6"
        >
          <!-- Anti-spam Honeypot (invisible to real users) -->
          <input type="text" name="_gotcha" id="contact-gotcha" style="display:none !important;" tabindex="-1" autocomplete="off" aria-hidden="true" />

          <div class="space-y-2">
            <label for="contact-name" class="block text-xs font-bold uppercase tracking-wider text-text-muted">Your Name <span class="text-red-500">*</span></label>
            <input type="text" id="contact-name" name="name" required minlength="2" placeholder="Dr. Jane Doe" class="input" />
          </div>
          <div class="space-y-2">
            <label for="contact-email" class="block text-xs font-bold uppercase tracking-wider text-text-muted">Email Address <span class="text-red-500">*</span></label>
            <input type="email" id="contact-email" name="email" required placeholder="jane@example.com" class="input" />
          </div>
          <div class="space-y-2">
            <label for="contact-subject" class="block text-xs font-bold uppercase tracking-wider text-text-muted">Subject <span class="text-red-500">*</span></label>
            <input type="text" id="contact-subject" name="subject" required minlength="3" placeholder="Correction: How Browsers Render / Topic Request" class="input" />
          </div>
          <div class="space-y-2">
            <label for="contact-message" class="block text-xs font-bold uppercase tracking-wider text-text-muted">Message <span class="text-red-500">*</span></label>
            <textarea id="contact-message" name="message" rows="5" required minlength="10" maxlength="5000" placeholder="Your message, code snippet errata, or inquiry..." class="input"></textarea>
            <span class="text-[10px] text-text-muted block text-right">Min 10 characters</span>
          </div>

          <button id="contact-submit-btn" type="submit" class="btn-primary w-full cursor-pointer transition-all">
            <span id="contact-btn-text">Send Message</span>
            <span id="contact-btn-icon" aria-hidden="true">&rarr;</span>
          </button>
        </form>
      </div>

    </div>
  </main>

  <script is:inline>
    (function() {
      const form = document.getElementById('contact-form');
      const statusBox = document.getElementById('contact-status');
      const submitBtn = document.getElementById('contact-submit-btn');
      const btnText = document.getElementById('contact-btn-text');
      const btnIcon = document.getElementById('contact-btn-icon');

      if (!form || !statusBox || !submitBtn) return;

      form.addEventListener('submit', async function(e) {
        e.preventDefault();

        // Basic client validation
        const name = (document.getElementById('contact-name')?.value || '').trim();
        const email = (document.getElementById('contact-email')?.value || '').trim();
        const subject = (document.getElementById('contact-subject')?.value || '').trim();
        const message = (document.getElementById('contact-message')?.value || '').trim();
        const gotcha = (document.getElementById('contact-gotcha')?.value || '').trim();

        if (name.length < 2) {
          showStatus('Please enter a valid name (at least 2 characters).', 'error');
          return;
        }
        if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
          showStatus('Please enter a valid email address.', 'error');
          return;
        }
        if (subject.length < 3) {
          showStatus('Please enter a valid subject.', 'error');
          return;
        }
        if (message.length < 10) {
          showStatus('Message must be at least 10 characters long.', 'error');
          return;
        }

        // Loading state
        submitBtn.disabled = true;
        submitBtn.classList.add('opacity-70', 'cursor-not-allowed');
        btnText.textContent = 'Verifying & Sending...';
        btnIcon.textContent = '⏳';
        hideStatus();

        try {
          const res = await fetch('/api/contact', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'Accept': 'application/json'
            },
            body: JSON.stringify({ name, email, subject, message, _gotcha: gotcha })
          });

          const data = await res.json().catch(() => ({}));

          if (res.ok && data.success) {
            showStatus(data.message || 'Thank you! Your message has been received.', 'success');
            form.reset();
          } else {
            showStatus(data.error || 'Unable to deliver message. Please contact us directly at editorial@curion.pages.dev.', 'error');
          }
        } catch (err) {
          showStatus('Network connection error. Please try again or email us directly at editorial@curion.pages.dev.', 'error');
        } finally {
          submitBtn.disabled = false;
          submitBtn.classList.remove('opacity-70', 'cursor-not-allowed');
          btnText.textContent = 'Send Message';
          btnIcon.textContent = '→';
        }
      });

      function showStatus(msg, type) {
        statusBox.textContent = msg;
        statusBox.classList.remove('hidden', 'bg-red-50', 'text-red-700', 'border', 'border-red-200', 'bg-emerald-50', 'text-emerald-700', 'border-emerald-200', 'dark:bg-red-950/50', 'dark:text-red-300', 'dark:border-red-900', 'dark:bg-emerald-950/50', 'dark:text-emerald-300', 'dark:border-emerald-900');
        if (type === 'error') {
          statusBox.classList.add('bg-red-50', 'text-red-700', 'border', 'border-red-200', 'dark:bg-red-950/50', 'dark:text-red-300', 'dark:border-red-900');
        } else {
          statusBox.classList.add('bg-emerald-50', 'text-emerald-700', 'border', 'border-emerald-200', 'dark:bg-emerald-950/50', 'dark:text-emerald-300', 'dark:border-emerald-900');
        }
      }

      function hideStatus() {
        statusBox.classList.add('hidden');
      }
    })();
  </script>
</Base>
