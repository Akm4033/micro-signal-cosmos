---
import Base from '../layouts/Base.astro';
import { site } from '../config/site';

const siteUrl = Astro.site ? Astro.site.href.replace(/\/$/, '') : (process.env.SITE_URL || 'https://signal-insight.pages.dev');
const contactUrl = `${siteUrl}/contact/`;
const contactMailto = `mailto:${site.contactEmail}`;
---

<Base
  title="Contact Signal Insight | Editorial & Errata Desk"
  description="Contact the Signal Insight research desk for article feedback, peer review errata, technical inquiries, or collaboration."
  canonical={contactUrl}
  ogImage="/og/default.png"
>
  <div class="bg-neutral-50 py-12 sm:py-20 border-b border-neutral-200 dark:bg-[#05070E] dark:border-white/[0.08]">
    <div class="container-narrow">

      <!-- Breadcrumbs -->
      <nav aria-label="Breadcrumb" class="mb-8">
        <ol class="flex items-center gap-2 text-xs text-slate-500 dark:text-slate-400">
          <li>
            <a href="/" class="transition-colors hover:text-blue-600">Home</a>
          </li>
          <li aria-hidden="true" class="text-slate-400">/</li>
          <li class="font-semibold text-slate-900 dark:text-white" aria-current="page">Contact</li>
        </ol>
      </nav>

      <!-- Hero Header -->
      <header class="mb-10">
        <div class="inline-flex items-center gap-2 rounded-full border border-blue-200/80 bg-blue-50/80 px-3.5 py-1 text-xs font-bold tracking-widest text-blue-700 uppercase shadow-2xs dark:border-blue-900/60 dark:bg-blue-950/40 dark:text-blue-300 font-mono">
          <span class="h-1.5 w-1.5 rounded-full bg-blue-600 animate-pulse"></span>
          <span>Editorial &amp; Research Desk</span>
        </div>
        <h1 class="mt-4 text-3xl font-extrabold tracking-tight text-slate-900 dark:text-white sm:text-4xl">
          Contact Signal Insight
        </h1>
        <p class="mt-4 text-base sm:text-lg leading-relaxed text-slate-600 dark:text-slate-300">
          For editorial feedback, corrections, or research proposals, email <a href={contactMailto} class="font-semibold text-blue-600 dark:text-blue-400 hover:underline font-mono">{site.contactEmail}</a>. We respond within two business days.
        </p>
      </header>

      <!-- Main Contact Form / Message Composer -->
      <div class="rounded-2xl border border-slate-200 bg-white p-6 sm:p-10 shadow-xs dark:border-white/[0.08] dark:bg-[#0B101D]">
        <div class="mb-6 pb-4 border-b border-slate-100 dark:border-white/[0.08] flex items-center justify-between">
          <div>
            <h2 class="text-xl font-bold text-slate-900 dark:text-white">Editorial Message Composer</h2>
            <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">Direct transmission to the Signal Insight editorial inbox.</p>
          </div>
          <span class="px-2.5 py-1 rounded-full text-xs font-mono font-semibold bg-blue-50 text-blue-700 dark:bg-blue-950/60 dark:text-blue-300">
            Verified Desk
          </span>
        </div>

        <form id="contact-form" action={contactMailto} method="GET" class="space-y-5">
          <div>
            <label for="contact-name" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-1.5 font-mono">
              Your Name
            </label>
            <input
              type="text"
              id="contact-name"
              name="name"
              required
              placeholder="Ada Lovelace"
              class="w-full min-h-11 rounded-xl border border-slate-300 bg-white px-4 py-2.5 text-sm text-slate-900 placeholder-slate-400 focus:border-blue-600 focus:outline-none focus:ring-2 focus:ring-blue-600/20 dark:border-white/[0.1] dark:bg-[#070B14] dark:text-white dark:placeholder-slate-500 transition-colors shadow-2xs"
            />
          </div>

          <div>
            <label for="contact-email" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-1.5 font-mono">
              Email Address
            </label>
            <input
              type="email"
              id="contact-email"
              name="email"
              required
              autocomplete="email"
              placeholder="ada@example.com"
              class="w-full min-h-11 rounded-xl border border-slate-300 bg-white px-4 py-2.5 text-sm text-slate-900 placeholder-slate-400 focus:border-blue-600 focus:outline-none focus:ring-2 focus:ring-blue-600/20 dark:border-white/[0.1] dark:bg-[#070B14] dark:text-white dark:placeholder-slate-500 transition-colors shadow-2xs"
            />
          </div>

          <div>
            <label for="contact-subject" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-1.5 font-mono">
              Subject
            </label>
            <input
              type="text"
              id="contact-subject"
              name="subject"
              required
              placeholder="Technical Inquiry / Errata / Research Proposal"
              class="w-full min-h-11 rounded-xl border border-slate-300 bg-white px-4 py-2.5 text-sm text-slate-900 placeholder-slate-400 focus:border-blue-600 focus:outline-none focus:ring-2 focus:ring-blue-600/20 dark:border-white/[0.1] dark:bg-[#070B14] dark:text-white dark:placeholder-slate-500 transition-colors shadow-2xs"
            />
          </div>

          <div>
            <label for="contact-message" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-1.5 font-mono">
              Message / Errata Details
            </label>
            <textarea
              id="contact-message"
              name="body"
              rows="5"
              required
              placeholder="Describe your question, architectural correction, or research inquiry..."
              class="w-full rounded-xl border border-slate-300 bg-white p-4 text-sm text-slate-900 placeholder-slate-400 focus:border-blue-600 focus:outline-none focus:ring-2 focus:ring-blue-600/20 dark:border-white/[0.1] dark:bg-[#070B14] dark:text-white dark:placeholder-slate-500 transition-colors shadow-2xs"
            ></textarea>
          </div>

          <div class="pt-2 flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-4">
            <button
              type="submit"
              class="min-h-11 px-6 py-2.5 rounded-xl bg-blue-600 text-xs font-bold uppercase tracking-wider text-white shadow-xs hover:bg-blue-700 active:translate-y-0.5 transition-all cursor-pointer font-mono inline-flex items-center justify-center gap-2"
            >
              <span>Compose Message</span>
              <span aria-hidden="true">&rarr;</span>
            </button>

            <p class="text-xs text-slate-500 dark:text-slate-400">
              We use privacy-first, cookie-free Cloudflare Web Analytics to measure site performance with zero session recording.
            </p>
          </div>

          <div id="contact-status" class="hidden mt-4 rounded-xl border border-emerald-300/80 bg-emerald-50/90 p-4 text-xs font-mono text-emerald-900 dark:border-emerald-500/30 dark:bg-emerald-500/10 dark:text-emerald-300" role="status" aria-live="polite">
            Preparing your transmission to {site.contactEmail}. If your email client does not open automatically, please send directly to <a href={contactMailto} class="underline font-bold">{site.contactEmail}</a>.
          </div>
        </form>

        <script is:inline>
          document.getElementById('contact-form')?.addEventListener('submit', function(e) {
            var name = document.getElementById('contact-name')?.value || '';
            var email = document.getElementById('contact-email')?.value || '';
            var subject = document.getElementById('contact-subject')?.value || 'Signal Insight Inquiry';
            var body = document.getElementById('contact-message')?.value || '';
            var status = document.getElementById('contact-status');
            
            var fullBody = body + '\n\n---\nSent by: ' + name + ' (' + email + ')';
            var mailto = 'mailto:editorial@signal-insight.pages.dev?subject=' + encodeURIComponent(subject) + '&body=' + encodeURIComponent(fullBody);
            
            if (status) {
              status.classList.remove('hidden');
            }
            window.location.href = mailto;
            e.preventDefault();
          });
        </script>

        <!-- Secondary GitHub Issues Path -->
        <div class="mt-8 pt-6 border-t border-slate-100 dark:border-white/[0.08] flex items-center justify-between text-xs text-slate-600 dark:text-slate-400">
          <span>For reproducible bugs and code errata, open an issue on <a href="https://github.com/Akm4033/signal-insight/issues" target="_blank" rel="noopener noreferrer" class="font-semibold text-blue-600 dark:text-blue-400 hover:underline">GitHub</a>.</span>
          <a href="https://github.com/Akm4033/signal-insight/issues" target="_blank" rel="noopener noreferrer" class="font-mono font-bold text-slate-700 dark:text-slate-300 hover:text-blue-600 dark:hover:text-blue-400">Issues &rarr;</a>
        </div>
      </div>

    </div>
  </div>
</Base>
