---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

// Environment-configurable form backend (e.g. Web3Forms or Formspree)
// Provide PUBLIC_WEB3FORMS_KEY in your hosting dashboard or .env to activate live email relay.
const web3formsKey = import.meta.env.PUBLIC_WEB3FORMS_KEY || process.env.PUBLIC_WEB3FORMS_KEY || '';
const isFormLive = Boolean(web3formsKey && web3formsKey.trim().length > 0);
---

<Layout
  title="Contact Us | Micro Signal Cosmos"
  description="Get in touch with the Micro Signal Cosmos editorial team for story inquiries, feedback, corrections, and partnerships."
  canonical="https://microsignalcosmos.com/contact/"
>
  <Header />

  <main id="main-content" class="bg-[#F7F9FC] py-12 sm:py-20">
    <div class="container-main">

      <!-- Breadcrumbs -->
      <nav aria-label="Breadcrumb" class="mb-8">
        <ol class="flex items-center gap-2 text-xs text-[#697586]">
          <li>
            <a href="/" class="transition-colors hover:text-[#14233B]">Home</a>
          </li>
          <li aria-hidden="true" class="text-slate-300">/</li>
          <li aria-current="page" class="font-medium text-[#14233B]">Contact Us</li>
        </ol>
      </nav>

      <!-- Header Section -->
      <div class="mx-auto max-w-3xl text-center">
        <div class="inline-flex items-center gap-2 rounded-full border border-[#E3E8EF] bg-white px-3.5 py-1.5 shadow-xs">
          <span class="h-2 w-2 rounded-full bg-[#3478F6]"></span>
          <span class="text-xs font-semibold tracking-wider text-[#14233B] uppercase">
            Communications Desk
          </span>
        </div>

        <h1 class="mt-6 text-3xl font-extrabold tracking-tight text-[#14233B] sm:text-5xl">
          Connect With <span class="text-[#3478F6]">Our Editorial Desk</span>
        </h1>

        <p class="mt-4 text-base leading-relaxed text-[#4B5565] sm:text-lg">
          Whether you have feedback on an article, a research paper to share, or an editorial correction, we welcome your inquiry.
        </p>
      </div>

      <!-- Communication Channels Grid -->
      <section class="mx-auto mt-12 max-w-4xl" aria-labelledby="channels-heading">
        <h2 id="channels-heading" class="sr-only">Communication Channels</h2>
        <div class="grid gap-6 sm:grid-cols-3">
          <!-- Editorial & Pitches -->
          <div class="rounded-xl border border-[#E3E8EF] bg-white p-6 shadow-xs transition-all hover:border-[#3478F6]">
            <span class="inline-flex h-9 w-9 items-center justify-center rounded-lg bg-[#3478F6]/10 text-xs font-bold text-[#3478F6]">
              ED
            </span>
            <h3 class="mt-4 text-base font-bold text-[#14233B]">Editorial Inquiries</h3>
            <p class="mt-1 text-xs leading-relaxed text-[#697586]">
              Story suggestions, research leads, and reader commentary on published dispatches.
            </p>
            <a href="#contact-message" class="mt-4 inline-flex items-center gap-1 text-xs font-semibold text-[#3478F6]">
              <span>Compose Message</span>
              <span aria-hidden="true">&darr;</span>
            </a>
          </div>

          <!-- Corrections & Accuracy -->
          <div class="rounded-xl border border-[#E3E8EF] bg-white p-6 shadow-xs transition-all hover:border-[#3478F6]">
            <span class="inline-flex h-9 w-9 items-center justify-center rounded-lg bg-[#14233B]/10 text-xs font-bold text-[#14233B]">
              QC
            </span>
            <h3 class="mt-4 text-base font-bold text-[#14233B]">Corrections Desk</h3>
            <p class="mt-1 text-xs leading-relaxed text-[#697586]">
              Spotted a factual or numerical discrepancy? Help us maintain peer-level accuracy.
            </p>
            <a href="/corrections-policy/" class="mt-4 inline-flex items-center gap-1 text-xs font-semibold text-[#3478F6]">
              <span>Review Policy &rarr;</span>
            </a>
          </div>

          <!-- Media & Partnerships -->
          <div class="rounded-xl border border-[#E3E8EF] bg-white p-6 shadow-xs transition-all hover:border-[#3478F6]">
            <span class="inline-flex h-9 w-9 items-center justify-center rounded-lg bg-emerald-500/10 text-xs font-bold text-emerald-600">
              PR
            </span>
            <h3 class="mt-4 text-base font-bold text-[#14233B]">Media & Partnerships</h3>
            <p class="mt-1 text-xs leading-relaxed text-[#697586]">
              Syndication quotes, press inquiries, and educational collaboration requests.
            </p>
            <a href="#contact-message" class="mt-4 inline-flex items-center gap-1 text-xs font-semibold text-[#3478F6]">
              <span>Send Request</span>
              <span aria-hidden="true">&darr;</span>
            </a>
          </div>
        </div>
      </section>

      <!-- Contact Form & Sidebar Section -->
      <div class="mx-auto mt-10 grid max-w-4xl gap-8 lg:grid-cols-5">

        <!-- Form Column -->
        <div class="rounded-2xl border border-[#E3E8EF] bg-white p-8 shadow-sm sm:p-10 lg:col-span-3">
          <h2 class="text-xl font-bold text-[#14233B]">Send a Message</h2>
          <p class="mt-1 text-xs text-[#697586]">
            Our editorial staff reviews reader communications regularly, typically responding within 24 to 48 business hours.
          </p>

          {isFormLive ? (
            <form
              action="https://api.web3forms.com/submit"
              method="POST"
              class="mt-6 space-y-4"
            >
              <input type="hidden" name="access_key" value={web3formsKey} />
              <input type="hidden" name="subject" value="Transmission to Micro Signal Cosmos" />
              <input type="hidden" name="from_name" value="Micro Signal Cosmos Reader Desk" />
              <!-- Honeypot Spam Protection -->
              <input type="checkbox" name="botcheck" class="hidden" style="display: none;" tabindex="-1" autocomplete="off" />

              <div>
                <label for="contact-name" class="block text-xs font-semibold text-[#14233B]">
                  Your Name
                </label>
                <input
                  type="text"
                  id="contact-name"
                  name="name"
                  required
                  placeholder="e.g. Sarah Connor"
                  class="mt-1.5 w-full rounded-lg border border-[#E3E8EF] bg-white px-3.5 py-2.5 text-sm text-[#202938] placeholder-[#9AA4B2] shadow-xs focus:border-[#3478F6] focus:outline-none focus:ring-2 focus:ring-[#3478F6]/20"
                />
              </div>

              <div>
                <label for="contact-email" class="block text-xs font-semibold text-[#14233B]">
                  Email Address
                </label>
                <input
                  type="email"
                  id="contact-email"
                  name="email"
                  required
                  placeholder="reader@example.com"
                  class="mt-1.5 w-full rounded-lg border border-[#E3E8EF] bg-white px-3.5 py-2.5 text-sm text-[#202938] placeholder-[#9AA4B2] shadow-xs focus:border-[#3478F6] focus:outline-none focus:ring-2 focus:ring-[#3478F6]/20"
                />
              </div>

              <div>
                <label for="contact-topic" class="block text-xs font-semibold text-[#14233B]">
                  Inquiry Topic
                </label>
                <select
                  id="contact-topic"
                  name="topic"
                  class="mt-1.5 w-full rounded-lg border border-[#E3E8EF] bg-white px-3.5 py-2.5 text-sm text-[#202938] shadow-xs focus:border-[#3478F6] focus:outline-none focus:ring-2 focus:ring-[#3478F6]/20"
                >
                  <option value="general">General Reader Inquiry</option>
                  <option value="editorial">Editorial / Article Feedback</option>
                  <option value="correction">Correction Report</option>
                  <option value="press">Media & Collaboration</option>
                </select>
              </div>

              <div>
                <label for="contact-message" class="block text-xs font-semibold text-[#14233B]">
                  Message
                </label>
                <textarea
                  id="contact-message"
                  name="message"
                  rows="4"
                  required
                  minlength="10"
                  placeholder="Please provide clear details regarding your inquiry or story lead..."
                  class="mt-1.5 w-full rounded-lg border border-[#E3E8EF] bg-white px-3.5 py-2.5 text-sm text-[#202938] placeholder-[#9AA4B2] shadow-xs focus:border-[#3478F6] focus:outline-none focus:ring-2 focus:ring-[#3478F6]/20"
                ></textarea>
              </div>

              <button
                type="submit"
                class="w-full rounded-lg bg-[#3478F6] py-3 text-xs font-semibold text-white shadow-xs transition-colors hover:bg-[#2563EB] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#3478F6]"
              >
                Send Message
              </button>
            </form>
          ) : (
            <form
              class="mt-6 space-y-4"
              onsubmit="event.preventDefault(); document.getElementById('relay-notice')?.classList.remove('hidden');"
            >
              <input type="checkbox" name="botcheck" class="hidden" style="display: none;" tabindex="-1" autocomplete="off" />

              <div>
                <label for="contact-name" class="block text-xs font-semibold text-[#14233B]">
                  Your Name
                </label>
                <input
                  type="text"
                  id="contact-name"
                  name="name"
                  required
                  placeholder="e.g. Sarah Connor"
                  class="mt-1.5 w-full rounded-lg border border-[#E3E8EF] bg-white px-3.5 py-2.5 text-sm text-[#202938] placeholder-[#9AA4B2] shadow-xs focus:border-[#3478F6] focus:outline-none focus:ring-2 focus:ring-[#3478F6]/20"
                />
              </div>

              <div>
                <label for="contact-email" class="block text-xs font-semibold text-[#14233B]">
                  Email Address
                </label>
                <input
                  type="email"
                  id="contact-email"
                  name="email"
                  required
                  placeholder="reader@example.com"
                  class="mt-1.5 w-full rounded-lg border border-[#E3E8EF] bg-white px-3.5 py-2.5 text-sm text-[#202938] placeholder-[#9AA4B2] shadow-xs focus:border-[#3478F6] focus:outline-none focus:ring-2 focus:ring-[#3478F6]/20"
                />
              </div>

              <div>
                <label for="contact-topic" class="block text-xs font-semibold text-[#14233B]">
                  Inquiry Topic
                </label>
                <select
                  id="contact-topic"
                  name="topic"
                  class="mt-1.5 w-full rounded-lg border border-[#E3E8EF] bg-white px-3.5 py-2.5 text-sm text-[#202938] shadow-xs focus:border-[#3478F6] focus:outline-none focus:ring-2 focus:ring-[#3478F6]/20"
                >
                  <option value="general">General Reader Inquiry</option>
                  <option value="editorial">Editorial / Article Feedback</option>
                  <option value="correction">Correction Report</option>
                  <option value="press">Media & Collaboration</option>
                </select>
              </div>

              <div>
                <label for="contact-message" class="block text-xs font-semibold text-[#14233B]">
                  Message
                </label>
                <textarea
                  id="contact-message"
                  name="message"
                  rows="4"
                  required
                  minlength="10"
                  placeholder="Please provide clear details regarding your inquiry or story lead..."
                  class="mt-1.5 w-full rounded-lg border border-[#E3E8EF] bg-white px-3.5 py-2.5 text-sm text-[#202938] placeholder-[#9AA4B2] shadow-xs focus:border-[#3478F6] focus:outline-none focus:ring-2 focus:ring-[#3478F6]/20"
                ></textarea>
              </div>

              <button
                type="submit"
                class="w-full rounded-lg bg-[#3478F6] py-3 text-xs font-semibold text-white shadow-xs transition-colors hover:bg-[#2563EB] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#3478F6]"
              >
                Send Message
              </button>

              <div id="relay-notice" role="status" aria-live="polite" class="hidden rounded-xl border border-blue-200 bg-blue-50 p-4 text-xs text-blue-900">
                <p class="font-bold text-[#14233B]">Mail Relay In Preparation</p>
                <p class="mt-1 text-[#4B5565]">
                  Thank you for your message. Live transmission requires configuring the <code class="rounded bg-white px-1.5 py-0.5 font-mono text-xs border border-blue-200">PUBLIC_WEB3FORMS_KEY</code> environment variable in your Cloudflare Pages dashboard as detailed in <code class="rounded bg-white px-1.5 py-0.5 font-mono text-xs border border-blue-200">DEPLOYMENT.md</code>.
                </p>
              </div>

              <p class="text-center text-[11px] text-[#697586]">
                Notice: Electronic messages are routed to our editorial verification queue.
              </p>
            </form>
          )}
        </div>

        <!-- Sidebar Information Column -->
        <div class="flex flex-col justify-between gap-6 rounded-2xl border border-[#E3E8EF] bg-white p-8 shadow-sm lg:col-span-2">
          <div>
            <h3 class="text-xs font-bold uppercase tracking-wider text-[#14233B]">
              Official Channels
            </h3>
            <p class="mt-2 text-xs leading-relaxed text-[#697586]">
              Follow Micro Signal Cosmos across our verified digital presence:
            </p>

            <div class="mt-5 space-y-3">
              <a
                href="https://www.facebook.com/profile.php?id=61596288235891"
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center justify-between rounded-lg border border-[#E3E8EF] bg-[#F7F9FC] px-4 py-3 text-xs font-semibold text-[#14233B] transition-colors hover:border-[#3478F6] hover:text-[#3478F6]"
              >
                <span>Facebook Community</span>
                <span aria-hidden="true">&rarr;</span>
              </a>

              <a
                href="https://www.youtube.com/@MicroSignalCosmos"
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center justify-between rounded-lg border border-[#E3E8EF] bg-[#F7F9FC] px-4 py-3 text-xs font-semibold text-[#14233B] transition-colors hover:border-[#3478F6] hover:text-[#3478F6]"
              >
                <span>YouTube Channel</span>
                <span aria-hidden="true">&rarr;</span>
              </a>
            </div>
          </div>

          <div class="border-t border-[#E3E8EF] pt-6">
            <h4 class="text-xs font-bold uppercase tracking-wider text-[#14233B]">
              Publisher Notice
            </h4>
            <p class="mt-2 text-xs leading-relaxed text-[#697586]">
              <strong class="font-semibold text-[#14233B]">Micro Signal Cosmos</strong><br />
              Independent digital technology and science publication.<br />
              Target domain: <span class="font-mono text-[11px]">microsignalcosmos.com</span><br />
              All editorial transmissions are archived in accordance with our data privacy guidelines.
            </p>
          </div>
        </div>

      </div>

    </div>
  </main>

  <Footer />
</Layout>
