---
import Base from '../layouts/Base.astro';

const web3formsKey = import.meta.env.PUBLIC_WEB3FORMS_KEY || process.env.PUBLIC_WEB3FORMS_KEY || '';
const isFormLive = Boolean(web3formsKey && web3formsKey.trim().length > 0);

const siteUrl = 'https://microsignalcosmos.com';
const contactUrl = `${siteUrl}/contact/`;
---

<Base
  title="Contact & Corrections | Micro Signal Cosmos"
  description="Get in touch with the Micro Signal Cosmos team for article feedback, technical errata, rapid corrections, or collaboration inquiries."
  canonical={contactUrl}
>
  <main id="main-content" class="bg-neutral-50 py-12 sm:py-20 border-b border-neutral-200 dark:bg-neutral-900/50 dark:border-neutral-800">
    <div class="container-narrow">

      <!-- Breadcrumbs -->
      <nav aria-label="Breadcrumb" class="mb-8">
        <ol class="flex items-center gap-2 text-xs text-text-muted">
          <li>
            <a href="/" class="transition-colors hover:text-brand-primary">Home</a>
          </li>
          <li aria-hidden="true" class="text-neutral-400">/</li>
          <li class="font-semibold text-text-primary" aria-current="page">Contact Desk</li>
        </ol>
      </nav>

      <!-- Hero Header -->
      <header class="mb-12">
        <div class="inline-flex items-center gap-2 rounded-full border border-neutral-200 bg-white px-3.5 py-1 text-xs font-bold tracking-widest text-brand-primary uppercase shadow-xs dark:border-neutral-700 dark:bg-neutral-900">
          <span class="h-1.5 w-1.5 rounded-full bg-brand-primary"></span>
          <span>Contact &amp; Errata</span>
        </div>
        <h1 class="mt-4 text-3xl font-extrabold tracking-tight text-text-primary sm:text-4xl">
          Get in Touch
        </h1>
        <p class="mt-4 text-base sm:text-lg leading-relaxed text-text-secondary">
          Have feedback on an investigation, found a code errata, or want to suggest a technical topic? We respond promptly.
        </p>
      </header>

      <!-- Direct Contact Channels -->
      <div class="grid gap-6 sm:grid-cols-2 mb-12">
        <div class="rounded-2xl border border-neutral-200 bg-white p-6 shadow-xs dark:border-neutral-700 dark:bg-neutral-900">
          <h2 class="text-sm font-bold uppercase tracking-wider text-text-muted mb-2">Editorial Desk</h2>
          <p class="text-sm text-text-secondary">For questions, corrections, or suggestions:</p>
          <a href="mailto:admin@microsignalcosmos.com" class="mt-3 inline-block font-semibold text-brand-primary hover:underline">
            admin@microsignalcosmos.com
          </a>
        </div>
        <div class="rounded-2xl border border-neutral-200 bg-white p-6 shadow-xs dark:border-neutral-700 dark:bg-neutral-900">
          <h2 class="text-sm font-bold uppercase tracking-wider text-text-muted mb-2">Code Errata &amp; Issues</h2>
          <p class="text-sm text-text-secondary">Submit public corrections or bug reports via GitHub:</p>
          <a href="https://github.com/Akm4033/micro-signal-cosmos/issues" target="_blank" rel="noopener noreferrer" class="mt-3 inline-block font-semibold text-brand-primary hover:underline">
            GitHub Issues &rarr;
          </a>
        </div>
      </div>

      <!-- Contact Form -->
      <div class="rounded-2xl border border-neutral-200 bg-white p-6 sm:p-10 shadow-xs dark:border-neutral-700 dark:bg-neutral-900">
        <h2 class="text-xl font-bold text-text-primary mb-6">Send a Message</h2>
        <form
          action={isFormLive ? "https://api.web3forms.com/submit" : "mailto:admin@microsignalcosmos.com"}
          method={isFormLive ? "POST" : "GET"}
          class="space-y-6"
        >
          {isFormLive && <input type="hidden" name="access_key" value={web3formsKey} />}
          <div class="space-y-2">
            <label for="contact-name" class="block text-xs font-bold uppercase tracking-wider text-text-muted">Your Name</label>
            <input type="text" id="contact-name" name="name" required placeholder="Dr. Jane Doe" class="input" />
          </div>
          <div class="space-y-2">
            <label for="contact-email" class="block text-xs font-bold uppercase tracking-wider text-text-muted">Email Address</label>
            <input type="email" id="contact-email" name="email" required placeholder="jane@example.com" class="input" />
          </div>
          <div class="space-y-2">
            <label for="contact-subject" class="block text-xs font-bold uppercase tracking-wider text-text-muted">Subject</label>
            <input type="text" id="contact-subject" name="subject" required placeholder="Correction: How Browsers Render / Topic Request" class="input" />
          </div>
          <div class="space-y-2">
            <label for="contact-message" class="block text-xs font-bold uppercase tracking-wider text-text-muted">Message</label>
            <textarea id="contact-message" name="message" rows="5" required placeholder="Your message, code snippet errata, or inquiry..." class="input"></textarea>
          </div>
          <button type="submit" class="btn-primary w-full">
            <span>Send Message</span>
            <span aria-hidden="true">&rarr;</span>
          </button>
        </form>
      </div>

    </div>
  </main>
</Base>
