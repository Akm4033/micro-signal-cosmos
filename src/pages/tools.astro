---
import Base from '../layouts/Base.astro';
import InteractiveCalculators from '../components/tools/InteractiveCalculators.astro';

const siteUrl = Astro.site ? Astro.site.href.replace(/\/$/, '') : (process.env.SITE_URL || 'https://signal-insight.pages.dev');
const canonicalUrl = `${siteUrl}/tools/`;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Signal Insight Engineering Workbench & Utilities",
  "url": canonicalUrl,
  "description": "Interactive technical calculators for AI token inference pricing, network bandwidth-delay product (BDP) buffer sizing, and cosmic redshift lookback time.",
  "applicationCategory": "DeveloperApplication",
  "operatingSystem": "All",
  "browserRequirements": "Requires JavaScript. Requires HTML5.",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "publisher": {
    "@type": "Organization",
    "name": "Signal Insight",
    "url": siteUrl
  }
};
---

<Base title="Interactive Engineering Tools & Resources | Signal Insight" description="Interactive engineering calculators for AI inference costs, network BDP buffer sizing, cosmic redshift, and curated technical resources." canonical={canonicalUrl}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <div class="container-narrow py-12 sm:py-16">
    <header class="mb-10">
      <div class="inline-flex items-center gap-2 rounded-full border border-neutral-200 bg-white px-3.5 py-1 text-xs font-bold tracking-widest text-brand-primary uppercase shadow-xs dark:border-white/[0.08] dark:bg-[#0B101D] dark:text-blue-400">
        <span class="h-1.5 w-1.5 rounded-full bg-brand-primary"></span>
        <span class="font-mono text-[10.5px]">Technical Utilities &amp; Stack</span>
      </div>
      <h1 class="mt-4 text-display font-extrabold tracking-tight text-text-primary">Tools &amp; Engineering Workbench</h1>
      <p class="mt-4 text-lead text-text-secondary">Interactive technical calculators for systems architects and researchers, alongside the battle-tested infrastructure powering Signal Insight.</p>
    </header>

    <!-- Interactive Technical Calculators -->
    <InteractiveCalculators />

    <div class="mt-14 mb-8 border-t border-neutral-200 pt-10 dark:border-white/[0.08]">
      <h2 class="text-display-sm font-bold tracking-tight text-text-primary">Curated Stack &amp; Recommended Infrastructure</h2>
      <p class="mt-2 text-sm text-text-secondary">Production-proven developer tools and infrastructure we personally run and recommend.</p>
      <p class="mt-1 text-xs text-text-muted"><strong>Affiliate disclosure:</strong> Links marked <strong>★</strong> are affiliate partner links. We earn a commission at no extra cost to you if you purchase through our links. <a href="/about/#business-model" class="text-brand-primary underline">Full disclosure &rarr;</a></p>
    </div>

    <!-- Development Environment -->
    <section class="mb-16">
      <h2 class="text-h2 font-bold text-text-primary mb-8">Development Environment</h2>
      <dl class="space-y-6">
        <div class="grid gap-2 sm:grid-cols-[200px_1fr] items-start">
          <dt class="font-semibold text-text-primary">VS Code</dt>
          <dd class="text-text-secondary">Best extension ecosystem, remote SSH, and container development integration.</dd>
        </div>
        <div class="grid gap-2 sm:grid-cols-[200px_1fr] items-start">
          <dt class="font-semibold text-text-primary">GitHub Copilot ★</dt>
          <dd class="text-text-secondary">Assistance for boilerplate, unit tests, regex, and complex SQL queries. <a href="https://github.com/features/copilot" class="text-brand-primary underline" target="_blank" rel="sponsored nofollow noopener">Learn more &rarr;</a></dd>
        </div>
        <div class="grid gap-2 sm:grid-cols-[200px_1fr] items-start">
          <dt class="font-semibold text-text-primary">Cursor ★</dt>
          <dd class="text-text-secondary">AI-assisted editor with fast multi-file refactoring and inline diffing. <a href="https://cursor.sh/" class="text-brand-primary underline" target="_blank" rel="sponsored nofollow noopener">Learn more &rarr;</a></dd>
        </div>
        <div class="grid gap-2 sm:grid-cols-[200px_1fr] items-start">
          <dt class="font-semibold text-text-primary">Raycast ★</dt>
          <dd class="text-text-secondary">Spotlight replacement with clipboard history, window management, and custom scripts. <a href="https://raycast.com/?ref=signalinsight" class="text-brand-primary underline" target="_blank" rel="sponsored nofollow noopener">Learn more &rarr;</a></dd>
        </div>
        <div class="grid gap-2 sm:grid-cols-[200px_1fr] items-start">
          <dt class="font-semibold text-text-primary">Warp ★</dt>
          <dd class="text-text-secondary">Modern GPU-accelerated terminal with command search and team workflows. <a href="https://www.warp.dev/?ref=signalinsight" class="text-brand-primary underline" target="_blank" rel="sponsored nofollow noopener">Learn more &rarr;</a></dd>
        </div>
        <div class="grid gap-2 sm:grid-cols-[200px_1fr] items-start">
          <dt class="font-semibold text-text-primary">Obsidian</dt>
          <dd class="text-text-secondary">Local-first Markdown knowledge base with canvas and link graph exploration.</dd>
        </div>
      </dl>
    </section>

    <!-- Research & Writing Tools -->
    <section class="mb-16">
      <h2 class="text-h2 font-bold text-text-primary mb-8">Research &amp; Writing Tools</h2>
      <dl class="space-y-6">
        <div class="grid gap-2 sm:grid-cols-[200px_1fr] items-start">
          <dt class="font-semibold text-text-primary">AI Research Assistant</dt>
          <dd class="text-text-secondary">Long-context analysis, architectural review, code exploration, and technical synthesis.</dd>
        </div>
        <div class="grid gap-2 sm:grid-cols-[200px_1fr] items-start">
          <dt class="font-semibold text-text-primary">Technical Search</dt>
          <dd class="text-text-secondary">Primary citation discovery, technical literature exploration, and documentation search.</dd>
        </div>
        <div class="grid gap-2 sm:grid-cols-[200px_1fr] items-start">
          <dt class="font-semibold text-text-primary">Document Synthesis</dt>
          <dd class="text-text-secondary">Grounded source synthesis over technical specs, arXiv papers, and documentation.</dd>
        </div>
      </dl>
    </section>

    <!-- Hosting & Infrastructure -->
    <section class="mb-16">
      <h2 class="text-h2 font-bold text-text-primary mb-8">Hosting &amp; Infrastructure</h2>
      <dl class="space-y-6">
        <div class="grid gap-2 sm:grid-cols-[200px_1fr] items-start">
          <dt class="font-semibold text-text-primary">Cloudflare Pages</dt>
          <dd class="text-text-secondary">Hosts this publication with edge CDN distribution, instant preview builds, and zero cold starts.</dd>
        </div>
        <div class="grid gap-2 sm:grid-cols-[200px_1fr] items-start">
          <dt class="font-semibold text-text-primary">Hetzner Cloud ★</dt>
          <dd class="text-text-secondary">Self-hosted infrastructure: Docker, Postgres, Redis, MinIO, and internal Prometheus monitoring. <a href="https://www.hetzner.com/cloud?ref=signalinsight" class="text-brand-primary underline" target="_blank" rel="sponsored nofollow noopener">View Hetzner &rarr;</a></dd>
        </div>
        <div class="grid gap-2 sm:grid-cols-[200px_1fr] items-start">
          <dt class="font-semibold text-text-primary">DigitalOcean ★</dt>
          <dd class="text-text-secondary">Managed Kubernetes, Spaces object storage, and staging droplets. <a href="https://www.digitalocean.com/?ref=signalinsight" class="text-brand-primary underline" target="_blank" rel="sponsored nofollow noopener">View DigitalOcean &rarr;</a></dd>
        </div>
        <div class="grid gap-2 sm:grid-cols-[200px_1fr] items-start">
          <dt class="font-semibold text-text-primary">Railway ★</dt>
          <dd class="text-text-secondary">Fast deployment for microservices, Redis workers, and internal APIs. <a href="https://railway.app/?ref=signalinsight" class="text-brand-primary underline" target="_blank" rel="sponsored nofollow noopener">View Railway &rarr;</a></dd>
        </div>
        <div class="grid gap-2 sm:grid-cols-[200px_1fr] items-start">
          <dt class="font-semibold text-text-primary">Supabase ★</dt>
          <dd class="text-text-secondary">Managed Postgres with row-level security, auth, and realtime subscriptions. <a href="https://supabase.com/?utm_source=signalinsight" class="text-brand-primary underline" target="_blank" rel="sponsored nofollow noopener">View Supabase &rarr;</a></dd>
        </div>
        <div class="grid gap-2 sm:grid-cols-[200px_1fr] items-start">
          <dt class="font-semibold text-text-primary">Turso ★</dt>
          <dd class="text-text-secondary">Edge-replicated libSQL database with sub-millisecond query times worldwide. <a href="https://turso.tech/?ref=signalinsight" class="text-brand-primary underline" target="_blank" rel="sponsored nofollow noopener">View Turso &rarr;</a></dd>
        </div>
      </dl>
    </section>

    <!-- Databases & Data -->
    <section class="mb-16">
      <h2 class="text-h2 font-bold text-text-primary mb-8">Databases &amp; Data</h2>
      <dl class="space-y-6">
        <div class="grid gap-2 sm:grid-cols-[200px_1fr] items-start">
          <dt class="font-semibold text-text-primary">PostgreSQL 16</dt>
          <dd class="text-text-secondary">Primary transactional engine with JSONB, pgvector, and native partitioning.</dd>
        </div>
        <div class="grid gap-2 sm:grid-cols-[200px_1fr] items-start">
          <dt class="font-semibold text-text-primary">Redis / Valkey</dt>
          <dd class="text-text-secondary">In-memory caching, rate-limiting, and high-throughput job queues.</dd>
        </div>
        <div class="grid gap-2 sm:grid-cols-[200px_1fr] items-start">
          <dt class="font-semibold text-text-primary">ClickHouse</dt>
          <dd class="text-text-secondary">High-speed columnar analytics and telemetry ingestion.</dd>
        </div>
        <div class="grid gap-2 sm:grid-cols-[200px_1fr] items-start">
          <dt class="font-semibold text-text-primary">Qdrant ★</dt>
          <dd class="text-text-secondary">Production vector similarity search engine with HNSW indexing and payload filtering. <a href="https://qdrant.tech/?partner=signalinsight" class="text-brand-primary underline" target="_blank" rel="sponsored nofollow noopener">View Qdrant &rarr;</a></dd>
        </div>
        <div class="grid gap-2 sm:grid-cols-[200px_1fr] items-start">
          <dt class="font-semibold text-text-primary">DuckDB</dt>
          <dd class="text-text-secondary">Fast in-process SQL OLAP engine for Parquet datasets and browser-based WASM analysis.</dd>
        </div>
      </dl>
    </section>

    <!-- Affiliate Programs -->
    <section class="mb-16">
      <h2 class="text-h2 font-bold text-text-primary mb-8">Affiliate Programs We Participate In</h2>
      <div class="grid gap-4 sm:grid-cols-2">
        <div class="rounded-xl border border-neutral-200 bg-neutral-50 p-5 dark:border-white/[0.08] dark:bg-[#0B101D]">
          <h3 class="font-semibold text-text-primary">Infrastructure &amp; Compute</h3>
          <p class="mt-1 text-xs text-text-secondary">Hetzner Cloud, DigitalOcean, Lambda Labs, Railway</p>
        </div>
        <div class="rounded-xl border border-neutral-200 bg-neutral-50 p-5 dark:border-white/[0.08] dark:bg-[#0B101D]">
          <h3 class="font-semibold text-text-primary">Data &amp; Vector</h3>
          <p class="mt-1 text-xs text-text-secondary">Qdrant, Neon Serverless PG, Supabase, Turso</p>
        </div>
        <div class="rounded-xl border border-neutral-200 bg-neutral-50 p-5 dark:border-white/[0.08] dark:bg-[#0B101D]">
          <h3 class="font-semibold text-text-primary">Security &amp; Auth</h3>
          <p class="mt-1 text-xs text-text-secondary">Clerk, 1Password, YubiKey</p>
        </div>
        <div class="rounded-xl border border-neutral-200 bg-neutral-50 p-5 dark:border-white/[0.08] dark:bg-[#0B101D]">
          <h3 class="font-semibold text-text-primary">Analytics &amp; Syndication</h3>
          <p class="mt-1 text-xs text-text-secondary">Cloudflare Web Analytics, Open RSS 2.0</p>
        </div>
      </div>
    </section>

    <!-- How to Support -->
    <section>
      <h2 class="text-h2 font-bold text-text-primary mb-6">How to Support This Publication</h2>
      <ol class="list-decimal pl-6 space-y-3 text-text-secondary">
        <li>Use our links when evaluating or signing up for engineering tools you need.</li>
        <li>Share technical deep dives with your team or engineering channels.</li>
        <li>Subscribe to our open RSS 2.0 feed to get new architectures first.</li>
        <li>Report any broken links, configuration errata, or updates to help maintain quality.</li>
      </ol>
    </section>
  </div>
</Base>
