---
import Base from '../layouts/Base.astro';

const siteUrl = Astro.site ? Astro.site.href.replace(/\/$/, '') : (process.env.SITE_URL || 'https://Signal Insight.pages.dev');
const canonicalUrl = `${siteUrl}/tools/`;
---

<Base title="Tools & Resources | Signal Insight" description="The software, services, and infrastructure powering the Signal Insight knowledge platform." canonical={canonicalUrl}>
  <div class="container-narrow py-12 sm:py-16">
    <header class="mb-12">
      <h1 class="text-display font-extrabold tracking-tight text-text-primary">Tools &amp; Resources</h1>
      <p class="mt-4 text-lead text-text-secondary">Everything below is in our daily engineering workflow. We've tested alternatives; these are what stuck.</p>
      <p class="mt-2 text-sm text-text-muted"><strong>Affiliate disclosure:</strong> Links marked <strong>★</strong> are affiliate partner links. We earn a commission at no extra cost to you. We only link products we personally use in production and recommend to colleagues. <a href="/about/#business-model" class="text-brand-primary underline">Full disclosure &rarr;</a></p>
    </header>

    <!-- Development Environment -->
    <section class="mb-16">
      <h2 class="text-h2 font-bold text-text-primary mb-8">Development Environment</h2>
      <dl class="space-y-6">
        <div class="grid gap-2 sm:grid-cols-[200px_1fr] items-start">
          <dt class="font-semibold text-text-primary">VS Code</dt>
          <dd class="text-text-secondary">Best extension ecosystem, remote SSH, and container development integration.</dd>
        </div>
        <div class="grid gap-2 sm:grid-cols-[200px_1fr] items-start">
          <dt class="font-semibold text-text-primary">GitHub Copilot ★</dt>
          <dd class="text-text-secondary">Assistance for boilerplate, unit tests, regex, and complex SQL queries. <a href="https://github.com/features/copilot" class="text-brand-primary underline" target="_blank" rel="sponsored nofollow noopener">Learn more &rarr;</a></dd>
        </div>
        <div class="grid gap-2 sm:grid-cols-[200px_1fr] items-start">
          <dt class="font-semibold text-text-primary">Cursor ★</dt>
          <dd class="text-text-secondary">AI-assisted editor with fast multi-file refactoring and inline diffing. <a href="https://cursor.sh/" class="text-brand-primary underline" target="_blank" rel="sponsored nofollow noopener">Learn more &rarr;</a></dd>
        </div>
        <div class="grid gap-2 sm:grid-cols-[200px_1fr] items-start">
          <dt class="font-semibold text-text-primary">Raycast ★</dt>
          <dd class="text-text-secondary">Spotlight replacement with clipboard history, window management, and custom scripts. <a href="https://raycast.com/?ref=microsignal" class="text-brand-primary underline" target="_blank" rel="sponsored nofollow noopener">Learn more &rarr;</a></dd>
        </div>
        <div class="grid gap-2 sm:grid-cols-[200px_1fr] items-start">
          <dt class="font-semibold text-text-primary">Warp ★</dt>
          <dd class="text-text-secondary">Modern GPU-accelerated terminal with command search and team workflows. <a href="https://www.warp.dev/?ref=microsignal" class="text-brand-primary underline" target="_blank" rel="sponsored nofollow noopener">Learn more &rarr;</a></dd>
        </div>
        <div class="grid gap-2 sm:grid-cols-[200px_1fr] items-start">
          <dt class="font-semibold text-text-primary">Obsidian</dt>
          <dd class="text-text-secondary">Local-first Markdown knowledge base with canvas and link graph exploration.</dd>
        </div>
      </dl>
    </section>

    <!-- Research & Writing Tools -->
    <section class="mb-16">
      <h2 class="text-h2 font-bold text-text-primary mb-8">Research &amp; Writing Tools</h2>
      <dl class="space-y-6">
        <div class="grid gap-2 sm:grid-cols-[200px_1fr] items-start">
          <dt class="font-semibold text-text-primary">AI Research Assistant</dt>
          <dd class="text-text-secondary">Long-context analysis, architectural review, code exploration, and technical synthesis.</dd>
        </div>
        <div class="grid gap-2 sm:grid-cols-[200px_1fr] items-start">
          <dt class="font-semibold text-text-primary">Technical Search</dt>
          <dd class="text-text-secondary">Primary citation discovery, technical literature exploration, and documentation search.</dd>
        </div>
        <div class="grid gap-2 sm:grid-cols-[200px_1fr] items-start">
          <dt class="font-semibold text-text-primary">Document Synthesis</dt>
          <dd class="text-text-secondary">Grounded source synthesis over technical specs, arXiv papers, and documentation.</dd>
        </div>
      </dl>
    </section>

    <!-- Hosting & Infrastructure -->
    <section class="mb-16">
      <h2 class="text-h2 font-bold text-text-primary mb-8">Hosting &amp; Infrastructure</h2>
      <dl class="space-y-6">
        <div class="grid gap-2 sm:grid-cols-[200px_1fr] items-start">
          <dt class="font-semibold text-text-primary">Cloudflare Pages</dt>
          <dd class="text-text-secondary">Hosts this publication with edge CDN distribution, instant preview builds, and zero cold starts.</dd>
        </div>
        <div class="grid gap-2 sm:grid-cols-[200px_1fr] items-start">
          <dt class="font-semibold text-text-primary">Hetzner Cloud ★</dt>
          <dd class="text-text-secondary">Self-hosted infrastructure: Docker, Postgres, Redis, MinIO, and internal Prometheus monitoring. <a href="https://www.hetzner.com/cloud?ref=microsignal" class="text-brand-primary underline" target="_blank" rel="sponsored nofollow noopener">View Hetzner &rarr;</a></dd>
        </div>
        <div class="grid gap-2 sm:grid-cols-[200px_1fr] items-start">
          <dt class="font-semibold text-text-primary">DigitalOcean ★</dt>
          <dd class="text-text-secondary">Managed Kubernetes, Spaces object storage, and staging droplets. <a href="https://www.digitalocean.com/?ref=microsignal" class="text-brand-primary underline" target="_blank" rel="sponsored nofollow noopener">View DigitalOcean &rarr;</a></dd>
        </div>
        <div class="grid gap-2 sm:grid-cols-[200px_1fr] items-start">
          <dt class="font-semibold text-text-primary">Railway ★</dt>
          <dd class="text-text-secondary">Fast deployment for microservices, Redis workers, and internal APIs. <a href="https://railway.app/?ref=microsignal" class="text-brand-primary underline" target="_blank" rel="sponsored nofollow noopener">View Railway &rarr;</a></dd>
        </div>
        <div class="grid gap-2 sm:grid-cols-[200px_1fr] items-start">
          <dt class="font-semibold text-text-primary">Supabase ★</dt>
          <dd class="text-text-secondary">Managed Postgres with row-level security, auth, and realtime subscriptions. <a href="https://supabase.com/?utm_source=microsignal" class="text-brand-primary underline" target="_blank" rel="sponsored nofollow noopener">View Supabase &rarr;</a></dd>
        </div>
        <div class="grid gap-2 sm:grid-cols-[200px_1fr] items-start">
          <dt class="font-semibold text-text-primary">Turso ★</dt>
          <dd class="text-text-secondary">Edge-replicated libSQL database with sub-millisecond query times worldwide. <a href="https://turso.tech/?ref=microsignal" class="text-brand-primary underline" target="_blank" rel="sponsored nofollow noopener">View Turso &rarr;</a></dd>
        </div>
      </dl>
    </section>

    <!-- Databases & Data -->
    <section class="mb-16">
      <h2 class="text-h2 font-bold text-text-primary mb-8">Databases &amp; Data</h2>
      <dl class="space-y-6">
        <div class="grid gap-2 sm:grid-cols-[200px_1fr] items-start">
          <dt class="font-semibold text-text-primary">PostgreSQL 16</dt>
          <dd class="text-text-secondary">Primary transactional engine with JSONB, pgvector, and native partitioning.</dd>
        </div>
        <div class="grid gap-2 sm:grid-cols-[200px_1fr] items-start">
          <dt class="font-semibold text-text-primary">Redis / Valkey</dt>
          <dd class="text-text-secondary">In-memory caching, rate-limiting, and high-throughput job queues.</dd>
        </div>
        <div class="grid gap-2 sm:grid-cols-[200px_1fr] items-start">
          <dt class="font-semibold text-text-primary">ClickHouse</dt>
          <dd class="text-text-secondary">High-speed columnar analytics and telemetry ingestion.</dd>
        </div>
        <div class="grid gap-2 sm:grid-cols-[200px_1fr] items-start">
          <dt class="font-semibold text-text-primary">Qdrant ★</dt>
          <dd class="text-text-secondary">Production vector similarity search engine with HNSW indexing and payload filtering. <a href="https://qdrant.tech/?partner=microsignal" class="text-brand-primary underline" target="_blank" rel="sponsored nofollow noopener">View Qdrant &rarr;</a></dd>
        </div>
        <div class="grid gap-2 sm:grid-cols-[200px_1fr] items-start">
          <dt class="font-semibold text-text-primary">DuckDB</dt>
          <dd class="text-text-secondary">Fast in-process SQL OLAP engine for Parquet datasets and browser-based WASM analysis.</dd>
        </div>
      </dl>
    </section>

    <!-- Affiliate Programs -->
    <section class="mb-16">
      <h2 class="text-h2 font-bold text-text-primary mb-8">Affiliate Programs We Participate In</h2>
      <div class="grid gap-4 sm:grid-cols-2">
        <div class="rounded-xl border border-neutral-200 bg-neutral-50 p-5 dark:border-white/[0.08] dark:bg-[#0B101D]">
          <h3 class="font-semibold text-text-primary">Infrastructure &amp; Compute</h3>
          <p class="mt-1 text-xs text-text-secondary">Hetzner Cloud, DigitalOcean, Lambda Labs, Railway</p>
        </div>
        <div class="rounded-xl border border-neutral-200 bg-neutral-50 p-5 dark:border-white/[0.08] dark:bg-[#0B101D]">
          <h3 class="font-semibold text-text-primary">Data &amp; Vector</h3>
          <p class="mt-1 text-xs text-text-secondary">Qdrant, Neon Serverless PG, Supabase, Turso</p>
        </div>
        <div class="rounded-xl border border-neutral-200 bg-neutral-50 p-5 dark:border-white/[0.08] dark:bg-[#0B101D]">
          <h3 class="font-semibold text-text-primary">Security &amp; Auth</h3>
          <p class="mt-1 text-xs text-text-secondary">Clerk, 1Password, YubiKey</p>
        </div>
        <div class="rounded-xl border border-neutral-200 bg-neutral-50 p-5 dark:border-white/[0.08] dark:bg-[#0B101D]">
          <h3 class="font-semibold text-text-primary">Analytics &amp; Syndication</h3>
          <p class="mt-1 text-xs text-text-secondary">Cloudflare Web Analytics, Open RSS 2.0</p>
        </div>
      </div>
    </section>

    <!-- How to Support -->
    <section>
      <h2 class="text-h2 font-bold text-text-primary mb-6">How to Support This Publication</h2>
      <ol class="list-decimal pl-6 space-y-3 text-text-secondary">
        <li>Use our links when evaluating or signing up for engineering tools you need.</li>
        <li>Share technical deep dives with your team or engineering channels.</li>
        <li>Subscribe to our open RSS 2.0 feed to get new architectures first.</li>
        <li>Report any broken links, configuration errata, or updates to help maintain quality.</li>
      </ol>
    </section>
  </div>
</Base>
