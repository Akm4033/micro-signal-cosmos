---
import Base from '../layouts/Base.astro';

const siteUrl = Astro.site ? Astro.site.href.replace(/\/$/, '') : (process.env.SITE_URL || 'https://signal-insight.pages.dev');
const pageUrl = `${siteUrl}/terms/`;
---

<Base
  title="Terms of Use | Signal Insight"
  description="Terms of Use for Signal Insight. Transparent guidance on reading, code reproduction, citations, and content usage."
  canonical={pageUrl}
>
  <div class="bg-neutral-50 py-12 sm:py-20 border-b border-neutral-200 dark:bg-[#05070E] dark:border-white/[0.08]">
    <div class="container-narrow">

      <!-- Breadcrumbs -->
      <nav aria-label="Breadcrumb" class="mb-8">
        <ol class="flex items-center gap-2 text-xs text-text-muted">
          <li>
            <a href="/" class="transition-colors hover:text-brand-primary">Home</a>
          </li>
          <li aria-hidden="true" class="text-neutral-400">/</li>
          <li class="font-semibold text-text-primary" aria-current="page">Terms of Use</li>
        </ol>
      </nav>

      <header class="mb-12">
        <h1 class="text-display font-extrabold tracking-tight text-text-primary">Terms of Use</h1>
        <p class="mt-4 text-lead text-text-secondary">Effective Date: November 2026</p>
      </header>

      <div class="prose-editorial max-w-none space-y-8">
        <section>
          <h2 class="text-h2 font-bold text-text-primary mb-4">1. Agreement to Terms</h2>
          <p class="text-text-secondary">
            By accessing or reading Signal Insight, you agree to these terms of service. If you do not agree, you may discontinue using the publication.
          </p>
        </section>

        <section>
          <h2 class="text-h2 font-bold text-text-primary mb-4">2. Code Snippets &amp; Permissive License</h2>
          <p class="text-text-secondary">
            Unless otherwise marked, all standalone code snippets and technical configuration templates published in our articles are provided under the MIT License. You are welcome and encouraged to test, modify, and integrate them into your own personal or commercial projects.
          </p>
        </section>

        <section>
          <h2 class="text-h2 font-bold text-text-primary mb-4">3. Editorial Copyright &amp; Attribution</h2>
          <p class="text-text-secondary">
            Written editorial prose, explanatory text, and bespoke architectural diagrams are &copy; 2026 Signal Insight. You may quote excerpts with clear attribution and a canonical backlink to the original article. Wholesale reproduction or automated scraping without permission is prohibited.
          </p>
        </section>

        <section>
          <h2 class="text-h2 font-bold text-text-primary mb-4">4. Technical Accuracy &amp; Disclaimer</h2>
          <p class="text-text-secondary">
            Articles are written for educational and systems architecture analysis. While every article undergoes rigorous human verification, benchmarking, and review, technical specifications, APIs, and cloud pricing change frequently. Always test in isolated environments before deploying to production.
          </p>
        </section>
      </div>

    </div>
  </div>
</Base>
