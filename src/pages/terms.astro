---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Terms of Service | Micro Signal Cosmos"
  description="Terms of Service governing your access and reading of the Micro Signal Cosmos digital publication."
  canonical="https://microsignalcosmos.com/terms/"
>
  <Header />

  <main id="main-content" class="bg-[#F7F9FC] py-12 sm:py-20">
    <div class="container-main">

      <!-- Breadcrumbs -->
      <nav aria-label="Breadcrumb" class="mb-8">
        <ol class="flex items-center gap-2 text-xs text-[#697586]">
          <li>
            <a href="/" class="transition-colors hover:text-[#14233B]">Home</a>
          </li>
          <li aria-hidden="true" class="text-slate-300">/</li>
          <li aria-current="page" class="font-medium text-[#14233B]">Terms of Service</li>
        </ol>
      </nav>

      <!-- Header Section -->
      <div class="mx-auto max-w-3xl text-center">
        <div class="inline-flex items-center gap-2 rounded-full border border-[#E3E8EF] bg-white px-3.5 py-1.5 shadow-xs">
          <span class="h-2 w-2 rounded-full bg-[#3478F6]"></span>
          <span class="text-xs font-semibold tracking-wider text-[#14233B] uppercase">
            User Agreement
          </span>
        </div>

        <h1 class="mt-6 text-3xl font-extrabold tracking-tight text-[#14233B] sm:text-5xl">
          Terms of <span class="text-[#3478F6]">Service</span>
        </h1>

        <p class="mt-4 text-xs font-medium uppercase tracking-widest text-[#697586]">
          Effective Date: November 2026 &bull; Last Revised: November 2026
        </p>

        <p class="mt-4 text-base leading-relaxed text-[#4B5565] sm:text-lg">
          Please review the rules governing access, reading, and fair quotation of Micro Signal Cosmos dispatches.
        </p>
      </div>

      <!-- Main Document -->
      <article class="mx-auto mt-12 max-w-3xl rounded-2xl border border-[#E3E8EF] bg-white p-8 sm:p-12 shadow-sm text-sm leading-relaxed text-[#4B5565] space-y-10">

        <!-- 1. Acceptance -->
        <section aria-labelledby="acceptance">
          <h2 id="acceptance" class="text-xl font-bold tracking-tight text-[#14233B]">
            1. Acceptance of Terms
          </h2>
          <p class="mt-3">
            By accessing, reading, or navigating <strong class="font-semibold text-[#14233B]">Micro Signal Cosmos</strong> ("the Website," "the Publication"), you acknowledge that you have read, understood, and agreed to be bound by these Terms of Service. If you do not agree with any provision herein, please discontinue use of the Website.
          </p>
        </section>

        <!-- 2. Intellectual Property & Copyright -->
        <section aria-labelledby="ip-copyright" class="border-t border-[#E3E8EF] pt-8">
          <h2 id="ip-copyright" class="text-xl font-bold tracking-tight text-[#14233B]">
            2. Intellectual Property & Copyright
          </h2>
          <p class="mt-3">
            All original editorial articles, research summaries, editorial visual artwork, branding marks, layout arrangements, and code presented on Micro Signal Cosmos are the proprietary intellectual property of Micro Signal Cosmos or its content creators and are protected by applicable copyright, trademark, and intellectual property laws.
          </p>
        </section>

        <!-- 3. Fair Use & Citation -->
        <section aria-labelledby="fair-use" class="border-t border-[#E3E8EF] pt-8">
          <h2 id="fair-use" class="text-xl font-bold tracking-tight text-[#14233B]">
            3. Fair Use Quotation & Academic Citation
          </h2>
          <p class="mt-3">
            We strongly encourage academic citation, educational commentary, and constructive discourse. You are granted permission to quote excerpts from our articles under the following conditions:
          </p>
          <ul class="mt-4 list-disc space-y-2 pl-6">
            <li><strong class="font-semibold text-[#14233B]">Length Limit:</strong> Quotes must be limited to fair excerpts (up to 150 words per article).</li>
            <li><strong class="font-semibold text-[#14233B]">Explicit Attribution:</strong> You must clearly credit <em>Micro Signal Cosmos</em> and the respective article title.</li>
            <li><strong class="font-semibold text-[#14233B]">Direct Hyperlink:</strong> You must provide a live, direct hyperlink back to the canonical article URL.</li>
            <li><strong class="font-semibold text-[#14233B]">No Mass Syndication:</strong> Full-article scraping, automated mirroring, or republishing of entire dispatches is strictly prohibited without prior written permission.</li>
          </ul>
        </section>

        <!-- 4. Acceptable Conduct -->
        <section aria-labelledby="conduct" class="border-t border-[#E3E8EF] pt-8">
          <h2 id="conduct" class="text-xl font-bold tracking-tight text-[#14233B]">
            4. Acceptable Reader Conduct & Security
          </h2>
          <p class="mt-3">
            When interacting with the Website or transmitting inquiries through our communication forms, you agree not to:
          </p>
          <ul class="mt-4 list-disc space-y-2 pl-6">
            <li>Engage in denial-of-service attacks, automated scrapers that degrade server capacity, or malicious vulnerability scans.</li>
            <li>Submit fraudulent, abusive, defamatory, or unsolicited promotional spam through our contact forms.</li>
            <li>Attempt to bypass security boundaries, inject unauthorized code, or tamper with page headers.</li>
          </ul>
        </section>

        <!-- 5. Educational Disclaimer Reference -->
        <section aria-labelledby="disclaimer-ref" class="border-t border-[#E3E8EF] pt-8">
          <h2 id="disclaimer-ref" class="text-xl font-bold tracking-tight text-[#14233B]">
            5. Informational Nature & No Warranty
          </h2>
          <p class="mt-3">
            The publication is provided on an "as is" and "as available" basis without warranties of any kind. All technical and scientific content is intended solely for educational and informational purposes. Please review our formal <a href="/disclaimer/" class="font-semibold text-[#3478F6] hover:underline">Editorial Disclaimer</a> for details.
          </p>
        </section>

        <!-- 6. Limitation of Liability -->
        <section aria-labelledby="liability" class="border-t border-[#E3E8EF] pt-8">
          <h2 id="liability" class="text-xl font-bold tracking-tight text-[#14233B]">
            6. Limitation of Liability
          </h2>
          <p class="mt-3">
            To the fullest extent permitted by applicable law, Micro Signal Cosmos, its editors, authors, and affiliates shall not be liable for any direct, indirect, incidental, consequential, or punitive damages arising from your access to, use of, or inability to access the Website or its content.
          </p>
        </section>

        <!-- 7. Modifications & Inquiries -->
        <section aria-labelledby="contact" class="border-t border-[#E3E8EF] pt-8">
          <h2 id="contact" class="text-xl font-bold tracking-tight text-[#14233B]">
            7. Revisions & Questions
          </h2>
          <p class="mt-3">
            We reserve the right to revise these Terms of Service at any time. Continued use of the Website constitutes acceptance of any revised terms. For inquiries regarding licensing, reprint permissions, or terms clarification, contact our desk via the <a href="/contact/" class="font-semibold text-[#3478F6] hover:underline">Contact Desk</a>.
          </p>
        </section>

      </article>

    </div>
  </main>

  <Footer />
</Layout>
