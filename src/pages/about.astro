---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { CATEGORIES } from '../data/categories';

const siteUrl = 'https://microsignalcosmos.com';
const aboutUrl = `${siteUrl}/about/`;

const aboutJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'AboutPage',
      '@id': `${aboutUrl}#aboutpage`,
      name: 'About Us | Micro Signal Cosmos',
      description: 'Learn about Micro Signal Cosmos, our mission, vision, and how we explore science, technology, and AI through clear, practical guides.',
      url: aboutUrl,
      mainEntity: {
        '@type': 'Organization',
        '@id': `${siteUrl}/#organization`,
      },
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${aboutUrl}#breadcrumb`,
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Home',
          item: `${siteUrl}/`,
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'About Us',
          item: aboutUrl,
        },
      ],
    },
  ],
};
---

<Layout
  title="About Us | Micro Signal Cosmos"
  description="Learn about Micro Signal Cosmos, our mission, vision, and how we explore science, technology, and AI through clear, practical guides."
  canonical={aboutUrl}
  jsonLd={aboutJsonLd}
>
  <Header />

  <main id="main-content" class="bg-[#F7F9FC] py-12 sm:py-20">
    <div class="container-main">

      <!-- Breadcrumbs -->
      <nav aria-label="Breadcrumb" class="mb-8">
        <ol class="flex items-center gap-2 text-xs text-[#697586]">
          <li>
            <a href="/" class="transition-colors hover:text-[#14233B]">Home</a>
          </li>
          <li aria-hidden="true" class="text-slate-300">/</li>
          <li aria-current="page" class="font-medium text-[#14233B]">About Us</li>
        </ol>
      </nav>

      <!-- Hero Header -->
      <div class="mx-auto max-w-3xl text-center">
        <div class="inline-flex items-center gap-2 rounded-full border border-[#E3E8EF] bg-white px-3.5 py-1.5 shadow-xs">
          <span class="h-2 w-2 rounded-full bg-[#3478F6]"></span>
          <span class="text-xs font-semibold tracking-wider text-[#14233B] uppercase">
            About the Publication
          </span>
        </div>

        <h1 class="mt-6 text-3xl font-extrabold tracking-tight text-[#14233B] sm:text-5xl lg:text-6xl">
          Discover More.
          <span class="mt-2 block text-[#3478F6]">
            Understand Better.
          </span>
        </h1>

        <p class="mt-6 text-base leading-relaxed text-[#4B5565] sm:text-lg">
          Micro Signal Cosmos is an independent digital publication exploring the frontiers of science, computing, artificial intelligence, and human innovation. We translate complex breakthroughs into clear, grounded, and accessible knowledge.
        </p>
      </div>

      <!-- Core Mission Card -->
      <div class="mx-auto mt-14 max-w-4xl rounded-2xl border border-[#E3E8EF] bg-white p-8 sm:p-12 shadow-sm">
        <span class="text-xs font-bold tracking-[0.2em] text-[#3478F6] uppercase">
          Our Publishing Philosophy
        </span>

        <h2 class="mt-3 text-2xl font-bold tracking-tight text-[#14233B] sm:text-3xl">
          Finding the Signal in a Universe of Noise
        </h2>

        <div class="mt-6 space-y-5 text-base leading-relaxed text-[#4B5565]">
          <p>
            In today's fast-moving digital ecosystem, information is ubiquitous, but genuine comprehension is rare. Daily feeds are flooded with sensational headlines, hype-driven narratives, and surface-level abstracts that leave readers more perplexed than enlightened.
          </p>

          <p>
            The name <strong class="font-semibold text-[#14233B]">Micro Signal Cosmos</strong> reflects our core philosophy: just as radio astronomers filter electromagnetic static to detect faint, revealing micro-signals from distant corners of the cosmos, we filter through internet noise to isolate the foundational engineering, AI architectures, and scientific discoveries that actually matter.
          </p>

          <p>
            Micro Signal Cosmos is a solo technical media publication. We operate with an AI-assisted workflow—leveraging modern language models (Claude, ChatGPT, Gemini, Perplexity) for comprehensive literature screening, comparative research, and initial drafting. Crucially, every line of code, architectural diagram, and factual assertion is verified, tested, and edited by human hands before publication.
          </p>

          <p>
            To present deep technical subjects with domain precision, our articles are written through three specialized domain lenses: <strong class="font-semibold text-[#0ea5e9]">Dr. Marina Kowalski</strong> (Systems Engineering & Browser Internals), <strong class="font-semibold text-emerald-600">Kai Nakamura</strong> (Machine Learning & LLM Infrastructure), and <strong class="font-semibold text-[#8b5cf6]">Dr. Arun Mehta</strong> (Astrophysics & Observational Science).
          </p>
        </div>
      </div>

      <!-- Core Pillars Grid -->
      <div class="mx-auto mt-16 max-w-5xl">
        <div class="text-center">
          <p class="text-xs font-bold tracking-[0.2em] text-[#0ea5e9] uppercase">
            Curated Knowledge Streams
          </p>
          <h2 class="mt-2 text-2xl font-bold tracking-tight text-[#14233B] sm:text-3xl">
            Our Core Coverage Pillars
          </h2>
          <p class="mx-auto mt-3 max-w-2xl text-sm text-[#697586]">
            Structured technical verticals designed for software engineers, ML researchers, and curious systems thinkers.
          </p>
        </div>

        <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
          {CATEGORIES.map((cat, index) => (
            <a
              href={cat.href}
              class="group flex flex-col justify-between rounded-xl border border-[#E3E8EF] bg-white p-6 shadow-xs transition-all duration-200 hover:-translate-y-1 hover:border-[#0ea5e9] hover:shadow-md"
            >
              <div>
                <div class="flex items-center justify-between">
                  <span class="flex h-10 w-10 items-center justify-center rounded-lg border border-[#E3E8EF] bg-[#F7F9FC] text-sm font-bold text-[#14233B] group-hover:border-[#0ea5e9]/30 group-hover:bg-sky-50 group-hover:text-[#0ea5e9]">
                    {cat.icon}
                  </span>
                  <span class="text-xs font-bold tracking-widest text-[#9AA4B2] uppercase">
                    0{index + 1}
                  </span>
                </div>
                <h3 class="mt-4 text-lg font-bold text-[#14233B] group-hover:text-[#0ea5e9]">
                  {cat.name}
                </h3>
                <p class="mt-2 text-xs leading-relaxed text-[#697586]">
                  {cat.description}
                </p>
              </div>

              <div class="mt-6 flex items-center gap-1.5 text-xs font-semibold text-[#0ea5e9]">
                <span>Explore stream</span>
                <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">&rarr;</span>
              </div>
            </a>
          ))}
        </div>
      </div>

      <!-- Publishing Process & Corrections Policy -->
      <div class="mx-auto mt-20 max-w-5xl border-t border-[#E3E8EF] pt-16">
        <div class="text-center">
          <p class="text-xs font-bold tracking-[0.2em] text-[#0ea5e9] uppercase">
            Transparency & Process
          </p>
          <h2 class="mt-2 text-2xl font-bold tracking-tight text-[#14233B] sm:text-3xl">
            How We Research, Build & Correct
          </h2>
          <p class="mx-auto mt-3 max-w-xl text-sm text-[#697586]">
            Our commitment to technical rigor, runnable code, and transparent corrections.
          </p>
        </div>

        <div class="mt-10 grid gap-6 sm:grid-cols-3">
          <div class="rounded-xl border border-[#E3E8EF] bg-white p-7 shadow-xs">
            <span class="inline-flex h-8 w-8 items-center justify-center rounded-full bg-sky-100 text-xs font-extrabold text-[#0ea5e9]">01</span>
            <h3 class="mt-4 text-base font-bold text-[#14233B]">Primary Sources & Code Verification</h3>
            <p class="mt-2 text-xs leading-relaxed text-[#697586]">
              We consult official specifications, run benchmarks, test scripts in live environments, and link directly to public documentation and papers.
            </p>
          </div>

          <div class="rounded-xl border border-[#E3E8EF] bg-white p-7 shadow-xs">
            <span class="inline-flex h-8 w-8 items-center justify-center rounded-full bg-sky-100 text-xs font-extrabold text-[#0ea5e9]">02</span>
            <h3 class="mt-4 text-base font-bold text-[#14233B]">Honest Business Model</h3>
            <p class="mt-2 text-xs leading-relaxed text-[#697586]">
              We are funded through non-intrusive display ads, transparent affiliate links for vetted tools (marked with ★), and digital technical products.
            </p>
          </div>

          <div class="rounded-xl border border-[#E3E8EF] bg-white p-7 shadow-xs">
            <span class="inline-flex h-8 w-8 items-center justify-center rounded-full bg-sky-100 text-xs font-extrabold text-[#0ea5e9]">03</span>
            <h3 class="mt-4 text-base font-bold text-[#14233B]">Rapid Corrections Policy</h3>
            <p class="mt-2 text-xs leading-relaxed text-[#697586]">
              Found a bug in a snippet or an outdated metric? Send a note via our contact page and we will verify, patch, and document the fix promptly.
            </p>
          </div>
        </div>

        <!-- Quick Navigation Grid -->
        <div class="mt-14 rounded-2xl border border-[#E3E8EF] bg-[#EEF1F5]/60 p-8">
          <h3 class="text-base font-bold text-[#14233B]">Explore Micro Signal Cosmos</h3>
          <p class="mt-1 text-xs text-[#697586]">
            Dive deeper into our technical library, author profiles, or engineering tools:
          </p>
          <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
            <a href="/articles/" class="rounded-lg border border-[#E3E8EF] bg-white p-4 text-left transition-colors hover:border-[#0ea5e9] hover:bg-slate-50">
              <span class="block text-xs font-bold text-[#14233B]">All 15 Articles &rarr;</span>
              <span class="mt-1 block text-[11px] text-[#697586]">Browse our complete library</span>
            </a>
            <a href="/authors/" class="rounded-lg border border-[#E3E8EF] bg-white p-4 text-left transition-colors hover:border-[#0ea5e9] hover:bg-slate-50">
              <span class="block text-xs font-bold text-[#14233B]">Author Lenses &rarr;</span>
              <span class="mt-1 block text-[11px] text-[#697586]">Marina, Kai & Arun</span>
            </a>
            <a href="/tools/" class="rounded-lg border border-[#E3E8EF] bg-white p-4 text-left transition-colors hover:border-[#0ea5e9] hover:bg-slate-50">
              <span class="block text-xs font-bold text-[#14233B]">Recommended Tools &rarr;</span>
              <span class="mt-1 block text-[11px] text-[#697586]">Cloud, AI & database stack</span>
            </a>
            <a href="/contact/" class="rounded-lg border border-[#E3E8EF] bg-white p-4 text-left transition-colors hover:border-[#0ea5e9] hover:bg-slate-50">
              <span class="block text-xs font-bold text-[#14233B]">Contact Us &rarr;</span>
              <span class="mt-1 block text-[11px] text-[#697586]">Feedback or report a fix</span>
            </a>
          </div>
        </div>

        <!-- Action Banner -->
        <div class="mt-12 flex flex-wrap items-center justify-between gap-4 rounded-xl border border-[#E3E8EF] bg-white p-6 shadow-xs sm:p-8">
          <div>
            <h4 class="text-base font-bold text-[#14233B]">Have feedback or spotted a fix?</h4>
            <p class="mt-1 text-xs text-[#697586]">We review reader suggestions and patch technical discrepancies promptly.</p>
          </div>
          <div class="flex items-center gap-3">
            <a
              href="/contact/"
              class="inline-flex items-center justify-center rounded-lg bg-[#0ea5e9] px-5 py-2.5 text-xs font-semibold text-white shadow-xs transition-colors hover:bg-[#0284c7]"
            >
              Contact Our Team
            </a>
            <a
              href="/articles/"
              class="inline-flex items-center justify-center rounded-lg border border-[#E3E8EF] bg-white px-5 py-2.5 text-xs font-semibold text-[#14233B] transition-colors hover:bg-slate-50"
            >
              Browse Articles
            </a>
          </div>
        </div>
      </div>

    </div>
  </main>

  <Footer />
</Layout>
