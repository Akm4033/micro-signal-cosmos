---
import Base from '../layouts/Base.astro';

const siteUrl = Astro.site ? Astro.site.href.replace(/\/$/, '') : (process.env.SITE_URL || 'https://micro-signal-cosmos.pages.dev');
const canonicalUrl = `${siteUrl}/about/`;
---

<Base
  title="About Signal Insight — Understand the world. Explore beyond it."
  description="Who runs Signal Insight, how knowledge guides are researched and verified, and our transparent editorial methodology."
  canonical={canonicalUrl}
>
  <div class="container-narrow py-12 sm:py-16">
    <header class="mb-12">
      <div class="inline-flex items-center gap-2 rounded-full border border-neutral-200 bg-neutral-50 px-3.5 py-1 text-xs font-bold tracking-widest text-brand-primary uppercase shadow-2xs dark:border-white/[0.08] dark:bg-[#0B101D] dark:text-blue-400 mb-3 font-mono text-[10.5px]">
        <span class="h-1.5 w-1.5 rounded-full bg-brand-primary dark:bg-blue-400"></span>
        <span>Mission &amp; Methodology</span>
      </div>
      <h1 class="text-display font-extrabold tracking-tight text-text-primary">About Signal Insight</h1>
      <p class="mt-4 text-lead text-text-secondary">An AI-powered global knowledge discovery and learning platform exploring systems engineering, AI/ML foundations, and observational astrophysics through deep-dive guides and reproducible architectures.</p>
    </header>

    <section class="mb-16">
      <h2 class="text-h2 font-bold text-text-primary mb-6">Our Mission</h2>
      <div class="prose-editorial max-w-none">
        <p><strong>Signal Insight exists to help curious minds understand how the world works — and explore beyond it.</strong></p>
        <p>We believe that true mastery comes from first-principles comprehension: peeling back layers of abstraction to reveal the actual mechanical, algorithmic, and physical laws governing complex systems. Whether it is decoding the inner loops of Blink render trees, calculating the parameter costs of transformer attention heads, or measuring stellar atmospheres across light years, Signal Insight is dedicated to clarity, rigor, and depth.</p>
        <p>Every guide published on Signal Insight is researched using primary sources (RFCs, peer-reviewed arXiv papers, official language specifications, and open-source implementations). Code is executed locally, equations are mathematically verified, and configurations are tested before publication.</p>
      </div>
    </section>

    <section class="mb-16">
      <h2 class="text-h2 font-bold text-text-primary mb-6">How Articles Are Made</h2>
      <div class="overflow-x-auto">
        <table class="w-full border-collapse">
          <thead>
            <tr class="border-b-2 border-neutral-200 dark:border-white/[0.08]">
              <th class="text-left p-3 font-semibold">Step</th>
              <th class="text-left p-3 font-semibold">Process</th>
              <th class="text-left p-3 font-semibold">Tools &amp; Sources</th>
            </tr>
          </thead>
          <tbody>
            <tr class="border-b border-neutral-100 dark:border-white/[0.06]">
              <td class="p-3 font-medium">Topic Selection</td>
              <td class="p-3">Chosen based on foundational importance, architecture gaps, and emerging technological shifts</td>
              <td class="p-3">Editorial research &amp; reader inquiries</td>
            </tr>
            <tr class="border-b border-neutral-100 dark:border-white/[0.06]">
              <td class="p-3 font-medium">Primary Research</td>
              <td class="p-3">Primary sources: arXiv, W3C/IETF RFCs, Linux manpages, upstream Git repositories</td>
              <td class="p-3">Academic databases, RFC specifications, source trees</td>
            </tr>
            <tr class="border-b border-neutral-100 dark:border-white/[0.06]">
              <td class="p-3 font-medium">Drafting &amp; Synthesis</td>
              <td class="p-3">Structured architectural outline &rarr; AI-assisted research drafting &rarr; human engineering review</td>
              <td class="p-3">AI research assistance + manual editorial craftsmanship</td>
            </tr>
            <tr class="border-b border-neutral-100 dark:border-white/[0.06]">
              <td class="p-3 font-medium">Verification</td>
              <td class="p-3">Run ALL code locally, check ALL math equations, validate configs, benchmark commands</td>
              <td class="p-3">Local Linux testbeds, compiler explorer, test suites</td>
            </tr>
            <tr class="border-b border-neutral-100 dark:border-white/[0.06]">
              <td class="p-3 font-medium">Diagrams &amp; Visuals</td>
              <td class="p-3">Author custom high-contrast 2D/3D technical isometric illustrations</td>
              <td class="p-3">Vector SVG graphic system &amp; component architecture</td>
            </tr>
            <tr class="border-b border-neutral-100 dark:border-white/[0.06]">
              <td class="p-3 font-medium">Fact-Checking</td>
              <td class="p-3">Every technical claim traced to a primary paper or official specification</td>
              <td class="p-3">Direct paper and specification cross-citations</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <section class="mb-16">
      <h2 class="text-h2 font-bold text-text-primary mb-6">Editorial Independence &amp; Trust</h2>
      <div class="prose-editorial max-w-none">
        <p><strong>Zero sponsored influence:</strong> Signal Insight maintains strict editorial independence. Technical recommendations are based solely on empirical benchmarks, developer ergonomics, and system reliability.</p>
        <p><strong>Affiliate transparency:</strong> If a tool link carries an affiliate relationship, it is clearly noted, and we only link tools we actively deploy and stand behind in production.</p>
      </div>
    </section>

    <section class="mb-16">
      <h2 class="text-h2 font-bold text-text-primary mb-6">Newsletter: Signal Insight Briefings</h2>
      <div class="prose-editorial max-w-none">
        <p><strong>Free, weekly, zero spam.</strong></p>
        <ul>
          <li>In-depth technical analyses across systems, AI, and astrophysics</li>
          <li>One core system or quantum mechanism explained from first principles</li>
          <li>Curated architecture blueprints and diagrams</li>
          <li>Zero tracking pixels, 1-click unsubscribe anytime</li>
        </ul>
      </div>
    </section>

    <section class="mb-16">
      <h2 class="text-h2 font-bold text-text-primary mb-6">Corrections &amp; Feedback</h2>
      <div class="prose-editorial max-w-none">
        <p><strong>If you find a technical inaccuracy, please let us know.</strong></p>
        <ul>
          <li>Contact Form: <a href="/contact/" class="text-brand-primary underline">Signal Insight Contact Desk</a></li>
          <li>GitHub Issues: <a href="https://github.com/Akm4033/signal-insight/issues" class="text-brand-primary underline" target="_blank" rel="noopener noreferrer">github.com/Akm4033/signal-insight/issues</a></li>
        </ul>
        <p>Technical errata and verified corrections are transparently appended to articles with timestamps.</p>
      </div>
    </section>
  </div>
</Base>
