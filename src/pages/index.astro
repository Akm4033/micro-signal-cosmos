---
import Base from '../layouts/Base.astro';
import ArticleCard from '../components/ui/ArticleCard.astro';
import ArticleVisual from '../components/ui/ArticleVisual.astro';
import NewsletterHero from '../components/newsletter/NewsletterHero.astro';
import NewsletterExitIntent from '../components/newsletter/NewsletterExitIntent.astro';
import { getPublishedArticles, getArticleSlug, getArticleReadingTime } from '../data/articles';

const articles = await getPublishedArticles();
const sortedArticles = [...articles].sort(
  (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime()
);
const latestArticles = sortedArticles.slice(0, 6);

const dbArticle = articles.find((a) => getArticleSlug(a) === 'choosing-a-database-in-2026');
const starsArticle = articles.find((a) => getArticleSlug(a) === 'how-we-know-what-stars-are-made-of');
const browserArticle = articles.find((a) => getArticleSlug(a) === 'how-browsers-actually-render-a-page');

function formatArticleDate(art: typeof articles[0] | undefined, fallback: string) {
  if (!art) return fallback;
  const d = art.data.publishDate || art.data.pubDate;
  if (!d) return fallback;
  return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
}

function getArticleIsoDate(art: typeof articles[0] | undefined, fallback: string) {
  if (!art) return fallback;
  const d = art.data.publishDate || art.data.pubDate;
  if (!d) return fallback;
  return d.toISOString();
}
