---
import Base from '../layouts/Base.astro';
import { getAllAuthors } from '../data/authors';
import { getPublishedArticles, getArticleSlug, getArticleReadingTime } from '../data/articles';

const authorsList = getAllAuthors();
const allArticles = await getPublishedArticles();

const siteUrl = 'https://microsignalcosmos.com';
const authorsUrl = `${siteUrl}/authors/`;
---

<Base
  title="Authors & Editorial Lenses | Micro Signal Cosmos"
  description="Meet the technical writers and domain lenses behind Micro Signal Cosmos."
  canonical={authorsUrl}
>
  <main id="main-content" class="bg-neutral-50 py-12 sm:py-20 border-b border-neutral-200 dark:bg-neutral-900/50 dark:border-neutral-800">
    <div class="container-wide">

      <!-- Breadcrumbs -->
      <nav aria-label="Breadcrumb" class="mb-8">
        <ol class="flex items-center gap-2 text-xs text-text-muted">
          <li>
            <a href="/" class="transition-colors hover:text-brand-primary">Home</a>
          </li>
          <li aria-hidden="true" class="text-neutral-400">/</li>
          <li class="font-semibold text-text-primary" aria-current="page">Authors &amp; Domain Lenses</li>
        </ol>
      </nav>

      <!-- Hero Header -->
      <header class="mx-auto max-w-3xl text-center mb-16">
        <div class="inline-flex items-center gap-2 rounded-full border border-neutral-200 bg-white px-3.5 py-1 text-xs font-bold tracking-widest text-brand-primary uppercase shadow-xs dark:border-neutral-700 dark:bg-neutral-900">
          <span class="h-1.5 w-1.5 rounded-full bg-brand-primary"></span>
          <span>Editorial Authors</span>
        </div>
        <h1 class="mt-4 text-3xl font-extrabold tracking-tight text-text-primary sm:text-4xl lg:text-5xl">
          The Minds Behind the <span class="text-brand-primary">Signals</span>
        </h1>
        <p class="mt-4 text-base sm:text-lg leading-relaxed text-text-secondary">
          Micro Signal Cosmos is written through three specialized domain lenses, each bringing deep engineering and scientific inquiry to complex technical concepts.
        </p>
      </header>

      <!-- Authors Grid -->
      <div class="grid gap-8 md:grid-cols-3">
        {authorsList.map((author) => {
          const authorArticles = allArticles.filter(
            (a) => a.data.author.toLowerCase() === author.key.toLowerCase()
          );

          return (
            <article
              id={author.key}
              class="editorial-card group flex flex-col justify-between"
            >
              <div class="p-6 sm:p-8">
                <div class="flex items-center gap-4 mb-6">
                  <div class="w-16 h-16 rounded-full bg-brand-primary/10 text-brand-primary flex items-center justify-center font-bold text-xl overflow-hidden shrink-0">
                    {author.avatar ? (
                      <img src={author.avatar} alt={author.name} class="w-full h-full object-cover" />
                    ) : (
                      author.initials
                    )}
                  </div>
                  <div>
                    <h2 class="text-xl font-bold text-text-primary group-hover:text-brand-primary transition-colors">
                      {author.name}
                    </h2>
                    <p class="text-xs font-semibold text-brand-primary uppercase tracking-wider mt-0.5">
                      {author.role}
                    </p>
                  </div>
                </div>

                <p class="text-sm leading-relaxed text-text-secondary">
                  {author.bio}
                </p>

                <!-- Social / Profile Links -->
                <div class="mt-6 pt-5 border-t border-neutral-200 dark:border-neutral-700 flex flex-wrap items-center gap-3 text-xs">
                  {author.links.github && (
                    <a href={author.links.github} target="_blank" rel="noopener noreferrer" class="font-medium text-brand-primary hover:underline">
                      GitHub &rarr;
                    </a>
                  )}
                  {author.links.mastodon && (
                    <a href={author.links.mastodon} target="_blank" rel="noopener noreferrer" class="font-medium text-brand-primary hover:underline">
                      Mastodon &rarr;
                    </a>
                  )}
                  {author.links.twitter && (
                    <a href={author.links.twitter} target="_blank" rel="noopener noreferrer" class="font-medium text-brand-primary hover:underline">
                      X &rarr;
                    </a>
                  )}
                  {author.links.site && (
                    <a href={author.links.site} target="_blank" rel="noopener noreferrer" class="font-medium text-brand-primary hover:underline">
                      Personal Site &rarr;
                    </a>
                  )}
                  {author.links.blog && (
                    <a href={author.links.blog} target="_blank" rel="noopener noreferrer" class="font-medium text-brand-primary hover:underline">
                      Blog &rarr;
                    </a>
                  )}
                </div>
              </div>

              <!-- Published Articles by Author -->
              <div class="bg-neutral-50 px-6 py-5 border-t border-neutral-200 dark:bg-neutral-800/50 dark:border-neutral-700">
                <span class="text-xs font-bold uppercase tracking-wider text-text-muted block mb-3">
                  Articles ({authorArticles.length})
                </span>
                <ul class="space-y-2 text-xs">
                  {authorArticles.slice(0, 3).map((art) => (
                    <li>
                      <a
                        href={`/articles/${getArticleSlug(art)}/`}
                        class="text-text-primary hover:text-brand-primary line-clamp-1 font-medium transition-colors"
                      >
                        {art.data.title}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            </article>
          );
        })}
      </div>

    </div>
  </main>
</Base>
