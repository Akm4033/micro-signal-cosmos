---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getPublishedArticles, getArticleReadingTime, getArticleSlug } from '../data/articles';

const articles = await getPublishedArticles();

const siteUrl = 'https://microsignalcosmos.com';
const authorsUrl = `${siteUrl}/authors/`;

const authorsJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      '@id': `${authorsUrl}#collection`,
      name: 'Editorial Desk & Authors | Micro Signal Cosmos',
      description: 'Meet the Micro Signal Cosmos editorial team and contributors dedicated to rigorous science, computing, and technology journalism.',
      url: authorsUrl,
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${authorsUrl}#breadcrumb`,
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Home',
          item: `${siteUrl}/`,
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Editorial Desk & Authors',
          item: authorsUrl,
        },
      ],
    },
  ],
};
---

<Layout
  title="Authors & Contributors | Micro Signal Cosmos"
  description="Meet the independent writers, curators, and contributors behind Micro Signal Cosmos."
  canonical={authorsUrl}
  jsonLd={authorsJsonLd}
>
  <Header />

  <main id="main-content" class="bg-[#F7F9FC] py-12 sm:py-20">
    <div class="container-main">

      <!-- Breadcrumbs -->
      <nav aria-label="Breadcrumb" class="mb-8">
        <ol class="flex items-center gap-2 text-xs text-[#697586]">
          <li>
            <a href="/" class="transition-colors hover:text-[#14233B]">Home</a>
          </li>
          <li aria-hidden="true" class="text-slate-300">/</li>
          <li aria-current="page" class="font-medium text-[#14233B]">Authors & Writers</li>
        </ol>
      </nav>

      <!-- Header Section -->
      <div class="mx-auto max-w-3xl text-center">
        <div class="inline-flex items-center gap-2 rounded-full border border-[#E3E8EF] bg-white px-3.5 py-1.5 shadow-xs">
          <span class="h-2 w-2 rounded-full bg-[#3478F6]"></span>
          <span class="text-xs font-semibold tracking-wider text-[#14233B] uppercase">
            Authors & Writers
          </span>
        </div>

        <h1 class="mt-6 text-3xl font-extrabold tracking-tight text-[#14233B] sm:text-5xl">
          Authors & <span class="text-[#3478F6]">Writers</span>
        </h1>

        <p class="mt-4 text-base leading-relaxed text-[#4B5565] sm:text-lg">
          Meet the independent writers, curators, and contributors behind Micro Signal Cosmos.
        </p>
      </div>

      <!-- The 3 Domain Expert Personas -->
      <div class="mx-auto mt-14 max-w-4xl space-y-8">
        
        <!-- Dr. Marina Kowalski -->
        <div class="rounded-2xl border border-[#E3E8EF] bg-white p-8 shadow-xs transition-all hover:border-[#0ea5e9]">
          <div class="flex flex-col sm:flex-row items-start sm:items-center gap-6">
            <img src="/authors/marina/avatar.svg" alt="Dr. Marina Kowalski" class="h-20 w-20 shrink-0 rounded-2xl shadow-sm" width="80" height="80" />
            <div class="flex-1">
              <div class="flex flex-wrap items-center justify-between gap-2">
                <div>
                  <h2 class="text-2xl font-bold text-[#14233B]">Dr. Marina Kowalski</h2>
                  <p class="text-xs font-semibold text-[#0ea5e9] uppercase tracking-wider">Systems Engineer & Performance Architect</p>
                </div>
                <span class="rounded-full bg-sky-50 px-3 py-1 text-xs font-bold text-[#0ea5e9] border border-sky-200">
                  Systems Lens
                </span>
              </div>
              <p class="mt-3 text-sm leading-relaxed text-[#4B5565]">
                Marina builds and dissects the invisible infrastructure powering the modern web. She spent a decade optimizing JavaScript engines at Google and now writes about the systems nobody notices—until they break.
              </p>
              <div class="mt-4 flex flex-wrap gap-2 pt-3 border-t border-[#E3E8EF]">
                <span class="text-[11px] font-bold uppercase tracking-wider text-[#697586] mr-1">Domain Focus:</span>
                {['Distributed Systems', 'Browser Internals', 'WebAssembly', 'Performance Engineering'].map((exp) => (
                  <span class="text-[11px] font-semibold text-[#14233B] bg-[#F7F9FC] border border-[#E3E8EF] px-2.5 py-0.5 rounded-md">
                    {exp}
                  </span>
                ))}
              </div>
            </div>
          </div>
        </div>

        <!-- Kai Nakamura -->
        <div class="rounded-2xl border border-[#E3E8EF] bg-white p-8 shadow-xs transition-all hover:border-emerald-500">
          <div class="flex flex-col sm:flex-row items-start sm:items-center gap-6">
            <img src="/authors/kai/avatar.svg" alt="Kai Nakamura" class="h-20 w-20 shrink-0 rounded-2xl shadow-sm" width="80" height="80" />
            <div class="flex-1">
              <div class="flex flex-wrap items-center justify-between gap-2">
                <div>
                  <h2 class="text-2xl font-bold text-[#14233B]">Kai Nakamura</h2>
                  <p class="text-xs font-semibold text-emerald-600 uppercase tracking-wider">Machine Learning & Inference Engineer</p>
                </div>
                <span class="rounded-full bg-emerald-50 px-3 py-1 text-xs font-bold text-emerald-700 border border-emerald-200">
                  AI & ML Lens
                </span>
              </div>
              <p class="mt-3 text-sm leading-relaxed text-[#4B5565]">
                Kai builds the plumbing that makes AI useful—retrieval systems, serving infrastructure, and evaluation harnesses. He has deployed models from 7B to 70B parameters in production and has the cloud bills to prove it.
              </p>
              <div class="mt-4 flex flex-wrap gap-2 pt-3 border-t border-[#E3E8EF]">
                <span class="text-[11px] font-bold uppercase tracking-wider text-[#697586] mr-1">Domain Focus:</span>
                {['LLM Training', 'Inference Optimization', 'RAG Systems', 'Model Evaluation'].map((exp) => (
                  <span class="text-[11px] font-semibold text-[#14233B] bg-[#F7F9FC] border border-[#E3E8EF] px-2.5 py-0.5 rounded-md">
                    {exp}
                  </span>
                ))}
              </div>
            </div>
          </div>
        </div>

        <!-- Dr. Arun Mehta -->
        <div class="rounded-2xl border border-[#E3E8EF] bg-white p-8 shadow-xs transition-all hover:border-[#8b5cf6]">
          <div class="flex flex-col sm:flex-row items-start sm:items-center gap-6">
            <img src="/authors/arun/avatar.svg" alt="Dr. Arun Mehta" class="h-20 w-20 shrink-0 rounded-2xl shadow-sm" width="80" height="80" />
            <div class="flex-1">
              <div class="flex flex-wrap items-center justify-between gap-2">
                <div>
                  <h2 class="text-2xl font-bold text-[#14233B]">Dr. Arun Mehta</h2>
                  <p class="text-xs font-semibold text-[#8b5cf6] uppercase tracking-wider">Astrophysicist & Planetary Scientist</p>
                </div>
                <span class="rounded-full bg-purple-50 px-3 py-1 text-xs font-bold text-[#8b5cf6] border border-purple-200">
                  Science Lens
                </span>
              </div>
              <p class="mt-3 text-sm leading-relaxed text-[#4B5565]">
                Arun studies the chemical fingerprints of distant galaxies using the world's largest telescopes. He believes the best science writing reconstructs the detective story behind every discovery.
              </p>
              <div class="mt-4 flex flex-wrap gap-2 pt-3 border-t border-[#E3E8EF]">
                <span class="text-[11px] font-bold uppercase tracking-wider text-[#697586] mr-1">Domain Focus:</span>
                {['Observational Astrophysics', 'Spectroscopy', 'Scientific Method', 'Instrumentation'].map((exp) => (
                  <span class="text-[11px] font-semibold text-[#14233B] bg-[#F7F9FC] border border-[#E3E8EF] px-2.5 py-0.5 rounded-md">
                    {exp}
                  </span>
                ))}
              </div>
            </div>
          </div>
        </div>

      </div>

      <!-- Articles By Editorial Desk -->
      <div class="mx-auto mt-16 max-w-4xl">
        <div class="flex items-center justify-between border-b border-[#E3E8EF] pb-4">
          <div>
            <h2 class="text-xl font-bold text-[#14233B]">
              Published Articles & Guides
            </h2>
            <p class="text-xs text-[#697586]">
              Explore guides and explanations currently published on Micro Signal Cosmos.
            </p>
          </div>
          <span class="rounded-full bg-[#14233B] px-3 py-1 text-xs font-bold text-white">
            {articles.length} {articles.length === 1 ? 'Article' : 'Articles'}
          </span>
        </div>

        <div class="mt-8 space-y-6">
          {articles.map((article) => (
            <article class="group rounded-2xl border border-[#E3E8EF] bg-white p-6 shadow-xs transition-all duration-200 hover:border-[#3478F6] hover:shadow-md sm:p-8">
              <div class="flex flex-wrap items-center gap-3 text-xs text-[#697586]">
                <span class="rounded-full bg-[#3478F6]/10 px-2.5 py-1 font-semibold text-[#3478F6]">
                  {article.data.category}
                </span>
                <span>&bull;</span>
                <time datetime={article.data.publishDate.toISOString()}>
                  {article.data.publishDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
                </time>
                <span>&bull;</span>
                <span>{getArticleReadingTime(article)}</span>
              </div>

              <h3 class="mt-3 text-xl font-bold text-[#14233B] group-hover:text-[#3478F6]">
                <a href={`/articles/${getArticleSlug(article)}/`} class="focus-visible:outline-2 focus-visible:outline-[#3478F6]">
                  {article.data.title}
                </a>
              </h3>

              <p class="mt-2 text-sm leading-relaxed text-[#4B5565]">
                {article.data.description}
              </p>

              <div class="mt-4 flex items-center justify-between">
                <a
                  href={`/articles/${getArticleSlug(article)}/`}
                  class="inline-flex items-center gap-1.5 text-xs font-semibold text-[#3478F6]"
                >
                  <span>Read full analysis</span>
                  <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">&rarr;</span>
                </a>
              </div>
            </article>
          ))}
        </div>
      </div>

      <!-- Contributor Pitch Banner -->
      <div class="mx-auto mt-16 max-w-4xl rounded-2xl border border-[#E3E8EF] bg-white p-8 shadow-xs">
        <h3 class="text-lg font-bold text-[#14233B]">
          Write for Micro Signal Cosmos
        </h3>
        <p class="mt-2 text-sm leading-relaxed text-[#4B5565]">
          Are you a software engineer, technical writer, or specialist with a helpful guide or interesting insight? We welcome guest contributions that provide clear, practical knowledge to our readers.
        </p>
        <div class="mt-6 flex flex-wrap gap-4">
          <a
            href="/contact/"
            class="inline-flex items-center justify-center rounded-lg bg-[#3478F6] px-5 py-2.5 text-xs font-semibold text-white transition-colors hover:bg-[#2563EB]"
          >
            Get In Touch
          </a>
          <a
            href="/about/"
            class="inline-flex items-center justify-center rounded-lg border border-[#E3E8EF] bg-white px-5 py-2.5 text-xs font-semibold text-[#14233B] transition-colors hover:bg-slate-50"
          >
            About Our Blog
          </a>
        </div>
      </div>

    </div>
  </main>

  <Footer />
</Layout>

