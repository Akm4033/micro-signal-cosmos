---
import Base from '../layouts/Base.astro';
import { getPublishedArticles, getArticleSlug } from '../data/articles';

const allArticles = await getPublishedArticles();

const siteUrl = Astro.site ? Astro.site.href.replace(/\/$/, '') : (process.env.SITE_URL || 'https://signal-insight.pages.dev');
const focusAreasUrl = `${siteUrl}/authors/`;

const focusAreas = [
  {
    key: 'systems',
    title: 'Systems & Infrastructure',
    tagline: 'Core Systems, Networks & Compilers',
    description: 'Browser internals, CPU architecture, WebAssembly, Linux networking, TLS 1.3, passwordless authentication, and production database internals.',
    color: '#1d4ed8',
    badgeClass: 'bg-blue-50 text-blue-700 border-blue-200 dark:bg-blue-950/40 dark:text-blue-300 dark:border-blue-800',
    iconBg: 'bg-blue-500/10 text-blue-600 dark:text-blue-400',
    categories: ['technology', 'developer-tools'],
    keyTopics: ['Browser Engines', 'CPU Pipelines', 'WebAssembly', 'TLS 1.3 & PKI', 'Database Engines']
  },
  {
    key: 'ai-ml',
    title: 'AI & Machine Learning',
    tagline: 'Transformer Architecture & Inference Systems',
    description: 'Transformer internals, KV cache optimization, LLM training and serving economics, RAG pipelines from scratch, and rigorous model evaluation benchmarks.',
    color: '#059669',
    badgeClass: 'bg-emerald-50 text-emerald-700 border-emerald-200 dark:bg-emerald-950/40 dark:text-emerald-300 dark:border-emerald-800',
    iconBg: 'bg-emerald-500/10 text-emerald-600 dark:text-emerald-400',
    categories: ['artificial-intelligence'],
    keyTopics: ['Attention Mechanics', 'Inference Economics', 'RAG Architecture', 'Benchmark Auditing']
  },
  {
    key: 'science',
    title: 'Science & Physics',
    tagline: 'Observational Astrophysics & Energy',
    description: 'Stellar spectroscopy, exoplanet atmospheric transmission, dark matter observational evidence, and nuclear fusion confinement physics.',
    color: '#7c3aed',
    badgeClass: 'bg-purple-50 text-purple-700 border-purple-200 dark:bg-purple-950/40 dark:text-purple-300 dark:border-purple-800',
    iconBg: 'bg-purple-500/10 text-purple-600 dark:text-purple-400',
    categories: ['science'],
    keyTopics: ['Spectroscopy', 'Atmospheric Transit', 'Dark Matter Evidence', 'Fusion Physics']
  }
];
---

<Base
  title="Research Focus Areas & Standards | Signal Insight"
  description="Explore our three specialized research focus areas: Systems & Infrastructure, AI & Machine Learning, and Science & Physics."
  canonical={focusAreasUrl}
>
  <main id="main-content" class="bg-neutral-50 py-12 sm:py-20 border-b border-neutral-200 dark:bg-[#05070E] dark:border-white/[0.08]">
    <div class="container-wide">

      <!-- Breadcrumbs -->
      <nav aria-label="Breadcrumb" class="mb-8">
        <ol class="flex items-center gap-2 text-xs text-text-muted">
          <li>
            <a href="/" class="transition-colors hover:text-brand-primary">Home</a>
          </li>
          <li aria-hidden="true" class="text-neutral-400">/</li>
          <li class="font-semibold text-text-primary" aria-current="page">Editorial Focus Areas</li>
        </ol>
      </nav>

      <!-- Hero Header -->
      <header class="mx-auto max-w-3xl text-center mb-16">
        <div class="inline-flex items-center gap-2 rounded-full border border-neutral-200 bg-white px-3.5 py-1 text-xs font-bold tracking-widest text-brand-primary uppercase shadow-xs dark:border-white/[0.08] dark:bg-[#0B101D] dark:text-blue-400 font-mono text-[10.5px]">
          <span class="h-1.5 w-1.5 rounded-full bg-brand-primary dark:bg-blue-400"></span>
          <span>Editorial Focus Areas</span>
        </div>
        <h1 class="mt-4 text-3xl font-extrabold tracking-tight text-text-primary sm:text-4xl lg:text-5xl">
          Three Lenses. <span class="text-brand-primary dark:text-blue-400">One High Standard.</span>
        </h1>
        <p class="mt-4 text-base sm:text-lg leading-relaxed text-text-secondary">
          Signal Insight organizes its technical investigations into three specialized focus areas. Each area is treated with deep rigor, verified with code or math, and grounded in primary source literature.
        </p>
      </header>

      <!-- Focus Areas Grid -->
      <div class="grid gap-8 md:grid-cols-3 mb-16">
        {focusAreas.map((area) => {
          const areaArticles = allArticles.filter((a) =>
            area.categories.includes(a.data.category.toLowerCase())
          );

          return (
            <article
              id={area.key}
              class="editorial-card group flex flex-col justify-between bg-white border border-neutral-200 rounded-2xl shadow-sm hover:shadow-md transition-all duration-300 dark:bg-[#0B101D] dark:border-white/[0.08] dark:hover:border-blue-500/60 dark:hover:shadow-[0_12px_28px_-6px_rgba(0,0,0,0.5),0_0_20px_rgba(59,130,246,0.15)]"
            >
              <div class="p-6 sm:p-8">
                <!-- Header badge & title -->
                <div class="mb-4">
                  <span class={`inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold uppercase tracking-wider border font-mono text-[10.5px] ${area.badgeClass}`}>
                    {area.tagline}
                  </span>
                  <h2 class="text-xl font-bold text-text-primary group-hover:text-brand-primary dark:group-hover:text-blue-400 transition-colors mt-3">
                    {area.title}
                  </h2>
                </div>

                <p class="text-sm leading-relaxed text-text-secondary mb-6">
                  {area.description}
                </p>

                <!-- Key Topics Tag Cloud -->
                <div class="pt-4 border-t border-neutral-200 dark:border-white/[0.08]">
                  <span class="text-[11px] font-bold uppercase tracking-wider text-text-muted block mb-2.5 font-mono">
                    Core Topics Covered
                  </span>
                  <div class="flex flex-wrap gap-1.5">
                    {area.keyTopics.map((topic) => (
                      <span class="px-2 py-0.5 rounded-md bg-neutral-100 text-neutral-700 text-xs font-medium dark:bg-white/[0.06] dark:text-slate-300 font-mono text-[11px]">
                        {topic}
                      </span>
                    ))}
                  </div>
                </div>
              </div>

              <!-- Published Articles in this Focus Area -->
              <div class="bg-neutral-50 px-6 py-5 border-t border-neutral-200 rounded-b-2xl dark:bg-[#070B14] dark:border-white/[0.08]">
                <div class="flex items-center justify-between mb-3">
                  <span class="text-xs font-bold uppercase tracking-wider text-text-muted font-mono text-[11px]">
                    Published Guides ({areaArticles.length})
                  </span>
                  <a
                    href={`/category/${area.categories[0]}/`}
                    class="text-xs font-semibold text-brand-primary dark:text-blue-400 hover:underline inline-flex items-center gap-1 font-mono text-[11px]"
                  >
                    <span>Browse Stream</span>
                    <span aria-hidden="true">&rarr;</span>
                  </a>
                </div>
                <ul class="space-y-2 text-xs">
                  {areaArticles.slice(0, 4).map((art) => (
                    <li>
                      <a
                        href={`/articles/${getArticleSlug(art)}/`}
                        class="text-text-primary hover:text-brand-primary dark:hover:text-blue-400 line-clamp-1 font-medium transition-colors"
                      >
                        {art.data.title}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            </article>
          );
        })}
      </div>

      <!-- Editorial Verification Guarantee Banner -->
      <section class="rounded-2xl border border-neutral-200 bg-white p-8 sm:p-10 shadow-xs dark:border-white/[0.08] dark:bg-[#0B101D]">
        <div class="max-w-3xl mx-auto text-center">
          <h2 class="text-2xl font-bold text-text-primary">Our Editorial Commitment</h2>
          <p class="mt-3 text-sm sm:text-base leading-relaxed text-text-secondary">
            Signal Insight operates as an independent technical publication assisted by AI research tools. Every article undergoes strict manual verification: code is compiled and executed, mathematical proofs are rechecked, and every factual statement is linked to an authoritative primary source.
          </p>
          <div class="mt-6 flex flex-wrap justify-center gap-4">
            <a href="/about/" class="btn-primary text-xs sm:text-sm">
              Read About Our Process &rarr;
            </a>
            <a href="/articles/" class="btn-secondary text-xs sm:text-sm">
              Explore All Articles
            </a>
          </div>
        </div>
      </section>

    </div>
  </main>
</Base>
