---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getPublishedArticles, getArticleReadingTime, getArticleSlug } from '../data/articles';

const articles = await getPublishedArticles();

const siteUrl = 'https://microsignalcosmos.com';
const authorsUrl = `${siteUrl}/authors/`;

const authorsJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      '@id': `${authorsUrl}#collection`,
      name: 'Editorial Desk & Authors | Micro Signal Cosmos',
      description: 'Meet the Micro Signal Cosmos editorial team and contributors dedicated to rigorous science, computing, and technology journalism.',
      url: authorsUrl,
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${authorsUrl}#breadcrumb`,
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Home',
          item: `${siteUrl}/`,
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Editorial Desk & Authors',
          item: authorsUrl,
        },
      ],
    },
  ],
};
---

<Layout
  title="Editorial Desk & Authors | Micro Signal Cosmos"
  description="Meet the Micro Signal Cosmos editorial team and contributors dedicated to rigorous science, computing, and technology journalism."
  canonical={authorsUrl}
  jsonLd={authorsJsonLd}
>
  <Header />

  <main id="main-content" class="bg-[#F7F9FC] py-12 sm:py-20">
    <div class="container-main">

      <!-- Breadcrumbs -->
      <nav aria-label="Breadcrumb" class="mb-8">
        <ol class="flex items-center gap-2 text-xs text-[#697586]">
          <li>
            <a href="/" class="transition-colors hover:text-[#14233B]">Home</a>
          </li>
          <li aria-hidden="true" class="text-slate-300">/</li>
          <li aria-current="page" class="font-medium text-[#14233B]">Editorial Desk & Authors</li>
        </ol>
      </nav>

      <!-- Header Section -->
      <div class="mx-auto max-w-3xl text-center">
        <div class="inline-flex items-center gap-2 rounded-full border border-[#E3E8EF] bg-white px-3.5 py-1.5 shadow-xs">
          <span class="h-2 w-2 rounded-full bg-[#3478F6]"></span>
          <span class="text-xs font-semibold tracking-wider text-[#14233B] uppercase">
            Editorial Team
          </span>
        </div>

        <h1 class="mt-6 text-3xl font-extrabold tracking-tight text-[#14233B] sm:text-5xl">
          Editorial Desk & <span class="text-[#3478F6]">Authors</span>
        </h1>

        <p class="mt-4 text-base leading-relaxed text-[#4B5565] sm:text-lg">
          Transparent, domain-driven publishing. Discover the standards, roles, and multidisciplinary expertise powering Micro Signal Cosmos dispatches.
        </p>
      </div>

      <!-- Lead Editorial Profile Card -->
      <div class="mx-auto mt-14 max-w-4xl rounded-2xl border border-[#E3E8EF] bg-white p-8 sm:p-12 shadow-sm">
        <div class="flex flex-col gap-6 sm:flex-row sm:items-center">
          <div class="flex h-20 w-20 shrink-0 items-center justify-center rounded-2xl border border-[#E3E8EF] bg-[#14233B] text-2xl font-black text-white shadow-inner">
            <span class="text-[#3478F6]">M</span>SC
          </div>

          <div>
            <div class="inline-flex items-center gap-2 rounded-full bg-[#3478F6]/10 px-3 py-1 text-xs font-semibold text-[#3478F6]">
              Primary Editorial Collective
            </div>
            <h2 class="mt-2 text-2xl font-bold tracking-tight text-[#14233B]">
              Micro Signal Cosmos Editorial Desk
            </h2>
            <p class="text-xs font-medium text-[#697586]">
              Multidisciplinary Research, Fact-checking & Technical Writing
            </p>
          </div>
        </div>

        <div class="mt-8 space-y-4 text-sm leading-relaxed text-[#4B5565] border-t border-[#E3E8EF] pt-8">
          <p>
            The <strong class="font-semibold text-[#14233B]">Micro Signal Cosmos Editorial Desk</strong> operates as a unified independent blogging collective. Rather than relying on superficial commentary or unverified syndication, our independent writers and reviewers collaborate to synthesize complex developments in contemporary computing, planetary science, and algorithmic research.
          </p>
          <p>
            We openly utilize advanced AI tools (including ChatGPT, Claude, Gemini, and Perplexity) for literature screening, comparative research, and drafting assistance. Crucially, every dispatch is evaluated, fact-checked, and finalized by our human team before publication, ensuring our articles remain genuinely helpful, original, and grounded in verifiable reality.
          </p>
        </div>

        <!-- Editorial Focus Areas -->
        <div class="mt-8 grid gap-4 sm:grid-cols-2">
          <div class="rounded-xl border border-[#E3E8EF] bg-[#F7F9FC] p-4">
            <h3 class="text-xs font-bold uppercase tracking-wider text-[#14233B]">Artificial Intelligence & ML</h3>
            <p class="mt-1 text-xs text-[#697586]">Transformer architectures, inference optimization, alignment, and cognitive systems.</p>
          </div>
          <div class="rounded-xl border border-[#E3E8EF] bg-[#F7F9FC] p-4">
            <h3 class="text-xs font-bold uppercase tracking-wider text-[#14233B]">Astrophysics & Deep Science</h3>
            <p class="mt-1 text-xs text-[#697586]">Observational astronomy, space exploration probes, quantum computing, and material science.</p>
          </div>
          <div class="rounded-xl border border-[#E3E8EF] bg-[#F7F9FC] p-4">
            <h3 class="text-xs font-bold uppercase tracking-wider text-[#14233B]">Digital Architecture</h3>
            <p class="mt-1 text-xs text-[#697586]">Distributed systems, edge deployment networks, cybersecurity, and open protocols.</p>
          </div>
          <div class="rounded-xl border border-[#E3E8EF] bg-[#F7F9FC] p-4">
            <h3 class="text-xs font-bold uppercase tracking-wider text-[#14233B]">Technical Education</h3>
            <p class="mt-1 text-xs text-[#697586]">Accessible deep-dives and comprehensive conceptual guides designed for lifelong learners.</p>
          </div>
        </div>
      </div>

      <!-- Articles By Editorial Desk -->
      <div class="mx-auto mt-16 max-w-4xl">
        <div class="flex items-center justify-between border-b border-[#E3E8EF] pb-4">
          <div>
            <h2 class="text-xl font-bold text-[#14233B]">
              Published Dispatches by the Editorial Desk
            </h2>
            <p class="text-xs text-[#697586]">
              Peer-reviewed articles and research guides currently active in the publication.
            </p>
          </div>
          <span class="rounded-full bg-[#14233B] px-3 py-1 text-xs font-bold text-white">
            {articles.length} {articles.length === 1 ? 'Article' : 'Articles'}
          </span>
        </div>

        <div class="mt-8 space-y-6">
          {articles.map((article) => (
            <article class="group rounded-2xl border border-[#E3E8EF] bg-white p-6 shadow-xs transition-all duration-200 hover:border-[#3478F6] hover:shadow-md sm:p-8">
              <div class="flex flex-wrap items-center gap-3 text-xs text-[#697586]">
                <span class="rounded-full bg-[#3478F6]/10 px-2.5 py-1 font-semibold text-[#3478F6]">
                  {article.data.category}
                </span>
                <span>&bull;</span>
                <time datetime={article.data.publishDate.toISOString()}>
                  {article.data.publishDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
                </time>
                <span>&bull;</span>
                <span>{getArticleReadingTime(article)}</span>
              </div>

              <h3 class="mt-3 text-xl font-bold text-[#14233B] group-hover:text-[#3478F6]">
                <a href={`/articles/${getArticleSlug(article)}/`} class="focus-visible:outline-2 focus-visible:outline-[#3478F6]">
                  {article.data.title}
                </a>
              </h3>

              <p class="mt-2 text-sm leading-relaxed text-[#4B5565]">
                {article.data.description}
              </p>

              <div class="mt-4 flex items-center justify-between">
                <a
                  href={`/articles/${getArticleSlug(article)}/`}
                  class="inline-flex items-center gap-1.5 text-xs font-semibold text-[#3478F6]"
                >
                  <span>Read full analysis</span>
                  <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">&rarr;</span>
                </a>
              </div>
            </article>
          ))}
        </div>
      </div>

      <!-- Contributor Pitch Banner -->
      <div class="mx-auto mt-16 max-w-4xl rounded-2xl border border-[#E3E8EF] bg-white p-8 shadow-xs">
        <h3 class="text-lg font-bold text-[#14233B]">
          Pitch a Story or Research Dispatch
        </h3>
        <p class="mt-2 text-sm leading-relaxed text-[#4B5565]">
          Are you a software engineer, computer science researcher, or domain specialist with an original breakthrough or educational guide? We accept guest dispatches that adhere to our fact-checking protocols and non-commercial integrity.
        </p>
        <div class="mt-6 flex flex-wrap gap-4">
          <a
            href="/contact/"
            class="inline-flex items-center justify-center rounded-lg bg-[#3478F6] px-5 py-2.5 text-xs font-semibold text-white transition-colors hover:bg-[#2563EB]"
          >
            Submit an Editorial Pitch
          </a>
          <a
            href="/editorial-policy/"
            class="inline-flex items-center justify-center rounded-lg border border-[#E3E8EF] bg-white px-5 py-2.5 text-xs font-semibold text-[#14233B] transition-colors hover:bg-slate-50"
          >
            Review Editorial Standards
          </a>
        </div>
      </div>

    </div>
  </main>

  <Footer />
</Layout>

