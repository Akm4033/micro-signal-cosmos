---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { CATEGORIES } from '../../data/categories';
import { getPublishedArticles, type Article } from '../../data/articles';
import { render } from 'astro:content';

export async function getStaticPaths() {
  const publishedArticles = await getPublishedArticles();

  return publishedArticles.map((article) => {
    const slug = article.data.slug || article.id;
    return {
      params: { slug },
      props: { article },
    };
  });
}

interface Props {
  article: Article;
}

const { article } = Astro.props;
const { Content } = await render(article);

// Resolve category metadata from the official taxonomy
const category = CATEGORIES.find(
  (c) =>
    c.slug.toLowerCase() === article.data.category.toLowerCase().trim() ||
    c.name.toLowerCase() === article.data.category.toLowerCase().trim()
);

const categoryName = category?.name || article.data.category;
const categoryHref = category?.href || `/category/${article.data.category}/`;

// Format publication and update dates
const publishDateFormatted = article.data.publishDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
const publishDateISO = article.data.publishDate.toISOString();

const updatedDateFormatted = article.data.updatedDate
  ? article.data.updatedDate.toLocaleDateString('en-US', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
    })
  : null;
const updatedDateISO = article.data.updatedDate ? article.data.updatedDate.toISOString() : null;

// Determine related articles
const allPublished = await getPublishedArticles();
const currentSlug = article.data.slug || article.id;
const currentIndex = allPublished.findIndex((a) => (a.data.slug || a.id) === currentSlug);
const prevArticle = currentIndex > 0 ? allPublished[currentIndex - 1] : null;
const nextArticle = currentIndex < allPublished.length - 1 ? allPublished[currentIndex + 1] : null;

const otherArticles = allPublished.filter((a) => (a.data.slug || a.id) !== currentSlug);
const sameCategoryArticles = otherArticles.filter(
  (a) => a.data.category.toLowerCase().trim() === article.data.category.toLowerCase().trim()
);
const differentCategoryArticles = otherArticles.filter(
  (a) => a.data.category.toLowerCase().trim() !== article.data.category.toLowerCase().trim()
);

const relatedArticles = [...sameCategoryArticles, ...differentCategoryArticles].slice(0, 3);

// JSON-LD Structured Data
const siteUrl = 'https://microsignalcosmos.com';
const articleUrl = `${siteUrl}/articles/${currentSlug}/`;

const articleJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': ['NewsArticle', 'BlogPosting', 'TechArticle'],
      '@id': `${articleUrl}#article`,
      headline: article.data.title,
      description: article.data.description,
      url: articleUrl,
      mainEntityOfPage: {
        '@type': 'WebPage',
        '@id': articleUrl,
      },
      datePublished: publishDateISO,
      dateModified: updatedDateISO || publishDateISO,
      author: {
        '@type': 'Person',
        name: article.data.author,
      },
      publisher: {
        '@type': 'Organization',
        name: 'Micro Signal Cosmos',
        url: siteUrl,
        logo: {
          '@type': 'ImageObject',
          url: `${siteUrl}/favicon.svg`,
          width: 512,
          height: 512,
        },
      },
      articleSection: categoryName,
      keywords: (article.data.tags || []).join(', '),
      image: article.data.coverImage
        ? (article.data.coverImage.startsWith('http')
            ? article.data.coverImage
            : `${siteUrl}${article.data.coverImage}`)
        : `${siteUrl}/favicon.svg`,
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${articleUrl}#breadcrumb`,
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Home',
          item: `${siteUrl}/`,
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Articles',
          item: `${siteUrl}/articles/`,
        },
        {
          '@type': 'ListItem',
          position: 3,
          name: article.data.title,
          item: articleUrl,
        },
      ],
    },
  ],
};

const shareEncodedUrl = encodeURIComponent(articleUrl);
const shareEncodedTitle = encodeURIComponent(article.data.title);
---

<Layout
  title={`${article.data.title} | Micro Signal Cosmos`}
  description={article.data.description}
  type="article"
  image={article.data.coverImage}
  jsonLd={articleJsonLd}
>
  <Header />

  <main id="main-content" class="bg-[#F7F9FC] py-10 sm:py-14 lg:py-16">
    <div class="container-main">

      <!-- Breadcrumbs Navigation -->
      <div class="mx-auto max-w-3xl mb-8 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between text-xs sm:text-sm text-[#697586]">
        <nav aria-label="Breadcrumb">
          <ol class="flex flex-wrap items-center gap-1.5 sm:gap-2">
            <li>
              <a href="/" class="hover:text-[#3478F6] transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#3478F6] rounded">
                Home
              </a>
            </li>
            <li aria-hidden="true" class="text-slate-400">/</li>
            <li>
              <a href="/articles/" class="hover:text-[#3478F6] transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#3478F6] rounded">
                Articles
              </a>
            </li>
            <li aria-hidden="true" class="text-slate-400">/</li>
            <li>
              <a href={categoryHref} class="hover:text-[#3478F6] transition-colors font-medium">
                {categoryName}
              </a>
            </li>
          </ol>
        </nav>

        <a
          href="/articles/"
          class="inline-flex items-center gap-1 font-semibold text-[#3478F6] hover:text-[#2563EB] transition-colors"
        >
          <span>&larr;</span> Back to all articles
        </a>
      </div>

      <!-- Main Article Card Surface -->
      <article class="mx-auto max-w-3xl rounded-2xl border border-[#E3E8EF] bg-white p-6 sm:p-10 lg:p-12 shadow-xs">
        
        <!-- Article Header -->
        <header class="border-b border-[#E3E8EF] pb-8">
          <!-- Category Badge -->
          <div class="mb-4">
            <a
              href={categoryHref}
              class="inline-flex items-center gap-2 rounded-full border border-[#E3E8EF] bg-[#F7F9FC] px-3.5 py-1 text-xs font-bold tracking-wider uppercase text-[#3478F6] transition-colors hover:border-[#3478F6]"
            >
              <span class="h-1.5 w-1.5 rounded-full bg-[#3478F6]"></span>
              <span>{categoryName}</span>
            </a>
          </div>

          <!-- Main Article Title -->
          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-[#14233B] leading-[1.18]">
            {article.data.title}
          </h1>

          <!-- Article Excerpt / Lead -->
          <p class="mt-5 text-lg sm:text-xl font-normal leading-relaxed text-[#202938]">
            {article.data.description}
          </p>

          <!-- Metadata & Share Actions Bar -->
          <div class="mt-8 pt-6 border-t border-[#E3E8EF] flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 text-xs sm:text-sm text-[#697586]">
            <!-- Author & Dates -->
            <div class="flex flex-wrap items-center gap-3">
              <a href="/authors/" class="flex items-center gap-2 font-medium text-[#14233B] hover:text-[#3478F6] transition-colors">
                <span class="flex h-7 w-7 items-center justify-center rounded-full bg-[#EEF1F5] text-xs font-bold text-[#3478F6]">
                  MS
                </span>
                <span>{article.data.author}</span>
              </a>

              <span aria-hidden="true">&bull;</span>

              <time datetime={publishDateISO}>
                {publishDateFormatted}
              </time>

              {updatedDateFormatted && (
                <>
                  <span aria-hidden="true">&bull;</span>
                  <span>Updated {updatedDateFormatted}</span>
                </>
              )}

              {article.data.readingTime && (
                <>
                  <span aria-hidden="true">&bull;</span>
                  <span>{article.data.readingTime}</span>
                </>
              )}
            </div>

            <!-- Social Share Bar & Copy Link -->
            <div class="flex items-center gap-2">
              <span class="text-xs font-semibold text-[#14233B] uppercase tracking-wider mr-1">Share:</span>
              
              <!-- Copy Link Button -->
              <button
                type="button"
                id="copy-link-btn"
                class="inline-flex h-8 items-center gap-1.5 rounded-md border border-[#E3E8EF] bg-[#F7F9FC] px-2.5 text-xs font-medium text-[#202938] hover:border-[#3478F6] hover:text-[#3478F6] transition-colors"
                aria-label="Copy link to clipboard"
                data-url={articleUrl}
              >
                <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
                  <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
                </svg>
                <span id="copy-text">Copy</span>
              </button>

              <!-- Twitter / X -->
              <a
                href={`https://twitter.com/intent/tweet?text=${shareEncodedTitle}&url=${shareEncodedUrl}`}
                target="_blank"
                rel="noopener noreferrer"
                class="flex h-8 w-8 items-center justify-center rounded-md border border-[#E3E8EF] bg-[#F7F9FC] text-[#202938] hover:border-[#3478F6] hover:text-[#3478F6] transition-colors"
                aria-label="Share on X / Twitter"
              >
                <span class="text-xs font-bold">𝕏</span>
              </a>

              <!-- LinkedIn -->
              <a
                href={`https://www.linkedin.com/sharing/share-offsite/?url=${shareEncodedUrl}`}
                target="_blank"
                rel="noopener noreferrer"
                class="flex h-8 w-8 items-center justify-center rounded-md border border-[#E3E8EF] bg-[#F7F9FC] text-[#202938] hover:border-[#3478F6] hover:text-[#3478F6] transition-colors"
                aria-label="Share on LinkedIn"
              >
                <span class="text-xs font-bold">in</span>
              </a>
            </div>
          </div>

          <!-- Cover Image (when provided) -->
          {article.data.coverImage && (
            <div class="mt-8 overflow-hidden rounded-xl border border-[#E3E8EF] bg-[#F7F9FC]">
              <img
                src={article.data.coverImage}
                alt={article.data.title}
                width="1200"
                height="630"
                class="h-auto max-h-[460px] w-full object-cover"
                loading="lazy"
              />
            </div>
          )}
        </header>

        <!-- 1. Above-the-Fold Ad Slot (Reserved Height / Zero CLS) -->
        <div class="ad-slot-container ad-slot-above-fold" role="region" aria-label="Sponsored Space">
          <div class="ad-slot-inner">
            <span class="ad-slot-badge">Advertisement</span>
            <div class="ad-slot-placeholder" data-ad-slot="above-fold">
              <!-- Reserved for 728x90 Leaderboard / Responsive Banner -->
            </div>
          </div>
        </div>

        <!-- Article Content Column -->
        <div class="article-content mt-8" id="article-body-content">
          <Content />
        </div>

        <!-- 2. Mid-Article In-Feed Ad Template & Inline Injection (Roughly Halfway / Zero CLS) -->
        <template id="mid-article-ad-template">
          <div class="ad-slot-container ad-slot-mid-article" role="region" aria-label="Sponsored Content">
            <div class="ad-slot-inner">
              <span class="ad-slot-badge">Advertisement</span>
              <div class="ad-slot-placeholder" data-ad-slot="mid-article-feed">
                <!-- Reserved for 336x280 / 300x250 Large Rectangle -->
              </div>
            </div>
          </div>
        </template>

        <script is:inline>
          (function() {
            const body = document.getElementById('article-body-content');
            const tpl = document.getElementById('mid-article-ad-template');
            if (body && tpl) {
              const paragraphs = body.querySelectorAll(':scope > p');
              if (paragraphs.length >= 2) {
                const mid = Math.floor(paragraphs.length / 2);
                paragraphs[mid - 1].after(tpl.content.cloneNode(true));
              } else {
                body.appendChild(tpl.content.cloneNode(true));
              }
            }

            // Copy Link Handler
            const copyBtn = document.getElementById('copy-link-btn');
            const copyText = document.getElementById('copy-text');
            if (copyBtn && copyText) {
              copyBtn.addEventListener('click', async () => {
                const url = copyBtn.getAttribute('data-url') || window.location.href;
                try {
                  await navigator.clipboard.writeText(url);
                  copyText.textContent = 'Copied!';
                  copyBtn.classList.add('border-[#3478F6]', 'text-[#3478F6]');
                  setTimeout(() => {
                    copyText.textContent = 'Copy';
                    copyBtn.classList.remove('border-[#3478F6]', 'text-[#3478F6]');
                  }, 2500);
                } catch (e) {
                  copyText.textContent = 'Copied!';
                }
              });
            }
          })();
        </script>

        <!-- 3. Post-Article Ad Slot (Reserved Height / Zero CLS) -->
        <div class="ad-slot-container ad-slot-post-article" role="region" aria-label="Sponsored Space">
          <div class="ad-slot-inner">
            <span class="ad-slot-badge">Advertisement</span>
            <div class="ad-slot-placeholder" data-ad-slot="post-article">
              <!-- Reserved for 728x250 Billboard / Responsive Banner -->
            </div>
          </div>
        </div>

        <!-- Article Topic Tags -->
        {article.data.tags && article.data.tags.length > 0 && (
          <div class="mt-10 pt-6 border-t border-[#E3E8EF]">
            <div class="flex flex-wrap items-center gap-2">
              <span class="text-xs font-bold uppercase tracking-wider text-[#14233B] mr-2">
                Tagged Topics:
              </span>
              {article.data.tags.map((tag) => (
                <span class="rounded-md border border-[#E3E8EF] bg-[#F7F9FC] px-3 py-1 text-xs font-semibold text-[#202938]">
                  #{tag}
                </span>
              ))}
            </div>
          </div>
        )}

        <!-- Author Biography & Editorial Trust Box -->
        <div class="mt-10 rounded-xl border border-[#E3E8EF] bg-[#F7F9FC] p-6 sm:p-7">
          <div class="flex flex-col sm:flex-row items-start sm:items-center gap-4">
            <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-[#14233B] text-white font-bold text-base shadow-sm">
              MS
            </div>
            <div class="flex-1">
              <div class="flex items-center justify-between">
                <h3 class="text-base font-bold text-[#14233B]">
                  {article.data.author}
                </h3>
                <a href="/authors/" class="text-xs font-semibold text-[#3478F6] hover:underline">
                  View Editorial Team &rarr;
                </a>
              </div>
              <p class="mt-1.5 text-xs sm:text-sm leading-relaxed text-[#202938]">
                Editorial and research collective at Micro Signal Cosmos. We analyze emerging developments in technology, science, artificial intelligence, and computing with an emphasis on primary sources, verifiable evidence, and clear conceptual explanations.
              </p>
            </div>
          </div>
        </div>

        <!-- Previous and Next Article Navigation -->
        {(prevArticle || nextArticle) && (
          <nav aria-label="Adjacent Articles" class="mt-10 pt-8 border-t border-[#E3E8EF] grid gap-4 sm:grid-cols-2">
            {prevArticle ? (
              <a
                href={`/articles/${prevArticle.data.slug || prevArticle.id}/`}
                class="group flex flex-col justify-between rounded-xl border border-[#E3E8EF] bg-[#F7F9FC] p-4 transition-all hover:border-[#3478F6] hover:bg-white"
              >
                <span class="text-[11px] font-bold uppercase tracking-wider text-[#697586] group-hover:text-[#3478F6]">
                  &larr; Previous Article
                </span>
                <span class="mt-2 text-sm font-bold text-[#14233B] line-clamp-2 group-hover:text-[#3478F6]">
                  {prevArticle.data.title}
                </span>
              </a>
            ) : <div></div>}

            {nextArticle ? (
              <a
                href={`/articles/${nextArticle.data.slug || nextArticle.id}/`}
                class="group flex flex-col justify-between rounded-xl border border-[#E3E8EF] bg-[#F7F9FC] p-4 text-right transition-all hover:border-[#3478F6] hover:bg-white"
              >
                <span class="text-[11px] font-bold uppercase tracking-wider text-[#697586] group-hover:text-[#3478F6]">
                  Next Article &rarr;
                </span>
                <span class="mt-2 text-sm font-bold text-[#14233B] line-clamp-2 group-hover:text-[#3478F6]">
                  {nextArticle.data.title}
                </span>
              </a>
            ) : <div></div>}
          </nav>
        )}

      </article>

      <!-- Related Articles Section -->
      {relatedArticles.length > 0 && (
        <section class="mx-auto mt-16 max-w-4xl" aria-labelledby="related-heading">
          <div class="mb-8 flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
            <div>
              <p class="text-xs font-bold uppercase tracking-widest text-[#3478F6] mb-1">
                Continue Reading
              </p>
              <h2 id="related-heading" class="text-2xl font-extrabold tracking-tight text-[#14233B] sm:text-3xl">
                Related <span class="text-[#3478F6]">Investigations</span>
              </h2>
            </div>
            <a
              href="/articles/"
              class="text-xs sm:text-sm font-semibold text-[#3478F6] hover:text-[#2563EB] transition-colors"
            >
              Browse complete catalog &rarr;
            </a>
          </div>

          <div class="grid gap-6 md:grid-cols-3">
            {relatedArticles.map((rel) => {
              const relSlug = rel.data.slug || rel.id;
              const relDateFormatted = rel.data.publishDate.toLocaleDateString('en-US', {
                year: 'numeric',
                month: 'short',
                day: 'numeric',
              });

              return (
                <article class="group flex flex-col justify-between rounded-xl border border-[#E3E8EF] bg-white p-5 shadow-xs transition-all duration-300 hover:shadow-md hover:border-[#CBD5E1]">
                  <div>
                    <span class="text-[11px] font-bold uppercase tracking-wider text-[#3478F6]">
                      {rel.data.category}
                    </span>

                    <h3 class="mt-2 text-base font-bold leading-snug text-[#14233B] transition-colors group-hover:text-[#3478F6]">
                      <a href={`/articles/${relSlug}/`} class="focus-visible:outline-none focus-visible:underline">
                        {rel.data.title}
                      </a>
                    </h3>

                    <p class="mt-2 text-xs leading-relaxed text-[#202938] line-clamp-2">
                      {rel.data.description}
                    </p>
                  </div>

                  <div class="mt-5 pt-3 border-t border-[#E3E8EF] flex items-center justify-between text-[11px] text-[#697586]">
                    <span>{relDateFormatted}</span>
                    <a
                      href={`/articles/${relSlug}/`}
                      class="font-semibold text-[#3478F6] group-hover:text-[#2563EB]"
                    >
                      Read &rarr;
                    </a>
                  </div>
                </article>
              );
            })}
          </div>
        </section>
      )}

    </div>
  </main>

  <Footer />
</Layout>

<style>
  /* ===================================================
     ARTICLE CONTENT STYLING (PREMIUM LIGHT MAGAZINE)
     =================================================== */
  .article-content {
    color: #202938; /* Deep charcoal text */
    font-size: 1.125rem; /* 18px */
    line-height: 1.75;
  }

  /* Headings */
  .article-content :global(h2) {
    color: #14233B;
    font-size: 1.75rem;
    font-weight: 700;
    line-height: 1.3;
    margin-top: 2.75rem;
    margin-bottom: 1.25rem;
    padding-bottom: 0.5rem;
    border-bottom: 2px solid #EEF1F5;
    letter-spacing: -0.02em;
  }

  .article-content :global(h3) {
    color: #14233B;
    font-size: 1.375rem;
    font-weight: 600;
    line-height: 1.35;
    margin-top: 2.25rem;
    margin-bottom: 1rem;
    letter-spacing: -0.01em;
  }

  .article-content :global(h4) {
    color: #14233B;
    font-size: 1.15rem;
    font-weight: 600;
    line-height: 1.4;
    margin-top: 1.75rem;
    margin-bottom: 0.75rem;
  }

  /* Paragraphs */
  .article-content :global(p) {
    margin-bottom: 1.5rem;
  }

  /* Emphasis */
  .article-content :global(strong) {
    color: #14233B;
    font-weight: 700;
  }

  .article-content :global(em) {
    color: #202938;
    font-style: italic;
  }

  /* Lists */
  .article-content :global(ul) {
    list-style-type: disc;
    padding-left: 1.5rem;
    margin-bottom: 1.75rem;
    margin-top: 0.5rem;
  }

  .article-content :global(ol) {
    list-style-type: decimal;
    padding-left: 1.5rem;
    margin-bottom: 1.75rem;
    margin-top: 0.5rem;
  }

  .article-content :global(li) {
    margin-bottom: 0.5rem;
    padding-left: 0.25rem;
    color: #202938;
  }

  .article-content :global(li::marker) {
    color: #3478F6;
  }

  /* Blockquotes */
  .article-content :global(blockquote) {
    margin: 2rem 0;
    padding: 1.25rem 1.75rem;
    background: #F8FAFC;
    border-left: 4px solid #3478F6;
    border-radius: 0 0.5rem 0.5rem 0;
    color: #202938;
    font-style: italic;
  }

  .article-content :global(blockquote p:last-child) {
    margin-bottom: 0;
  }

  /* Links */
  .article-content :global(a) {
    color: #3478F6;
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color 0.2s ease;
  }

  .article-content :global(a:hover) {
    color: #2563EB;
  }

  /* Inline Code */
  .article-content :global(:not(pre) > code) {
    background: #EEF1F5;
    color: #2563EB;
    padding: 0.15rem 0.45rem;
    border-radius: 0.375rem;
    font-size: 0.875em;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    border: 1px solid #E2E8F0;
  }

  /* Preformatted & Code Blocks */
  .article-content :global(pre) {
    background: #0F172A !important;
    border: 1px solid #334155;
    border-radius: 0.75rem;
    padding: 1.25rem 1.5rem;
    margin: 2rem 0;
    overflow-x: auto;
    font-size: 0.875rem;
    line-height: 1.7;
    color: #F1F5F9;
    -webkit-overflow-scrolling: touch;
  }

  .article-content :global(pre code) {
    background: transparent !important;
    border: none !important;
    padding: 0 !important;
    color: inherit !important;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
  }

  /* Tables */
  .article-content :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 2rem 0;
    border: 1px solid #E3E8EF;
    border-radius: 0.5rem;
    overflow: hidden;
    font-size: 0.9375rem;
  }

  .article-content :global(th) {
    background: #F8FAFC;
    color: #14233B;
    font-weight: 700;
    text-align: left;
    padding: 0.85rem 1rem;
    border-bottom: 2px solid #E3E8EF;
  }

  .article-content :global(td) {
    padding: 0.85rem 1rem;
    border-bottom: 1px solid #E3E8EF;
