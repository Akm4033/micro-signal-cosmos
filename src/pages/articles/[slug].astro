                    <line x1="8" y1="12" x2="21" y2="12"></line>
                    <line x1="8" y1="18" x2="21" y2="18"></line>
                    <line x1="3" y1="6" x2="3.01" y2="6"></line>
                    <line x1="3" y1="12" x2="3.01" y2="12"></line>
                    <line x1="3" y1="18" x2="3.01" y2="18"></line>
                  </svg>
                  <span>In This Article</span>
                </h2>
                <span class="text-[10px] font-semibold text-[#697586]">
                  {tocHeadings.length} Sections
                </span>
              </div>

              <nav aria-label="Table of contents" class="mt-4 space-y-2 max-h-[60vh] overflow-y-auto pr-1">
                {tocHeadings.map((h) => (
                  <a
                    href={`#${h.slug}`}
                    class:list={[
                      'block transition-colors hover:text-[#3478F6] text-xs leading-relaxed py-1',
                      h.depth === 3 ? 'pl-3 text-[#697586]' : 'font-semibold text-[#202938]',
                    ]}
                  >
                    {h.text}
                  </a>
                ))}
              </nav>

              <div class="mt-5 pt-3 border-t border-[#E3E8EF] text-right">
                <a href="#main-content" class="text-[11px] font-semibold text-[#3478F6] hover:underline">
                  &uarr; Back to top
                </a>
