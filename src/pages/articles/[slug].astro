---
import ArticleLayout from '../../layouts/Article.astro';
import {
  getPublishedArticles,
  getArticleReadingTime,
  getArticleSlug,
  type Article,
} from '../../data/articles';
import { getAuthor } from '../../data/authors';
import { render } from 'astro:content';
import NewsletterInline from '../../components/newsletter/NewsletterInline.astro';
import NewsletterExitIntent from '../../components/newsletter/NewsletterExitIntent.astro';

export async function getStaticPaths() {
  const publishedArticles = await getPublishedArticles();

  return publishedArticles.map((article) => {
    const slug = getArticleSlug(article);
    return {
      params: { slug },
      props: { article },
    };
  });
}

interface Props {
  article: Article;
}

const { article } = Astro.props;
const { Content, headings = [] } = await render(article);

// Resolve author profile from centralized registry
const author = getAuthor(article.data.author);

// Consistently compute reading time
const readingTime = getArticleReadingTime(article);

// Filter Table of Contents headings (h2 and h3)
const tocHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);

// Category mapping
const categoryName = article.data.category;
const categorySlug = article.data.category.toLowerCase().trim();

const variantMap: Record<string, 'tech' | 'science' | 'ai' | 'devtools'> = {
  'technology': 'tech',
  'artificial-intelligence': 'ai',
  'science': 'science',
  'developer-tools': 'devtools',
  'tech': 'tech',
  'ai': 'ai',
  'devtools': 'devtools'
};
const categoryVariant = variantMap[categorySlug] || 'tech';

// Format publication and update dates
const publishDateISO = article.data.publishDate.toISOString();
const updatedDateISO = article.data.updatedDate ? article.data.updatedDate.toISOString() : undefined;

// Determine related articles
const allPublished = await getPublishedArticles();
const currentSlug = getArticleSlug(article);

const otherArticles = allPublished.filter((a) => getArticleSlug(a) !== currentSlug);
const currentTags = (article.data.tags || []).map((t: string) => t.toLowerCase());

const scoredArticles = otherArticles.map((candidate) => {
  let score = 0;
  if (candidate.data.category.toLowerCase().trim() === categorySlug) {
    score += 5;
  }
  const candidateTags = (candidate.data.tags || []).map((t: string) => t.toLowerCase());
  const sharedTags = currentTags.filter((tag: string) => candidateTags.includes(tag));
  score += sharedTags.length * 2;
  return { article: candidate, score };
});

scoredArticles.sort((a, b) => {
  if (b.score !== a.score) return b.score - a.score;
  return b.article.data.publishDate.getTime() - a.article.data.publishDate.getTime();
});

const relatedArticlesData = scoredArticles.map((s) => s.article).slice(0, 3);
const relatedForProps = relatedArticlesData.map((a) => ({
  slug: getArticleSlug(a),
  title: a.data.title,
  category: a.data.category,
  categoryVariant: variantMap[a.data.category.toLowerCase().trim()] || 'tech',
  readingTime: getArticleReadingTime(a),
  excerpt: a.data.description,
}));

// Page Title & Meta Description
const rawSeoTitle = article.data.seoTitle || article.data.title;
const cleanSeoTitle = rawSeoTitle.replace(/\s*\|\s*Signal Insight\s*$/i, '');
const pageTitle = `${cleanSeoTitle} | Signal Insight`;
const pageDescription = article.data.seoDescription || article.data.description;

const siteUrl = Astro.site ? Astro.site.href.replace(/\/$/, '') : (process.env.SITE_URL || 'https://signal-insight.pages.dev');
const articleUrl = `${siteUrl}/articles/${currentSlug}/`;

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "TechArticle",
  "headline": article.data.title,
  "description": article.data.description,
  "url": articleUrl,
  "datePublished": publishDateISO,
  "dateModified": updatedDateISO || publishDateISO,
  "author": {
    "@type": "Person",
    "name": author.name,
    "jobTitle": author.role,
    "url": author.links?.site || `${siteUrl}/about/`
  },
  "publisher": {
    "@type": "Organization",
    "name": "Signal Insight",
    "url": siteUrl,
    "logo": {
      "@type": "ImageObject",
      "url": `${siteUrl}/favicon.svg`
    }
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": articleUrl
  },
  "keywords": (article.data.tags || []).join(', ')
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": siteUrl
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Articles",
      "item": `${siteUrl}/articles/`
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": categoryName,
      "item": `${siteUrl}/category/${categorySlug}/`
    },
    {
      "@type": "ListItem",
      "position": 4,
      "name": article.data.title,
      "item": articleUrl
    }
  ]
};
---

<script type="application/ld+json" is:inline set:html={JSON.stringify(articleSchema)} />
<script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbSchema)} />

<ArticleLayout
  title={article.data.title}
  seoTitle={pageTitle}
  description={pageDescription}
  author={article.data.author}
  authorName={author.name}
  authorRole={author.role}
  authorAvatar={author.avatar}
  category={categoryName}
  categoryVariant={categoryVariant}
  tags={article.data.tags}
  readingTime={readingTime}
  publishedTime={publishDateISO}
  updatedTime={updatedDateISO}
  canonical={articleUrl}
  ogImage={article.data.coverImage || `/og/${currentSlug}.svg`}
  logo={article.data.logo}
  slug={currentSlug}
  references={article.data.references || []}
  relatedArticles={relatedForProps}
>
  <Fragment slot="toc">
    {tocHeadings.length > 0 ? (
      tocHeadings.map((h) => (
        <li class={h.depth === 3 ? "pl-3 text-xs" : ""}>
          <a
            href={`#${h.slug}`}
            class="toc-link block text-text-secondary hover:text-brand-primary transition-colors py-1"
          >
            {h.text}
          </a>
        </li>
      ))
    ) : (
      <li class="text-xs text-text-muted italic">Overview</li>
    )}
  </Fragment>

  <!-- Editorial Content Body -->
  <div class="space-y-6">
    <Content />
  </div>

  <!-- In-article Newsletter touchpoint -->
  <div class="my-12">
    <NewsletterInline />
  </div>

  <!-- Exit intent modal trigger -->
  <NewsletterExitIntent />
</ArticleLayout>
