          <!-- Editorial Trust Card -->
          <div class="rounded-2xl border border-[#E3E8EF] bg-white p-6 shadow-xs">
            <h3 class="text-xs font-bold uppercase tracking-wider text-[#14233B]">
              Editorial Standards
