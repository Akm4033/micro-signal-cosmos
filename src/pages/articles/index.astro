---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { CATEGORIES } from '../../data/categories';
import { getPublishedArticles } from '../../data/articles';

// Retrieve all published, non-draft articles sorted by date descending
const publishedArticles = await getPublishedArticles();

// Calculate published counts per category
const categoryCounts = publishedArticles.reduce<Record<string, number>>((acc, article) => {
  const cat = article.data.category.toLowerCase().trim();
  acc[cat] = (acc[cat] || 0) + 1;
  return acc;
}, {});
// JSON-LD Structured Data (CollectionPage + BreadcrumbList)
const siteUrl = Astro.site?.href.replace(/\/$/, '') || 'https://microsignalcosmos.com';
const archiveUrl = `${siteUrl}/articles/`;

const archiveJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      '@id': `${archiveUrl}#collection`,
      name: 'Explore All Articles | Micro Signal Cosmos',
      description: 'Explore our complete editorial catalog of technology, science, artificial intelligence, and digital insights.',
      url: archiveUrl,
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${archiveUrl}#breadcrumb`,
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Home',
          item: siteUrl ? `${siteUrl}/` : '/',
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Articles',
          item: archiveUrl,
        },
      ],
    },
  ],
};
---

<Layout
  title="Explore All Articles | Micro Signal Cosmos"
  description="Explore our complete editorial catalog of technology, science, artificial intelligence, and digital insights. Filter by topic or search our published archives."
  type="website"
  jsonLd={archiveJsonLd}
>
  <Header />

  <main id="main-content" class="bg-[#0B0F19] py-12 sm:py-16 lg:py-20">
    <div class="container-main">

      <!-- Breadcrumbs Navigation -->
      <nav aria-label="Breadcrumb" class="mb-8">
        <ol class="flex flex-wrap items-center gap-2 text-xs sm:text-sm text-slate-400">
          <li>
            <a
              href="/"
              class="transition-colors hover:text-sky-400 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sky-400 rounded"
            >
              Home
            </a>
          </li>
          <li aria-hidden="true" class="text-slate-600">/</li>
          <li class="font-medium text-slate-300" aria-current="page">
            Articles
          </li>
        </ol>
      </nav>

      <!-- Archive Hero Section -->
      <header class="mx-auto max-w-4xl text-center sm:text-left">
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
          <!-- Archive Insignia Badge -->
          <div class="inline-flex items-center gap-2.5 self-center sm:self-start rounded-full border border-sky-400/20 bg-sky-400/5 px-4 py-1.5 text-xs font-semibold tracking-wider uppercase">
            <span class="h-2 w-2 rounded-full bg-[#00D2FF] shadow-[0_0_10px_#00D2FF]" aria-hidden="true"></span>
            <span class="text-sky-300">Knowledge Archive</span>
            <span class="text-slate-600">•</span>
            <span class="text-slate-400">Editorial Feed</span>
          </div>

          <!-- Total Count Badge -->
          <div class="self-center sm:self-auto text-xs font-medium text-slate-400">
            <span class="rounded-full border border-white/10 bg-[#151C2E] px-3.5 py-1 text-slate-300">
              <strong class="font-semibold text-white" id="total-badge-count">{publishedArticles.length}</strong> {publishedArticles.length === 1 ? 'Article' : 'Articles'} Published
            </span>
          </div>
        </div>

        <h1 class="mt-6 text-3xl font-extrabold tracking-tight text-white sm:text-4xl lg:text-5xl">
          Explore All <span class="bg-gradient-to-r from-sky-400 via-blue-400 to-purple-400 bg-clip-text text-transparent">Articles</span>
        </h1>

        <p class="mt-4 max-w-2xl text-base leading-relaxed text-slate-300 sm:text-lg">
          Discover deep-dive analyses, scientific discoveries, and practical technology guides designed to clarify complex developments and expand your digital horizons.
        </p>

        <!-- Search & Filtering Interface -->
        <div class="mt-10 rounded-2xl border border-white/10 bg-[#151C2E] p-5 sm:p-7 shadow-lg">
          <!-- Search Bar -->
          <div class="flex flex-col sm:flex-row gap-4 items-stretch sm:items-center justify-between">
            <div class="relative flex-1 max-w-xl">
              <label for="article-search" class="sr-only">Search articles by title, description, category or tag</label>
              <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-4 text-sky-400" aria-hidden="true">
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                </svg>
              </div>
              <input
                id="article-search"
                type="search"
                placeholder="Search by title, topic, keyword or tag..."
                class="w-full rounded-xl border border-white/10 bg-[#0B0F19] py-3 pl-11 pr-10 text-sm text-white placeholder-slate-500 transition-all focus:border-sky-400 focus:outline-none focus:ring-1 focus:ring-sky-400"
                autocomplete="off"
              />
              <button
                id="clear-search-btn"
                type="button"
                class="hidden absolute inset-y-0 right-0 flex items-center pr-3.5 text-slate-400 hover:text-white"
                aria-label="Clear search input"
              >
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                </svg>
              </button>
            </div>

            <!-- Dynamic Results Counter -->
            <div id="results-count" aria-live="polite" class="text-xs sm:text-sm font-medium text-slate-400 shrink-0 self-center">
              Showing all {publishedArticles.length} articles
            </div>
          </div>

          <!-- Category Filter Tabs -->
          <div class="mt-6 border-t border-white/5 pt-5">
            <div class="overflow-x-auto pb-2 -mx-2 px-2">
              <div
                role="tablist"
                aria-label="Filter articles by category"
                class="flex items-center gap-2 min-w-max"
              >
                <span class="text-xs font-semibold uppercase tracking-wider text-slate-400 mr-2">
                  Topics:
                </span>

                <!-- All Articles Filter Button -->
                <button
                  type="button"
                  role="tab"
                  aria-selected="true"
                  data-category-filter="all"
                  class="category-filter-btn inline-flex items-center gap-2 rounded-full px-3.5 py-1.5 text-xs font-bold transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sky-400 bg-sky-400 text-slate-950 shadow-[0_0_15px_rgba(56,189,248,0.25)] border border-sky-400"
                >
                  <span class="h-1.5 w-1.5 rounded-full bg-slate-950" aria-hidden="true"></span>
                  <span>All Articles</span>
                  <span class="filter-count rounded-full bg-slate-950/20 px-1.5 py-0.2 text-[10px]">
                    {publishedArticles.length}
                  </span>
                </button>

                <!-- Seven Individual Category Filters -->
                {CATEGORIES.map((cat) => {
                  const count = categoryCounts[cat.slug] || categoryCounts[cat.name.toLowerCase()] || 0;
                  return (
                    <button
                      type="button"
                      role="tab"
                      aria-selected="false"
                      data-category-filter={cat.slug}
                      data-accent={cat.accent}
                      class="category-filter-btn inline-flex items-center gap-2 rounded-full border border-white/10 bg-[#0B0F19] px-3.5 py-1.5 text-xs font-medium text-slate-300 transition-all hover:border-white/20 hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sky-400"
                    >
                      <span
                        class:list={[
                          'h-1.5 w-1.5 rounded-full',
                          cat.accent === 'purple' ? 'bg-purple-400' : 'bg-sky-400',
                        ]}
                        aria-hidden="true"
                      ></span>
                      <span>{cat.shortName || cat.name}</span>
                      {count > 0 && (
                        <span class="filter-count rounded-full bg-white/10 px-1.5 py-0.2 text-[10px] text-slate-400">
                          {count}
                        </span>
                      )}
                    </button>
                  );
                })}
              </div>
            </div>
          </div>
        </div>
      </header>

      <!-- Articles Content Section -->
      <section class="mt-14" aria-labelledby="articles-archive-heading">
        <h2 id="articles-archive-heading" class="sr-only">
          Articles Archive List
        </h2>

        <!-- Active Articles Grid -->
        <div id="articles-grid" class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {publishedArticles.map((article) => {
            const slug = article.data.slug || article.id;
            const formattedDate = article.data.publishDate.toLocaleDateString('en-US', {
              year: 'numeric',
              month: 'short',
              day: 'numeric',
            });
            const isoDate = article.data.publishDate.toISOString();

            const categoryInfo = CATEGORIES.find(
              (c) =>
                c.slug.toLowerCase() === article.data.category.toLowerCase().trim() ||
                c.name.toLowerCase() === article.data.category.toLowerCase().trim()
            );
            const categoryName = categoryInfo?.name || article.data.category;
            const categorySlug = categoryInfo?.slug || article.data.category.toLowerCase().trim();
            const categoryAccent = categoryInfo?.accent || 'sky';
            const categoryHref = categoryInfo?.href || `/category/${categorySlug}/`;

            const searchableText = `${article.data.title} ${article.data.description} ${categoryName} ${categorySlug} ${(article.data.tags || []).join(' ')} ${article.data.author}`.toLowerCase();

            return (
              <article
                data-article-card
                data-category={categorySlug}
                data-search-text={searchableText}
                class="group flex flex-col justify-between overflow-hidden rounded-2xl border border-white/10 bg-[#151C2E] p-7 transition-all duration-300 hover:-translate-y-1 hover:border-sky-400/40"
              >
                <div>
                  <div class="flex items-center justify-between gap-2 text-xs">
                    <a
                      href={categoryHref}
                      class:list={[
                        'font-semibold uppercase tracking-wider transition-colors hover:underline',
                        categoryAccent === 'purple' ? 'text-purple-400 hover:text-purple-300' : 'text-sky-400 hover:text-sky-300',
                      ]}
                    >
                      {categoryName}
                    </a>
                    {article.data.readingTime && (
                      <span class="text-slate-400">{article.data.readingTime}</span>
                    )}
                  </div>

                  <h3 class="mt-4 text-xl font-bold leading-snug text-white transition-colors group-hover:text-sky-300">
                    <a
                      href={`/articles/${slug}/`}
                      class="focus-visible:outline-none focus-visible:underline"
                    >
                      {article.data.title}
                    </a>
                  </h3>

                  <p class="mt-3 text-sm leading-relaxed text-slate-400 line-clamp-3">
                    {article.data.description}
                  </p>
                </div>

                <div class="mt-8 flex items-center justify-between border-t border-white/5 pt-5 text-xs text-slate-400">
                  <div class="flex items-center gap-2">
                    <span class="block font-medium text-slate-300">{article.data.author}</span>
                    <span aria-hidden="true">•</span>
                    <time datetime={isoDate}>{formattedDate}</time>
                  </div>

                  <a
                    href={`/articles/${slug}/`}
                    class="inline-flex items-center gap-1 font-semibold text-sky-400 transition-all group-hover:gap-2 group-hover:text-sky-300"
                    aria-label={`Read article: ${article.data.title}`}
                  >
                    Read <span aria-hidden="true">→</span>
                  </a>
                </div>
              </article>
            );
          })}
        </div>

        <!-- Empty State: No Matches Found via Search or Filter -->
        <div
          id="no-results-state"
          class="hidden mx-auto max-w-xl rounded-2xl border border-white/10 bg-[#151C2E] p-8 sm:p-12 text-center"
        >
          <div class="relative mx-auto flex h-20 w-20 items-center justify-center rounded-full border border-sky-400/30 bg-sky-400/5 shadow-[0_0_30px_rgba(56,189,248,0.12)]">
            <svg class="h-10 w-10 text-sky-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7" />
            </svg>
          </div>

          <h3 class="mt-6 text-xl font-bold tracking-tight text-white sm:text-2xl">
            No Matching Articles Found
          </h3>

          <p class="mt-2 text-sm leading-relaxed text-slate-400">
            We couldn't find any articles matching your search query or topic filter. Try broadening your keywords or clearing the active filters.
          </p>

          <div class="mt-6 flex flex-wrap justify-center gap-3">
            <button
              id="reset-filters-btn"
              type="button"
              class="inline-flex items-center gap-2 rounded-lg border border-sky-400/40 bg-sky-400/10 px-4 py-2 text-xs font-semibold text-sky-300 transition-all hover:bg-sky-400/20 hover:border-sky-400 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sky-400"
            >
              Reset Search & Filters
            </button>
            <a
              href="/#categories"
              class="inline-flex items-center gap-2 rounded-lg border border-white/10 bg-white/5 px-4 py-2 text-xs font-semibold text-slate-300 transition-all hover:border-white/20 hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sky-400"
            >
              Browse Categories
            </a>
          </div>
        </div>
      </section>

      <!-- Editorial Standards Footer Callout -->
      <section class="mt-20 rounded-2xl border border-white/10 bg-gradient-to-br from-[#151C2E] via-[#101726] to-[#191932] p-8 sm:p-12">
        <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-8">
          <div class="max-w-2xl">
            <span class="text-xs font-bold tracking-[0.2em] text-sky-400 uppercase">
              Micro Signal Cosmos Standards
            </span>
            <h2 class="mt-3 text-2xl font-bold tracking-tight text-white sm:text-3xl">
              Clarity, Depth, and Rigorous Editorial Integrity
            </h2>
            <p class="mt-3 text-sm sm:text-base leading-relaxed text-slate-400">
              Every article published in Micro Signal Cosmos is authored with a commitment to fundamental understanding: peeling back sensationalist hype to explain the actual mechanics of emerging technology and science.
            </p>
          </div>
          <div class="flex flex-wrap items-center gap-3 shrink-0">
            <a
              href="/about/"
              class="inline-flex items-center gap-2 rounded-lg border border-sky-400/40 bg-sky-400/10 px-5 py-3 text-xs sm:text-sm font-semibold text-sky-300 transition-all hover:bg-sky-400/20 hover:border-sky-400 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sky-400"
            >
              Our Mission & Standards →
            </a>
            <a
              href="/contact/"
              class="inline-flex items-center gap-2 rounded-lg border border-white/10 bg-white/5 px-5 py-3 text-xs sm:text-sm font-semibold text-slate-300 transition-all hover:border-white/30 hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sky-400"
            >
              Contact Editorial Desk
            </a>
          </div>
        </div>
      </section>

    </div>
  </main>

  <Footer />
</Layout>

<script>
  // ========================================================
  // CLIENT-SIDE SEARCH & CATEGORY FILTERING ENGINE
  // ========================================================
  document.addEventListener('DOMContentLoaded', () => {
    const searchInput = document.getElementById('article-search') as HTMLInputElement | null;
    const clearSearchBtn = document.getElementById('clear-search-btn') as HTMLButtonElement | null;
    const filterButtons = document.querySelectorAll<HTMLButtonElement>('.category-filter-btn');
    const articleCards = document.querySelectorAll<HTMLElement>('[data-article-card]');
    const noResultsState = document.getElementById('no-results-state');
    const resultsCount = document.getElementById('results-count');
    const resetBtn = document.getElementById('reset-filters-btn');

    let activeCategory = 'all';
    let searchQuery = '';

    function filterArticles() {
      const query = searchQuery.trim().toLowerCase();
      let visibleCount = 0;

      articleCards.forEach((card) => {
        const category = (card.getAttribute('data-category') || '').toLowerCase();
        const searchText = (card.getAttribute('data-search-text') || '').toLowerCase();

        const matchesCategory = activeCategory === 'all' || category === activeCategory;
        const matchesSearch = !query || searchText.includes(query);

        if (matchesCategory && matchesSearch) {
          card.classList.remove('hidden');
          visibleCount++;
        } else {
          card.classList.add('hidden');
        }
      });

      // Update screen-reader and visual result counter
      if (resultsCount) {
        if (activeCategory === 'all' && !query) {
          resultsCount.textContent = `Showing all ${visibleCount} articles`;
        } else {
          resultsCount.textContent = `Showing ${visibleCount} of ${articleCards.length} articles`;
        }
      }

      // Show/hide empty state
      if (noResultsState) {
        if (visibleCount === 0) {
          noResultsState.classList.remove('hidden');
        } else {
          noResultsState.classList.add('hidden');
        }
      }
    }

    // Category button click handlers
    filterButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const targetCategory = btn.getAttribute('data-category-filter') || 'all';
        activeCategory = targetCategory;

        // Update button visual styles and ARIA states
        filterButtons.forEach((b) => {
          const isSelected = b === btn;
          b.setAttribute('aria-selected', isSelected ? 'true' : 'false');

          if (isSelected) {
            const accent = b.getAttribute('data-accent');
            if (accent === 'purple') {
              b.className = 'category-filter-btn inline-flex items-center gap-2 rounded-full px-3.5 py-1.5 text-xs font-bold transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-purple-400 bg-purple-400 text-slate-950 shadow-[0_0_15px_rgba(167,139,250,0.25)] border border-purple-400';
            } else {
              b.className = 'category-filter-btn inline-flex items-center gap-2 rounded-full px-3.5 py-1.5 text-xs font-bold transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sky-400 bg-sky-400 text-slate-950 shadow-[0_0_15px_rgba(56,189,248,0.25)] border border-sky-400';
            }
          } else {
            b.className = 'category-filter-btn inline-flex items-center gap-2 rounded-full border border-white/10 bg-[#0B0F19] px-3.5 py-1.5 text-xs font-medium text-slate-300 transition-all hover:border-white/20 hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sky-400';
          }
        });

        filterArticles();
      });
    });

    // Search input handler
    searchInput?.addEventListener('input', (e) => {
      searchQuery = (e.target as HTMLInputElement).value;
      if (clearSearchBtn) {
        if (searchQuery.length > 0) {
          clearSearchBtn.classList.remove('hidden');
        } else {
          clearSearchBtn.classList.add('hidden');
        }
      }
      filterArticles();
    });

    // Clear search button handler
    clearSearchBtn?.addEventListener('click', () => {
      if (searchInput) {
        searchInput.value = '';
        searchQuery = '';
        clearSearchBtn.classList.add('hidden');
        searchInput.focus();
        filterArticles();
      }
    });

    // Reset button in empty state
    resetBtn?.addEventListener('click', () => {
      if (searchInput) {
        searchInput.value = '';
        searchQuery = '';
      }
      if (clearSearchBtn) {
        clearSearchBtn.classList.add('hidden');
      }

      // Reset to "all" filter button
      const allBtn = document.querySelector<HTMLButtonElement>('[data-category-filter="all"]');
      if (allBtn) {
        allBtn.click();
      } else {
        activeCategory = 'all';
        filterArticles();
      }
    });

    // Support URL param filtering (e.g., /articles/?category=technology)
    const urlParams = new URLSearchParams(window.location.search);
    const categoryParam = urlParams.get('category');
    if (categoryParam) {
      const matchingBtn = document.querySelector<HTMLButtonElement>(`[data-category-filter="${categoryParam.toLowerCase()}"]`);
      if (matchingBtn) {
        matchingBtn.click();
      }
    }
  });
</script>
