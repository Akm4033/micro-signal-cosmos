---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { CATEGORIES } from '../../data/categories';
import { getPublishedArticles } from '../../data/articles';

// Retrieve all published, non-draft articles sorted by date descending
const publishedArticles = await getPublishedArticles();

// Calculate published counts per category
const categoryCounts = publishedArticles.reduce<Record<string, number>>((acc, article) => {
  const cat = article.data.category.toLowerCase().trim();
  acc[cat] = (acc[cat] || 0) + 1;
  return acc;
}, {});

// JSON-LD Structured Data
const siteUrl = Astro.site?.href.replace(/\/$/, '') || 'https://microsignalcosmos.com';
const archiveUrl = `${siteUrl}/articles/`;

const archiveJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      '@id': `${archiveUrl}#collection`,
      name: 'Explore All Articles | Micro Signal Cosmos',
      description: 'Explore our complete editorial catalog of technology, science, artificial intelligence, and digital insights.',
      url: archiveUrl,
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${archiveUrl}#breadcrumb`,
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Home',
          item: `${siteUrl}/`,
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Articles',
          item: archiveUrl,
        },
      ],
    },
  ],
};
---

<Layout
  title="Explore All Articles | Micro Signal Cosmos"
  description="Explore our complete editorial catalog of technology, science, artificial intelligence, and digital insights. Filter by topic or search our published archives."
  type="website"
  jsonLd={archiveJsonLd}
>
  <Header />

  <main id="main-content" class="bg-[#F7F9FC] py-12 sm:py-16 lg:py-20">
    <div class="container-main">

      <!-- Breadcrumbs Navigation -->
      <nav aria-label="Breadcrumb" class="mb-8">
        <ol class="flex flex-wrap items-center gap-2 text-xs sm:text-sm text-[#697586]">
          <li>
            <a
              href="/"
              class="transition-colors hover:text-[#3478F6] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#3478F6] rounded"
            >
              Home
            </a>
          </li>
          <li aria-hidden="true" class="text-slate-400">/</li>
          <li class="font-semibold text-[#14233B]" aria-current="page">
            Articles Archive
          </li>
        </ol>
      </nav>

      <!-- Archive Hero Header -->
      <header class="mx-auto max-w-4xl text-center sm:text-left">
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
          <div class="inline-flex items-center gap-2 self-center sm:self-start rounded-full border border-[#E3E8EF] bg-white px-3.5 py-1 text-xs font-bold tracking-widest text-[#3478F6] uppercase shadow-xs">
            <span class="h-1.5 w-1.5 rounded-full bg-[#3478F6]"></span>
            <span>Knowledge Archive</span>
          </div>

          <div class="self-center sm:self-auto text-xs font-semibold text-[#697586]">
            <span class="rounded-full border border-[#E3E8EF] bg-white px-3.5 py-1 text-[#14233B] shadow-xs">
              <strong class="font-bold text-[#3478F6]" id="total-badge-count">{publishedArticles.length}</strong> {publishedArticles.length === 1 ? 'Article' : 'Articles'} Published
            </span>
          </div>
        </div>

        <h1 class="mt-6 text-3xl font-extrabold tracking-tight text-[#14233B] sm:text-4xl lg:text-5xl">
          Explore All <span class="text-[#3478F6]">Articles</span>
        </h1>

        <p class="mt-4 max-w-2xl text-base leading-relaxed text-[#202938] sm:text-lg">
          Discover deep-dive analyses, scientific discoveries, and practical technology guides designed to clarify complex developments and expand your digital horizons.
        </p>

        <!-- Search & Filtering Interface Card -->
        <div class="mt-10 rounded-2xl border border-[#E3E8EF] bg-white p-6 sm:p-8 shadow-xs">
          <!-- Search Bar -->
          <div class="flex flex-col sm:flex-row gap-4 items-stretch sm:items-center justify-between">
            <div class="relative flex-1 max-w-xl">
              <label for="article-search" class="sr-only">Search articles by title, description, category or tag</label>
              <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-4 text-[#697586]" aria-hidden="true">
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                </svg>
              </div>
              <input
                id="article-search"
                type="search"
                placeholder="Search by title, topic, keyword or tag..."
                class="w-full rounded-xl border border-[#E3E8EF] bg-[#F7F9FC] py-3 pl-11 pr-10 text-sm text-[#14233B] placeholder-[#697586] transition-all focus:border-[#3478F6] focus:bg-white focus:outline-none focus:ring-2 focus:ring-[#3478F6]/20"
                autocomplete="off"
              />
              <button
                id="clear-search-btn"
                type="button"
                class="hidden absolute inset-y-0 right-0 flex items-center pr-3.5 text-[#697586] hover:text-[#14233B]"
                aria-label="Clear search input"
              >
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                </svg>
              </button>
            </div>

            <!-- Dynamic Results Counter -->
            <div id="results-count" aria-live="polite" class="text-xs sm:text-sm font-semibold text-[#697586] shrink-0 self-center">
              Showing all {publishedArticles.length} articles
            </div>
          </div>

          <!-- Category Filter Tabs -->
          <div class="mt-6 border-t border-[#E3E8EF] pt-5">
            <div class="overflow-x-auto pb-2 -mx-2 px-2">
              <div
                role="tablist"
                aria-label="Filter articles by category"
                class="flex items-center gap-2 min-w-max"
              >
                <span class="text-xs font-bold uppercase tracking-wider text-[#697586] mr-2">
                  Streams:
                </span>

                <!-- All Articles Filter Button -->
                <button
                  type="button"
                  role="tab"
                  aria-selected="true"
                  data-category-filter="all"
                  class="category-filter-btn inline-flex items-center gap-2 rounded-full px-3.5 py-1.5 text-xs font-bold transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#3478F6] bg-[#3478F6] text-white shadow-xs border border-[#3478F6]"
                >
                  <span class="h-1.5 w-1.5 rounded-full bg-white" aria-hidden="true"></span>
                  <span>All Articles</span>
                  <span class="filter-count rounded-full bg-white/20 px-1.5 py-0.2 text-[10px]">
                    {publishedArticles.length}
                  </span>
                </button>

                <!-- 7 Individual Category Filters -->
                {CATEGORIES.map((cat) => {
                  const count = categoryCounts[cat.slug] || categoryCounts[cat.name.toLowerCase()] || 0;
                  return (
                    <button
                      type="button"
                      role="tab"
                      aria-selected="false"
                      data-category-filter={cat.slug}
                      class="category-filter-btn inline-flex items-center gap-2 rounded-full border border-[#E3E8EF] bg-[#F7F9FC] px-3.5 py-1.5 text-xs font-semibold text-[#202938] transition-all hover:border-[#3478F6] hover:text-[#3478F6] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#3478F6]"
                    >
                      <span class="h-1.5 w-1.5 rounded-full bg-[#3478F6]" aria-hidden="true"></span>
                      <span>{cat.shortName || cat.name}</span>
                      {count > 0 && (
                        <span class="filter-count rounded-full bg-[#E3E8EF] px-1.5 py-0.2 text-[10px] text-[#697586]">
                          {count}
                        </span>
                      )}
                    </button>
                  );
                })}
              </div>
            </div>
          </div>
        </div>
      </header>

      <!-- Articles Content Section -->
      <section class="mt-12" aria-labelledby="articles-archive-heading">
        <h2 id="articles-archive-heading" class="sr-only">
          Articles Archive List
        </h2>

        <!-- Active Articles Grid -->
        <div id="articles-grid" class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {publishedArticles.map((article) => {
            const slug = article.data.slug || article.id;
            const formattedDate = article.data.publishDate.toLocaleDateString('en-US', {
              year: 'numeric',
              month: 'short',
              day: 'numeric',
            });
            const isoDate = article.data.publishDate.toISOString();

            const categoryInfo = CATEGORIES.find(
              (c) =>
                c.slug.toLowerCase() === article.data.category.toLowerCase().trim() ||
                c.name.toLowerCase() === article.data.category.toLowerCase().trim()
            );
            const categoryName = categoryInfo?.name || article.data.category;
            const categorySlug = categoryInfo?.slug || article.data.category.toLowerCase().trim();
            const categoryHref = categoryInfo?.href || `/category/${categorySlug}/`;

            const searchableText = `${article.data.title} ${article.data.description} ${categoryName} ${categorySlug} ${(article.data.tags || []).join(' ')} ${article.data.author}`.toLowerCase();

            return (
              <article
                data-article-card
                data-category={categorySlug}
                data-search-text={searchableText}
                class="group flex flex-col justify-between overflow-hidden rounded-2xl border border-[#E3E8EF] bg-white p-6 sm:p-7 shadow-xs transition-all duration-300 hover:-translate-y-1 hover:shadow-md hover:border-[#CBD5E1]"
              >
                <div>
                  <div class="flex items-center justify-between gap-2 text-xs mb-3">
                    <a
                      href={categoryHref}
                      class="font-bold uppercase tracking-wider text-[#3478F6] hover:underline"
                    >
                      {categoryName}
                    </a>
                    {article.data.readingTime && (
                      <span class="text-[#697586]">{article.data.readingTime}</span>
                    )}
                  </div>

                  <h3 class="text-xl font-bold leading-snug text-[#14233B] transition-colors group-hover:text-[#3478F6]">
                    <a
                      href={`/articles/${slug}/`}
                      class="focus-visible:outline-none focus-visible:underline"
                    >
                      {article.data.title}
                    </a>
                  </h3>

                  <p class="mt-3 text-sm leading-relaxed text-[#202938] line-clamp-3">
                    {article.data.description}
                  </p>
                </div>

                <div class="mt-8 flex items-center justify-between border-t border-[#E3E8EF] pt-4 text-xs text-[#697586]">
                  <div class="flex items-center gap-2">
                    <span class="font-medium text-[#14233B]">{article.data.author}</span>
                    <span aria-hidden="true">&bull;</span>
                    <time datetime={isoDate}>{formattedDate}</time>
                  </div>

                  <a
                    href={`/articles/${slug}/`}
                    class="inline-flex items-center gap-1 font-semibold text-[#3478F6] transition-all group-hover:gap-2 group-hover:text-[#2563EB]"
                    aria-label={`Read article: ${article.data.title}`}
                  >
                    <span>Read</span>
                    <span aria-hidden="true">&rarr;</span>
                  </a>
                </div>
              </article>
            );
          })}
        </div>

        <!-- Empty State: No Matches Found via Search or Filter -->
        <div
          id="no-results-state"
          class="hidden mx-auto max-w-xl rounded-2xl border border-[#E3E8EF] bg-white p-8 sm:p-12 text-center shadow-xs"
        >
          <div class="relative mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-[#F7F9FC] border border-[#E3E8EF] text-[#3478F6] mb-4">
            <svg class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7" />
            </svg>
          </div>

          <h3 class="text-xl font-bold text-[#14233B]">
            No Matching Articles Found
          </h3>

          <p class="mt-2 text-sm text-[#697586]">
            We could not find any published articles matching your current search criteria.
          </p>

          <button
            id="reset-filter-btn"
            type="button"
            class="mt-6 btn-primary text-xs"
          >
            Clear Filters & View All Articles
          </button>
        </div>
      </section>

    </div>
  </main>

  <Footer />
</Layout>

<!-- Client-Side Instant Search & Filter Logic -->
<script is:inline>
  (function() {
    const searchInput = document.getElementById('article-search');
    const clearBtn = document.getElementById('clear-search-btn');
    const resultsCount = document.getElementById('results-count');
    const noResultsState = document.getElementById('no-results-state');
    const resetFilterBtn = document.getElementById('reset-filter-btn');
    const filterButtons = document.querySelectorAll('.category-filter-btn');
    const articleCards = document.querySelectorAll('[data-article-card]');

    let currentFilter = 'all';
    let currentQuery = '';

    function filterArticles() {
      let visibleCount = 0;
      const q = currentQuery.trim().toLowerCase();

      articleCards.forEach((card) => {
        const cardCategory = card.getAttribute('data-category') || '';
        const cardSearchText = card.getAttribute('data-search-text') || '';

        const matchesCategory = (currentFilter === 'all') || (cardCategory === currentFilter);
        const matchesQuery = (q === '') || cardSearchText.includes(q);

        if (matchesCategory && matchesQuery) {
          card.classList.remove('hidden');
          visibleCount++;
        } else {
          card.classList.add('hidden');
        }
      });

      // Update counter
      if (resultsCount) {
        if (q || currentFilter !== 'all') {
          resultsCount.textContent = `Showing ${visibleCount} matching ${visibleCount === 1 ? 'article' : 'articles'}`;
        } else {
          resultsCount.textContent = `Showing all ${articleCards.length} articles`;
        }
      }

      // Empty State Display
      if (noResultsState) {
        if (visibleCount === 0) {
          noResultsState.classList.remove('hidden');
        } else {
          noResultsState.classList.add('hidden');
        }
      }
    }

    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        currentQuery = e.target.value;
        if (clearBtn) {
          if (currentQuery.length > 0) {
            clearBtn.classList.remove('hidden');
          } else {
            clearBtn.classList.add('hidden');
          }
        }
        filterArticles();
      });
    }

    if (clearBtn) {
      clearBtn.addEventListener('click', () => {
        if (searchInput) {
          searchInput.value = '';
          searchInput.focus();
        }
        currentQuery = '';
        clearBtn.classList.add('hidden');
        filterArticles();
      });
    }

    filterButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        currentFilter = btn.getAttribute('data-category-filter') || 'all';

        filterButtons.forEach((b) => {
          const isSelected = b === btn;
          b.setAttribute('aria-selected', isSelected ? 'true' : 'false');

          if (isSelected) {
            b.className = 'category-filter-btn inline-flex items-center gap-2 rounded-full px-3.5 py-1.5 text-xs font-bold transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#3478F6] bg-[#3478F6] text-white shadow-xs border border-[#3478F6]';
          } else {
            b.className = 'category-filter-btn inline-flex items-center gap-2 rounded-full border border-[#E3E8EF] bg-[#F7F9FC] px-3.5 py-1.5 text-xs font-semibold text-[#202938] transition-all hover:border-[#3478F6] hover:text-[#3478F6] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#3478F6]';
          }
        });

        filterArticles();
      });
    });

    if (resetFilterBtn) {
      resetFilterBtn.addEventListener('click', () => {
        if (searchInput) {
          searchInput.value = '';
        }
        currentQuery = '';
        if (clearBtn) clearBtn.classList.add('hidden');

        const allBtn = document.querySelector('[data-category-filter="all"]');
        if (allBtn) {
          allBtn.click();
        } else {
          currentFilter = 'all';
          filterArticles();
        }
      });
    }
  })();
</script>
