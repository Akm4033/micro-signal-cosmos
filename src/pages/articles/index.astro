---
import Base from '../../layouts/Base.astro';
import ArticleLogo from '../../components/ui/ArticleLogo.astro';
import ArticleVisual from '../../components/ui/ArticleVisual.astro';
import { CATEGORIES } from '../../data/categories';
import { getPublishedArticles, getArticleReadingTime, getArticleSlug } from '../../data/articles';
import { getAuthor } from '../../data/authors';

// Retrieve all published, non-draft articles sorted by date descending
const publishedArticles = await getPublishedArticles();

// Calculate published counts per category
const categoryCounts = publishedArticles.reduce<Record<string, number>>((acc, article) => {
  const cat = article.data.category.toLowerCase().trim();
  acc[cat] = (acc[cat] || 0) + 1;
  return acc;
}, {});

const siteUrl = Astro.site ? Astro.site.href.replace(/\/$/, '') : (process.env.SITE_URL || 'https://Signal Insight.pages.dev');
const archiveUrl = `${siteUrl}/articles/`;
---

<Base
  title="Explore All Articles | Signal Insight"
  description="Explore our complete editorial catalog of technology, science, artificial intelligence, and developer tools. Filter by topic or search our published archives."
  canonical={archiveUrl}
>
  <main id="main-content" class="bg-neutral-50 py-12 sm:py-16 lg:py-20 border-b border-neutral-200 dark:bg-[#05070E] dark:border-white/[0.08]">
    <div class="container-wide">

      <!-- Breadcrumbs Navigation -->
      <nav aria-label="Breadcrumb" class="mb-8">
        <ol class="flex flex-wrap items-center gap-2 text-xs sm:text-sm text-text-muted">
          <li>
            <a
              href="/"
              class="transition-colors hover:text-brand-primary rounded"
            >
              Home
            </a>
          </li>
          <li aria-hidden="true" class="text-neutral-400">/</li>
          <li class="font-semibold text-text-primary" aria-current="page">
            Articles Archive
          </li>
        </ol>
      </nav>

      <!-- Archive Hero Header -->
      <header class="mx-auto max-w-4xl text-center sm:text-left">
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
          <div class="inline-flex items-center gap-2 self-center sm:self-start rounded-full border border-neutral-200 bg-white px-3.5 py-1 text-xs font-bold tracking-widest text-brand-primary uppercase shadow-xs dark:border-white/[0.08] dark:bg-[#0B101D] dark:text-blue-400">
            <span class="h-1.5 w-1.5 rounded-full bg-brand-primary"></span>
            <span class="font-mono text-[10.5px]">Knowledge Archive</span>
          </div>

          <div class="self-center sm:self-auto text-xs font-semibold text-text-muted">
            <span class="rounded-full border border-neutral-200 bg-white px-3.5 py-1 text-text-primary shadow-xs dark:border-white/[0.08] dark:bg-[#0B101D] dark:text-slate-300 font-mono text-[11px]">
              <strong class="font-bold text-brand-primary dark:text-blue-400" id="total-badge-count">{publishedArticles.length}</strong> {publishedArticles.length === 1 ? 'Article' : 'Articles'} Published
            </span>
          </div>
        </div>

        <h1 class="mt-6 text-3xl font-extrabold tracking-tight text-text-primary sm:text-4xl lg:text-5xl">
          Explore All <span class="text-brand-primary dark:text-blue-400">Articles</span>
        </h1>

        <p class="mt-4 max-w-2xl text-base leading-relaxed text-text-secondary sm:text-lg">
          Filter by technical pillar, search keywords across all deep-dive guides, or browse our complete technical catalog.
        </p>

        <!-- Search Input & Interactive Filter Controls -->
        <div class="mt-8 space-y-4">
          <!-- Instant Search Box -->
          <div class="relative max-w-xl">
            <label for="archive-search-input" class="sr-only">Search articles</label>
            <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-4 text-text-muted">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="11" cy="11" r="8"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
              </svg>
            </div>
            <input
              id="archive-search-input"
              type="search"
              placeholder="Search by keyword, topic, or author..."
              class="w-full rounded-xl border border-neutral-300 bg-white py-3 pl-11 pr-10 text-sm text-text-primary placeholder-text-muted shadow-xs transition-all focus:border-brand-primary focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-primary/20 dark:border-white/[0.08] dark:bg-[#0B101D] dark:text-neutral-100 dark:placeholder-neutral-500 focus:dark:border-blue-500/60"
              autocomplete="off"
            />
            <button
              id="clear-search-btn"
              type="button"
              class="hidden absolute inset-y-0 right-0 items-center pr-3.5 text-text-muted hover:text-text-primary rounded"
              aria-label="Clear search query"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="18" y1="6" x2="6" y2="18"></line>
                <line x1="6" y1="6" x2="18" y2="18"></line>
              </svg>
            </button>
          </div>

          <!-- Category Filter Pills -->
          <div class="overflow-x-auto pb-2 -mx-4 px-4 sm:mx-0 sm:px-0">
            <div
              id="category-filters-container"
              class="flex items-center gap-2 min-w-max"
              role="tablist"
              aria-label="Filter articles by category"
            >
              <span class="text-xs font-bold uppercase tracking-wider text-text-muted mr-2 font-mono text-[11px]">
                Streams:
              </span>

              <!-- All Articles Filter Button -->
              <button
                type="button"
                role="tab"
                aria-selected="true"
                data-category-filter="all"
                class="category-filter-btn inline-flex items-center gap-2 rounded-full px-3.5 py-1.5 text-xs font-bold transition-all bg-brand-primary text-white shadow-xs border border-brand-primary dark:bg-blue-600 dark:border-blue-500"
              >
                <span class="h-1.5 w-1.5 rounded-full bg-white" aria-hidden="true"></span>
                <span>All Articles</span>
                <span class="filter-count rounded-full bg-white/20 px-1.5 py-0.2 text-[10px] font-mono">
                  {publishedArticles.length}
                </span>
              </button>

              <!-- 4 Consolidated Category Filters -->
              {CATEGORIES.map((cat) => {
                const count = categoryCounts[cat.slug] || categoryCounts[cat.name.toLowerCase()] || 0;
                return (
                  <button
                    type="button"
                    role="tab"
                    aria-selected="false"
                    data-category-filter={cat.slug}
                    class="category-filter-btn inline-flex items-center gap-2 rounded-full border border-neutral-200 bg-white px-3.5 py-1.5 text-xs font-semibold text-text-secondary transition-all hover:border-brand-primary hover:text-brand-primary dark:border-white/[0.08] dark:bg-[#0B101D] dark:text-slate-300 dark:hover:border-blue-500/60 dark:hover:text-blue-400"
                  >
                    <span class="h-1.5 w-1.5 rounded-full bg-brand-primary dark:bg-blue-400" aria-hidden="true"></span>
                    <span>{cat.shortName || cat.name}</span>
                    {count > 0 && (
                      <span class="filter-count rounded-full bg-neutral-100 px-1.5 py-0.2 text-[10px] text-text-muted dark:bg-white/[0.06] dark:text-slate-400 font-mono">
                        {count}
                      </span>
                    )}
                  </button>
                );
              })}
            </div>
          </div>
        </div>
      </header>

      <!-- Articles Content Section -->
      <section class="mt-12" aria-labelledby="articles-archive-heading">
        <h2 id="articles-archive-heading" class="sr-only">
          Articles Archive List
        </h2>

        <!-- Active Articles Grid -->
        <div id="articles-grid" class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {publishedArticles.map((article) => {
            const slug = getArticleSlug(article);
            const formattedDate = article.data.publishDate.toLocaleDateString('en-US', {
              year: 'numeric',
              month: 'short',
              day: 'numeric',
            });
            const isoDate = article.data.publishDate.toISOString();

            const categoryInfo = CATEGORIES.find(
              (c) =>
                c.slug.toLowerCase() === article.data.category.toLowerCase().trim() ||
                c.name.toLowerCase() === article.data.category.toLowerCase().trim()
            );
            const categoryName = categoryInfo?.name || article.data.category;
            const categorySlug = categoryInfo?.slug || article.data.category.toLowerCase().trim();
            const categoryHref = categoryInfo?.href || `/category/${categorySlug}/`;

            const searchableText = `${article.data.title} ${article.data.description} ${categoryName} ${categorySlug} ${(article.data.tags || []).join(' ')} ${article.data.author}`.toLowerCase();
            const author = getAuthor(article.data.author);

            return (
              <article
                data-article-card
                data-category={categorySlug}
                data-search-text={searchableText}
                class="group flex flex-col justify-between overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-xs hover:shadow-lg hover:-translate-y-1 hover:border-blue-400 dark:hover:border-blue-500/60 dark:hover:shadow-[0_12px_28px_-6px_rgba(0,0,0,0.5),0_0_20px_rgba(59,130,246,0.15)] transition-all duration-200 dark:bg-[#0B101D] dark:border-white/[0.08]"
              >
                <div>
                  <div class="relative h-44 sm:h-48 w-full shrink-0 overflow-hidden flex items-center justify-center transition-colors border-b border-slate-100 dark:border-white/[0.08] bg-slate-50 dark:bg-[#070B14]">
                    <!-- Scientific Vector Graphic -->
                    <ArticleVisual slug={slug} category={categorySlug} logo={article.data.logo || categorySlug} />

                    <a href={categoryHref} class="absolute top-2.5 left-2.5 px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider bg-white/90 border border-slate-200 text-slate-800 shadow-xs z-20 dark:bg-[#0B101D]/90 dark:border-white/[0.1] dark:text-slate-200 font-mono">
                      {categoryName}
                    </a>
                  </div>

                  <div class="p-4 sm:p-5">
                    <div class="flex items-center gap-2 text-xs mb-2 text-slate-500 dark:text-slate-400 font-mono text-[10.5px]">
                      <span class="font-medium text-slate-900 dark:text-slate-200 font-sans">{author.name}</span>
                      <span aria-hidden="true" class="text-slate-300 dark:text-slate-600">&bull;</span>
                      <time datetime={isoDate}>{formattedDate}</time>
                      <span aria-hidden="true" class="text-slate-300 dark:text-slate-600">&bull;</span>
                      <span>{getArticleReadingTime(article)}</span>
                    </div>

                    <h3 class="text-base sm:text-lg font-bold leading-snug text-slate-900 group-hover:text-blue-600 transition-colors line-clamp-2 dark:text-white dark:group-hover:text-blue-400">
                      <a
                        href={`/articles/${slug}/`}
                        class="hover:underline"
                      >
                        {article.data.title}
                      </a>
                    </h3>

                    <p class="mt-2 text-xs sm:text-sm leading-relaxed text-slate-600 line-clamp-2 dark:text-slate-400">
                      {article.data.description}
                    </p>
                  </div>
                </div>

                <div class="px-4 pb-4 sm:px-5 sm:pb-5 mt-auto">
                  <div class="flex items-center justify-between border-t border-slate-100 pt-3 dark:border-white/[0.06]">
                    <div class="flex items-center gap-2">
                      <div class="w-6 h-6 rounded-full bg-blue-50 text-blue-700 flex items-center justify-center text-[10px] font-bold border border-blue-200 shadow-2xs dark:bg-blue-950/60 dark:text-blue-300 dark:border-blue-900">
                        {author.initials}
                      </div>
                      <span class="text-[11px] font-medium text-slate-500 dark:text-slate-400">{author.role}</span>
                    </div>

                    <a
                      href={`/articles/${slug}/`}
                      class="inline-flex items-center gap-1 text-xs font-bold text-blue-600 group-hover:text-blue-700 group-hover:translate-x-0.5 transition-all dark:text-blue-400"
                    >
                      <span>Read</span>
                      <span aria-hidden="true">&rarr;</span>
                    </a>
                  </div>
                </div>
              </article>
            );
          })}
        </div>

        <!-- Empty Results State (shown via JS when search/filter has 0 matches) -->
        <div
          id="no-results-state"
          class="hidden mx-auto max-w-lg rounded-2xl border border-neutral-200 bg-white p-8 sm:p-12 text-center shadow-xs dark:border-white/[0.08] dark:bg-[#0B101D]"
          role="status"
          aria-live="polite"
        >
          <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-xl bg-brand-primary/10 text-brand-primary">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
              <line x1="8" y1="11" x2="14" y2="11"></line>
            </svg>
          </div>
          <h3 class="mt-4 text-lg font-bold text-text-primary">No matching articles found</h3>
          <p class="mt-2 text-sm text-text-muted">
            We couldn't find any articles matching your search query or selected topic filter.
          </p>
          <button
            id="reset-filters-btn"
            type="button"
            class="btn-secondary mt-6"
          >
            Reset Filters
          </button>
        </div>
      </section>

    </div>
  </main>
</Base>

<!-- Client-side Search and Filter JavaScript -->
<script is:inline>
  (function initArticleArchive() {
    const searchInput = document.getElementById('archive-search-input');
    const clearBtn = document.getElementById('clear-search-btn');
    const filterButtons = document.querySelectorAll('.category-filter-btn');
    const articleCards = document.querySelectorAll('[data-article-card]');
    const noResultsState = document.getElementById('no-results-state');
    const resetFiltersBtn = document.getElementById('reset-filters-btn');
    const totalBadgeCount = document.getElementById('total-badge-count');

    let currentCategory = 'all';
    let currentSearchTerm = '';

    // Read initial URL params (?q=... and ?category=...)
    const urlParams = new URLSearchParams(window.location.search);
    const initialQuery = urlParams.get('q') || '';
    const initialCategory = urlParams.get('category') || 'all';

    if (initialQuery && searchInput) {
      searchInput.value = initialQuery;
      currentSearchTerm = initialQuery.toLowerCase().trim();
      if (clearBtn) clearBtn.classList.remove('hidden');
      if (clearBtn) clearBtn.classList.add('flex');
    }

    if (initialCategory) {
      currentCategory = initialCategory.toLowerCase().trim();
      updateFilterButtonsUI(currentCategory);
    }

    function applyFilterAndSearch() {
      let visibleCount = 0;

      articleCards.forEach((card) => {
        const cardCategory = card.getAttribute('data-category') || '';
        const cardSearchText = card.getAttribute('data-search-text') || '';

        const matchesCategory = currentCategory === 'all' || cardCategory === currentCategory;
        const matchesSearch = !currentSearchTerm || cardSearchText.includes(currentSearchTerm);

        if (matchesCategory && matchesSearch) {
          card.classList.remove('hidden');
          visibleCount++;
        } else {
          card.classList.add('hidden');
        }
      });

      if (totalBadgeCount) {
        totalBadgeCount.textContent = String(visibleCount);
      }

      if (noResultsState) {
        if (visibleCount === 0) {
          noResultsState.classList.remove('hidden');
        } else {
          noResultsState.classList.add('hidden');
        }
      }

      // Update URL without page reload
      const newUrl = new URL(window.location.href);
      if (currentSearchTerm) {
        newUrl.searchParams.set('q', currentSearchTerm);
      } else {
        newUrl.searchParams.delete('q');
      }

      if (currentCategory !== 'all') {
        newUrl.searchParams.set('category', currentCategory);
      } else {
        newUrl.searchParams.delete('category');
      }

      window.history.replaceState({}, '', newUrl.toString());
    }

    function updateFilterButtonsUI(activeCategory) {
      filterButtons.forEach((btn) => {
        const btnCategory = btn.getAttribute('data-category-filter');
        const isActive = btnCategory === activeCategory;

        btn.setAttribute('aria-selected', isActive ? 'true' : 'false');
        if (isActive) {
          btn.className = 'category-filter-btn inline-flex items-center gap-2 rounded-full px-3.5 py-1.5 text-xs font-bold transition-all bg-brand-primary text-white shadow-xs border border-brand-primary';
          const dot = btn.querySelector('span');
          if (dot) dot.className = 'h-1.5 w-1.5 rounded-full bg-white';
        } else {
          btn.className = 'category-filter-btn inline-flex items-center gap-2 rounded-full border border-neutral-200 bg-white px-3.5 py-1.5 text-xs font-semibold text-text-secondary transition-all hover:border-brand-primary hover:text-brand-primary dark:border-neutral-700 dark:bg-neutral-900';
          const dot = btn.querySelector('span');
          if (dot) dot.className = 'h-1.5 w-1.5 rounded-full bg-brand-primary';
        }
      });
    }

    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        currentSearchTerm = e.target.value.toLowerCase().trim();
        if (clearBtn) {
          if (currentSearchTerm.length > 0) {
            clearBtn.classList.remove('hidden');
            clearBtn.classList.add('flex');
          } else {
            clearBtn.classList.add('hidden');
            clearBtn.classList.remove('flex');
          }
        }
        applyFilterAndSearch();
      });
    }

    if (clearBtn && searchInput) {
      clearBtn.addEventListener('click', () => {
        searchInput.value = '';
        currentSearchTerm = '';
        clearBtn.classList.add('hidden');
        clearBtn.classList.remove('flex');
        searchInput.focus();
        applyFilterAndSearch();
      });
    }

    filterButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const selected = btn.getAttribute('data-category-filter') || 'all';
        currentCategory = selected;
        updateFilterButtonsUI(currentCategory);
        applyFilterAndSearch();
      });
    });

    if (resetFiltersBtn && searchInput) {
      resetFiltersBtn.addEventListener('click', () => {
        searchInput.value = '';
        currentSearchTerm = '';
        currentCategory = 'all';
        if (clearBtn) {
          clearBtn.classList.add('hidden');
          clearBtn.classList.remove('flex');
        }
        updateFilterButtonsUI('all');
        applyFilterAndSearch();
      });
    }

    // Run initial filter on load
    applyFilterAndSearch();
  })();
</script>
