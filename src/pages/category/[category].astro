---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { CATEGORIES, type Category } from '../../data/categories';
import { getPublishedArticles, getArticlesByCategory, type Article } from '../../data/articles';

export async function getStaticPaths() {
  const paths = await Promise.all(
    CATEGORIES.map(async (category) => {
      const articles = await getArticlesByCategory(category.slug);
      return {
        params: { category: category.slug },
        props: { category, articles },
      };
    })
  );

  return paths;
}

interface Props {
  category: Category;
  articles: Article[];
}

const { category, articles } = Astro.props;

// Other categories that currently have published articles (for recommendation in empty state)
const allPublished = await getPublishedArticles();
const categoriesWithArticles = CATEGORIES.filter((c) => {
  return allPublished.some((a) => {
    const artCat = a.data.category.toLowerCase().trim();
    return artCat === c.slug.toLowerCase().trim() || artCat === c.name.toLowerCase().trim();
  });
});
// JSON-LD Structured Data (CollectionPage + BreadcrumbList)
const siteUrl = Astro.site?.href.replace(/\/$/, '') || '';
const categoryUrl = siteUrl ? `${siteUrl}/category/${category.slug}/` : `/category/${category.slug}/`;

const categoryJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      '@id': `${categoryUrl}#collection`,
      name: `${category.name} | Micro Signal Cosmos`,
      description: category.description,
      url: categoryUrl,
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${categoryUrl}#breadcrumb`,
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Home',
          item: siteUrl ? `${siteUrl}/` : '/',
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Categories',
          item: siteUrl ? `${siteUrl}/#categories` : '/#categories',
        },
        {
          '@type': 'ListItem',
          position: 3,
          name: category.name,
          item: categoryUrl,
        },
      ],
    },
  ],
};
---

<Layout
  title={`${category.name} | Micro Signal Cosmos`}
  description={category.description}
  type="website"
  jsonLd={categoryJsonLd}
>
  <Header />

  <main id="main-content" class="bg-[#0B1020] py-12 sm:py-16 lg:py-20">
    <div class="container-main">

      <!-- Breadcrumbs Navigation -->
      <nav aria-label="Breadcrumb" class="mb-8">
        <ol class="flex flex-wrap items-center gap-2 text-xs sm:text-sm text-slate-400">
          <li>
            <a
              href="/"
              class="transition-colors hover:text-sky-400 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sky-400 rounded"
            >
              Home
            </a>
          </li>
          <li aria-hidden="true" class="text-slate-600">/</li>
          <li>
            <a
              href="/#categories"
              class="transition-colors hover:text-sky-400 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sky-400 rounded"
            >
              Categories
            </a>
          </li>
          <li aria-hidden="true" class="text-slate-600">/</li>
          <li class="font-medium text-slate-300" aria-current="page">
            {category.name}
          </li>
        </ol>
      </nav>

      <!-- Category Hero Section -->
      <header class="mx-auto max-w-4xl text-center sm:text-left">
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
          <!-- Category Pillar Badge -->
          <div class="inline-flex items-center gap-2.5 self-center sm:self-start rounded-full border border-white/10 bg-[#141C2E] px-4 py-1.5 text-xs font-semibold tracking-wider uppercase">
            <span
              class:list={[
                'h-2 w-2 rounded-full shadow-[0_0_10px_currentColor]',
                category.accent === 'purple' ? 'bg-purple-400 text-purple-400' : 'bg-sky-400 text-sky-400',
              ]}
              aria-hidden="true"
            ></span>
            <span class="text-slate-400">Pillar {category.number}</span>
            <span class="text-slate-600">•</span>
            <span
              class:list={[
                'font-bold',
                category.accent === 'purple' ? 'text-purple-300' : 'text-sky-300',
              ]}
            >
              {category.shortName || category.name}
            </span>
          </div>

          <!-- Article Count Indicator -->
          <div class="self-center sm:self-auto text-xs font-medium text-slate-400">
            {articles.length === 1 && (
              <span class="rounded-full border border-sky-400/30 bg-sky-400/10 px-3 py-1 text-sky-300">
                1 Article Published
              </span>
            )}
            {articles.length > 1 && (
              <span class="rounded-full border border-sky-400/30 bg-sky-400/10 px-3 py-1 text-sky-300">
                {articles.length} Articles Published
              </span>
            )}
            {articles.length === 0 && (
              <span class="rounded-full border border-white/10 bg-white/5 px-3 py-1 text-slate-400">
                Articles in Editorial Queue
              </span>
            )}
          </div>
        </div>

        <h1 class="mt-6 text-3xl font-extrabold tracking-tight text-white sm:text-4xl lg:text-5xl">
          {category.name}
        </h1>

        <p class="mt-4 max-w-2xl text-base leading-relaxed text-slate-300 sm:text-lg">
          {category.description}
        </p>

        <!-- Category Quick Switcher -->
        <div class="mt-10 overflow-x-auto pb-2 -mx-4 px-4 sm:mx-0 sm:px-0">
          <div class="flex items-center gap-2 min-w-max">
            <span class="text-xs font-semibold uppercase tracking-wider text-slate-400 mr-2">
              Browse Topics:
            </span>
            {CATEGORIES.map((cat) => {
              const isActive = cat.slug === category.slug;
              return (
                <a
                  href={cat.href}
                  class:list={[
                    'inline-flex items-center gap-2 rounded-full px-3.5 py-1.5 text-xs font-medium transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sky-400',
                    isActive
                      ? cat.accent === 'purple'
                        ? 'bg-purple-400 text-slate-950 font-bold shadow-[0_0_15px_rgba(167,139,250,0.3)]'
                        : 'bg-sky-400 text-slate-950 font-bold shadow-[0_0_15px_rgba(56,189,248,0.3)]'
                      : 'border border-white/10 bg-[#141C2E] text-slate-300 hover:border-white/20 hover:text-white',
                  ]}
                >
                  <span
                    class:list={[
                      'h-1.5 w-1.5 rounded-full',
                      isActive
                        ? 'bg-slate-950'
                        : cat.accent === 'purple'
                          ? 'bg-purple-400'
                          : 'bg-sky-400',
                    ]}
                    aria-hidden="true"
                  ></span>
                  {cat.shortName || cat.name}
                </a>
              );
            })}
          </div>
        </div>
      </header>

      <!-- Articles Content Section -->
      <section class="mt-12" aria-labelledby="articles-list-heading">
        <h2 id="articles-list-heading" class="sr-only">
          Articles in {category.name}
        </h2>

        {articles.length > 0 ? (
          <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
            {articles.map((article) => {
              const slug = article.data.slug || article.id;
              const formattedDate = article.data.publishDate.toLocaleDateString('en-US', {
                year: 'numeric',
                month: 'short',
                day: 'numeric',
              });
              const isoDate = article.data.publishDate.toISOString();

              return (
                <article class="group flex flex-col justify-between overflow-hidden rounded-2xl border border-white/10 bg-[#141C2E] p-7 transition-all duration-300 hover:-translate-y-1 hover:border-sky-400/40">
                  <div>
                    <div class="flex items-center justify-between gap-2 text-xs">
                      <span
                        class:list={[
                          'font-semibold uppercase tracking-wider',
                          category.accent === 'purple' ? 'text-purple-400' : 'text-sky-400',
                        ]}
                      >
                        {category.shortName || category.name}
                      </span>
                      {article.data.readingTime && (
                        <span class="text-slate-400">{article.data.readingTime}</span>
                      )}
                    </div>

                    <h3 class="mt-4 text-xl font-bold leading-snug text-white transition-colors group-hover:text-sky-300">
                      <a
                        href={`/articles/${slug}/`}
                        class="focus-visible:outline-none focus-visible:underline"
                      >
                        {article.data.title}
                      </a>
                    </h3>

                    <p class="mt-3 text-sm leading-relaxed text-slate-400 line-clamp-3">
                      {article.data.description}
                    </p>
                  </div>

                  <div class="mt-8 flex items-center justify-between border-t border-white/5 pt-5 text-xs text-slate-400">
                    <div class="flex items-center gap-2">
                      <span class="block font-medium text-slate-300">{article.data.author}</span>
                      <span aria-hidden="true">•</span>
                      <time datetime={isoDate}>{formattedDate}</time>
                    </div>

                    <a
                      href={`/articles/${slug}/`}
                      class="inline-flex items-center gap-1 font-semibold text-sky-400 transition-all group-hover:gap-2 group-hover:text-sky-300"
                      aria-label={`Read article: ${article.data.title}`}
                    >
                      Read <span aria-hidden="true">→</span>
                    </a>
                  </div>
                </article>
              );
            })}
          </div>
        ) : (
          <div class="mx-auto max-w-2xl rounded-2xl border border-white/10 bg-[#141C2E] p-8 sm:p-14 text-center">
            <!-- Cosmic Radar Icon -->
            <div class="relative mx-auto flex h-24 w-24 items-center justify-center rounded-full border border-sky-400/30 bg-sky-400/5 shadow-[0_0_40px_rgba(56,189,248,0.12)]">
              <svg
                class="h-12 w-12 text-sky-400"
                viewBox="0 0 64 64"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
                aria-hidden="true"
              >
                <!-- Concentric signal orbits -->
                <circle cx="32" cy="32" r="28" stroke="currentColor" stroke-width="1.5" stroke-opacity="0.25" stroke-dasharray="3 3" />
                <circle cx="32" cy="32" r="20" stroke="currentColor" stroke-width="1.5" stroke-opacity="0.45" />
                <circle cx="32" cy="32" r="12" stroke="currentColor" stroke-width="1.5" stroke-opacity="0.75" />
                <!-- Center celestial signal dot -->
                <circle cx="32" cy="32" r="4" fill="#38BDF8" />
                <!-- Beam pulse line -->
                <path d="M32 32L50 14" stroke="#A78BFA" stroke-width="2" stroke-linecap="round" />
                <circle cx="50" cy="14" r="2" fill="#A78BFA" />
              </svg>
            </div>

            <div class="mt-6 inline-flex items-center gap-2 rounded-full border border-sky-400/20 bg-sky-400/5 px-3 py-1">
              <span class="h-1.5 w-1.5 rounded-full bg-sky-400 animate-pulse"></span>
              <span class="text-xs font-semibold uppercase tracking-wider text-sky-300">
                Editorial In Progress
              </span>
            </div>

            <h3 class="mt-4 text-2xl font-bold tracking-tight text-white sm:text-3xl">
              Articles Arriving Soon
            </h3>

            <p class="mt-3 text-sm sm:text-base leading-relaxed text-slate-400">
              Our editorial desk is currently preparing deep-dive analyses, practical guides, and foundational articles for <strong class="text-white font-medium">{category.name}</strong>.
            </p>

            <p class="mt-2 text-xs sm:text-sm text-slate-400">
              In the meantime, explore our published insights in other categories or return to the homepage.
            </p>

            <!-- Quick Access to Active Categories -->
            <div class="mt-8 border-t border-white/5 pt-6">
              <p class="text-xs font-semibold uppercase tracking-wider text-slate-400 mb-4">
                Explore Available Categories:
              </p>
              <div class="flex flex-wrap justify-center gap-2.5">
                {categoriesWithArticles.map((activeCat) => (
                  <a
                    href={activeCat.href}
                    class="inline-flex items-center gap-2 rounded-lg border border-sky-400/30 bg-sky-400/10 px-3.5 py-2 text-xs font-semibold text-sky-300 transition-all hover:bg-sky-400/20 hover:border-sky-400"
                  >
                    <span>{activeCat.name}</span>
                    <span aria-hidden="true">→</span>
                  </a>
                ))}
              </div>
            </div>

            <div class="mt-8">
              <a
                href="/"
                class="inline-flex items-center gap-2 rounded-lg border border-white/10 bg-white/5 px-5 py-2.5 text-xs sm:text-sm font-semibold text-slate-300 transition-all hover:border-white/30 hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sky-400"
              >
                ← Return to Homepage
              </a>
            </div>
          </div>
        )}
      </section>

    </div>
  </main>

  <Footer />
</Layout>
