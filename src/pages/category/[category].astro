---
import Base from '../../layouts/Base.astro';
import ArticleCard from '../../components/ui/ArticleCard.astro';
import { CATEGORIES, type Category } from '../../data/categories';
import { getPublishedArticles, getArticlesByCategory, getArticleReadingTime, getArticleSlug, type Article } from '../../data/articles';

export async function getStaticPaths() {
  const paths = await Promise.all(
    CATEGORIES.map(async (category) => {
      const articles = await getArticlesByCategory(category.slug);
      return {
        params: { category: category.slug },
        props: { category, articles },
      };
    })
  );

  return paths;
}

interface Props {
  category: Category;
  articles: Article[];
}

const { category, articles } = Astro.props;

// Other categories that currently have published articles
const allPublished = await getPublishedArticles();
const fallbackArticles = allPublished
  .filter((a) => {
    const artCat = a.data.category.toLowerCase().trim();
    return artCat !== category.slug.toLowerCase().trim() && artCat !== category.name.toLowerCase().trim();
  })
  .slice(0, 3);

const categoriesWithArticles = CATEGORIES.filter((c) => {
  return allPublished.some((a) => {
    const artCat = a.data.category.toLowerCase().trim();
    return artCat === c.slug.toLowerCase().trim() || artCat === c.name.toLowerCase().trim();
  });
});

const siteUrl = Astro.site ? Astro.site.href.replace(/\/$/, '') : (process.env.SITE_URL || 'https://micro-signal-cosmos.pages.dev');
const categoryUrl = `${siteUrl}/category/${category.slug}/`;
---

<Base
  title={`${category.name} | CURION`}
  description={category.description}
  canonical={categoryUrl}
  ogImage={`/og/category-${category.slug}.svg`}
>
  <main id="main-content" class="bg-neutral-50 py-12 sm:py-16 lg:py-20 border-b border-neutral-200 dark:bg-[#05070E] dark:border-white/[0.08]">
    <div class="container-wide">

      <!-- Breadcrumbs Navigation -->
      <nav aria-label="Breadcrumb" class="mb-8">
        <ol class="flex flex-wrap items-center gap-2 text-xs sm:text-sm text-text-muted">
          <li>
            <a
              href="/"
              class="transition-colors hover:text-brand-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-primary rounded"
            >
              Home
            </a>
          </li>
          <li aria-hidden="true" class="text-neutral-400">/</li>
          <li>
            <a
              href="/#categories"
              class="transition-colors hover:text-brand-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-primary rounded"
            >
              Categories
            </a>
          </li>
          <li aria-hidden="true" class="text-neutral-400">/</li>
          <li class="font-semibold text-text-primary" aria-current="page">
            {category.name}
          </li>
        </ol>
      </nav>

      <!-- Category Hero Header -->
      <header class="mx-auto max-w-4xl text-center sm:text-left">
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
          <!-- Category Pillar Badge -->
          <div class="inline-flex items-center gap-2.5 self-center sm:self-start rounded-full border border-neutral-200 bg-white px-4 py-1.5 text-xs font-semibold tracking-wider uppercase shadow-xs dark:border-white/[0.08] dark:bg-[#0B101D]">
            <span class="h-2 w-2 rounded-full bg-brand-primary"></span>
            <span class="text-text-muted font-mono text-[11px]">Pillar {category.number}</span>
            <span class="text-neutral-300 dark:text-neutral-600">&bull;</span>
            <span class="font-bold text-text-primary">
              {category.shortName || category.name}
            </span>
          </div>

          <!-- Article Count Indicator -->
          <div class="self-center sm:self-auto text-xs font-semibold text-text-muted">
            <span class="rounded-full border border-neutral-200 bg-white px-3 py-1 text-brand-primary dark:border-white/[0.08] dark:bg-[#0B101D] dark:text-blue-400 font-mono text-[11px]">
              {articles.length} Published {articles.length === 1 ? 'Article' : 'Articles'}
            </span>
          </div>
        </div>

        <h1 class="mt-6 text-3xl font-extrabold tracking-tight text-text-primary sm:text-4xl lg:text-5xl">
          {category.name}
        </h1>

        <p class="mt-4 max-w-2xl text-base leading-relaxed text-text-secondary sm:text-lg">
          {category.description}
        </p>

        <p class="mt-2 text-sm sm:text-base leading-relaxed text-text-muted">
          From fundamental scientific research to practical digital tools and artificial intelligence breakthroughs, explore thoughtful analysis across our <strong>four</strong> core categories.
        </p>

        <!-- Category Quick Switcher -->
        <div class="mt-8 overflow-x-auto pb-2 -mx-4 px-4 sm:mx-0 sm:px-0">
          <div class="flex items-center gap-2 min-w-max">
            <span class="text-xs font-bold uppercase tracking-wider text-text-muted mr-2 font-mono text-[11px]">
              Browse Streams:
            </span>
            {CATEGORIES.map((cat) => {
              const isActive = cat.slug === category.slug;
              return (
                <a
                  href={cat.href}
                  class:list={[
                    'inline-flex items-center gap-1.5 rounded-full px-3.5 py-1.5 text-xs font-semibold transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-primary',
                    isActive
                      ? 'bg-brand-primary text-white shadow-xs dark:bg-blue-600 dark:border-blue-500'
                      : 'border border-neutral-200 bg-white text-text-secondary hover:border-brand-primary hover:text-brand-primary dark:border-white/[0.08] dark:bg-[#0B101D] dark:text-slate-300 dark:hover:border-blue-500/60 dark:hover:text-blue-400',
                  ]}
                >
                  <span
                    class:list={[
                      'h-1.5 w-1.5 rounded-full',
                      isActive ? 'bg-white' : 'bg-brand-primary dark:bg-blue-400',
                    ]}
                    aria-hidden="true"
                  ></span>
                  {cat.shortName || cat.name}
                </a>
              );
            })}
          </div>
        </div>
      </header>

      <!-- Articles Content Section -->
      <section class="mt-12" aria-labelledby="articles-list-heading">
        <h2 id="articles-list-heading" class="sr-only">
          Articles in {category.name}
        </h2>

        {articles.length > 0 && (
          <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
            {articles.map((article) => (
              <ArticleCard
                title={article.data.title}
                slug={getArticleSlug(article)}
                category={category.name}
                categorySlug={category.slug}
                readingTime={getArticleReadingTime(article)}
                excerpt={article.data.description}
                author={article.data.author}
                publishedDate={article.data.publishDate}
                logo={article.data.logo}
              />
            ))}
          </div>
        )}

        <!-- Fallback section when category has fewer than 2 published articles -->
        {articles.length < 2 && (
          <div class={`mx-auto max-w-4xl rounded-2xl border border-neutral-200 bg-white p-8 sm:p-12 text-center shadow-xs dark:border-white/[0.08] dark:bg-[#0B101D] ${articles.length > 0 ? 'mt-14' : ''}`}>
            
            <div class="inline-flex items-center gap-2 rounded-full border border-neutral-200 bg-neutral-50 px-3.5 py-1 text-xs font-bold uppercase tracking-wider text-brand-primary dark:border-white/[0.08] dark:bg-[#05070E] dark:text-blue-400">
              <span class="h-1.5 w-1.5 rounded-full bg-brand-primary"></span>
              <span>More Articles Coming Soon</span>
            </div>

            <h3 class="mt-4 text-xl sm:text-2xl font-bold tracking-tight text-text-primary">
              New guides arriving soon. Explore our latest featured articles below.
            </h3>

            <p class="mt-3 text-sm sm:text-base leading-relaxed text-text-secondary max-w-xl mx-auto">
              {articles.length === 0
                ? `We are actively working on upcoming guides for ${category.name}. In the meantime, explore our latest published articles across the platform:`
                : `We are preparing additional guides for ${category.name}. In the meantime, explore these recommended articles:`}
            </p>

            <!-- Quick Cards Linking to Published Articles -->
            {fallbackArticles.length > 0 && (
              <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3 text-left">
                {fallbackArticles.map((fallbackArt) => {
                  const fbSlug = getArticleSlug(fallbackArt);
                  return (
                    <a
                      href={`/articles/${fbSlug}/`}
                      class="group block rounded-xl border border-neutral-200 bg-neutral-50 p-5 transition-all duration-200 hover:border-brand-primary hover:bg-white hover:shadow-xs dark:border-white/[0.08] dark:bg-[#070B14] dark:hover:bg-[#0B101D] dark:hover:border-blue-500/60"
                    >
                      <span class="text-[10px] font-bold uppercase tracking-wider text-brand-primary dark:text-blue-400 font-mono">
                        {fallbackArt.data.category}
                      </span>
                      <h4 class="mt-1 text-sm font-semibold text-text-primary group-hover:text-brand-primary dark:group-hover:text-blue-400 line-clamp-2">
                        {fallbackArt.data.title}
                      </h4>
                      <div class="mt-3 flex items-center justify-between text-xs text-text-muted">
                        <span class="font-mono text-[11px]">{getArticleReadingTime(fallbackArt)}</span>
                        <span class="text-brand-primary font-semibold dark:text-blue-400">Read &rarr;</span>
                      </div>
                    </a>
                  );
                })}
              </div>
            )}

            <div class="mt-8">
              <a
                href="/"
                class="btn-secondary"
              >
                &larr; Return to Homepage
              </a>
            </div>
          </div>
        )}
      </section>

    </div>
  </main>
</Base>
