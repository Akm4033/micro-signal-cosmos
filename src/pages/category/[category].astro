---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { CATEGORIES, type Category } from '../../data/categories';
import { getPublishedArticles, getArticlesByCategory, getArticleReadingTime, type Article } from '../../data/articles';

export async function getStaticPaths() {
  const paths = await Promise.all(
    CATEGORIES.map(async (category) => {
      const articles = await getArticlesByCategory(category.slug);
      return {
        params: { category: category.slug },
        props: { category, articles },
      };
    })
  );

  return paths;
}

interface Props {
  category: Category;
  articles: Article[];
}

const { category, articles } = Astro.props;

// Other categories that currently have published articles (for recommendation in fallback state)
const allPublished = await getPublishedArticles();
const fallbackArticles = allPublished
  .filter((a) => {
    const artCat = a.data.category.toLowerCase().trim();
    return artCat !== category.slug.toLowerCase().trim() && artCat !== category.name.toLowerCase().trim();
  })
  .slice(0, 3);

const categoriesWithArticles = CATEGORIES.filter((c) => {
  return allPublished.some((a) => {
    const artCat = a.data.category.toLowerCase().trim();
    return artCat === c.slug.toLowerCase().trim() || artCat === c.name.toLowerCase().trim();
  });
});

// JSON-LD Structured Data (CollectionPage + BreadcrumbList)
const siteUrl = Astro.site?.href.replace(/\/$/, '') || 'https://microsignalcosmos.com';
const categoryUrl = `${siteUrl}/category/${category.slug}/`;

const categoryJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      '@id': `${categoryUrl}#collection`,
      name: `${category.name} | Micro Signal Cosmos`,
      description: category.description,
      url: categoryUrl,
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${categoryUrl}#breadcrumb`,
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Home',
          item: `${siteUrl}/`,
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Articles',
          item: `${siteUrl}/articles/`,
        },
        {
          '@type': 'ListItem',
          position: 3,
          name: category.name,
          item: categoryUrl,
        },
      ],
    },
  ],
};
---

<Layout
  title={`${category.name} | Micro Signal Cosmos`}
  description={category.description}
  type="website"
  jsonLd={categoryJsonLd}
>
  <Header />

  <main id="main-content" class="bg-[#F7F9FC] py-12 sm:py-16 lg:py-20">
    <div class="container-main">

      <!-- Breadcrumbs Navigation -->
      <nav aria-label="Breadcrumb" class="mb-8">
        <ol class="flex flex-wrap items-center gap-2 text-xs sm:text-sm text-[#697586]">
          <li>
            <a
              href="/"
              class="transition-colors hover:text-[#3478F6] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#3478F6] rounded"
            >
              Home
            </a>
          </li>
          <li aria-hidden="true" class="text-slate-400">/</li>
          <li>
            <a
              href="/#categories"
              class="transition-colors hover:text-[#3478F6] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#3478F6] rounded"
            >
              Categories
            </a>
          </li>
          <li aria-hidden="true" class="text-slate-400">/</li>
          <li class="font-semibold text-[#14233B]" aria-current="page">
            {category.name}
          </li>
        </ol>
      </nav>

      <!-- Category Hero Header -->
      <header class="mx-auto max-w-4xl text-center sm:text-left">
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
          <!-- Category Pillar Badge -->
          <div class="inline-flex items-center gap-2.5 self-center sm:self-start rounded-full border border-[#E3E8EF] bg-white px-4 py-1.5 text-xs font-semibold tracking-wider uppercase shadow-xs">
            <span class="h-2 w-2 rounded-full bg-[#3478F6]"></span>
            <span class="text-[#697586]">Pillar {category.number}</span>
            <span class="text-slate-300">&bull;</span>
            <span class="font-bold text-[#14233B]">
              {category.shortName || category.name}
            </span>
          </div>

          <!-- Article Count Indicator -->
          <div class="self-center sm:self-auto text-xs font-semibold text-[#697586]">
            {articles.length === 1 && (
              <span class="rounded-full border border-[#E3E8EF] bg-white px-3 py-1 text-[#3478F6]">
                1 Published Investigation
              </span>
            )}
            {articles.length > 1 && (
              <span class="rounded-full border border-[#E3E8EF] bg-white px-3 py-1 text-[#3478F6]">
                {articles.length} Published Articles
              </span>
            )}
            {articles.length === 0 && (
              <span class="rounded-full border border-[#E3E8EF] bg-white px-3 py-1 text-[#697586]">
                More Articles Coming Soon
              </span>
            )}
          </div>
        </div>

        <h1 class="mt-6 text-3xl font-extrabold tracking-tight text-[#14233B] sm:text-4xl lg:text-5xl">
          {category.name}
        </h1>

        <p class="mt-4 max-w-2xl text-base leading-relaxed text-[#202938] sm:text-lg">
          {category.description}
        </p>

        <!-- Category Quick Switcher -->
        <div class="mt-8 overflow-x-auto pb-2 -mx-4 px-4 sm:mx-0 sm:px-0">
          <div class="flex items-center gap-2 min-w-max">
            <span class="text-xs font-bold uppercase tracking-wider text-[#697586] mr-2">
              Browse Streams:
            </span>
            {CATEGORIES.map((cat) => {
              const isActive = cat.slug === category.slug;
              return (
                <a
                  href={cat.href}
                  class:list={[
                    'inline-flex items-center gap-1.5 rounded-full px-3.5 py-1.5 text-xs font-semibold transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#3478F6]',
                    isActive
                      ? 'bg-[#3478F6] text-white shadow-xs'
                      : 'border border-[#E3E8EF] bg-white text-[#202938] hover:border-[#3478F6] hover:text-[#3478F6]',
                  ]}
                >
                  <span
                    class:list={[
                      'h-1.5 w-1.5 rounded-full',
                      isActive ? 'bg-white' : 'bg-[#3478F6]',
                    ]}
                    aria-hidden="true"
                  ></span>
                  {cat.shortName || cat.name}
                </a>
              );
            })}
          </div>
        </div>
      </header>

      <!-- Articles Content Section -->
      <section class="mt-12" aria-labelledby="articles-list-heading">
        <h2 id="articles-list-heading" class="sr-only">
          Articles in {category.name}
        </h2>

        {articles.length > 0 && (
          <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
            {articles.map((article) => {
              const slug = article.data.slug || article.id;
              const formattedDate = article.data.publishDate.toLocaleDateString('en-US', {
                year: 'numeric',
                month: 'short',
                day: 'numeric',
              });
              const isoDate = article.data.publishDate.toISOString();

              return (
                <article class="group flex flex-col justify-between overflow-hidden rounded-2xl border border-[#E3E8EF] bg-white p-6 sm:p-7 shadow-xs transition-all duration-300 hover:-translate-y-1 hover:shadow-md hover:border-[#CBD5E1]">
                  <div>
                    <div class="flex items-center justify-between gap-2 text-xs mb-3">
                      <span class="font-bold uppercase tracking-wider text-[#3478F6]">
                        {category.shortName || category.name}
                      </span>
                      <span class="text-[#697586]">{getArticleReadingTime(article)}</span>
                    </div>

                    <h3 class="text-xl font-bold leading-snug text-[#14233B] transition-colors group-hover:text-[#3478F6]">
                      <a
                        href={`/articles/${slug}/`}
                        class="focus-visible:outline-none focus-visible:underline"
                      >
                        {article.data.title}
                      </a>
                    </h3>

                    <p class="mt-3 text-sm leading-relaxed text-[#202938] line-clamp-3">
                      {article.data.description}
                    </p>
                  </div>

                  <div class="mt-8 flex items-center justify-between border-t border-[#E3E8EF] pt-4 text-xs text-[#697586]">
                    <div class="flex items-center gap-2">
                      <span class="font-medium text-[#14233B]">{article.data.author}</span>
                      <span aria-hidden="true">&bull;</span>
                      <time datetime={isoDate}>{formattedDate}</time>
                    </div>

                    <a
                      href={`/articles/${slug}/`}
                      class="inline-flex items-center gap-1 font-semibold text-[#3478F6] transition-all group-hover:gap-2 group-hover:text-[#2563EB]"
                      aria-label={`Read article: ${article.data.title}`}
                    >
                      <span>Read</span>
                      <span aria-hidden="true">&rarr;</span>
                    </a>
                  </div>
                </article>
              );
            })}
          </div>
        )}

        <!-- Fallback section when category has fewer than 2 published articles -->
        {articles.length < 2 && (
          <div class={`mx-auto max-w-4xl rounded-2xl border border-[#E3E8EF] bg-white p-8 sm:p-12 text-center shadow-xs ${articles.length > 0 ? 'mt-14' : ''}`}>
            
            <div class="inline-flex items-center gap-2 rounded-full border border-[#E3E8EF] bg-[#F7F9FC] px-3.5 py-1 text-xs font-bold uppercase tracking-wider text-[#3478F6]">
              <span class="h-1.5 w-1.5 rounded-full bg-[#3478F6]"></span>
              <span>More Articles Coming Soon</span>
            </div>

            <h3 class="mt-4 text-xl sm:text-2xl font-bold tracking-tight text-[#14233B]">
              New guides arriving soon. Explore our latest featured articles below.
            </h3>

            <p class="mt-3 text-sm sm:text-base leading-relaxed text-[#202938] max-w-xl mx-auto">
              {articles.length === 0
                ? `We are actively working on upcoming guides for ${category.name}. In the meantime, explore our latest published articles across the platform:`
                : `We are preparing additional guides for ${category.name}. In the meantime, explore these recommended articles:`}
            </p>

            <!-- Quick Cards Linking to Published Articles -->
            {fallbackArticles.length > 0 && (
              <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3 text-left">
                {fallbackArticles.map((fallbackArt) => {
                  const fbSlug = fallbackArt.data.slug || fallbackArt.id;
                  return (
                    <a
                      href={`/articles/${fbSlug}/`}
                      class="group block rounded-xl border border-[#E3E8EF] bg-[#F7F9FC] p-5 transition-all duration-200 hover:border-[#3478F6] hover:bg-white hover:shadow-xs"
                    >
                      <span class="text-[10px] font-bold uppercase tracking-wider text-[#3478F6]">
                        {fallbackArt.data.category}
                      </span>
                      <h4 class="mt-1 text-sm font-semibold text-[#14233B] group-hover:text-[#3478F6] line-clamp-2">
                        {fallbackArt.data.title}
                      </h4>
                      <div class="mt-3 flex items-center justify-between text-xs text-[#697586]">
                        <span>{getArticleReadingTime(fallbackArt)}</span>
                        <span class="text-[#3478F6] font-semibold">Read &rarr;</span>
                      </div>
                    </a>
                  );
                })}
              </div>
            )}

            <!-- Quick Access to Active Categories -->
            <div class="mt-8 border-t border-[#E3E8EF] pt-6">
              <p class="text-xs font-bold uppercase tracking-wider text-[#697586] mb-3">
                Other Active Topic Streams:
              </p>
              <div class="flex flex-wrap justify-center gap-2">
                {categoriesWithArticles.map((activeCat) => (
                  <a
                    href={activeCat.href}
                    class="inline-flex items-center gap-1.5 rounded-lg border border-[#E3E8EF] bg-[#F7F9FC] px-3.5 py-1.5 text-xs font-semibold text-[#202938] hover:border-[#3478F6] hover:text-[#3478F6]"
                  >
                    <span>{activeCat.name}</span>
                    <span aria-hidden="true">&rarr;</span>
                  </a>
                ))}
              </div>
            </div>

            <div class="mt-8">
              <a
                href="/"
                class="btn-secondary"
              >
                &larr; Return to Homepage
              </a>
            </div>
          </div>
        )}
      </section>

    </div>
  </main>

  <Footer />
</Layout>
