---
import Base from '../layouts/Base.astro';

const siteUrl = 'https://microsignalcosmos.com';
const pageUrl = `${siteUrl}/privacy-policy/`;
---

<Base
  title="Privacy Policy | Micro Signal Cosmos"
  description="Privacy Policy for Micro Signal Cosmos. Read our transparent policies on data handling, cookies, analytics, and reader privacy protection."
  canonical={pageUrl}
>
  <main id="main-content" class="bg-neutral-50 py-12 sm:py-20 border-b border-neutral-200 dark:bg-neutral-900/50 dark:border-neutral-800">
    <div class="container-narrow">

      <!-- Breadcrumbs -->
      <nav aria-label="Breadcrumb" class="mb-8">
        <ol class="flex items-center gap-2 text-xs text-text-muted">
          <li>
            <a href="/" class="transition-colors hover:text-brand-primary">Home</a>
          </li>
          <li aria-hidden="true" class="text-neutral-400">/</li>
          <li class="font-semibold text-text-primary" aria-current="page">Privacy Policy</li>
        </ol>
      </nav>

      <header class="mb-12">
        <h1 class="text-display font-extrabold tracking-tight text-text-primary">Privacy Policy</h1>
        <p class="mt-4 text-lead text-text-secondary">Effective Date: November 2026</p>
      </header>

      <div class="prose-editorial max-w-none space-y-8">
        <section>
          <h2 class="text-h2 font-bold text-text-primary mb-4">1. Overview &amp; Philosophy</h2>
          <p class="text-text-secondary">
            Micro Signal Cosmos ("we", "our", or "us") operates as an independent technical publication. We believe privacy is fundamental to open web publishing. We collect minimal telemetry necessary to operate and improve our content.
          </p>
        </section>

        <section>
          <h2 class="text-h2 font-bold text-text-primary mb-4">2. Analytics &amp; Telemetry</h2>
          <p class="text-text-secondary">
            We prioritize privacy-first analytics tools (such as Plausible Analytics). We do not use cross-site tracking cookies, store personal identifying information, or profile individual readers across other websites.
          </p>
        </section>

        <section>
          <h2 class="text-h2 font-bold text-text-primary mb-4">3. Newsletter Subscriptions</h2>
          <p class="text-text-secondary">
            When you subscribe to The Weekly Signal via Buttondown, your email address is used exclusively to deliver the technical publication. We do not embed hidden tracking pixels, sell subscriber lists, or share emails with third-party marketers. You can unsubscribe at any time with a single click.
          </p>
        </section>

        <section>
          <h2 class="text-h2 font-bold text-text-primary mb-4">4. Affiliate Links &amp; External Sites</h2>
          <p class="text-text-secondary">
            Our articles and Tools directory contain outbound partner links (marked with ★). If you click through to an external provider (such as Hetzner, Qdrant, or Cloudflare), that provider processes your visit according to their own privacy policy.
          </p>
        </section>

        <section>
          <h2 class="text-h2 font-bold text-text-primary mb-4">5. Contact Information</h2>
          <p class="text-text-secondary">
            If you have questions regarding this privacy policy or your data rights, contact us at <a href="mailto:admin@microsignalcosmos.com" class="text-brand-primary underline">admin@microsignalcosmos.com</a> or via our <a href="/contact/" class="text-brand-primary underline">Contact Form</a>.
          </p>
        </section>
      </div>

    </div>
  </main>
</Base>
