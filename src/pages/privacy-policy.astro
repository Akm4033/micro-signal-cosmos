---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const siteUrl = 'https://microsignalcosmos.com';
const pageUrl = `${siteUrl}/privacy-policy/`;

const pageJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      '@id': `${pageUrl}#webpage`,
      name: 'Privacy Policy | Micro Signal Cosmos',
      description: 'Privacy Policy for Micro Signal Cosmos. Read our transparent policies on data handling, cookies, analytics, and reader privacy protection.',
      url: pageUrl,
      isPartOf: {
        '@id': `${siteUrl}/#website`,
      },
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${pageUrl}#breadcrumb`,
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Home',
          item: `${siteUrl}/`,
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Privacy Policy',
          item: pageUrl,
        },
      ],
    },
  ],
};
---

<Layout
  title="Privacy Policy | Micro Signal Cosmos"
  description="Privacy Policy for Micro Signal Cosmos. Read our transparent policies on data handling, cookies, analytics, and reader privacy protection."
  canonical={pageUrl}
  jsonLd={pageJsonLd}
>
  <Header />

  <main id="main-content" class="bg-[#F7F9FC] py-12 sm:py-20">
    <div class="container-main">

      <!-- Breadcrumbs -->
      <nav aria-label="Breadcrumb" class="mb-8">
        <ol class="flex items-center gap-2 text-xs text-[#697586]">
          <li>
            <a href="/" class="transition-colors hover:text-[#14233B]">Home</a>
          </li>
          <li aria-hidden="true" class="text-slate-300">/</li>
          <li aria-current="page" class="font-medium text-[#14233B]">Privacy Policy</li>
        </ol>
      </nav>

      <!-- Header Section -->
      <div class="mx-auto max-w-3xl text-center">
        <div class="inline-flex items-center gap-2 rounded-full border border-[#E3E8EF] bg-white px-3.5 py-1.5 shadow-xs">
          <span class="h-2 w-2 rounded-full bg-[#3478F6]"></span>
          <span class="text-xs font-semibold tracking-wider text-[#14233B] uppercase">
            Data Transparency
          </span>
        </div>

        <h1 class="mt-6 text-3xl font-extrabold tracking-tight text-[#14233B] sm:text-5xl">
          Privacy <span class="text-[#3478F6]">Policy</span>
        </h1>

        <p class="mt-4 text-xs font-medium uppercase tracking-widest text-[#697586]">
          Effective Date: November 2026 &bull; Last Revised: November 2026
        </p>

        <p class="mt-4 text-base leading-relaxed text-[#4B5565] sm:text-lg">
          We operate on a strict principle of data minimization and reader privacy protection.
        </p>
      </div>

      <!-- Main Policy Document -->
      <article class="mx-auto mt-12 max-w-3xl rounded-2xl border border-[#E3E8EF] bg-white p-8 sm:p-12 shadow-sm text-sm leading-relaxed text-[#4B5565] space-y-10">

        <!-- 1. Introduction -->
        <section aria-labelledby="privacy-intro">
          <h2 id="privacy-intro" class="text-xl font-bold tracking-tight text-[#14233B]">
            1. Introduction & Core Principle
          </h2>
          <p class="mt-3">
            Welcome to <strong class="font-semibold text-[#14233B]">Micro Signal Cosmos</strong> ("we," "our," or "the Publication"). We believe that deep, thoughtful reading requires an uncluttered, private digital environment. We are committed to safeguarding the privacy rights of all readers, subscribers, and correspondents.
          </p>
          <p class="mt-3">
            This Privacy Policy details the types of technical data we process, how that information is utilized, and your fundamental rights under global privacy frameworks including the General Data Protection Regulation (GDPR) and the California Consumer Privacy Act (CCPA/CPRA).
          </p>
        </section>

        <!-- 2. Information We Collect -->
        <section aria-labelledby="data-collection" class="border-t border-[#E3E8EF] pt-8">
          <h2 id="data-collection" class="text-xl font-bold tracking-tight text-[#14233B]">
            2. Technical Data & Reader Communications
          </h2>
          <p class="mt-3">
            We collect only the bare minimum information necessary to deliver a secure, performant static web experience:
          </p>
          <ul class="mt-4 list-disc space-y-2 pl-6">
            <li>
              <strong class="font-semibold text-[#14233B]">Server & Edge Network Logs:</strong> Standard request headers, IP address, user-agent string, and timestamp logged temporarily by Cloudflare edge networks solely for distributed denial-of-service (DDoS) mitigation and technical performance monitoring.
            </li>
            <li>
              <strong class="font-semibold text-[#14233B]">Voluntary Reader Inquiries:</strong> When you send an inquiry via our contact desk, we receive the name, email address, topic, and message text you choose to transmit to respond to your inquiry.
            </li>
            <li>
              <strong class="font-semibold text-[#14233B]">Zero Automated Profiling:</strong> We do not build personal reader dossiers, cross-device behavioral profiles, or biometric databases.
            </li>
          </ul>
        </section>

        <!-- 3. Cookies & Local Storage -->
        <section aria-labelledby="cookies-storage" class="border-t border-[#E3E8EF] pt-8">
          <h2 id="cookies-storage" class="text-xl font-bold tracking-tight text-[#14233B]">
            3. Cookies, Telemetry & Local Storage
          </h2>
          <p class="mt-3">
            Micro Signal Cosmos does not employ third-party surveillance tracking cookies, browser fingerprinting scripts, or persistent cross-site advertising beacons.
          </p>
          <p class="mt-3">
            Lightweight client-side features (such as caching read status or maintaining interactive filter preferences) may utilize standard browser <code class="rounded bg-[#F7F9FC] px-1 py-0.5 font-mono text-xs border border-[#E3E8EF]">localStorage</code> strictly confined to your device. You can clear local storage or disable cookies in your browser settings at any time without compromising article readability.
          </p>
        </section>

        <!-- 4. Monetization & Zero-CLS Ad Containers -->
        <section aria-labelledby="monetization-disclosure" class="border-t border-[#E3E8EF] pt-8">
          <h2 id="monetization-disclosure" class="text-xl font-bold tracking-tight text-[#14233B]">
            4. Advertising & Monetization Disclosures
          </h2>
          <p class="mt-3">
            To sustain our independent publishing operations, Micro Signal Cosmos may reserve discrete, pre-sized display advertising spaces. In accordance with our technical guidelines:
          </p>
          <ul class="mt-4 list-disc space-y-2 pl-6">
            <li>All advertising containers utilize fixed aspect ratios and pre-allocated minimum heights (<code class="rounded bg-[#F7F9FC] px-1 py-0.5 font-mono text-xs border border-[#E3E8EF]">min-height: 250px</code>) to guarantee zero Cumulative Layout Shift (CLS = 0.00).</li>
            <li>We do not permit popups, autoplay video overlays, sticky floor banners, or interstitials that obscure reading typography.</li>
            <li>Sponsored dispatches or affiliate references will always carry unambiguous disclosure badges at the top of the content.</li>
          </ul>
        </section>

        <!-- 5. Third-Party Links -->
        <section aria-labelledby="third-party" class="border-t border-[#E3E8EF] pt-8">
          <h2 id="third-party" class="text-xl font-bold tracking-tight text-[#14233B]">
            5. External Links & Academic Repositories
          </h2>
          <p class="mt-3">
            Our articles regularly link to external scientific journals, open-source repositories (e.g. GitHub), and social networks (Facebook, YouTube). When you click an external link, you navigate to an independent domain whose data practices are governed by their respective privacy terms.
          </p>
        </section>

        <!-- 6. Your Legal Data Rights -->
        <section aria-labelledby="reader-rights" class="border-t border-[#E3E8EF] pt-8">
          <h2 id="reader-rights" class="text-xl font-bold tracking-tight text-[#14233B]">
            6. Reader Rights (GDPR, UK-GDPR & CCPA/CPRA)
          </h2>
          <p class="mt-3">
            Under international privacy frameworks, you have fundamental rights regarding your personal information:
          </p>
          <ul class="mt-4 list-disc space-y-2 pl-6">
            <li><strong class="font-semibold text-[#14233B]">Right of Access:</strong> Request a confirmation of whether we hold personal communications submitted by you.</li>
            <li><strong class="font-semibold text-[#14233B]">Right to Rectification:</strong> Request correction of inaccurate information.</li>
            <li><strong class="font-semibold text-[#14233B]">Right to Erasure:</strong> Request deletion of your prior email correspondence from our communications archive.</li>
            <li><strong class="font-semibold text-[#14233B]">Non-Discrimination:</strong> We never deny access, charge differentiated rates, or degrade editorial quality for exercising statutory privacy rights.</li>
          </ul>
        </section>

        <!-- 7. Data Controller & Inquiries -->
        <section aria-labelledby="contact-desk" class="border-t border-[#E3E8EF] pt-8">
          <h2 id="contact-desk" class="text-xl font-bold tracking-tight text-[#14233B]">
            7. Privacy Desk & Contact Details
          </h2>
          <p class="mt-3">
            For all questions regarding this Privacy Policy or to submit a privacy rights request, please connect with our editorial administration:
          </p>
          <div class="mt-4 rounded-xl border border-[#E3E8EF] bg-[#F7F9FC] p-5 text-xs text-[#4B5565] space-y-1.5">
            <p><strong class="font-semibold text-[#14233B]">Publication:</strong> Micro Signal Cosmos</p>
            <p><strong class="font-semibold text-[#14233B]">Official Website:</strong> https://microsignalcosmos.com</p>
            <p><strong class="font-semibold text-[#14233B]">Inquiries:</strong> Accessible via our verified <a href="/contact/" class="font-semibold text-[#3478F6] hover:underline">Contact Desk</a></p>
          </div>
        </section>

      </article>

    </div>
  </main>

  <Footer />
</Layout>
