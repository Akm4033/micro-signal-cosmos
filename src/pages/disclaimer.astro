---
import Base from '../layouts/Base.astro';

const siteUrl = Astro.site ? Astro.site.href.replace(/\/$/, '') : (process.env.SITE_URL || 'https://signal-insight.pages.dev');
const pageUrl = `${siteUrl}/disclaimer/`;
---

<Base
  title="Disclaimer & Notices | Signal Insight"
  description="Disclaimer and monetization notices for Signal Insight."
  canonical={pageUrl}
>
  <main id="main-content" class="bg-neutral-50 py-12 sm:py-20 border-b border-neutral-200 dark:bg-[#05070E] dark:border-white/[0.08]">
    <div class="container-narrow">

      <!-- Breadcrumbs -->
      <nav aria-label="Breadcrumb" class="mb-8">
        <ol class="flex items-center gap-2 text-xs text-text-muted">
          <li>
            <a href="/" class="transition-colors hover:text-brand-primary">Home</a>
          </li>
          <li aria-hidden="true" class="text-neutral-400">/</li>
          <li class="font-semibold text-text-primary" aria-current="page">Disclaimer</li>
        </ol>
      </nav>

      <header class="mb-12">
        <h1 class="text-display font-extrabold tracking-tight text-text-primary">Disclaimer &amp; Affiliate Policy</h1>
        <p class="mt-4 text-lead text-text-secondary">Transparency, partner compensation, and technical testing standards.</p>
      </header>

      <div class="prose-editorial max-w-none space-y-8">
        <section>
          <h2 class="text-h2 font-bold text-text-primary mb-4">1. Affiliate Disclosure</h2>
          <p class="text-text-secondary">
            Signal Insight participates in select affiliate programs. Articles, guides, and the <a href="/tools/" class="text-brand-primary underline">Tools Directory</a> contain partner links marked with a star symbol (<strong>★</strong>).
          </p>
          <p class="text-text-secondary mt-3">
            If you click an affiliate link and make a purchase or create an account, we may receive a commission or referral credit at zero additional cost to you.
          </p>
        </section>

        <section>
          <h2 class="text-h2 font-bold text-text-primary mb-4">2. Editorial Independence</h2>
          <p class="text-text-secondary">
            We never accept payment to write positive reviews or fabricate benchmarks. Every tool recommended has been used in production environments, tested against open workloads, or vetted through hands-on technical evaluation.
          </p>
        </section>

        <section>
          <h2 class="text-h2 font-bold text-text-primary mb-4">3. Engineering &amp; Operational Disclaimer</h2>
          <p class="text-text-secondary">
            The technical guides, code snippets, network configurations, and database benchmarks published here are for educational, informational, and reference purposes. Deployments should always be tested within staging or local sandboxes before production implementation.
          </p>
        </section>
      </div>

    </div>
  </main>
</Base>
