---
import '../styles/global.css';
import { monetizationConfig, isAdsEnabled } from '../config/monetization';
import CookieConsent from '../components/consent/CookieConsent.astro';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  canonicalURL?: string;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  jsonLd?: Record<string, any> | Array<Record<string, any>>;
}

const {
  title = 'Micro Signal Cosmos | Discover More. Understand Better.',
  description = 'Explore technology, science, artificial intelligence, digital discoveries and practical guides.',
  canonical: canonicalProp,
  canonicalURL,
  image,
  type = 'website',
  noindex = false,
  jsonLd,
} = Astro.props;

// Canonical URL configuration: Target upcoming production custom domain
const productionBase = 'https://microsignalcosmos.com';
const siteUrl = Astro.site ? Astro.site.href.replace(/\/$/, '') : productionBase;
const canonical = canonicalProp || canonicalURL || new URL(Astro.url.pathname, productionBase).href;

// Resolve social sharing image (default to high-resolution brand vector if none provided):
let resolvedImage: string = `${productionBase}/favicon.svg`;
if (image) {
  if (image.startsWith('http://') || image.startsWith('https://')) {
    resolvedImage = image;
  } else {
    resolvedImage = new URL(image, productionBase).href;
  }
}

// Twitter Card Format: summary_large_image for elite editorial presentation
const twitterCard = 'summary_large_image';

// Base Schema.org Structured Data
const defaultJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${productionBase}/#organization`,
      name: 'Micro Signal Cosmos',
      url: productionBase,
      logo: {
        '@type': 'ImageObject',
        url: `${productionBase}/favicon.svg`,
        width: 512,
        height: 512,
      },
      description: 'Discover More. Understand Better. Exploring technology, science, artificial intelligence, and digital innovations.',
      sameAs: [
        'https://www.facebook.com/profile.php?id=61596288235891',
        'https://www.youtube.com/@MicroSignalCosmos',
      ],
    },
    {
      '@type': 'WebSite',
      '@id': `${productionBase}/#website`,
      name: 'Micro Signal Cosmos',
      url: productionBase,
      description: description,
      publisher: {
        '@id': `${productionBase}/#organization`,
      },
      potentialAction: {
        '@type': 'SearchAction',
        target: {
          '@type': 'EntryPoint',
          urlTemplate: `${productionBase}/articles/?q={search_term_string}`,
        },
        'query-input': 'required name=search_term_string',
      },
    },
  ],
};

const finalJsonLd = noindex ? null : (jsonLd || defaultJsonLd);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#FFFFFF" />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <!-- Indexing & Crawler Directives -->
    <meta
      name="robots"
      content={noindex ? "noindex, follow" : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"}
    />

    <!-- Canonical URL -->
    {!noindex && canonical && <link rel="canonical" href={canonical} />}

    <!-- Open Graph / Facebook -->
    <meta property="og:site_name" content="Micro Signal Cosmos" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!noindex && canonical && <meta property="og:url" content={canonical} />}
    {resolvedImage && <meta property="og:image" content={resolvedImage} />}
    {resolvedImage && <meta property="og:image:alt" content={title} />}
    {resolvedImage && <meta property="og:image:width" content="1200" />}
    {resolvedImage && <meta property="og:image:height" content="630" />}

    <!-- Twitter / X -->
    <meta name="twitter:card" content={twitterCard} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {resolvedImage && <meta name="twitter:image" content={resolvedImage} />}
    {resolvedImage && <meta name="twitter:image:alt" content={title} />}

    <!-- RSS & Sitemap Discovery -->
    <link rel="alternate" type="application/rss+xml" title="Micro Signal Cosmos" href="/rss.xml" />
    <link rel="sitemap" href="/sitemap.xml" />

    <!-- Search Engine Verification (Configurable via PUBLIC_GSC_VERIFICATION) -->
    {monetizationConfig.analytics.gscVerification && (
      <meta name="google-site-verification" content={monetizationConfig.analytics.gscVerification} />
    )}

    <!-- Google AdSense Script (Configurable via PUBLIC_ADS_ENABLED & PUBLIC_ADSENSE_CLIENT_ID) -->
    {isAdsEnabled() && monetizationConfig.ads.adsenseClientId && (
      <script
        async
        src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${monetizationConfig.ads.adsenseClientId}`}
        crossorigin="anonymous"
      ></script>
    )}

    <!-- Google Analytics 4 with Consent Mode v2 (Configurable via PUBLIC_GA_MEASUREMENT_ID) -->
    {monetizationConfig.analytics.gaMeasurementId && (
      <>
        <script is:inline>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('consent', 'default', {
            'analytics_storage': 'denied',
            'ad_storage': 'denied',
            'ad_user_data': 'denied',
            'ad_personalization': 'denied'
          });
        </script>
        <script
          async
          src={`https://www.googletagmanager.com/gtag/js?id=${monetizationConfig.analytics.gaMeasurementId}`}
        ></script>
        <script is:inline define:vars={{ gaId: monetizationConfig.analytics.gaMeasurementId }}>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', gaId, {
            anonymize_ip: true,
            send_page_view: true
          });
        </script>
      </>
    )}

    <!-- Structured Data (JSON-LD) -->
    {finalJsonLd && (
      <script
        type="application/ld+json"
        is:inline
        set:html={JSON.stringify(finalJsonLd)}
      />
    )}
  </head>

  <body>
    <!-- Reading Progress Bar -->
    <div id="reading-progress-bar" aria-hidden="true"></div>

    <!-- Accessible Skip to Content Link -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:rounded-lg focus:bg-[#3478F6] focus:px-4 focus:py-2 focus:text-sm focus:font-bold focus:text-white focus:shadow-lg focus:outline-none"
    >
      Skip to main content
    </a>

    <slot />

    <!-- Reading Progress Scroll Script (Passive, non-blocking) -->
    <script is:inline>
      (function() {
        const bar = document.getElementById('reading-progress-bar');
        if (!bar) return;
        window.addEventListener('scroll', function() {
          const winScroll = document.documentElement.scrollTop || document.body.scrollTop;
          const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
          if (height > 0) {
            const scrolled = (winScroll / height) * 100;
            bar.style.width = scrolled + '%';
          }
        }, { passive: true });
      })();
    </script>
    <!-- Privacy & Cookie Consent Banner -->
    <CookieConsent />
  </body>
</html>
