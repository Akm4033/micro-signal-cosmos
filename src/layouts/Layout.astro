---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  canonicalURL?: string;
  image?: string;
  type?: 'website' | 'article';
  jsonLd?: Record<string, any> | Array<Record<string, any>>;
}

const {
  title = 'Micro Signal Cosmos | Discover More. Understand Better.',
  description = 'Explore technology, science, artificial intelligence, digital discoveries and practical guides.',
  canonicalURL,
  image,
  type = 'website',
  jsonLd,
} = Astro.props;

// Determine canonical and production URL:
// Only emit canonical & og:url if an explicit canonicalURL prop is provided OR if Astro.site is configured in astro.config.mjs.
// This prevents emitting invalid "http://localhost:4321/" URLs in production builds before a real domain is purchased.
const canonical = canonicalURL || (Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined);

// Resolve social sharing image:
// Only emit an absolute image URL if an image prop is provided and either already absolute or resolvable against Astro.site.
let resolvedImage: string | undefined = undefined;
if (image) {
  if (image.startsWith('http://') || image.startsWith('https://')) {
    resolvedImage = image;
  } else if (Astro.site) {
    resolvedImage = new URL(image, Astro.site).href;
  }
}

// Select Twitter card format based on image availability
const twitterCard = resolvedImage ? 'summary_large_image' : 'summary';

// Base Schema.org Structured Data
const siteUrl = Astro.site?.href.replace(/\/$/, '') || '';
const defaultJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': siteUrl ? `${siteUrl}/#organization` : '#organization',
      name: 'Micro Signal Cosmos',
      url: siteUrl || '/',
      description: 'Discover More. Understand Better. Exploring technology, science, artificial intelligence, and digital innovations.',
      sameAs: [
        'https://www.facebook.com/profile.php?id=61596288235891',
        'https://www.youtube.com/@MicroSignalCosmos',
      ],
    },
    {
      '@type': 'WebSite',
      '@id': siteUrl ? `${siteUrl}/#website` : '#website',
      name: 'Micro Signal Cosmos',
      url: siteUrl || '/',
      description: description,
      publisher: {
        '@id': siteUrl ? `${siteUrl}/#organization` : '#organization',
      },
    },
  ],
};

const finalJsonLd = jsonLd || defaultJsonLd;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0B1020" />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <!-- Open Graph / Facebook -->
    <meta property="og:site_name" content="Micro Signal Cosmos" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {resolvedImage && <meta property="og:image" content={resolvedImage} />}

    <!-- Twitter / X -->
    <meta name="twitter:card" content={twitterCard} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {resolvedImage && <meta name="twitter:image" content={resolvedImage} />}

    <!-- Canonical URL -->
    {canonical && <link rel="canonical" href={canonical} />}

    <!-- RSS & Sitemap Discovery -->
    <link rel="alternate" type="application/rss+xml" title="Micro Signal Cosmos" href="/rss.xml" />
    <link rel="sitemap" href="/sitemap.xml" />

    <!-- Structured Data (JSON-LD) -->
    {finalJsonLd && (
      <script
        type="application/ld+json"
        is:inline
        set:html={JSON.stringify(finalJsonLd)}
      />
    )}
  </head>

  <body>
    <!-- Accessible Skip to Content Link -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:rounded-lg focus:bg-sky-400 focus:px-4 focus:py-2 focus:text-sm focus:font-bold focus:text-slate-950 focus:shadow-lg focus:outline-none"
    >
      Skip to main content
    </a>

    <slot />
  </body>
</html>
