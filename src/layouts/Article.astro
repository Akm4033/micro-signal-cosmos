---
import Base from './Base.astro';
import ArticleLogo from '../components/ui/ArticleLogo.astro';
import ArticleVisual from '../components/ui/ArticleVisual.astro';
import { getAuthor } from '../data/authors';

interface Props {
  title: string;
  seoTitle?: string;
  description: string;
  author: string;
  authorName?: string;
  authorRole?: string;
  authorAvatar?: string;
  category: string;
  categoryVariant?: 'tech' | 'science' | 'ai' | 'devtools';
  tags?: string[];
  readingTime?: string;
  publishedTime: string;
  updatedTime?: string;
  canonical?: string;
  ogImage?: string;
  logo?: string;
  slug?: string;
  references?: Array<{ title: string; source?: string; url?: string }>;
  relatedArticles?: Array<{ slug: string; title: string; category: string; categoryVariant?: string; readingTime: string; excerpt: string }>;
}

const {
  title,
  seoTitle,
  description,
  author,
  category,
  categoryVariant: catVariantProp,
  tags = [],
  readingTime = '8 min read',
  publishedTime,
  updatedTime,
  canonical,
  ogImage,
  logo,
  slug: propSlug,
  references = [],
  relatedArticles = []
} = Astro.props;

const slug = propSlug || Astro.params.slug || '';

const authorData = getAuthor(author);
const authorName = Astro.props.authorName || authorData.name;
const authorRole = Astro.props.authorRole || authorData.role;
const authorAvatar = Astro.props.authorAvatar || authorData.avatar;

const variantMap: Record<string, 'tech' | 'science' | 'ai' | 'devtools'> = {
  'technology': 'tech',
  'artificial-intelligence': 'ai',
  'science': 'science',
  'developer-tools': 'devtools',
  'tech': 'tech',
  'ai': 'ai',
  'devtools': 'devtools'
};

const categoryVariant = catVariantProp || variantMap[category.toLowerCase().replace(/\s+/g, '-')] || 'tech';
const siteUrl = Astro.site ? Astro.site.href.replace(/\/$/, '') : (process.env.SITE_URL || 'https://signal-insight.pages.dev');
const resolvedCanonical = canonical || `${siteUrl}/articles/${Astro.params.slug || ''}/`;

// Discipline Art Direction Mapping for Bespoke Category Layouts
const disciplineTheme = {
  ai: {
    gradient: 'from-cyan-500/10 via-blue-600/5 to-indigo-600/10',
    border: 'border-cyan-500/30 dark:border-cyan-500/20',
    accentText: 'text-cyan-600 dark:text-cyan-400',
    disciplineTag: 'NEURAL FOUNDATIONS & AI COMPUTATION',
    badgeClass: 'bg-cyan-50 text-cyan-800 border-cyan-200 dark:bg-cyan-950/60 dark:text-cyan-300 dark:border-cyan-800',
    dotColor: 'bg-cyan-500',
    synthesisTitle: 'Architecture Takeaways & Inference Impact',
    synthesisClass: 'callout-synthesis',
  },
  science: {
    gradient: 'from-purple-900/10 via-violet-600/5 to-amber-500/10',
    border: 'border-purple-500/30 dark:border-purple-500/20',
    accentText: 'text-purple-600 dark:text-purple-400',
    disciplineTag: 'ASTROPHYSICAL RESEARCH & FUNDAMENTAL PHYSICS',
    badgeClass: 'bg-purple-50 text-purple-800 border-purple-200 dark:bg-purple-950/60 dark:text-purple-300 dark:border-purple-800',
    dotColor: 'bg-purple-500',
    synthesisTitle: 'Empirical Evidence & Theoretical Significance',
    synthesisClass: 'callout-astrophysics',
  },
  tech: {
    gradient: 'from-emerald-500/10 via-teal-500/5 to-blue-600/10',
    border: 'border-emerald-500/30 dark:border-emerald-500/20',
    accentText: 'text-emerald-600 dark:text-emerald-400',
    disciplineTag: 'SYSTEMS ENGINEERING & SILICON ARCHITECTURE',
    badgeClass: 'bg-emerald-50 text-emerald-800 border-emerald-200 dark:bg-emerald-950/60 dark:text-emerald-300 dark:border-emerald-800',
    dotColor: 'bg-emerald-500',
    synthesisTitle: 'Low-Level Mechanics & Hardware Impact',
    synthesisClass: 'callout-deep-dive',
  },
  devtools: {
    gradient: 'from-amber-500/10 via-orange-500/5 to-sky-500/10',
    border: 'border-amber-500/30 dark:border-amber-500/20',
    accentText: 'text-amber-600 dark:text-amber-400',
    disciplineTag: 'DEVELOPER INFRASTRUCTURE & APPLIED SECURITY',
    badgeClass: 'bg-amber-50 text-amber-800 border-amber-200 dark:bg-amber-950/60 dark:text-amber-300 dark:border-amber-800',
    dotColor: 'bg-amber-500',
    synthesisTitle: 'Deployment Checklist & Threat Model',
    synthesisClass: 'callout-warning',
  }
}[categoryVariant] || {
  gradient: 'from-blue-600/10 via-slate-500/5 to-blue-800/10',
  border: 'border-blue-500/30 dark:border-blue-500/20',
  accentText: 'text-blue-600 dark:text-blue-400',
  disciplineTag: 'TECHNICAL ARCHITECTURE SPECIFICATION',
  badgeClass: 'bg-blue-50 text-blue-800 border-blue-200 dark:bg-blue-950/60 dark:text-blue-300 dark:border-blue-800',
  dotColor: 'bg-blue-500',
  synthesisTitle: 'Core Findings & Analysis',
  synthesisClass: 'callout-synthesis',
};

// Compute clean headline for visible <h1> (without brand suffix)
const cleanHeadline = title.replace(/\s*\|\s*Signal Insight\s*$/i, '');
// Compute clean page title for <title> in <head> (ensures exactly one "| Signal Insight" suffix)
const cleanSeoTitle = (seoTitle || cleanHeadline).replace(/\s*\|\s*Signal Insight\s*$/i, '');
const fullPageTitle = `${cleanSeoTitle} | Signal Insight`;
---

<Base title={fullPageTitle} description={description} canonical={resolvedCanonical} ogImage={ogImage} author={author} publishedTime={publishedTime} modifiedTime={updatedTime}>
  <div class="container-wide py-8 lg:py-14" id="article-container">
    <article class="max-w-5xl mx-auto w-full min-w-0" id="main-article-element">
      <!-- Bespoke Discipline Editorial Header -->
      <header class={`article-header mb-8 rounded-2xl border ${disciplineTheme.border} bg-gradient-to-br ${disciplineTheme.gradient} p-6 sm:p-8 relative overflow-hidden backdrop-blur-xs`}>
        <!-- Top Metadata & Reader Controls Bar -->
        <div class="flex flex-wrap items-center justify-between gap-3 mb-6">
          <div class="inline-flex items-center gap-2 rounded-full border px-3 py-1 text-[11px] font-mono font-bold uppercase tracking-wider shadow-2xs" class:list={[disciplineTheme.badgeClass]}>
            <span class="h-2 w-2 rounded-full animate-pulse" class:list={[disciplineTheme.dotColor]}></span>
            <span>{disciplineTheme.disciplineTag}</span>
          </div>

          <!-- Interactive Reading Controls: Typography & Focus Mode -->
          <div class="flex items-center gap-1.5 rounded-xl border border-slate-200 bg-white/90 p-1 text-xs shadow-2xs backdrop-blur-xs dark:border-white/[0.08] dark:bg-[#0B101D]/90">
            <span class="text-[10px] font-mono text-slate-400 px-1 uppercase hidden sm:inline">Text</span>
            <button type="button" id="font-decrease" class="rounded px-2 py-0.5 text-slate-600 hover:bg-slate-100 hover:text-slate-900 dark:text-slate-400 dark:hover:bg-slate-800 font-mono" title="Decrease font size">A-</button>
            <button type="button" id="font-reset" class="rounded px-2 py-0.5 text-slate-600 hover:bg-slate-100 hover:text-slate-900 dark:text-slate-400 dark:hover:bg-slate-800 font-mono font-bold" title="Reset font size">A</button>
            <button type="button" id="font-increase" class="rounded px-2 py-0.5 text-slate-600 hover:bg-slate-100 hover:text-slate-900 dark:text-slate-400 dark:hover:bg-slate-800 font-mono" title="Increase font size">A+</button>
            <span class="h-3 w-px bg-slate-200 dark:bg-slate-700 mx-0.5" aria-hidden="true"></span>
            <button type="button" id="focus-mode-toggle" class="rounded px-2.5 py-0.5 text-slate-600 hover:bg-slate-100 hover:text-blue-600 dark:text-slate-400 dark:hover:bg-slate-800 text-[11px] font-medium" title="Toggle Distraction-Free Focus Mode">Focus</button>
          </div>
        </div>

        <div class="header-meta flex items-center gap-2.5 flex-wrap mb-4 text-xs font-mono text-slate-500 dark:text-slate-400">
          {logo && <ArticleLogo logo={logo} category={categoryVariant} size="sm" />}
          <span class="font-semibold text-slate-700 dark:text-slate-300">{category}</span>
          <span aria-hidden="true">&bull;</span>
          <time datetime={publishedTime}>
            {new Date(publishedTime).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}
          </time>
          {updatedTime && (
            <>
              <span aria-hidden="true">&bull;</span>
              <time datetime={updatedTime}>
                Updated {new Date(updatedTime).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}
              </time>
            </>
          )}
          <span aria-hidden="true">&bull;</span>
          <span class="font-bold text-blue-600 dark:text-blue-400">{readingTime}</span>
        </div>

        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black tracking-tight text-slate-900 dark:text-white leading-[1.15]">{cleanHeadline}</h1>
        <p class="mt-4 text-base sm:text-lg leading-relaxed text-slate-600 dark:text-slate-300 max-w-3xl">{description}</p>

        <div class="mt-6 flex items-center gap-4 author-byline pt-4 border-t border-slate-200/60 dark:border-white/[0.06]">
          <div class="w-11 h-11 rounded-full bg-blue-50 text-blue-700 flex items-center justify-center font-bold text-sm border border-blue-200 shadow-2xs dark:bg-blue-950/60 dark:text-blue-300 dark:border-blue-900 overflow-hidden shrink-0">
            {authorAvatar ? (
              <img src={authorAvatar} alt={authorName} width="44" height="44" decoding="async" class="w-full h-full object-cover" />
            ) : (
              authorData.initials || author.charAt(0).toUpperCase()
            )}
          </div>
          <div>
            <p class="font-bold text-slate-900 dark:text-white text-sm flex items-center gap-1.5">
              <span>{authorName}</span>
              <span class="inline-flex items-center px-1.5 py-0.2 rounded text-[10px] font-mono bg-blue-100 text-blue-800 dark:bg-blue-950 dark:text-blue-300 font-normal">Verified Research</span>
            </p>
            <p class="text-xs text-slate-500 dark:text-slate-400 font-mono">{authorRole} &bull; Peer-Reviewed Editorial</p>
          </div>
        </div>
      </header>

      <!-- Prominent High-Contrast Scientific Vector Illustration Hero Banner -->
      <div class="article-hero-visual relative h-64 sm:h-80 lg:h-96 w-full overflow-hidden rounded-2xl border border-slate-200 bg-slate-50 shadow-xs dark:bg-[#070B14] dark:border-white/[0.08] my-8 flex items-center justify-center p-4 sm:p-6">
        <ArticleVisual slug={slug} category={categoryVariant} logo={logo} />
      </div>

      <!-- Executive Synthesis Takeaways Callout -->
      <div class:list={['editorial-callout', disciplineTheme.synthesisClass, 'mb-10']}>
        <div class="flex items-start gap-3.5">
          <div class="mt-0.5 shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class:list={[disciplineTheme.accentText]}>
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
              <polyline points="14 2 14 8 20 8"></polyline>
              <line x1="16" y1="13" x2="8" y2="13"></line>
              <line x1="16" y1="17" x2="8" y2="17"></line>
              <polyline points="10 9 9 9 8 9"></polyline>
            </svg>
          </div>
          <div class="min-w-0 flex-1">
            <h2 class="text-xs font-bold uppercase tracking-wider text-slate-900 dark:text-white font-mono">
              {disciplineTheme.synthesisTitle}
            </h2>
            <p class="mt-1 text-sm leading-relaxed text-slate-700 dark:text-slate-300">
              {description}
            </p>
            <div class="mt-2.5 flex flex-wrap items-center gap-3 text-[11px] font-mono text-slate-500 dark:text-slate-400">
              <span>Discipline: <strong class="text-slate-800 dark:text-slate-200">{category}</strong></span>
              <span>&bull;</span>
              <span>Reading Depth: <strong class="text-slate-800 dark:text-slate-200">{readingTime}</strong></span>
              <span>&bull;</span>
              <span>Standards: <strong class="text-emerald-600 dark:text-emerald-400">100% Primary Academic Citations</strong></span>
            </div>
          </div>
        </div>
      </div>

      <div class="article-layout grid grid-cols-1 lg:grid-cols-[260px_minmax(0,1fr)] xl:grid-cols-[280px_minmax(0,1fr)] gap-10 lg:gap-12 w-full max-w-full min-w-0 items-start">
        <!-- Sidebar: TOC + Share + Author -->
        <aside class="toc-sidebar sticky top-24 space-y-8 hidden lg:block">
          <nav class="toc" aria-label="Table of Contents">
            <h2 class="text-caption uppercase tracking-wider text-text-muted mb-3 font-bold font-mono text-[11px]">Contents</h2>
            <ol class="space-y-2 text-sm">
              <slot name="toc" />
            </ol>
          </nav>
          <div class="share-actions space-y-3 pt-6 border-t border-slate-200 dark:border-white/[0.08]">
            <span class="text-caption uppercase tracking-wider text-text-muted block mb-2 font-bold font-mono text-[11px]">Share</span>
            <div class="flex gap-2">
              <a href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(title)}&url=${encodeURIComponent(resolvedCanonical)}`} target="_blank" rel="noopener noreferrer" class="p-2 rounded-lg bg-neutral-100 hover:bg-brand-primary/10 text-text-secondary hover:text-brand-primary transition-colors dark:bg-[#0B101D] dark:border dark:border-white/[0.08] dark:hover:border-blue-500/50 dark:hover:text-blue-400" aria-label="Share on X">
                <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 9.24-8.333-9.24-8.502 9.24 8.333 9.24-8.502-9.24-8.333 9.24 8.502 9.24 8.333-9.24-8.502-9.24-8.333 9.24 8.502 9.24 8.333-9.24-8.502-9.24Z"/></svg>
              </a>
              <a href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(resolvedCanonical)}`} target="_blank" rel="noopener noreferrer" class="p-2 rounded-lg bg-neutral-100 hover:bg-brand-primary/10 text-text-secondary hover:text-brand-primary transition-colors dark:bg-[#0B101D] dark:border dark:border-white/[0.08] dark:hover:border-blue-500/50 dark:hover:text-blue-400" aria-label="Share on LinkedIn">
                <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24"><path fill-rule="evenodd" d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v11z"/></svg>
              </a>
              <a href={`mailto:?subject=${encodeURIComponent(title)}&body=${encodeURIComponent(resolvedCanonical)}`} class="p-2 rounded-lg bg-neutral-100 hover:bg-brand-primary/10 text-text-secondary hover:text-brand-primary transition-colors dark:bg-[#0B101D] dark:border dark:border-white/[0.08] dark:hover:border-blue-500/50 dark:hover:text-blue-400" aria-label="Share via Email">
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
              </a>
            </div>
          </div>
          <div class="author-card p-5 rounded-xl border border-slate-200 bg-slate-50 dark:border-white/[0.08] dark:bg-[#0B101D]">
            <div class="flex items-start gap-3">
              <div class="w-10 h-10 rounded-full bg-blue-50 text-blue-600 flex items-center justify-center font-bold text-sm shrink-0 overflow-hidden dark:bg-blue-950/60 dark:text-blue-400 border border-blue-200/60 dark:border-blue-900/60">
                {authorAvatar ? <img src={authorAvatar} alt={authorName} width="40" height="40" loading="lazy" decoding="async" class="w-full h-full object-cover" /> : authorData.initials}
              </div>
              <div>
                <p class="font-semibold text-slate-900 dark:text-white text-sm">{authorName}</p>
                <p class="text-xs text-slate-500 dark:text-slate-400">{authorRole}</p>
                <p class="mt-2 text-xs text-slate-600 dark:text-slate-300 leading-relaxed">{authorData.bio}</p>
                <div class="mt-3 flex flex-wrap items-center gap-2 text-xs">
                  {authorData.links.about && <a href={authorData.links.about} class="text-blue-600 dark:text-blue-400 font-semibold hover:underline">Editorial Standards</a>}
                  {authorData.links.github && <><span class="text-slate-400" aria-hidden="true">&bull;</span><a href={authorData.links.github} target="_blank" rel="noopener noreferrer" class="text-blue-600 dark:text-blue-400 hover:underline">GitHub</a></>}
                  {authorData.links.site && <><span class="text-slate-400" aria-hidden="true">&bull;</span><a href={authorData.links.site} target="_blank" rel="noopener noreferrer" class="text-blue-600 dark:text-blue-400 hover:underline">Site</a></>}
                </div>
              </div>
            </div>
          </div>
        </aside>

        <div class="article-content prose-editorial max-w-none w-full min-w-0 overflow-x-clip">
          <!-- Mobile Collapsible Table of Contents -->
          <div class="lg:hidden mb-8 rounded-xl border border-slate-200 bg-slate-50 p-4 dark:border-white/[0.08] dark:bg-[#0B101D] not-prose">
            <details class="group">
              <summary class="flex items-center justify-between cursor-pointer font-bold text-sm text-slate-900 dark:text-white select-none">
                <span class="inline-flex items-center gap-2">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-blue-600 dark:text-blue-400"><line x1="8" y1="6" x2="21" y2="6"></line><line x1="8" y1="12" x2="21" y2="12"></line><line x1="8" y1="18" x2="21" y2="18"></line><line x1="3" y1="6" x2="3.01" y2="6"></line><line x1="3" y1="12" x2="3.01" y2="12"></line><line x1="3" y1="18" x2="3.01" y2="18"></line></svg>
                  Table of Contents
                </span>
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform group-open:rotate-180 text-slate-400"><polyline points="6 9 12 15 18 9"></polyline></svg>
              </summary>
              <nav class="mt-3 pt-3 border-t border-slate-200 dark:border-white/[0.08] text-sm">
                <ol class="space-y-2">
                  <slot name="toc" />
                </ol>
              </nav>
            </details>
          </div>

          <slot />

          <!-- Primary References & Scientific Citations -->
          {references && references.length > 0 && (
            <section class="mt-12 pt-8 border-t border-slate-200 dark:border-white/[0.08] not-prose" aria-labelledby="references-heading">
              <div class="flex items-center gap-2 mb-4">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-blue-600 dark:text-blue-400"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path></svg>
                <h2 id="references-heading" class="text-lg font-bold text-slate-900 dark:text-white">Primary References &amp; Scientific Citations</h2>
              </div>
              <ol class="space-y-2.5 list-decimal list-inside text-xs sm:text-sm text-slate-600 dark:text-slate-300">
                {references.map((ref) => (
                  <li class="leading-relaxed">
                    <span class="font-medium text-slate-800 dark:text-slate-200">{ref.title}</span>
                    {ref.source && <span class="text-slate-500 dark:text-slate-400"> &mdash; {ref.source}</span>}
                    {ref.url && (
                      <a href={ref.url} target="_blank" rel="noopener noreferrer" class="ml-1.5 text-blue-600 dark:text-blue-400 hover:underline inline-flex items-center gap-0.5">
                        <span>[Source]</span>
                        <svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
                      </a>
                    )}
                  </li>
                ))}
              </ol>
            </section>
          )}
        </div>
      </div>

      <!-- Tags -->
      {tags && tags.length > 0 && (
        <div class="mt-12 pt-8 border-t border-slate-200 dark:border-white/[0.08]">
          <div class="flex flex-wrap items-center gap-2">
            <span class="text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400 mr-2 font-mono">Tags:</span>
            {tags.map((tag: string) => (
              <span class="rounded-lg border border-slate-200 bg-slate-50 px-3 py-1 text-xs font-medium text-slate-700 dark:border-white/[0.08] dark:bg-[#0B101D] dark:text-slate-300">
                #{tag}
              </span>
            ))}
          </div>
        </div>
      )}

      <!-- Author Bio Card -->
      <div class="mt-10 rounded-2xl border border-slate-200 bg-slate-50 p-6 sm:p-8 dark:border-white/[0.08] dark:bg-[#0B101D]">
        <div class="flex items-start gap-4">
          <div class="w-14 h-14 rounded-full bg-blue-50 text-blue-600 flex items-center justify-center font-bold text-lg shrink-0 overflow-hidden dark:bg-blue-950/60 dark:text-blue-400 border border-blue-200/60 dark:border-blue-900/60">
            {authorAvatar ? <img src={authorAvatar} alt={authorName} width="56" height="56" loading="lazy" decoding="async" class="w-full h-full object-cover" /> : authorData.initials}
          </div>
          <div>
            <h3 class="font-bold text-slate-900 dark:text-white text-lg">{authorName}</h3>
            <p class="text-xs text-slate-500 dark:text-slate-400">{authorRole}</p>
            <p class="mt-2 text-sm text-slate-600 dark:text-slate-300 leading-relaxed">{authorData.bio}</p>
            <div class="mt-3 flex flex-wrap gap-3 text-xs">
              {authorData.links.github && <a href={authorData.links.github} target="_blank" rel="noopener noreferrer" class="font-medium text-blue-600 dark:text-blue-400 hover:underline">GitHub</a>}
              {authorData.links.mastodon && <><span class="text-slate-400">&bull;</span><a href={authorData.links.mastodon} target="_blank" rel="noopener noreferrer" class="font-medium text-blue-600 dark:text-blue-400 hover:underline">Mastodon</a></>}
              {authorData.links.twitter && <><span class="text-slate-400">&bull;</span><a href={authorData.links.twitter} target="_blank" rel="noopener noreferrer" class="font-medium text-blue-600 dark:text-blue-400 hover:underline">X</a></>}
              {authorData.links.site && <><span class="text-slate-400">&bull;</span><a href={authorData.links.site} target="_blank" rel="noopener noreferrer" class="font-medium text-blue-600 dark:text-blue-400 hover:underline">Personal Site</a></>}
              {authorData.links.blog && <><span class="text-slate-400">&bull;</span><a href={authorData.links.blog} target="_blank" rel="noopener noreferrer" class="font-medium text-blue-600 dark:text-blue-400 hover:underline">Blog</a></>}
              {authorData.links.scholar && <><span class="text-slate-400">&bull;</span><a href={authorData.links.scholar} target="_blank" rel="noopener noreferrer" class="font-medium text-blue-600 dark:text-blue-400 hover:underline">Google Scholar</a></>}
            </div>
          </div>
        </div>
      </div>

      <!-- Related Articles -->
      {relatedArticles && relatedArticles.length > 0 && (
        <section class="mt-16" aria-labelledby="related-heading">
          <h2 id="related-heading" class="text-2xl font-bold tracking-tight text-slate-900 dark:text-white mb-6">Continue Reading</h2>
          <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
            {relatedArticles.map(item => (
              <article class="group flex flex-col justify-between overflow-hidden rounded-2xl border border-slate-200 bg-white p-6 shadow-xs transition-all duration-200 hover:-translate-y-1 hover:shadow-md hover:border-blue-400 dark:border-white/[0.08] dark:bg-[#0B101D] dark:hover:border-blue-500/60 dark:hover:shadow-[0_12px_28px_-6px_rgba(0,0,0,0.5),0_0_20px_rgba(59,130,246,0.15)]">
                <div>
                  <div class="flex items-center justify-between gap-2 text-xs mb-3">
                    <span class={`badge badge--${item.categoryVariant || 'tech'}`}>{item.category}</span>
                    <span class="text-slate-500 dark:text-slate-400 font-mono text-[11px]">{item.readingTime}</span>
                  </div>
                  <h3 class="text-base sm:text-lg font-bold leading-snug text-slate-900 transition-colors group-hover:text-blue-600 dark:text-white dark:group-hover:text-blue-400">
                    <a href={`/articles/${item.slug}/`} class="hover:underline">
                      {item.title}
                    </a>
                  </h3>
                  <p class="mt-3 text-sm leading-relaxed text-slate-600 dark:text-slate-400 line-clamp-3">{item.excerpt}</p>
                </div>
                <div class="mt-6 flex items-center justify-between border-t border-slate-100 pt-4 text-xs dark:border-white/[0.06]">
                  <span class="text-slate-500 dark:text-slate-400 font-mono text-[11px]">{item.readingTime}</span>
                  <a href={`/articles/${item.slug}/`} class="inline-flex items-center gap-1 font-bold text-blue-600 transition-all group-hover:gap-2 hover:text-blue-700 dark:text-blue-400">
                    <span>Read</span>
                    <span aria-hidden="true">&rarr;</span>
                  </a>
                </div>
              </article>
            ))}
          </div>
        </section>
      )}
    </article>
  </div>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      // Code copy buttons
      document.querySelectorAll('.prose-editorial pre').forEach((pre) => {
        if (pre.querySelector('.code-copy-btn')) return;
        pre.style.position = 'relative';
        const btn = document.createElement('button');
        btn.className = 'code-copy-btn';
        btn.type = 'button';
        btn.setAttribute('aria-label', 'Copy code to clipboard');
        btn.innerText = 'Copy';
        btn.addEventListener('click', async () => {
          const code = pre.querySelector('code')?.innerText || pre.innerText;
          try {
            await navigator.clipboard.writeText(code);
            btn.innerText = 'Copied!';
            btn.classList.add('copied');
            setTimeout(() => {
              btn.innerText = 'Copy';
              btn.classList.remove('copied');
            }, 2000);
          } catch (err) {
            btn.innerText = 'Failed';
          }
        });
        pre.appendChild(btn);
      });

      // Interactive typography scaling & Focus mode
      const prose = document.querySelector('.prose-editorial');
      const fontDec = document.getElementById('font-decrease');
      const fontRes = document.getElementById('font-reset');
      const fontInc = document.getElementById('font-increase');
      const focusToggle = document.getElementById('focus-mode-toggle');
      const sidebar = document.querySelector('.toc-sidebar');
      const articleEl = document.getElementById('main-article-element');

      let currentScale = 1;
      if (fontDec && fontRes && fontInc && prose) {
        fontDec.addEventListener('click', () => {
          currentScale = Math.max(0.85, currentScale - 0.08);
          prose.style.fontSize = `${currentScale * 1.025}rem`;
        });
        fontRes.addEventListener('click', () => {
          currentScale = 1;
          prose.style.fontSize = '1.025rem';
        });
        fontInc.addEventListener('click', () => {
          currentScale = Math.min(1.35, currentScale + 0.08);
          prose.style.fontSize = `${currentScale * 1.025}rem`;
        });
      }

      if (focusToggle && sidebar && articleEl) {
        focusToggle.addEventListener('click', () => {
          const isFocused = sidebar.classList.toggle('hidden');
          focusToggle.classList.toggle('bg-blue-600');
          focusToggle.classList.toggle('text-white');
          if (isFocused) {
            articleEl.classList.add('max-w-3xl');
          } else {
            articleEl.classList.remove('max-w-3xl');
          }
        });
      }
    });
  </script>
</Base>

