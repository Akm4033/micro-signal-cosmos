---
import Base from './Base.astro';
import ArticleLogo from '../components/ui/ArticleLogo.astro';
import ArticleVisual from '../components/ui/ArticleVisual.astro';
import { getAuthor } from '../data/authors';

interface Props {
  title: string;
  description: string;
  author: string;
  authorName?: string;
  authorRole?: string;
  authorAvatar?: string;
  category: string;
  categoryVariant?: 'tech' | 'science' | 'ai' | 'devtools';
  tags?: string[];
  readingTime?: string;
  publishedTime: string;
  updatedTime?: string;
  canonical?: string;
  ogImage?: string;
  logo?: string;
  slug?: string;
  relatedArticles?: Array<{ slug: string; title: string; category: string; categoryVariant?: string; readingTime: string; excerpt: string }>;
}

const {
  title,
  description,
  author,
  category,
  categoryVariant: catVariantProp,
  tags = [],
  readingTime = '8 min read',
  publishedTime,
  updatedTime,
  canonical,
  ogImage,
  logo,
  slug: propSlug,
  relatedArticles = []
} = Astro.props;

const slug = propSlug || Astro.params.slug || '';

const authorData = getAuthor(author);
const authorName = Astro.props.authorName || authorData.name;
const authorRole = Astro.props.authorRole || authorData.role;
const authorAvatar = Astro.props.authorAvatar || authorData.avatar;

const variantMap: Record<string, 'tech' | 'science' | 'ai' | 'devtools'> = {
  'technology': 'tech',
  'artificial-intelligence': 'ai',
  'science': 'science',
  'developer-tools': 'devtools',
  'tech': 'tech',
  'ai': 'ai',
  'devtools': 'devtools'
};

const categoryVariant = catVariantProp || variantMap[category.toLowerCase().replace(/\s+/g, '-')] || 'tech';
const siteUrl = Astro.site ? Astro.site.href.replace(/\/$/, '') : (process.env.SITE_URL || 'https://micro-signal-cosmos.pages.dev');
const resolvedCanonical = canonical || `${siteUrl}/articles/${Astro.params.slug || ''}/`;
---

<Base title={title} description={description} canonical={resolvedCanonical} ogImage={ogImage} author={author} publishedTime={publishedTime} modifiedTime={updatedTime}>
  <div class="container-wide py-10 lg:py-16">
    <article class="max-w-5xl mx-auto">
      <header class="article-header mb-8">
        <div class="header-meta flex items-center gap-3 flex-wrap mb-4">
          {logo && <ArticleLogo logo={logo} category={categoryVariant} size="sm" />}
          <span class={`badge badge--${categoryVariant}`}>{category}</span>
          <time datetime={publishedTime} class="text-sm text-slate-500 dark:text-slate-400">
            {new Date(publishedTime).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}
          </time>
          {updatedTime && (
            <>
              <span aria-hidden="true" class="text-slate-300 dark:text-slate-600">&bull;</span>
              <time datetime={updatedTime} class="text-sm text-slate-500 dark:text-slate-400">
                Updated {new Date(updatedTime).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}
              </time>
            </>
          )}
          <span aria-hidden="true" class="text-slate-300 dark:text-slate-600">&bull;</span>
          <span class="text-sm text-slate-500 dark:text-slate-400">{readingTime}</span>
        </div>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black tracking-tight text-slate-900 dark:text-white leading-tight">{title}</h1>
        <p class="mt-4 text-base sm:text-lg leading-relaxed text-slate-600 dark:text-slate-300 max-w-2xl">{description}</p>
        <div class="mt-6 flex items-center gap-4 author-byline">
          <div class="w-11 h-11 rounded-full bg-blue-50 text-blue-700 flex items-center justify-center font-bold text-sm border border-blue-200 shadow-2xs dark:bg-blue-950/60 dark:text-blue-300 dark:border-blue-900 overflow-hidden">
            {authorAvatar ? (
              <img src={authorAvatar} alt={authorName} class="w-full h-full object-cover" />
            ) : (
              authorData.initials || author.charAt(0).toUpperCase()
            )}
          </div>
          <div>
            <p class="font-bold text-slate-900 dark:text-white text-sm">{authorName}</p>
            <p class="text-xs text-slate-500 dark:text-slate-400">{authorRole} &bull; {readingTime}</p>
          </div>
        </div>
      </header>

      <!-- Prominent High-Contrast Scientific Vector Illustration Hero Banner -->
      <div class="article-hero-visual relative h-64 sm:h-80 lg:h-96 w-full overflow-hidden rounded-2xl border border-slate-200 bg-slate-50 shadow-xs dark:bg-slate-900/60 dark:border-slate-800 my-8 flex items-center justify-center p-4 sm:p-6">
        <ArticleVisual slug={slug} category={categoryVariant} logo={logo} />
      </div>

      <div class="article-layout grid grid-cols-1 lg:grid-cols-[260px_1fr] xl:grid-cols-[280px_1fr] gap-10 lg:gap-12 max-w-full items-start">
        <!-- Sidebar: TOC + Share + Author -->
        <aside class="toc-sidebar sticky top-24 space-y-8 hidden lg:block">
          <nav class="toc" aria-label="Table of Contents">
            <h3 class="text-caption uppercase tracking-wider text-text-muted mb-3 font-bold">Contents</h3>
            <ol class="space-y-2 text-sm">
              <slot name="toc" />
            </ol>
          </nav>
          <div class="share-actions space-y-3 pt-6 border-t border-neutral-200 dark:border-neutral-700">
            <span class="text-caption uppercase tracking-wider text-text-muted block mb-2 font-bold">Share</span>
            <div class="flex gap-2">
              <a href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(title)}&url=${encodeURIComponent(resolvedCanonical)}`} target="_blank" rel="noopener noreferrer" class="p-2 rounded-lg bg-neutral-100 hover:bg-brand-primary/10 text-text-secondary hover:text-brand-primary transition-colors dark:bg-neutral-800" aria-label="Share on X">
                <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 9.24-8.333-9.24-8.502 9.24 8.333 9.24-8.502-9.24-8.333 9.24 8.502 9.24 8.333-9.24-8.502-9.24-8.333 9.24 8.502 9.24 8.333-9.24-8.502-9.24Z"/></svg>
              </a>
              <a href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(resolvedCanonical)}`} target="_blank" rel="noopener noreferrer" class="p-2 rounded-lg bg-neutral-100 hover:bg-brand-primary/10 text-text-secondary hover:text-brand-primary transition-colors dark:bg-neutral-800" aria-label="Share on LinkedIn">
                <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24"><path fill-rule="evenodd" d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v11z"/></svg>
              </a>
              <a href={`mailto:?subject=${encodeURIComponent(title)}&body=${encodeURIComponent(resolvedCanonical)}`} class="p-2 rounded-lg bg-neutral-100 hover:bg-brand-primary/10 text-text-secondary hover:text-brand-primary transition-colors dark:bg-neutral-800" aria-label="Share via Email">
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
              </a>
            </div>
          </div>
          <div class="author-card p-5 rounded-xl border border-neutral-200 bg-neutral-50 dark:border-neutral-700 dark:bg-neutral-900/50">
            <div class="flex items-start gap-3">
              <div class="w-10 h-10 rounded-full bg-brand-primary/10 text-brand-primary flex items-center justify-center font-bold text-sm shrink-0 overflow-hidden">
                {authorAvatar ? <img src={authorAvatar} alt={authorName} class="w-full h-full object-cover" /> : authorData.initials}
              </div>
              <div>
                <p class="font-semibold text-text-primary text-sm">{authorName}</p>
                <p class="text-xs text-text-muted">{authorRole}</p>
                <p class="mt-2 text-xs text-text-secondary leading-relaxed">{authorData.bio}</p>
                <div class="mt-3 flex flex-wrap items-center gap-2 text-xs">
                  {authorData.links.about && <a href={authorData.links.about} class="text-brand-primary font-semibold hover:underline">Editorial Standards</a>}
                  {authorData.links.github && <><span class="text-text-muted" aria-hidden="true">&bull;</span><a href={authorData.links.github} target="_blank" rel="noopener noreferrer" class="text-brand-primary hover:underline">GitHub</a></>}
                  {authorData.links.site && <><span class="text-text-muted" aria-hidden="true">&bull;</span><a href={authorData.links.site} target="_blank" rel="noopener noreferrer" class="text-brand-primary hover:underline">Site</a></>}
                </div>
              </div>
            </div>
          </div>
        </aside>

        <div class="article-content prose-editorial max-w-none">
          <slot />
        </div>
      </div>

      <!-- Tags -->
      {tags && tags.length > 0 && (
        <div class="mt-12 pt-8 border-t border-neutral-200 dark:border-neutral-700">
          <div class="flex flex-wrap items-center gap-2">
            <span class="text-xs font-semibold uppercase tracking-wider text-text-muted mr-2">Tags:</span>
            {tags.map((tag: string) => (
              <span class="rounded-lg border border-neutral-200 bg-neutral-50 px-3 py-1 text-xs font-medium text-text-secondary dark:border-neutral-700 dark:bg-neutral-900">
                #{tag}
              </span>
            ))}
          </div>
        </div>
      )}

      <!-- Author Bio Card -->
      <div class="mt-10 rounded-2xl border border-neutral-200 bg-neutral-50 p-6 sm:p-8 dark:border-neutral-700 dark:bg-neutral-900/50">
        <div class="flex items-start gap-4">
          <div class="w-14 h-14 rounded-full bg-brand-primary/10 text-brand-primary flex items-center justify-center font-bold text-lg shrink-0 overflow-hidden">
            {authorAvatar ? <img src={authorAvatar} alt={authorName} class="w-full h-full object-cover" /> : authorData.initials}
          </div>
          <div>
            <h3 class="font-bold text-text-primary text-lg">{authorName}</h3>
            <p class="text-small text-text-muted">{authorRole}</p>
            <p class="mt-2 text-sm text-text-secondary leading-relaxed">{authorData.bio}</p>
            <div class="mt-3 flex flex-wrap gap-3 text-xs">
              {authorData.links.github && <a href={authorData.links.github} target="_blank" rel="noopener noreferrer" class="font-medium text-brand-primary hover:underline">GitHub</a>}
              {authorData.links.mastodon && <><span class="text-text-muted">&bull;</span><a href={authorData.links.mastodon} target="_blank" rel="noopener noreferrer" class="font-medium text-brand-primary hover:underline">Mastodon</a></>}
              {authorData.links.twitter && <><span class="text-text-muted">&bull;</span><a href={authorData.links.twitter} target="_blank" rel="noopener noreferrer" class="font-medium text-brand-primary hover:underline">X</a></>}
              {authorData.links.site && <><span class="text-text-muted">&bull;</span><a href={authorData.links.site} target="_blank" rel="noopener noreferrer" class="font-medium text-brand-primary hover:underline">Personal Site</a></>}
              {authorData.links.blog && <><span class="text-text-muted">&bull;</span><a href={authorData.links.blog} target="_blank" rel="noopener noreferrer" class="font-medium text-brand-primary hover:underline">Blog</a></>}
              {authorData.links.scholar && <><span class="text-text-muted">&bull;</span><a href={authorData.links.scholar} target="_blank" rel="noopener noreferrer" class="font-medium text-brand-primary hover:underline">Google Scholar</a></>}
            </div>
          </div>
        </div>
      </div>

      <!-- Related Articles -->
      {relatedArticles && relatedArticles.length > 0 && (
        <section class="mt-16" aria-labelledby="related-heading">
          <h2 id="related-heading" class="text-2xl font-bold tracking-tight text-slate-900 dark:text-white mb-6">Continue Reading</h2>
          <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
            {relatedArticles.map(item => (
              <article class="group flex flex-col justify-between overflow-hidden rounded-2xl border border-slate-200 bg-white p-6 shadow-xs transition-all duration-200 hover:-translate-y-1 hover:shadow-md hover:border-blue-400 dark:border-slate-800 dark:bg-slate-900">
                <div>
                  <div class="flex items-center justify-between gap-2 text-xs mb-3">
                    <span class={`badge badge--${item.categoryVariant || 'tech'}`}>{item.category}</span>
                    <span class="text-slate-500 dark:text-slate-400">{item.readingTime}</span>
                  </div>
                  <h3 class="text-base sm:text-lg font-bold leading-snug text-slate-900 transition-colors group-hover:text-blue-600 dark:text-white dark:group-hover:text-blue-400">
                    <a href={`/articles/${item.slug}/`} class="focus-visible:outline-none focus-visible:underline">
                      {item.title}
                    </a>
                  </h3>
                  <p class="mt-3 text-sm leading-relaxed text-slate-600 dark:text-slate-400 line-clamp-3">{item.excerpt}</p>
                </div>
                <div class="mt-6 flex items-center justify-between border-t border-slate-100 pt-4 text-xs dark:border-slate-800">
                  <span class="text-slate-500 dark:text-slate-400">{item.readingTime}</span>
                  <a href={`/articles/${item.slug}/`} class="inline-flex items-center gap-1 font-bold text-blue-600 transition-all group-hover:gap-2 hover:text-blue-700 dark:text-blue-400">
                    <span>Read</span>
                    <span aria-hidden="true">&rarr;</span>
                  </a>
                </div>
              </article>
            ))}
          </div>
        </section>
      )}
    </article>
  </div>
</Base>

