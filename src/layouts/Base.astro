---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  author?: string;
  publishedTime?: string;
  modifiedTime?: string;
}

const { title, description, canonical, ogImage, author, publishedTime, modifiedTime } = Astro.props;
const siteUrl = 'https://microsignalcosmos.com';
const canonicalUrl = canonical || siteUrl + Astro.url.pathname;
const ogImageUrl = ogImage || '/favicon.svg';
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="generator" content={Astro.generator}>
  <title>{title}</title>
  <meta name="description" content={description || 'Explore the world of technology, science, artificial intelligence and innovation through insightful articles, practical guides and ideas that shape our future.'}>
  <meta name="theme-color" content="#FFFFFF">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
  <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1">
  <link rel="canonical" href={canonicalUrl}>
  <meta property="og:site_name" content="Micro Signal Cosmos">
  <meta property="og:locale" content="en_US">
  <meta property="og:type" content="website">
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description || ''}>
  <meta property="og:url" content={canonicalUrl}>
  <meta property="og:image" content={ogImageUrl}>
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={description || ''}>
  <meta name="twitter:image" content={ogImageUrl}>
  <link rel="alternate" type="application/rss+xml" title="Micro Signal Cosmos" href="/rss.xml">
  <link rel="sitemap" href="/sitemap.xml">
  <script type="application/ld+json" is:inline set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      { "@type": "Organization", "@id": "https://microsignalcosmos.com/#organization", "name": "Micro Signal Cosmos", "url": "https://microsignalcosmos.com", "logo": { "@type": "ImageObject", "url": "https://microsignalcosmos.com/favicon.svg", "width": 512, "height": 512 }, "description": "Discover More. Understand Better. Exploring technology, science, artificial intelligence, and digital innovations." },
      { "@type": "WebSite", "@id": "https://microsignalcosmos.com/#website", "name": "Micro Signal Cosmos", "url": "https://microsignalcosmos.com", "publisher": { "@id": "https://microsignalcosmos.com/#organization" }, "potentialAction": { "@type": "SearchAction", "target": { "@type": "EntryPoint", "urlTemplate": "https://microsignalcosmos.com/articles/?q={search_term_string}" }, "query-input": "required name=search_term_string" } }
    ]
  })} />
</head>
<body>
  <!-- Reading Progress Bar -->
  <div id="reading-progress-bar" aria-hidden="true"></div>
  <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:rounded-lg focus:bg-brand-primary focus:px-4 focus:py-2 focus:text-sm focus:font-bold focus:text-white focus:shadow-lg focus:outline-none">Skip to main content</a>

  <!-- Top Utility Bar (Simplified) -->
  <div class="border-b border-neutral-200 bg-neutral-50 text-[11px] font-medium text-neutral-600 hidden sm:block dark:border-neutral-800 dark:bg-neutral-900/50">
    <div class="container-wide flex items-center justify-between py-1.5">
      <div class="flex items-center gap-3">
        <span class="inline-flex items-center gap-1.5 font-bold uppercase tracking-wider text-text-primary">
          <span class="h-1.5 w-1.5 rounded-full bg-brand-primary"></span>Micro Signal Cosmos
        </span>
        <span aria-hidden="true" class="text-neutral-300 dark:text-neutral-600">&bull;</span>
        <span class="text-text-muted">Technical Publication & Systems Engineering</span>
      </div>
      <div class="flex items-center gap-4">
        <a href="/tools/" class="hover:text-text-primary transition-colors">Tools</a>
        <a href="/authors/" class="hover:text-text-primary transition-colors">Authors</a>
        <a href="/about/" class="hover:text-text-primary transition-colors">About</a>
        <a href="/contact/" class="hover:text-text-primary transition-colors">Contact</a>
        <a href="/rss.xml" class="hover:text-brand-primary font-semibold transition-colors flex items-center gap-1"><span>RSS</span><span aria-hidden="true">&rarr;</span></a>
      </div>
    </div>
  </div>

  <!-- Header -->
  <header class="sticky top-0 z-50 border-b border-neutral-200 bg-white/95 backdrop-blur-md shadow-xs dark:border-neutral-800 dark:bg-neutral-950/95">
    <div class="container-wide">
      <div class="flex min-h-16 sm:min-h-20 items-center justify-between gap-3 sm:gap-4 lg:gap-8 py-2 sm:py-0">
        <!-- Brand -->
        <a href="/" class="shrink-0 flex flex-col justify-center group py-0.5" aria-label="Micro Signal Cosmos homepage">
          <span class="block text-xl font-extrabold tracking-tight text-text-primary sm:text-2xl transition-colors group-hover:text-brand-primary">Micro Signal<span class="text-brand-primary">Cosmos</span></span>
          <span class="block text-[10px] font-bold tracking-[0.22em] text-text-muted uppercase">Discover More. Understand Better.</span>
        </a>
        <!-- Desktop Nav -->
        <nav aria-label="Main navigation" class="hidden items-center gap-1 xl:gap-1.5 lg:flex">
          <a href="/" class="relative px-2.5 py-2 text-xs font-semibold tracking-wide transition-all rounded-md text-text-primary hover:text-brand-primary hover:bg-neutral-100 dark:hover:bg-neutral-800" title="Home">Home</a>
          <a href="/articles/" class="relative px-2.5 py-2 text-xs font-semibold tracking-wide transition-all rounded-md text-text-secondary hover:text-brand-primary hover:bg-neutral-100 dark:hover:bg-neutral-800" title="Articles">Articles</a>
          <a href="/category/technology/" class="relative px-2.5 py-2 text-xs font-semibold tracking-wide transition-all rounded-md text-text-secondary hover:text-brand-primary hover:bg-neutral-100 dark:hover:bg-neutral-800" title="Technology">Technology</a>
          <a href="/category/artificial-intelligence/" class="relative px-2.5 py-2 text-xs font-semibold tracking-wide transition-all rounded-md text-text-secondary hover:text-brand-primary hover:bg-neutral-100 dark:hover:bg-neutral-800" title="AI & ML">AI &amp; ML</a>
          <a href="/category/science/" class="relative px-2.5 py-2 text-xs font-semibold tracking-wide transition-all rounded-md text-text-secondary hover:text-brand-primary hover:bg-neutral-100 dark:hover:bg-neutral-800" title="Science">Science</a>
          <a href="/category/developer-tools/" class="relative px-2.5 py-2 text-xs font-semibold tracking-wide transition-all rounded-md text-text-secondary hover:text-brand-primary hover:bg-neutral-100 dark:hover:bg-neutral-800" title="Developer Tools">Dev Tools</a>
          <a href="/tools/" class="relative px-2.5 py-2 text-xs font-semibold tracking-wide transition-all rounded-md text-text-secondary hover:text-brand-primary hover:bg-neutral-100 dark:hover:bg-neutral-800" title="Tools">Tools</a>
          <a href="/about/" class="relative px-2.5 py-2 text-xs font-semibold tracking-wide transition-all rounded-md text-text-secondary hover:text-brand-primary hover:bg-neutral-100 dark:hover:bg-neutral-800" title="About">About</a>
        </nav>
        <!-- Search + Mobile -->
        <div class="flex items-center gap-2 sm:gap-2.5">
          <a href="/articles/" class="flex h-10 w-10 sm:w-auto items-center justify-center gap-2 rounded-xl border border-neutral-200 bg-neutral-50 px-0 sm:px-3.5 text-xs font-semibold text-text-primary transition-all hover:border-brand-primary hover:bg-white hover:text-brand-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-primary dark:border-neutral-700 dark:bg-neutral-800/50 dark:hover:bg-neutral-800" aria-label="Search articles archive" title="Search all articles">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
            <span class="hidden sm:inline">Search</span>
          </a>
          <!-- Mobile Drawer -->
          <details class="relative lg:hidden" id="mobile-nav-details">
            <summary class="flex h-10 w-10 cursor-pointer list-none items-center justify-center rounded-xl border border-neutral-200 bg-neutral-50 text-text-primary transition-all hover:border-brand-primary hover:bg-white hover:text-brand-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-primary dark:border-neutral-700 dark:bg-neutral-800/50 dark:hover:bg-neutral-800" aria-label="Toggle navigation menu" aria-expanded="false" id="mobile-nav-toggle">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
            </summary>
            <div class="absolute right-0 top-full mt-2 w-72 rounded-2xl border border-neutral-200 bg-white p-5 shadow-xl transition-all dark:border-neutral-700 dark:bg-neutral-900" role="dialog" aria-label="Mobile Navigation Menu">
              <div class="mb-3 pb-2 border-b border-neutral-200 flex items-center justify-between dark:border-neutral-700">
                <span class="text-xs font-bold uppercase tracking-wider text-text-muted">Browse Publication</span>
                <span class="text-[10px] font-semibold text-brand-primary uppercase">4 Pillars</span>
              </div>
              <nav class="flex flex-col space-y-1">
                <a href="/" class="rounded-lg px-3 py-2 text-sm font-semibold transition-colors flex items-center justify-between bg-brand-primary/10 text-brand-primary"><span>Home</span><span aria-hidden="true" class="text-xs text-text-muted">&rarr;</span></a>
                <a href="/articles/" class="rounded-lg px-3 py-2 text-sm font-semibold transition-colors flex items-center justify-between text-text-secondary hover:bg-neutral-100 hover:text-brand-primary dark:hover:bg-neutral-800"><span>Articles</span><span aria-hidden="true" class="text-xs text-text-muted">&rarr;</span></a>
                <a href="/category/technology/" class="rounded-lg px-3 py-2 text-sm font-semibold transition-colors flex items-center justify-between text-text-secondary hover:bg-neutral-100 hover:text-brand-primary dark:hover:bg-neutral-800"><span>Technology</span><span aria-hidden="true" class="text-xs text-text-muted">&rarr;</span></a>
                <a href="/category/artificial-intelligence/" class="rounded-lg px-3 py-2 text-sm font-semibold transition-colors flex items-center justify-between text-text-secondary hover:bg-neutral-100 hover:text-brand-primary dark:hover:bg-neutral-800"><span>AI &amp; ML</span><span aria-hidden="true" class="text-xs text-text-muted">&rarr;</span></a>
                <a href="/category/science/" class="rounded-lg px-3 py-2 text-sm font-semibold transition-colors flex items-center justify-between text-text-secondary hover:bg-neutral-100 hover:text-brand-primary dark:hover:bg-neutral-800"><span>Science</span><span aria-hidden="true" class="text-xs text-text-muted">&rarr;</span></a>
                <a href="/category/developer-tools/" class="rounded-lg px-3 py-2 text-sm font-semibold transition-colors flex items-center justify-between text-text-secondary hover:bg-neutral-100 hover:text-brand-primary dark:hover:bg-neutral-800"><span>Developer Tools</span><span aria-hidden="true" class="text-xs text-text-muted">&rarr;</span></a>
                <a href="/tools/" class="rounded-lg px-3 py-2 text-sm font-semibold transition-colors flex items-center justify-between text-text-secondary hover:bg-neutral-100 hover:text-brand-primary dark:hover:bg-neutral-800"><span>Tools</span><span aria-hidden="true" class="text-xs text-text-muted">&rarr;</span></a>
                <a href="/about/" class="rounded-lg px-3 py-2 text-sm font-semibold transition-colors flex items-center justify-between text-text-secondary hover:bg-neutral-100 hover:text-brand-primary dark:hover:bg-neutral-800"><span>About</span><span aria-hidden="true" class="text-xs text-text-muted">&rarr;</span></a>
              </nav>
              <div class="mt-4 pt-4 border-t border-neutral-200 flex flex-col gap-2 dark:border-neutral-700">
                <a href="/articles/" class="flex items-center justify-center gap-1.5 rounded-lg bg-brand-primary py-2.5 text-xs font-semibold text-white shadow-xs transition-colors hover:bg-brand-sky-deep"><span>Search & Archive</span><span aria-hidden="true">&rarr;</span></a>
                <div class="flex items-center justify-around text-xs text-text-muted pt-1">
                  <a href="/about/" class="hover:text-text-primary">About</a><span>&bull;</span><a href="/authors/" class="hover:text-text-primary">Authors</a><span>&bull;</span><a href="/contact/" class="hover:text-text-primary">Contact</a>
                </div>
              </div>
            </div>
          </details>
        </div>
      </div>
    </div>
  </header>

  <main id="main-content">
    <slot />
  </main>

  <!-- Footer -->
  <footer class="border-t border-neutral-200 bg-neutral-950 text-neutral-300 dark:border-neutral-800">
    <div class="container-wide py-16">
      <div class="grid grid-cols-1 gap-12 md:grid-cols-2 lg:grid-cols-5">
        <div class="lg:col-span-2">
          <a href="/" class="text-2xl font-extrabold tracking-tight text-white flex items-center gap-1.5"><span>Micro Signal</span><span class="text-brand-primary">Cosmos</span></a>
          <p class="mt-2 text-xs font-semibold uppercase tracking-wider text-neutral-400">Discover More. Understand Better.</p>
          <p class="mt-4 max-w-sm text-sm leading-relaxed text-neutral-300">Independent technical publication exploring systems engineering, AI/ML, and astrophysics through deep-dive guides and reproducible architectures.</p>
          <div class="mt-6 flex items-center gap-3">
            <a href="https://www.facebook.com/profile.php?id=61596288235891" target="_blank" rel="noopener noreferrer" class="flex h-9 items-center gap-1.5 rounded-lg border border-neutral-700 bg-neutral-800/80 px-3 text-xs font-medium text-neutral-200 transition-colors hover:border-brand-primary hover:text-brand-primary" aria-label="Follow on Facebook"><span>Facebook</span><span aria-hidden="true">↗</span></a>
            <a href="https://www.youtube.com/@MicroSignalCosmos" target="_blank" rel="noopener noreferrer" class="flex h-9 items-center gap-1.5 rounded-lg border border-neutral-700 bg-neutral-800/80 px-3 text-xs font-medium text-neutral-200 transition-colors hover:border-brand-primary hover:text-brand-primary" aria-label="Subscribe on YouTube"><span>YouTube</span><span aria-hidden="true">↗</span></a>
          </div>
        </div>
        <div>
          <h2 class="text-xs font-bold uppercase tracking-widest text-white mb-4">Core Topics</h2>
          <ul class="space-y-2.5 text-sm"><li><a href="/category/technology/" class="text-neutral-300 transition-colors hover:text-white hover:underline underline-offset-4">Technology</a></li><li><a href="/category/artificial-intelligence/" class="text-neutral-300 transition-colors hover:text-white hover:underline underline-offset-4">AI &amp; ML</a></li><li><a href="/category/science/" class="text-neutral-300 transition-colors hover:text-white hover:underline underline-offset-4">Science</a></li><li><a href="/category/developer-tools/" class="text-neutral-300 transition-colors hover:text-white hover:underline underline-offset-4">Developer Tools</a></li></ul>
        </div>
        <div>
          <h2 class="text-xs font-bold uppercase tracking-widest text-white mb-4">Discover</h2>
          <ul class="space-y-2.5 text-sm"><li><a href="/articles/" class="text-neutral-300 transition-colors hover:text-white hover:underline underline-offset-4">All Articles</a></li><li><a href="/tools/" class="text-neutral-300 transition-colors hover:text-white hover:underline underline-offset-4">Tools &amp; Stack</a></li><li><a href="/authors/" class="text-neutral-300 transition-colors hover:text-white hover:underline underline-offset-4">Authors &amp; Lenses</a></li><li><a href="/about/" class="text-neutral-300 transition-colors hover:text-white hover:underline underline-offset-4">About</a></li><li><a href="/contact/" class="text-neutral-300 transition-colors hover:text-white hover:underline underline-offset-4">Contact</a></li><li><a href="/rss.xml" class="text-neutral-300 transition-colors hover:text-white hover:underline underline-offset-4">RSS Feed</a></li></ul>
        </div>
        <div>
          <h2 class="text-xs font-bold uppercase tracking-widest text-white mb-4">Legal &amp; Trust</h2>
          <ul class="space-y-2.5 text-sm"><li><a href="/privacy-policy/" class="text-neutral-300 transition-colors hover:text-white hover:underline underline-offset-4">Privacy Policy</a></li><li><a href="/terms/" class="text-neutral-300 transition-colors hover:text-white hover:underline underline-offset-4">Terms of Use</a></li><li><a href="/disclaimer/" class="text-neutral-300 transition-colors hover:text-white hover:underline underline-offset-4">Disclaimer &amp; Affiliate Notice</a></li><li><a href="/sitemap.xml" class="text-neutral-300 transition-colors hover:text-white hover:underline underline-offset-4">XML Sitemap</a></li></ul>
        </div>
        <div class="newsletter-footer space-y-3">
          <h3 class="text-xs font-bold uppercase tracking-widest text-white">Subscribe to The Signal</h3>
          <p class="text-xs leading-relaxed text-neutral-300">Weekly deep dives into system internals, AI engineering, and astrophysics.</p>
          <form action="https://buttondown.email/api/emails/embed-subscribe/microsignalcosmos" method="post" target="popupwindow" onsubmit="window.open('https://buttondown.email/microsignalcosmos', 'popupwindow'); return true;" class="flex flex-col sm:flex-row gap-2">
            <input type="email" name="email" required placeholder="email@domain.com" aria-label="Email address" class="rounded-lg border border-neutral-700 bg-neutral-800/90 px-3 py-2 text-xs text-white placeholder-neutral-400 focus:border-brand-primary focus:outline-none focus:ring-1 focus:ring-brand-primary">
            <input type="hidden" value="1" name="embed">
            <button type="submit" class="rounded-lg bg-brand-primary px-3.5 py-2 text-xs font-semibold text-white transition-colors hover:bg-brand-sky-deep">Join</button>
          </form>
          <p class="text-[10px] text-neutral-400">No tracking pixels. Unsubscribe anytime.</p>
        </div>
      </div>
      <div class="mt-14 border-t border-neutral-800 pt-8 flex flex-col items-center justify-between gap-4 text-xs text-neutral-400 sm:flex-row">
        <p>© 2026 Micro Signal Cosmos. All rights reserved.</p>
        <div class="flex flex-wrap items-center gap-6"><a href="/privacy-policy/" class="hover:text-white transition-colors">Privacy</a><a href="/terms/" class="hover:text-white transition-colors">Terms</a><a href="/disclaimer/" class="hover:text-white transition-colors">Disclaimer</a><a href="/contact/" class="hover:text-white transition-colors">Contact Desk</a></div>
      </div>
    </div>
  </footer>

  <!-- Scripts -->
  <script is:inline>
    (function() {
      const bar = document.getElementById('reading-progress-bar');
      if (!bar) return;
      window.addEventListener('scroll', function() {
        const winScroll = document.documentElement.scrollTop || document.body.scrollTop;
        const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
        if (height > 0) { bar.style.width = (winScroll / height) * 100 + '%'; }
      }, { passive: true });
    })();
  </script>
</body>
</html>

