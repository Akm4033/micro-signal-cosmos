              </div>
              <div class="flex flex-col space-y-1">
                {navLinks.map((link) => {
                  const active = isNavActive(link.href);
                  return (
                    <a
                      href={link.href}
                      class:list={[
                        'min-h-11 rounded-lg px-3 py-2.5 text-sm font-semibold transition-colors flex items-center justify-between',
                        active
                          ? 'text-blue-700 bg-blue-50 dark:bg-blue-950/70 dark:text-blue-300 font-bold'
                          : 'text-slate-700 hover:bg-slate-50 hover:text-blue-600 dark:text-slate-300 dark:hover:bg-slate-800'
                      ]}
                      aria-current={active ? 'page' : undefined}
                    >
                      <span>{link.name}</span>
                      <span aria-hidden="true" class="text-xs text-slate-400">&rarr;</span>
                    </a>
                  );
                })}
              </div>
              <div class="mt-4 pt-3 border-t border-slate-100 flex flex-col gap-2 dark:border-white/[0.08]">
                <a href="/articles/" class="min-h-11 flex items-center justify-center gap-1.5 rounded-lg bg-blue-600 py-2.5 text-xs font-semibold text-white shadow-xs transition-colors hover:bg-blue-700 font-mono"><span>Search All Knowledge</span><span aria-hidden="true">&rarr;</span></a>
                <div class="flex items-center justify-around text-xs text-slate-500 dark:text-slate-400 pt-2">
                  <a href="/about/" class="hover:text-blue-600 p-2 min-h-11 flex items-center">About</a>
                  <span aria-hidden="true">&bull;</span>
                  <a href="/authors/" class="hover:text-blue-600 p-2 min-h-11 flex items-center">Research</a>
                  <span aria-hidden="true">&bull;</span>
                  <a href="/contact/" class="hover:text-blue-600 p-2 min-h-11 flex items-center">Contact</a>
                </div>
              </div>
            </nav>
          </div>
        </div>
      </div>
    </div>
  </header>

  <main id="main-content" class="flex-1 w-full max-w-full min-w-0">
    <slot />
  </main>

  <!-- Global Editorial Footer (Clean Light Slate in Light Mode / Deep Cosmic Midnight in Dark Mode) -->
  <footer class="border-t border-slate-200/90 bg-slate-50 text-slate-600 dark:border-white/[0.08] dark:bg-[#060913] dark:text-slate-400 w-full max-w-full transition-colors duration-200">
    <div class="container-wide py-14 sm:py-16">
      <div class="grid grid-cols-1 gap-10 md:grid-cols-2 lg:grid-cols-5">
        <div class="lg:col-span-2">
          <a href="/" class="text-2xl font-black tracking-tight text-slate-900 dark:text-white flex items-center gap-2">
            <span>Signal Insight</span>
          </a>
          <p class="mt-2 text-xs font-bold uppercase tracking-widest text-slate-500 dark:text-slate-400">Understand the world. Explore beyond it.</p>
          <p class="mt-3.5 max-w-sm text-xs sm:text-sm leading-relaxed text-slate-600 dark:text-slate-300">A global scientific knowledge discovery and learning platform exploring systems engineering, neural architectures, astrophysics, and developer infrastructure through rigorous research.</p>
          <div class="mt-5 flex items-center gap-3">
            <a href="https://github.com/Akm4033/signal-insight" target="_blank" rel="noopener noreferrer" class="flex h-8 items-center gap-1.5 rounded-md border border-slate-300 bg-white px-2.5 text-xs font-medium text-slate-700 shadow-2xs transition-colors hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800/80 dark:text-slate-200 dark:hover:border-blue-500 dark:hover:text-white" aria-label="Signal Insight on GitHub"><span>GitHub</span><span aria-hidden="true">↗</span></a>
            <a href="https://www.youtube.com/@SignalInsight" target="_blank" rel="noopener noreferrer" class="flex h-8 items-center gap-1.5 rounded-md border border-slate-300 bg-white px-2.5 text-xs font-medium text-slate-700 shadow-2xs transition-colors hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800/80 dark:text-slate-200 dark:hover:border-blue-500 dark:hover:text-white" aria-label="Signal Insight Channel"><span>YouTube</span><span aria-hidden="true">↗</span></a>
          </div>
        </div>

        <nav aria-label="Knowledge Pillars navigation">
          <h3 class="text-xs font-bold uppercase tracking-widest text-slate-900 dark:text-white mb-3">4 Knowledge Pillars</h3>
          <ul class="space-y-2 text-xs sm:text-sm">
            <li><a href="/category/technology/" class="text-slate-600 transition-colors hover:text-blue-600 hover:underline underline-offset-4 dark:text-slate-400 dark:hover:text-white">Systems &amp; Technology</a></li>
            <li><a href="/category/artificial-intelligence/" class="text-slate-600 transition-colors hover:text-blue-600 hover:underline underline-offset-4 dark:text-slate-400 dark:hover:text-white">AI &amp; Neural Foundations</a></li>
            <li><a href="/category/science/" class="text-slate-600 transition-colors hover:text-blue-600 hover:underline underline-offset-4 dark:text-slate-400 dark:hover:text-white">Astrophysics &amp; Physics</a></li>
            <li><a href="/category/developer-tools/" class="text-slate-600 transition-colors hover:text-blue-600 hover:underline underline-offset-4 dark:text-slate-400 dark:hover:text-white">Developer Infrastructure</a></li>
          </ul>
        </nav>

        <nav aria-label="Site exploration navigation">
          <h3 class="text-xs font-bold uppercase tracking-widest text-slate-900 dark:text-white mb-3">Discover</h3>
          <ul class="space-y-2 text-xs sm:text-sm">
            <li><a href="/articles/" class="text-slate-600 transition-colors hover:text-blue-600 hover:underline underline-offset-4 dark:text-slate-400 dark:hover:text-white">All Articles</a></li>
            <li><a href="/tools/" class="text-slate-600 transition-colors hover:text-blue-600 hover:underline underline-offset-4 dark:text-slate-400 dark:hover:text-white">Tools &amp; Stack</a></li>
            <li><a href="/authors/" class="text-slate-600 transition-colors hover:text-blue-600 hover:underline underline-offset-4 dark:text-slate-400 dark:hover:text-white">Research Desk</a></li>
            <li><a href="/about/" class="text-slate-600 transition-colors hover:text-blue-600 hover:underline underline-offset-4 dark:text-slate-400 dark:hover:text-white">About Signal Insight</a></li>
            <li><a href="/contact/" class="text-slate-600 transition-colors hover:text-blue-600 hover:underline underline-offset-4 dark:text-slate-400 dark:hover:text-white">Contact</a></li>
            <li><a href="/rss.xml" class="text-slate-600 transition-colors hover:text-blue-600 hover:underline underline-offset-4 dark:text-slate-400 dark:hover:text-white">RSS Feed</a></li>
          </ul>
        </nav>

        <div class="newsletter-footer space-y-3">
          <h3 class="text-xs font-bold uppercase tracking-widest text-slate-900 dark:text-white">Weekly Briefing</h3>
          <p class="text-xs leading-relaxed text-slate-600 dark:text-slate-300">Join engineers getting systems breakdowns in their inbox every week.</p>
          <NewsletterInline variant="compact" source="footer" />
          <div class="pt-1 flex items-center justify-between text-xs text-slate-400">
            <span>Prefer RSS?</span>
            <a href="/rss.xml" target="_blank" class="hover:text-blue-500 font-mono text-xs inline-flex items-center gap-1">
              <span>/rss.xml</span>
              <span aria-hidden="true">&rarr;</span>
            </a>
          </div>
        </div>
      </div>

      <div class="mt-12 border-t border-slate-200 pt-6 flex flex-col items-center justify-between gap-3 text-xs text-slate-500 sm:flex-row dark:border-slate-800 dark:text-slate-400">
        <p>&copy; 2026 Signal Insight. All rights reserved.</p>
        <nav aria-label="Legal and utility navigation" class="flex flex-wrap items-center gap-4 sm:gap-6">
          <a href="/privacy-policy/" class="hover:text-slate-900 dark:hover:text-white transition-colors">Privacy</a>
          <a href="/terms/" class="hover:text-slate-900 dark:hover:text-white transition-colors">Terms</a>
          <a href="/disclaimer/" class="hover:text-slate-900 dark:hover:text-white transition-colors">Disclaimer</a>
          <a href="/sitemap.xml" class="hover:text-slate-900 dark:hover:text-white transition-colors">Sitemap</a>
          <a href="/contact/" class="hover:text-slate-900 dark:hover:text-white transition-colors">Contact</a>
        </nav>
      </div>
    </div>
  </footer>

  <!-- Theme Toggle & Reading Bar Scripts -->
  <script is:inline>
    (function() {
      // Reading progress bar
      const bar = document.getElementById('reading-progress-bar');
      if (bar) {
        window.addEventListener('scroll', function() {
          const winScroll = document.documentElement.scrollTop || document.body.scrollTop;
          const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
          if (height > 0) { bar.style.transform = 'scaleX(' + (winScroll / height) + ')'; }
        }, { passive: true });
      }

      // Theme toggle functionality
      const toggleBtn = document.getElementById('theme-toggle-btn');
      if (toggleBtn) {
        toggleBtn.addEventListener('click', function() {
          const isDark = document.documentElement.classList.toggle('dark');
          try {
            localStorage.setItem('signal_insight_theme', isDark ? 'dark' : 'light');
          } catch(e) {}
        });
      }

      // Accessible Mobile navigation drawer interaction (P1-5: Escape closes, focus trapped)
      const mobileToggle = document.getElementById('mobile-nav-toggle');
      const mobileMenu = document.getElementById('mobile-nav-menu');
      if (mobileToggle && mobileMenu) {
        function openMenu() {
          mobileMenu.classList.remove('hidden');
          mobileToggle.setAttribute('aria-expanded', 'true');
          const firstLink = mobileMenu.querySelector('a');
          if (firstLink) firstLink.focus();
        }

        function closeMenu() {
          mobileMenu.classList.add('hidden');
          mobileToggle.setAttribute('aria-expanded', 'false');
          mobileToggle.focus();
        }

        mobileToggle.addEventListener('click', function(e) {
          e.stopPropagation();
          const isOpen = mobileToggle.getAttribute('aria-expanded') === 'true';
          if (isOpen) {
            closeMenu();
          } else {
            openMenu();
          }
        });

        document.addEventListener('click', function(e) {
          const isOpen = mobileToggle.getAttribute('aria-expanded') === 'true';
          if (isOpen && !mobileMenu.contains(e.target) && e.target !== mobileToggle) {
            closeMenu();
          }
        });

        document.addEventListener('keydown', function(e) {
          const isOpen = mobileToggle.getAttribute('aria-expanded') === 'true';
          if (!isOpen) return;

          if (e.key === 'Escape') {
            closeMenu();
            return;
          }

          if (e.key === 'Tab') {
            const focusableEls = mobileMenu.querySelectorAll('a, button');
            if (!focusableEls.length) return;
            const firstEl = focusableEls[0];
            const lastEl = focusableEls[focusableEls.length - 1];

            if (e.shiftKey && document.activeElement === firstEl) {
              e.preventDefault();
              lastEl.focus();
            } else if (!e.shiftKey && document.activeElement === lastEl) {
              e.preventDefault();
              firstEl.focus();
            }
          }
        });
      }
    })();
  </script>
</body>
</html>
