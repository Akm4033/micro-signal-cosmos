---
import '../styles/global.css';
import NewsletterInline from '../components/newsletter/NewsletterInline.astro';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  author?: string;
  publishedTime?: string;
  modifiedTime?: string;
  noindex?: boolean;
}

const { title, description, canonical, ogImage, author, publishedTime, modifiedTime, noindex = false } = Astro.props;
const siteUrl = Astro.site ? Astro.site.href.replace(/\/$/, '') : (process.env.SITE_URL || 'https://signal-insight.pages.dev');
const canonicalUrl = canonical || (siteUrl + Astro.url.pathname);
const rawOg = ogImage && !ogImage.includes('favicon.svg') ? ogImage : '/og/default.png';
const ogImageUrl = rawOg.startsWith('http') ? rawOg : `${siteUrl}${rawOg.startsWith('/') ? '' : '/'}${rawOg}`;
const defaultDesc = 'Understand the world. Explore beyond it. Signal Insight is an AI-powered global knowledge discovery and learning platform exploring systems engineering, AI/ML foundations, astrophysics, and developer infrastructure.';

const pathname = Astro.url.pathname;
const navLinks = [
  { name: 'Articles', href: '/articles/' },
  { name: 'Curriculum', href: '/curriculum/' },
  { name: 'Tools', href: '/tools/' },
  { name: 'Subscribe', href: '/newsletter/' },
];

function isNavActive(href: string) {
  if (href === '/') return pathname === '/';
  return pathname.startsWith(href);
}
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="generator" content={Astro.generator}>
  <title>{title}</title>
  <meta name="description" content={description || defaultDesc}>
  <meta name="theme-color" content="#2563EB">
  <meta name="msvalidate.01" content="F1C67ADB1DD604D02EF0E520B82D7DE3">
  <!-- Microsoft Clarity Analytics & Heatmaps -->
  <script is:inline>
    (function(c,l,a,r,i,t,y){
        c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
        t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i+"?ref=bwt";
        y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
    })(window, document, "clarity", "script", "zcpk9zcqlk");
  </script>
  <!-- Cloudflare Web Analytics (Privacy-First & Core Web Vitals) -->
  <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "cf833ca7852d42e3bea7c5ecd72994b8"}'></script>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <!-- High-Performance Zero-Network System Font Stack -->
  <style is:inline>
    :root {
      --font-system: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
      --font-mono: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, 'Liberation Mono', monospace;
    }
  </style>
  {noindex ? (
    <meta name="robots" content="noindex, nofollow">
  ) : (
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1">
  )}
  <link rel="canonical" href={canonicalUrl}>
  <meta property="og:site_name" content="Signal Insight">
  <meta property="og:locale" content="en_US">
  <meta property="og:type" content="website">
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description || defaultDesc}>
  <meta property="og:url" content={canonicalUrl}>
  <meta property="og:image" content={ogImageUrl}>
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={description || defaultDesc}>
  <meta name="twitter:image" content={ogImageUrl}>
  <link rel="alternate" type="application/rss+xml" title="Signal Insight" href="/rss.xml">
  <link rel="sitemap" href="/sitemap.xml">

  <!-- Immediate Theme Determination to Prevent Flash (Deep Midnight Default) -->
  <script is:inline>
    (function() {
      try {
        var t = localStorage.getItem('signal_insight_theme');
        if (t === 'light') {
          document.documentElement.classList.remove('dark');
        } else {
          document.documentElement.classList.add('dark');
        }
      } catch (e) {}
    })();
  </script>

  <script type="application/ld+json" is:inline set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Organization",
        "@id": `${siteUrl}/#organization`,
        "name": "Signal Insight",
        "url": siteUrl,
        "logo": {
          "@type": "ImageObject",
          "url": `${siteUrl}/favicon.svg`,
          "width": 512,
          "height": 512
        },
        "description": "Understand the world. Explore beyond it. Signal Insight is an AI-powered global knowledge discovery and learning platform."
      },
      {
        "@type": "WebSite",
        "@id": `${siteUrl}/#website`,
        "name": "Signal Insight",
        "url": siteUrl,
        "publisher": { "@id": `${siteUrl}/#organization` },
        "potentialAction": {
          "@type": "SearchAction",
          "target": {
            "@type": "EntryPoint",
            "urlTemplate": `${siteUrl}/articles/?q={search_term_string}`
          },
          "query-input": "required name=search_term_string"
        }
      }
    ]
  })} />
</head>
<body class="bg-[#F8FAFC] text-[#0F172A] dark:bg-[#05070E] dark:text-[#F8FAFC] min-h-screen flex flex-col antialiased transition-colors duration-200">
  <!-- Reading Progress Bar -->
  <div id="reading-progress-bar" aria-hidden="true"></div>
  <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:rounded-lg focus:bg-blue-600 focus:px-4 focus:py-2 focus:text-sm focus:font-bold focus:text-white focus:shadow-lg focus:outline-none">Skip to main content</a>

  <!-- Top Editorial Utility Bar (Precision Monospaced Research Header) -->
  <div class="border-b border-slate-200/80 bg-white/80 text-xs font-medium text-slate-600 hidden sm:block dark:border-white/[0.06] dark:bg-[#05070E]/80 backdrop-blur-md">
    <div class="container-wide flex items-center justify-between py-1.5">
      <div class="flex items-center gap-2.5">
        <span class="inline-flex items-center gap-1.5 font-bold uppercase tracking-wider text-slate-900 dark:text-slate-100">
          <span class="h-1.5 w-1.5 rounded-full bg-emerald-500 animate-pulse"></span>Signal Insight
        </span>
        <span aria-hidden="true" class="text-slate-300 dark:text-slate-700">&bull;</span>
        <span class="text-slate-500 dark:text-slate-400 font-mono text-xs">Open Scientific Research &amp; Systems Platform</span>
      </div>
      <div class="flex items-center gap-4 text-slate-500 dark:text-slate-400 text-xs">
        <a href="/tools/" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">Tools</a>
        <a href="/authors/" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">Research Desk</a>
        <a href="/about/" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">About</a>
        <a href="/contact/" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">Contact</a>
        <a href="/rss.xml" class="hover:text-blue-600 dark:hover:text-blue-400 font-semibold transition-colors flex items-center gap-1 font-mono text-xs"><span>/rss.xml</span><span aria-hidden="true">&rarr;</span></a>
      </div>
    </div>
  </div>

  <!-- Header / Navigation (Frosted Glass Cosmic Bar) -->
  <header class="sticky top-0 z-40 border-b border-slate-200/80 bg-white/85 backdrop-blur-md dark:border-white/[0.08] dark:bg-[#05070E]/85 transition-colors">
    <div class="container-wide">
      <div class="flex min-h-16 items-center justify-between gap-3 py-2 sm:py-0">
        <!-- Brand Emblem & Wordmark -->
        <a href="/" class="shrink-0 flex items-center gap-2.5 sm:gap-3 group py-1" aria-label="Signal Insight Homepage">
          <div class="w-8 h-8 sm:w-9 sm:h-9 rounded-xl bg-blue-600 p-1 flex items-center justify-center transition-transform group-hover:scale-105 shadow-[0_0_15px_rgba(59,130,246,0.3)]">
            <svg class="w-full h-full" viewBox="0 0 128 128" fill="none" xmlns="http://www.w3.org/2000/svg">
              <circle cx="64" cy="64" r="44" stroke="#ffffff" stroke-width="7" stroke-opacity="0.35"/>
              <path d="M 88 38 A 38 38 0 1 0 88 90" stroke="#ffffff" stroke-width="9" stroke-linecap="round"/>
              <circle cx="64" cy="64" r="9" fill="#ffffff"/>
            </svg>
          </div>
          <div class="flex flex-col justify-center">
            <span class="block text-xl sm:text-2xl font-black tracking-tight text-slate-900 group-hover:text-blue-600 transition-colors dark:text-white leading-none">Signal Insight</span>
            <span class="block text-[9.5px] font-semibold tracking-[0.16em] text-slate-500 uppercase dark:text-slate-400 mt-1">Explore Beyond</span>
          </div>
        </a>

        <!-- Desktop Navigation (Dynamically Highlights Active State) -->
        <nav aria-label="Main navigation" class="hidden items-center gap-1 xl:gap-1.5 lg:flex">
          {navLinks.map((link) => {
            const active = isNavActive(link.href);
            return (
              <a
                href={link.href}
                class:list={[
                  'px-2.5 py-1.5 text-xs font-semibold tracking-wide rounded-lg transition-colors',
                  active
                    ? 'text-blue-700 bg-blue-50 dark:bg-blue-950/70 dark:text-blue-300 font-bold'
                    : 'text-slate-600 hover:text-blue-600 hover:bg-slate-100 dark:text-slate-300 dark:hover:bg-slate-800'
                ]}
                aria-current={active ? 'page' : undefined}
                title={link.name}
              >
                {link.name}
              </a>
            );
          })}
        </nav>

        <!-- Right Controls: Search + Theme Toggle + Mobile Drawer -->
        <div class="flex items-center gap-2">
          <!-- Quick Search Button (>=44x44px target) -->
          <a
            href="/articles/"
            class="flex min-h-11 h-11 items-center justify-center gap-1.5 rounded-xl border border-slate-200 bg-slate-50 px-3.5 text-xs font-medium text-slate-700 hover:border-blue-400 hover:bg-white hover:text-blue-600 dark:border-white/[0.1] dark:bg-[#0B101D] dark:text-slate-200 dark:hover:border-blue-500/50 dark:hover:bg-[#111827] transition-all"
            aria-label="Search articles"
            title="Search Signal Insight Knowledge Archive"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
            <span class="hidden sm:inline">Search</span>
            <span class="hidden md:inline-block ml-1 px-1.5 py-0.5 rounded border border-slate-200 dark:border-white/[0.1] text-xs font-mono text-slate-400">⌘K</span>
          </a>

          <!-- Theme Toggle (>=44x44px target) -->
          <button
            id="theme-toggle-btn"
            type="button"
            class="flex min-h-11 min-w-11 h-11 w-11 items-center justify-center rounded-xl border border-slate-200 bg-white text-slate-600 hover:text-blue-600 hover:border-blue-300 dark:border-white/[0.1] dark:bg-[#0B101D] dark:text-slate-300 dark:hover:text-white transition-colors cursor-pointer"
            aria-label="Toggle visual theme"
            title="Toggle dark/light theme"
          >
            <!-- Sun icon for dark mode -->
            <svg class="hidden dark:block h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="5"></circle>
              <line x1="12" y1="1" x2="12" y2="3"></line>
              <line x1="12" y1="21" x2="12" y2="23"></line>
              <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
              <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
              <line x1="1" y1="12" x2="3" y2="12"></line>
              <line x1="21" y1="12" x2="23" y2="12"></line>
              <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
              <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
            </svg>
            <!-- Moon icon for light mode -->
            <svg class="block dark:hidden h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
            </svg>
          </button>

          <!-- Mobile Drawer Toggle (>=44x44px target) -->
          <div class="relative lg:hidden">
            <button
              type="button"
              id="mobile-nav-toggle"
              aria-expanded="false"
              aria-controls="mobile-nav-menu"
              class="flex min-h-11 min-w-11 h-11 w-11 cursor-pointer items-center justify-center rounded-xl border border-slate-200 bg-white text-slate-700 hover:border-blue-400 hover:text-blue-600 dark:border-white/[0.1] dark:bg-[#0B101D] dark:text-slate-200 transition-all"
              aria-label="Toggle navigation menu"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="3" y1="12" x2="21" y2="12"></line>
                <line x1="3" y1="6" x2="21" y2="6"></line>
                <line x1="3" y1="18" x2="21" y2="18"></line>
              </svg>
            </button>
            <nav
              id="mobile-nav-menu"
              class="hidden absolute right-0 top-full mt-2 w-72 max-w-[calc(100vw-2rem)] rounded-xl border border-slate-200 bg-white p-4 shadow-xl dark:border-white/[0.1] dark:bg-[#0B101D] z-50"
              aria-label="Mobile Navigation Menu"
