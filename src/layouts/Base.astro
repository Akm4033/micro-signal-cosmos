---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  author?: string;
  publishedTime?: string;
  modifiedTime?: string;
  noindex?: boolean;
}

const { title, description, canonical, ogImage, author, publishedTime, modifiedTime, noindex = false } = Astro.props;
const siteUrl = Astro.site ? Astro.site.href.replace(/\/$/, '') : (process.env.SITE_URL || 'https://signal-insight.pages.dev');
const canonicalUrl = canonical || (siteUrl + Astro.url.pathname);
const ogImageUrl = ogImage || '/favicon.svg';
const defaultDesc = 'Understand the world. Explore beyond it. Signal Insight is an AI-powered global knowledge discovery and learning platform exploring systems engineering, AI/ML foundations, astrophysics, and developer infrastructure.';

const pathname = Astro.url.pathname;
const navLinks = [
  { name: 'Home', href: '/' },
  { name: 'Articles', href: '/articles/' },
  { name: 'Technology', href: '/category/technology/' },
  { name: 'AI & ML', href: '/category/artificial-intelligence/' },
  { name: 'Science', href: '/category/science/' },
  { name: 'Dev Tools', href: '/category/developer-tools/' },
  { name: 'Tools', href: '/tools/' },
  { name: 'About', href: '/about/' },
];

function isNavActive(href: string) {
  if (href === '/') return pathname === '/';
  return pathname.startsWith(href);
}
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="generator" content={Astro.generator}>
  <title>{title}</title>
  <meta name="description" content={description || defaultDesc}>
  <meta name="theme-color" content="#2563EB">
  <meta name="msvalidate.01" content="F1C67ADB1DD604D02EF0E520B82D7DE3">
  <!-- Microsoft Clarity Analytics & Heatmaps -->
  <script is:inline>
    (function(c,l,a,r,i,t,y){
        c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
        t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i+"?ref=bwt";
        y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
    })(window, document, "clarity", "script", "zcpk9zcqlk");
  </script>
  <!-- Cloudflare Web Analytics (Privacy-First & Core Web Vitals) -->
  <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "cf833ca7852d42e3bea7c5ecd72994b8"}'></script>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <!-- High-Performance Zero-Network System Font Stack -->
  <style is:inline>
    :root {
      --font-system: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
      --font-mono: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, 'Liberation Mono', monospace;
    }
  </style>
  {noindex ? (
    <meta name="robots" content="noindex, nofollow">
  ) : (
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1">
  )}
  <link rel="canonical" href={canonicalUrl}>
  <meta property="og:site_name" content="Signal Insight">
  <meta property="og:locale" content="en_US">
  <meta property="og:type" content="website">
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description || defaultDesc}>
  <meta property="og:url" content={canonicalUrl}>
  <meta property="og:image" content={ogImageUrl}>
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={description || defaultDesc}>
  <meta name="twitter:image" content={ogImageUrl}>
  <link rel="alternate" type="application/rss+xml" title="Signal Insight" href="/rss.xml">
  <link rel="sitemap" href="/sitemap.xml">

  <!-- Immediate Theme Determination to Prevent Flash (Deep Midnight Default) -->
  <script is:inline>
    (function() {
      try {
        var t = localStorage.getItem('signal_insight_theme');
        if (t === 'light') {
          document.documentElement.classList.remove('dark');
        } else {
          document.documentElement.classList.add('dark');
        }
      } catch (e) {}
    })();
  </script>

  <script type="application/ld+json" is:inline set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Organization",
        "@id": `${siteUrl}/#organization`,
        "name": "Signal Insight",
        "url": siteUrl,
        "logo": {
          "@type": "ImageObject",
          "url": `${siteUrl}/favicon.svg`,
          "width": 512,
          "height": 512
        },
        "description": "Understand the world. Explore beyond it. Signal Insight is an AI-powered global knowledge discovery and learning platform."
      },
      {
        "@type": "WebSite",
        "@id": `${siteUrl}/#website`,
        "name": "Signal Insight",
        "url": siteUrl,
        "publisher": { "@id": `${siteUrl}/#organization` },
        "potentialAction": {
          "@type": "SearchAction",
          "target": {
            "@type": "EntryPoint",
            "urlTemplate": `${siteUrl}/articles/?q={search_term_string}`
          },
          "query-input": "required name=search_term_string"
        }
      }
    ]
  })} />
</head>
<body class="bg-[#F8FAFC] text-[#0F172A] dark:bg-[#05070E] dark:text-[#F8FAFC] min-h-screen flex flex-col antialiased transition-colors duration-200">
  <!-- Reading Progress Bar -->
  <div id="reading-progress-bar" aria-hidden="true"></div>
  <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:rounded-lg focus:bg-blue-600 focus:px-4 focus:py-2 focus:text-sm focus:font-bold focus:text-white focus:shadow-lg focus:outline-none">Skip to main content</a>

  <!-- Top Editorial Utility Bar (Precision Monospaced Research Header) -->
  <div class="border-b border-slate-200/80 bg-white/80 text-[11px] font-medium text-slate-600 hidden sm:block dark:border-white/[0.06] dark:bg-[#05070E]/80 backdrop-blur-md">
    <div class="container-wide flex items-center justify-between py-1.5">
      <div class="flex items-center gap-2.5">
        <span class="inline-flex items-center gap-1.5 font-bold uppercase tracking-wider text-slate-900 dark:text-slate-100">
          <span class="h-1.5 w-1.5 rounded-full bg-emerald-500 animate-pulse"></span>Signal Insight
        </span>
        <span aria-hidden="true" class="text-slate-300 dark:text-slate-700">&bull;</span>
        <span class="text-slate-500 dark:text-slate-400 font-mono text-[10.5px]">Open Scientific Research &amp; Systems Platform</span>
      </div>
      <div class="flex items-center gap-4 text-slate-500 dark:text-slate-400 text-[11px]">
        <a href="/tools/" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">Tools</a>
        <a href="/authors/" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">Research Desk</a>
        <a href="/about/" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">About</a>
        <a href="/contact/" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">Contact</a>
        <a href="/rss.xml" class="hover:text-blue-600 dark:hover:text-blue-400 font-semibold transition-colors flex items-center gap-1 font-mono text-[10.5px]"><span>/rss.xml</span><span aria-hidden="true">&rarr;</span></a>
      </div>
    </div>
  </div>

  <!-- Header / Navigation (Frosted Glass Cosmic Bar) -->
  <header class="sticky top-0 z-40 border-b border-slate-200/80 bg-white/85 backdrop-blur-md dark:border-white/[0.08] dark:bg-[#05070E]/85 transition-colors">
    <div class="container-wide">
      <div class="flex min-h-16 items-center justify-between gap-3 py-2 sm:py-0">
        <!-- Brand Emblem & Wordmark -->
        <a href="/" class="shrink-0 flex items-center gap-2.5 sm:gap-3 group py-1" aria-label="Signal Insight Homepage">
          <div class="w-8 h-8 sm:w-9 sm:h-9 rounded-xl bg-blue-600 p-1 flex items-center justify-center transition-transform group-hover:scale-105 shadow-[0_0_15px_rgba(59,130,246,0.3)]">
            <svg class="w-full h-full" viewBox="0 0 128 128" fill="none" xmlns="http://www.w3.org/2000/svg">
              <circle cx="64" cy="64" r="44" stroke="#ffffff" stroke-width="7" stroke-opacity="0.35"/>
              <path d="M 88 38 A 38 38 0 1 0 88 90" stroke="#ffffff" stroke-width="9" stroke-linecap="round"/>
              <circle cx="64" cy="64" r="9" fill="#ffffff"/>
            </svg>
          </div>
          <div class="flex flex-col justify-center">
            <span class="block text-xl sm:text-2xl font-black tracking-tight text-slate-900 group-hover:text-blue-600 transition-colors dark:text-white leading-none">Signal Insight</span>
            <span class="block text-[9.5px] font-semibold tracking-[0.16em] text-slate-500 uppercase dark:text-slate-400 mt-1">Explore Beyond</span>
          </div>
        </a>

        <!-- Desktop Navigation (Dynamically Highlights Active State) -->
        <nav aria-label="Main navigation" class="hidden items-center gap-1 xl:gap-1.5 lg:flex">
          {navLinks.map((link) => {
            const active = isNavActive(link.href);
            return (
              <a
                href={link.href}
                class:list={[
                  'px-2.5 py-1.5 text-xs font-semibold tracking-wide rounded-lg transition-colors',
                  active
                    ? 'text-blue-700 bg-blue-50 dark:bg-blue-950/70 dark:text-blue-300 font-bold'
                    : 'text-slate-600 hover:text-blue-600 hover:bg-slate-100 dark:text-slate-300 dark:hover:bg-slate-800'
                ]}
                aria-current={active ? 'page' : undefined}
                title={link.name}
              >
                {link.name}
              </a>
            );
          })}
        </nav>

        <!-- Right Controls: Search + Theme Toggle + Mobile Drawer -->
        <div class="flex items-center gap-2">
          <!-- Quick Search Button -->
          <a
            href="/articles/"
            class="flex h-9 items-center justify-center gap-1.5 rounded-lg border border-slate-200 bg-slate-50 px-3 text-xs font-medium text-slate-700 hover:border-blue-400 hover:bg-white hover:text-blue-600 dark:border-white/[0.1] dark:bg-[#0B101D] dark:text-slate-200 dark:hover:border-blue-500/50 dark:hover:bg-[#111827] transition-all"
            aria-label="Search articles"
            title="Search Signal Insight Knowledge Archive"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
            <span class="hidden sm:inline">Search</span>
            <span class="hidden md:inline-block ml-1 px-1.5 py-0.2 rounded border border-slate-200 dark:border-white/[0.1] text-[10px] font-mono text-slate-400">⌘K</span>
          </a>

          <!-- Theme Toggle (Light / Dark Switch) -->
          <button
            id="theme-toggle-btn"
            type="button"
            class="flex h-9 w-9 items-center justify-center rounded-lg border border-slate-200 bg-white text-slate-600 hover:text-blue-600 hover:border-blue-300 dark:border-white/[0.1] dark:bg-[#0B101D] dark:text-slate-300 dark:hover:text-white transition-colors cursor-pointer"
            aria-label="Toggle visual theme"
            title="Toggle dark/light theme"
          >
            <!-- Sun icon for dark mode -->
            <svg class="hidden dark:block h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="5"></circle>
              <line x1="12" y1="1" x2="12" y2="3"></line>
              <line x1="12" y1="21" x2="12" y2="23"></line>
              <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
              <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
              <line x1="1" y1="12" x2="3" y2="12"></line>
              <line x1="21" y1="12" x2="23" y2="12"></line>
              <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
              <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
            </svg>
            <!-- Moon icon for light mode -->
            <svg class="block dark:hidden h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
            </svg>
          </button>

          <!-- Mobile Drawer Toggle -->
          <details class="relative lg:hidden" id="mobile-nav-details">
            <summary class="flex h-9 w-9 cursor-pointer list-none items-center justify-center rounded-lg border border-slate-200 bg-white text-slate-700 hover:border-blue-400 hover:text-blue-600 dark:border-white/[0.1] dark:bg-[#0B101D] dark:text-slate-200 transition-all" aria-label="Toggle navigation menu" id="mobile-nav-toggle">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="3" y1="12" x2="21" y2="12"></line>
                <line x1="3" y1="6" x2="21" y2="6"></line>
                <line x1="3" y1="18" x2="21" y2="18"></line>
              </svg>
            </summary>
            <div class="absolute right-0 top-full mt-2 w-72 max-w-[calc(100vw-2rem)] rounded-xl border border-slate-200 bg-white p-4 shadow-xl dark:border-white/[0.1] dark:bg-[#0B101D] z-50" role="dialog" aria-label="Mobile Navigation Menu">
              <div class="mb-3 pb-2 border-b border-slate-100 flex items-center justify-between dark:border-white/[0.08]">
                <span class="text-xs font-bold uppercase tracking-wider text-slate-400">Signal Insight Navigation</span>
                <span class="text-[10px] font-semibold text-blue-600 uppercase font-mono">4 Pillars</span>
              </div>
              <nav class="flex flex-col space-y-1">
                {navLinks.map((link) => {
                  const active = isNavActive(link.href);
                  return (
                    <a
                      href={link.href}
                      class:list={[
                        'rounded-lg px-3 py-2 text-sm font-semibold transition-colors flex items-center justify-between',
                        active
                          ? 'text-blue-700 bg-blue-50 dark:bg-blue-950/70 dark:text-blue-300 font-bold'
                          : 'text-slate-700 hover:bg-slate-50 hover:text-blue-600 dark:text-slate-300 dark:hover:bg-slate-800'
                      ]}
                      aria-current={active ? 'page' : undefined}
                    >
                      <span>{link.name}</span>
                      <span aria-hidden="true" class="text-xs text-slate-400">&rarr;</span>
                    </a>
                  );
                })}
              </nav>
              <div class="mt-4 pt-3 border-t border-slate-100 flex flex-col gap-2 dark:border-white/[0.08]">
                <a href="/articles/" class="flex items-center justify-center gap-1.5 rounded-lg bg-blue-600 py-2 text-xs font-semibold text-white shadow-xs transition-colors hover:bg-blue-700"><span>Search All Knowledge</span><span aria-hidden="true">&rarr;</span></a>
                <div class="flex items-center justify-around text-xs text-slate-500 dark:text-slate-400 pt-1">
                  <a href="/about/" class="hover:text-blue-600">About</a><span>&bull;</span><a href="/authors/" class="hover:text-blue-600">Research</a><span>&bull;</span><a href="/contact/" class="hover:text-blue-600">Contact</a>
                </div>
              </div>
            </div>
          </details>
        </div>
      </div>
    </div>
  </header>

  <main id="main-content" class="flex-1 w-full max-w-full min-w-0">
    <slot />
  </main>

  <!-- International Scientific Journal Footer (Deep Cosmic Midnight Background #030509) -->
  <footer class="border-t border-slate-200/80 bg-[#0F172A] text-slate-300 dark:border-white/[0.08] dark:bg-[#030509] w-full max-w-full">
    <div class="container-wide py-14 sm:py-16">
      <div class="grid grid-cols-1 gap-10 md:grid-cols-2 lg:grid-cols-5">
        <div class="lg:col-span-2">
          <a href="/" class="text-2xl font-black tracking-tight text-white flex items-center gap-2">
            <span>Signal Insight</span>
          </a>
          <p class="mt-2 text-xs font-bold uppercase tracking-widest text-slate-400">Understand the world. Explore beyond it.</p>
          <p class="mt-3.5 max-w-sm text-xs sm:text-sm leading-relaxed text-slate-300">A global scientific knowledge discovery and learning platform exploring systems engineering, neural architectures, astrophysics, and developer infrastructure through rigorous research.</p>
          <div class="mt-5 flex items-center gap-3">
            <a href="https://github.com/Akm4033/signal-insight" target="_blank" rel="noopener noreferrer" class="flex h-8 items-center gap-1.5 rounded-md border border-slate-700 bg-slate-800/80 px-2.5 text-xs font-medium text-slate-200 transition-colors hover:border-blue-500 hover:text-white" aria-label="Signal Insight on GitHub"><span>GitHub</span><span aria-hidden="true">↗</span></a>
            <a href="https://www.youtube.com/@SignalInsight" target="_blank" rel="noopener noreferrer" class="flex h-8 items-center gap-1.5 rounded-md border border-slate-700 bg-slate-800/80 px-2.5 text-xs font-medium text-slate-200 transition-colors hover:border-blue-500 hover:text-white" aria-label="Signal Insight Channel"><span>YouTube</span><span aria-hidden="true">↗</span></a>
          </div>
        </div>

        <nav aria-label="Knowledge Pillars navigation">
          <h3 class="text-xs font-bold uppercase tracking-widest text-white mb-3">4 Knowledge Pillars</h3>
          <ul class="space-y-2 text-xs sm:text-sm">
            <li><a href="/category/technology/" class="text-slate-300 transition-colors hover:text-white hover:underline underline-offset-4">Systems &amp; Technology</a></li>
            <li><a href="/category/artificial-intelligence/" class="text-slate-300 transition-colors hover:text-white hover:underline underline-offset-4">AI &amp; Neural Foundations</a></li>
            <li><a href="/category/science/" class="text-slate-300 transition-colors hover:text-white hover:underline underline-offset-4">Astrophysics &amp; Physics</a></li>
            <li><a href="/category/developer-tools/" class="text-slate-300 transition-colors hover:text-white hover:underline underline-offset-4">Developer Infrastructure</a></li>
          </ul>
        </nav>

        <nav aria-label="Site exploration navigation">
          <h3 class="text-xs font-bold uppercase tracking-widest text-white mb-3">Discover</h3>
          <ul class="space-y-2 text-xs sm:text-sm">
            <li><a href="/articles/" class="text-slate-300 transition-colors hover:text-white hover:underline underline-offset-4">All Articles</a></li>
            <li><a href="/tools/" class="text-slate-300 transition-colors hover:text-white hover:underline underline-offset-4">Tools &amp; Stack</a></li>
            <li><a href="/authors/" class="text-slate-300 transition-colors hover:text-white hover:underline underline-offset-4">Research Desk</a></li>
            <li><a href="/about/" class="text-slate-300 transition-colors hover:text-white hover:underline underline-offset-4">About Signal Insight</a></li>
            <li><a href="/contact/" class="text-slate-300 transition-colors hover:text-white hover:underline underline-offset-4">Contact</a></li>
            <li><a href="/rss.xml" class="text-slate-300 transition-colors hover:text-white hover:underline underline-offset-4">RSS Feed</a></li>
          </ul>
        </nav>

        <div class="newsletter-footer space-y-3">
          <h3 class="text-xs font-bold uppercase tracking-widest text-white">Signal Insight Syndication</h3>
          <p class="text-xs leading-relaxed text-slate-300">Weekly technical breakdowns via open RSS 2.0 web standards.</p>
          <div class="flex flex-col sm:flex-row gap-2">
            <a
              href="/rss.xml"
              target="_blank"
              class="inline-flex items-center justify-center gap-1.5 rounded-lg bg-blue-600 px-3.5 py-2 text-xs font-bold uppercase tracking-wider text-white transition-colors hover:bg-blue-500 text-center"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M4 11a9 9 0 0 1 9 9"></path>
                <path d="M4 4a16 16 0 0 1 16 16"></path>
                <circle cx="5" cy="19" r="1"></circle>
              </svg>
              <span>/rss.xml</span>
            </a>
            <a
              href="/newsletter/"
              class="inline-flex items-center justify-center rounded-lg border border-slate-700 bg-slate-800/90 px-3 py-2 text-xs font-medium text-slate-300 hover:text-white hover:bg-slate-700 transition-colors text-center"
            >
              Reader Options &rarr;
            </a>
          </div>
          <p class="text-[10px] text-slate-400">Zero tracking &bull; 100% open web standards.</p>
        </div>
      </div>

      <div class="mt-12 border-t border-slate-800 pt-6 flex flex-col items-center justify-between gap-3 text-xs text-slate-400 sm:flex-row">
        <p>&copy; 2026 Signal Insight. All rights reserved.</p>
        <nav aria-label="Legal and utility navigation" class="flex flex-wrap items-center gap-4 sm:gap-6">
          <a href="/privacy-policy/" class="hover:text-white transition-colors">Privacy</a>
          <a href="/terms/" class="hover:text-white transition-colors">Terms</a>
          <a href="/disclaimer/" class="hover:text-white transition-colors">Disclaimer</a>
          <a href="/sitemap.xml" class="hover:text-white transition-colors">Sitemap</a>
          <a href="/contact/" class="hover:text-white transition-colors">Contact</a>
        </nav>
      </div>
    </div>
  </footer>

  <!-- Theme Toggle & Reading Bar Scripts -->
  <script is:inline>
    (function() {
      // Reading progress bar
      const bar = document.getElementById('reading-progress-bar');
      if (bar) {
        window.addEventListener('scroll', function() {
          const winScroll = document.documentElement.scrollTop || document.body.scrollTop;
          const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
          if (height > 0) { bar.style.transform = 'scaleX(' + (winScroll / height) + ')'; }
        }, { passive: true });
      }

      // Theme toggle functionality
      const toggleBtn = document.getElementById('theme-toggle-btn');
      if (toggleBtn) {
        toggleBtn.addEventListener('click', function() {
          const isDark = document.documentElement.classList.toggle('dark');
          try {
            localStorage.setItem('signal_insight_theme', isDark ? 'dark' : 'light');
          } catch(e) {}
        });
      }

      // Mobile navigation drawer interaction & Escape key dismissal
      const mobileNav = document.getElementById('mobile-nav-details');
      const mobileToggle = document.getElementById('mobile-nav-toggle');
      if (mobileNav && mobileToggle) {
        mobileNav.addEventListener('toggle', function() {
          mobileToggle.setAttribute('aria-expanded', String(mobileNav.open));
        });

        document.addEventListener('click', function(e) {
          if (mobileNav.open && !mobileNav.contains(e.target)) {
            mobileNav.removeAttribute('open');
            mobileToggle.setAttribute('aria-expanded', 'false');
          }
        });

        document.addEventListener('keydown', function(e) {
          if (e.key === 'Escape' && mobileNav.open) {
            mobileNav.removeAttribute('open');
            mobileToggle.setAttribute('aria-expanded', 'false');
            mobileToggle.focus();
          }
        });
      }
    })();
  </script>
</body>
</html>
