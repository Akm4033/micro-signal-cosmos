# =========================================================================
# MICRO SIGNAL COSMOS — HTTP HEADERS & CACHING POLICY
# Supported by Cloudflare Pages, Netlify, and compatible static CDN engines
# =========================================================================

# 1. Hashed static assets — Immutable long-term caching (1 year)
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# 2. Static icons and brand vectors
/favicon.svg
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/favicon.ico
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# 3. Dynamic feeds & syndication — Short caching to ensure fresh updates
/rss.xml
  Cache-Control: public, max-age=3600, must-revalidate
  Content-Type: application/rss+xml; charset=UTF-8

/sitemap.xml
  Cache-Control: public, max-age=86400, must-revalidate
  Content-Type: application/xml; charset=UTF-8

/robots.txt
  Cache-Control: public, max-age=86400, must-revalidate
  Content-Type: text/plain; charset=UTF-8

# 4. Global Security Headers for all HTML and static responses
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  X-XSS-Protection: 1; mode=block

