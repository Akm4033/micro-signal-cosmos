# =========================================================================
# MICRO SIGNAL COSMOS — ENVIRONMENT CONFIGURATION
# Copy this file to .env for local development or set variables in your CI/CD platform
# =========================================================================

# Production Domain (Required for full canonical URLs, Open Graph, Sitemap & RSS links)
# Example: SITE_URL=https://microsignalcosmos.com
SITE_URL=

# Optional: Contact Form Provider Key (Web3Forms for Cloudflare Pages)
# Obtain a free access key at https://web3forms.com/ and set here or in hosting dashboard
PUBLIC_WEB3FORMS_KEY=

